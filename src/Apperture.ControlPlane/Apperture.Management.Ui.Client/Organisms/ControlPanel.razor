@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Shared
@using Apperture.Management.Ui.Shared.Models
@inject DomainMenuService DomainMenuService
@inject NavigationManager NavManager
@implements IDisposable

<div id="control-panel"
     class="shell-panel-width h-full bg-surface transition-transform duration-300 z-20 flex shrink-0 flex-col overflow-auto border-r border-default text-body @(IsOpen ? "translate-x-0" : "-translate-x-full") relative">
    @if (Definition is null)
    {
        <div class="p-4 text-sm text-muted">
            @if (DomainMenuService.LastLoaded is null)
            {
                <span>Loading…</span>
            }
            else if (string.IsNullOrWhiteSpace(DomainName))
            {
                <span>Select a domain</span>
            }
            else
            {
                <span>No menu found for '@DomainName'</span>
            }
        </div>
    }
    else
    {
        @if (TitleToShow is not null)
        {
            <div class="flex items-center px-3 pt-6 pb-3">
                <span class="text-lg font-semibold text-heading">
                    @TitleToShow
                </span>
            </div>
        }

        <ul class="flex flex-col">
            @for (var i = 0; i < Definition.Items.Count; i++)
            {
                var item = Definition.Items[i];
                <ControlPanelNavNode @key="@i"
                                     Item="@item"
                                     DomainName="@DomainName"
                                     IndexPath="@i.ToString()"
                                     CurrentPath="@NormalizedCurrentPath"
                                     Expanded="@_expanded"
                                     OnToggleKey="HandleToggleKey"
                                     OnExpandHeader="HandleExpandHeader" />
            }
        </ul>
    }
    @if (IsOpen)
    {
        <button type="button"
                id="control-panel-resize-handle"
                class="focus-ring absolute right-0 top-0 z-30 h-full w-2 cursor-ew-resize touch-none border-0 bg-transparent p-0 hover:bg-surface-muted/35"
                aria-label="Resize control panel"></button>
    }
</div>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string DomainName { get; set; } = "";

    private bool _disposed;
    private string _currentPath => new Uri(NavManager.Uri).AbsolutePath.TrimEnd('/');

    protected override void OnInitialized()
    {
        NavManager.LocationChanged += OnLocationChanged;
    }

    public void Dispose()
    {
        if (_disposed) return;
        _disposed = true;
        NavManager.LocationChanged -= OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (_disposed || !IsOpen)
            return;

        _ = InvokeAsync(async () =>
        {
            await Task.Yield();
            if (_disposed || !IsOpen)
                return;
            StateHasChanged();
        });
    }

    private DomainMenu? Definition => DomainMenuService.GetDomain(DomainName);

    private string? TitleToShow
    {
        get
        {
            if (Definition == null) return null;
            if (Definition.Title == null) return DomainName;
            if (Definition.Title == string.Empty) return null;
            return Definition.Title;
        }
    }

    private readonly HashSet<string> _expanded = new();
    /// <summary>Last (domain, path) we applied auto-expand for. Avoids re-expanding on every render after a manual collapse.</summary>
    private string? _lastAutoExpandDomain;
    private string? _lastAutoExpandPath;

    private string NormalizedCurrentPath
    {
        get
        {
            var path = _currentPath;
            if (path.Length == 0) path = "/";
            return path;
        }
    }

    protected override void OnParametersSet()
    {
        if (Definition?.Items is null || string.IsNullOrWhiteSpace(DomainName)) return;
        var path = NormalizedCurrentPath;
        var domainChanged = _lastAutoExpandDomain is null ||
                            !string.Equals(DomainName, _lastAutoExpandDomain, StringComparison.OrdinalIgnoreCase);
        var pathChanged = _lastAutoExpandPath is null ||
                          !string.Equals(path, _lastAutoExpandPath, StringComparison.OrdinalIgnoreCase);
        if (!domainChanged && !pathChanged)
            return;

        _lastAutoExpandDomain = DomainName;
        _lastAutoExpandPath = path;
        for (var i = 0; i < Definition.Items.Count; i++)
            EnsureExpandedForActiveSubtree(Definition.Items[i], i.ToString(), path);
    }

    private void EnsureExpandedForActiveSubtree(DomainMenuItem item, string indexPath, string path)
    {
        if (item.Children is null || item.Children.Count == 0) return;
        var key = DomainMenuTree.GetExpandStateKey(DomainName, indexPath, item);
        for (var i = 0; i < item.Children.Count; i++)
        {
            var child = item.Children[i];
            if (!DomainMenuTree.SubtreeContainsActiveHref(child, path)) continue;
            _expanded.Add(key);
            var childPath = string.IsNullOrEmpty(indexPath) ? i.ToString() : $"{indexPath}/{i}";
            EnsureExpandedForActiveSubtree(child, childPath, path);
        }
    }

    private Task HandleToggleKey(string key)
    {
        if (_expanded.Contains(key))
            _expanded.Remove(key);
        else
            _expanded.Add(key);
        StateHasChanged();
        return Task.CompletedTask;
    }

    private Task HandleExpandHeader((string Key, string IndexPath) request)
    {
        var keep = CollectAncestorExpandKeys(request.IndexPath);
        keep.Add(request.Key);

        var changed = false;
        foreach (var key in _expanded.Where(k => !keep.Contains(k)).ToList())
        {
            _expanded.Remove(key);
            changed = true;
        }

        if (_expanded.Add(request.Key))
            changed = true;

        if (changed)
            StateHasChanged();
        return Task.CompletedTask;
    }

    private HashSet<string> CollectAncestorExpandKeys(string indexPath)
    {
        var keep = new HashSet<string>(StringComparer.Ordinal);
        if (Definition?.Items is null)
            return keep;

        var segments = indexPath.Split('/', StringSplitOptions.RemoveEmptyEntries);
        if (segments.Length <= 1)
            return keep;

        IList<DomainMenuItem> items = Definition.Items;
        var builtPath = "";

        for (var i = 0; i < segments.Length - 1; i++)
        {
            if (!int.TryParse(segments[i], out var idx) || idx < 0 || idx >= items.Count)
                return keep;

            var item = items[idx];
            builtPath = string.IsNullOrEmpty(builtPath) ? segments[i] : $"{builtPath}/{segments[i]}";

            if (item.Children is { Count: > 0 })
                keep.Add(DomainMenuTree.GetExpandStateKey(DomainName, builtPath, item));

            if (item.Children is null)
                return keep;
            items = item.Children;
        }

        return keep;
    }
}
