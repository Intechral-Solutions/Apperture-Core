@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Shared
@using Apperture.Management.Ui.Shared.Models
@inject DomainMenuService DomainMenuService
@inject NavigationManager NavManager
@implements IDisposable

<div id="control-panel" class="h-full w-54 bg-surface transition-transform duration-300 z-20 flex flex-col relative overflow-auto border-r border-default text-body @(IsOpen ? "translate-x-0" : "-translate-x-full")">
    @if (Definition is null)
    {
        <div class="p-4 text-sm text-muted">
            @if (DomainMenuService.LastLoaded is null)
            {
                <span>Loading…</span>
            }
            else if (string.IsNullOrWhiteSpace(DomainName))
            {
                <span>Select a domain</span>
            }
            else
            {
                <span>No menu found for '@DomainName'</span>
            }
        </div>
    }
    else
    {
        @if (TitleToShow is not null)
        {
            <div class="flex items-center px-3 pt-6 pb-3">
                <span class="text-lg font-semibold text-heading">
                    @TitleToShow
                </span>
            </div>
        }

        <ul class="flex flex-col">
            @foreach (var item in Definition.Items)
            {
                <li>
                    @if (item.Children != null && item.Children.Count > 0)
                    {
                        <div class="flex cursor-pointer items-center justify-between px-3 py-2 text-sm text-body hover:bg-surface-muted"
                             @onclick="() => Toggle(item.Text)">
                            <span>@item.Text</span>
                            <svg class="h-4 w-4 transform transition-transform duration-200 @(_expanded.Contains(item.Text) ? "rotate-90" : "")"
                                 xmlns="http://www.w3.org/2000/svg"
                                 fill="none" viewBox="0 0 24 24"
                                 stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                            </svg>
                        </div>

                        <ul class="@(_expanded.Contains(item.Text) || HasActiveChild(item) ? "block" : "hidden") ml-4 border-l border-default">
                            @foreach (var child in item.Children)
                            {
                                <li>
                                    <a href="@child.Href"
                                       class="block rounded px-3 py-2 text-sm @(IsActiveHref(child.Href) ? "font-medium text-heading bg-surface-muted" : "text-body hover:bg-surface-muted")">
                                        @child.Text
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <a href="@item.Href"
                           class="block rounded px-3 py-2 text-sm @(IsActiveHref(item.Href) ? "font-medium text-heading bg-surface-muted" : "text-body hover:bg-surface-muted")">
                            @item.Text
                        </a>
                    }
                </li>
            }
        </ul>
    }
</div>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public string DomainName { get; set; } = "";

    private bool _disposed;
    private string _currentPath => new Uri(NavManager.Uri).AbsolutePath.TrimEnd('/');

    protected override void OnInitialized()
    {
        NavManager.LocationChanged += OnLocationChanged;
    }

    public void Dispose()
    {
        if (_disposed) return;
        _disposed = true;
        NavManager.LocationChanged -= OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        _ = InvokeAsync(() =>
        {
            if (_disposed) return;
            StateHasChanged();
        });
    }

    private DomainMenu? Definition => DomainMenuService.GetDomain(DomainName);

    private string? TitleToShow
    {
        get
        {
            if (Definition == null) return null;
            if (Definition.Title == null) return DomainName;
            if (Definition.Title == string.Empty) return null;
            return Definition.Title;
        }
    }

    private readonly HashSet<string> _expanded = new();

    protected override void OnParametersSet()
    {
        if (Definition?.Items is null) return;
        foreach (var item in Definition.Items.Where(i => i.Children?.Count > 0))
        {
            if (HasActiveChild(item))
                _expanded.Add(item.Text);
        }
    }

    private void Toggle(string key)
    {
        if (_expanded.Contains(key))
            _expanded.Remove(key);
        else
            _expanded.Add(key);
    }

    private bool IsActiveHref(string? href)
    {
        var path = _currentPath;
        if (path.Length == 0) path = "/";
        return NavPathMatching.PathMatchesMenuHref(path, href);
    }

    private bool HasActiveChild(DomainMenuItem parent)
    {
        if (parent.Children is null) return false;
        return parent.Children.Any(c => IsActiveHref(c.Href));
    }
}
