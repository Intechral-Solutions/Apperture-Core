@using Microsoft.AspNetCore.Components.Web
@using Blazor.Heroicons.Solid
@using Apperture.Management.Ui.Shared
@using Apperture.Management.Ui.Shared.Models
@inject NavigationManager NavManager
@inject DomainMenuService DomainMenuService

<div id="nav-rail" class="fixed z-60 flex min-h-0 flex-row h-full print:hidden start-0 top-0 @(IsControlPanelOpen ? "" : "w-18")">
    <div class="w-17 flex-none flex flex-col h-full relative border-r border-dashed border-default bg-surface text-body duration-300 z-40">
        <div role="button"
             class="logo-link group mt-0.5 mb-8 block p-3 text-muted transition-all duration-200 cursor-pointer @(_isDashboardActive ? "opacity-100" : "opacity-70 hover:opacity-90")"
             aria-label="Dashboard home"
             @onclick="HandleLogoClick"
             @onkeydown="HandleLogoKeyDown"
             tabindex="0">
            <AppertureLogo WrapperClass="" ShapeClass="w-full" />
        </div>
        <nav class="flex flex-1 flex-col">
            <div class="flex flex-col space-y-4">
                @foreach (var m in _menuItems)
                {
                    <NavRailItem @key="m.Domain"
                                 IconType="@m.Icon"
                                 Tooltip="@m.Tooltip"
                                 AriaLabel="@m.Tooltip"
                                 Domain="@m.Domain"
                                 Href="@m.Href"
                                 CurrentDomain="@CurrentDomainName"
                                 CurrentPageUri="@NavManager.Uri"
                                 OnItemClick="HandleNavItemClick" />
                }
            </div>
            <div class="mt-auto flex justify-center">
                <NavRailItem Domain="@SectionOwnerConstants.Config"
                             IconType="@typeof(CogIcon)"
                             Tooltip="Configuration"
                             AriaLabel="Configuration"
                             CurrentDomain="@CurrentDomainName"
                             CurrentPageUri="@NavManager.Uri"
                             ContainerStyle="group relative inline-block -translate-y-5"
                             NavButtonStyle="h-12 w-12 flex items-center"
                             IconStyle="@GetConfigIconStyle()"
                             UseGlowEffect="true"
                             OnItemClick="HandleNavItemClick" />
            </div>
        </nav>
    </div>
    <ControlPanel IsOpen="@IsControlPanelOpen" DomainName="@CurrentDomainName" />
</div>

@code {
    [Parameter] public bool IsControlPanelOpen { get; set; }
    [Parameter] public bool IsControlPanelLocked { get; set; }
    [Parameter] public string CurrentDomainName { get; set; } = "";
    [Parameter] public EventCallback<string> OnControlPanelOpen { get; set; }
    [Parameter] public EventCallback OnControlPanelClose { get; set; }

    private List<(Type Icon, string Tooltip, string? Href, string? Domain)> _menuItems = new();

    private bool _isDashboardActive =>
        string.Equals(CurrentDomainName, SectionOwnerConstants.Dashboard, StringComparison.OrdinalIgnoreCase);
    private bool _isConfigActive =>
        string.Equals(CurrentDomainName, SectionOwnerConstants.Config, StringComparison.OrdinalIgnoreCase);

    private string GetConfigIconStyle() =>
        "h-10 w-10 translate-x-1 text-body transition-opacity duration-200 " +
        (_isConfigActive ? "opacity-100" : "opacity-60 group-hover:opacity-90");

    protected override async Task OnInitializedAsync()
    {
        await DomainMenuService.LoadMenusAsync();
        BuildMenuItems();
    }

    private void BuildMenuItems()
    {
        var iconMap = new Dictionary<string, Type>(StringComparer.OrdinalIgnoreCase)
        {
            ["Catalog"] = typeof(Squares2X2Icon),
            ["Integrations"] = typeof(PuzzlePieceIcon),
            ["Environments"] = typeof(BuildingOffice2Icon),
            ["Connections"] = typeof(ServerStackIcon),
            ["Clients"] = typeof(CubeIcon),
            ["Tools"] = typeof(WrenchIcon),
            ["Schedules"] = typeof(ClockIcon),
            ["Runs"] = typeof(PlayIcon),
            ["Control"] = typeof(PlayIcon),
            ["Test Suite"] = typeof(PlayIcon),
            ["Settings"] = typeof(CogIcon),
            ["Users"] = typeof(UsersIcon)
        };

        _menuItems = new List<(Type Icon, string Tooltip, string? Href, string? Domain)>();

        foreach (var domainName in DomainMenuService.GetMiddleDomains())
        {
            var domain = DomainMenuService.GetDomain(domainName);
            if (domain == null) continue;

            var icon = iconMap.TryGetValue(domainName, out var mappedIcon)
                ? mappedIcon
                : typeof(Squares2X2Icon);

            if (domain.Items?.Count > 0)
            {
                // Treat every top-level domain icon as a domain selector.
                // Submenu items (and the leaf navigation) are rendered by ControlPanel.
                _menuItems.Add((icon, domainName, null, domainName));
            }
        }
    }

    private async Task HandleLogoClick()
    {
        if (OnControlPanelOpen.HasDelegate)
            await OnControlPanelOpen.InvokeAsync(SectionOwnerConstants.Dashboard);
        NavManager.NavigateTo(ShellSectionRoutes.DashboardHome);
    }

    private static bool IsActivationKey(KeyboardEventArgs e) =>
        e.Key == "Enter" || e.Key == " ";

    private async Task HandleLogoKeyDown(KeyboardEventArgs e)
    {
        if (IsActivationKey(e))
            await HandleLogoClick();
    }

    private async Task HandleNavItemClick(DomainNavClickArgs args)
    {
        if (!string.IsNullOrEmpty(args.Href))
        {
            if (OnControlPanelClose.HasDelegate)
                await OnControlPanelClose.InvokeAsync();
            NavManager.NavigateTo(args.Href);
        }
        else if (!string.IsNullOrEmpty(args.Domain))
        {
            if (OnControlPanelOpen.HasDelegate)
                await OnControlPanelOpen.InvokeAsync(args.Domain);
            if (string.Equals(args.Domain, SectionOwnerConstants.Config, StringComparison.OrdinalIgnoreCase))
                NavManager.NavigateTo(ShellSectionRoutes.ConfigHome);
        }
    }
}
