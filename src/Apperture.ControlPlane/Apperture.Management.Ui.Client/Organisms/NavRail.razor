@using Microsoft.AspNetCore.Components.Web
@using Blazor.Heroicons.Solid
@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Shared
@using Apperture.Management.Ui.Shared.Models
@inject NavigationManager NavManager
@inject DomainMenuService DomainMenuService
@implements IDisposable

<div id="nav-rail" class="fixed z-60 flex min-h-0 flex-row h-full print:hidden start-0 top-0 @(IsControlPanelOpen ? "" : "w-18")">
    <div class="ui-nav-rail w-17 flex-none flex flex-col h-full relative border-r border-default text-body duration-300 z-40">
        <div role="button"
             class="logo-link group mt-0.5 mb-8 block p-3 text-icon transition-colors duration-200 cursor-pointer hover:text-heading @(_isDashboardActive ? "text-heading" : "")"
             aria-label="Control Center"
             @onclick="HandleLogoClick"
             @onkeydown="HandleLogoKeyDown"
             tabindex="0">
            <AppertureLogo WrapperClass="" ShapeClass="w-full" />
        </div>
        <nav class="flex flex-1 flex-col">
            <div class="flex w-full flex-col space-y-4">
                @foreach (var m in _menuItems)
                {
                    <NavRailItem @key="m.Domain"
                                 IconType="@m.Icon"
                                 Tooltip="@m.Tooltip"
                                 AriaLabel="@m.Tooltip"
                                 Domain="@m.Domain"
                                 Href="@m.Href"
                                 CurrentDomain="@ActiveDomain"
                                 CurrentPageUri="@NavManager.Uri"
                                 OnItemClick="HandleNavItemClick" />
                }
            </div>
            <div class="mt-auto flex w-full justify-center overflow-visible pb-1">
                <NavRailItem Domain="@SectionOwnerConstants.Config"
                             IconType="@typeof(CogIcon)"
                             Tooltip="Configuration"
                             AriaLabel="Configuration"
                             CurrentDomain="@ActiveDomain"
                             CurrentPageUri="@NavManager.Uri"
                             ContainerStyle="group relative flex w-full shrink-0 justify-center -translate-y-5 overflow-visible"
                             NavButtonStyle="nav-rail-btn nav-rail-btn--config-gear flex items-center justify-center transition-all duration-300"
                             IconStyle="@GetConfigIconStyle()"
                             UseGlowEffect="true"
                             OnItemClick="HandleNavItemClick" />
            </div>
        </nav>
    </div>
    @* UIX-2: do not mount ControlPanel while closed — full nav tree on first paint caused parentNode. *@
    @if (IsControlPanelOpen)
    {
        <ControlPanel IsOpen="true" DomainName="@ActiveDomain" />
    }
</div>

@code {
    [Parameter] public bool IsControlPanelOpen { get; set; }
    [Parameter] public bool IsControlPanelLocked { get; set; }
    [Parameter] public string CurrentDomainName { get; set; } = "";
    [Parameter] public EventCallback<string> OnControlPanelOpen { get; set; }
    [Parameter] public EventCallback OnControlPanelClose { get; set; }

    private List<(Type Icon, string Tooltip, string? Href, string? Domain)> _menuItems = new();
    private bool _disposed;

    /// <summary>
    /// When the panel is locked, keep the operator-selected domain; otherwise follow the route
    /// so MainLayout does not need to StateHasChanged on every navigation.
    /// </summary>
    private string ActiveDomain =>
        IsControlPanelLocked && !string.IsNullOrWhiteSpace(CurrentDomainName)
            ? CurrentDomainName
            : ResolveDomainFromUri();

    private bool _isDashboardActive =>
        string.Equals(ActiveDomain, SectionOwnerConstants.ControlCenter, StringComparison.OrdinalIgnoreCase);
    private bool _isConfigActive =>
        string.Equals(ActiveDomain, SectionOwnerConstants.Config, StringComparison.OrdinalIgnoreCase);

    private string GetConfigIconStyle() =>
        "ui-nav-rail__icon block h-full w-full min-h-0 min-w-0 transition-colors duration-200" +
        (_isConfigActive ? " ui-nav-rail__icon--active" : "");

    protected override void OnInitialized()
    {
        DomainMenuService.Changed += OnMenusChanged;
        NavManager.LocationChanged += OnLocationChanged;
        BuildMenuItems();
    }

    // UIX-2: MainLayout owns post-paint LoadMenusAsync; rail is the sole Changed subscriber
    // and also owns location SHC for active-domain highlight (layout no longer SHC every nav).

    public void Dispose()
    {
        if (_disposed)
            return;
        _disposed = true;
        DomainMenuService.Changed -= OnMenusChanged;
        NavManager.LocationChanged -= OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        _ = InvokeAsync(async () =>
        {
            // Defer past the originating click (onGlobalEvent) so we do not SHC while the
            // navigated-away page is still finishing event dispatch → orphaned components.
            await Task.Yield();
            if (_disposed)
                return;
            StateHasChanged();
        });

    private string ResolveDomainFromUri()
    {
        var path = new Uri(NavManager.Uri).AbsolutePath;
        return RouteToSectionResolver.Resolve(
            path,
            DomainMenuService.GetDomain,
            DomainMenuService.GetValidDomains());
    }

    private void OnMenusChanged() =>
        _ = InvokeAsync(() =>
        {
            if (_disposed)
                return;

            var previous = _menuItems.Select(m => m.Domain).ToArray();
            BuildMenuItems();
            var next = _menuItems.Select(m => m.Domain).ToArray();
            if (previous.SequenceEqual(next, StringComparer.OrdinalIgnoreCase))
                return;

            StateHasChanged();
        });

    private void BuildMenuItems()
    {
        var iconMap = new Dictionary<string, Type>(StringComparer.OrdinalIgnoreCase)
        {
            [SectionOwnerConstants.Integrations] = typeof(PuzzlePieceIcon),
            [SectionOwnerConstants.BusinessData] = typeof(CircleStackIcon),
            ["Settings"] = typeof(WrenchScrewdriverIcon),
            ["Users"] = typeof(UsersIcon)
        };

        _menuItems = new List<(Type Icon, string Tooltip, string? Href, string? Domain)>();

        foreach (var domainName in DomainMenuService.GetMiddleDomains())
        {
            var domain = DomainMenuService.GetDomain(domainName);
            if (domain == null) continue;

            var icon = iconMap.TryGetValue(domainName, out var mappedIcon)
                ? mappedIcon
                : typeof(Squares2x2Icon);

            if (domain.Items?.Count > 0)
            {
                // Treat every top-level domain icon as a domain selector.
                // Submenu items (and the leaf navigation) are rendered by ControlPanel.
                _menuItems.Add((icon, domainName, null, domainName));
            }
        }
    }

    private void HandleLogoClick()
    {
        _ = HandleLogoClickCoreAsync();
    }

    private async Task HandleLogoClickCoreAsync()
    {
        await Task.Delay(1);
        if (_disposed)
            return;

        if (OnControlPanelOpen.HasDelegate)
            await OnControlPanelOpen.InvokeAsync(SectionOwnerConstants.ControlCenter);
        NavManager.NavigateTo(ShellSectionRoutes.ControlCenterHome);
    }

    private static bool IsActivationKey(KeyboardEventArgs e) =>
        e.Key == "Enter" || e.Key == " ";

    private void HandleLogoKeyDown(KeyboardEventArgs e)
    {
        if (IsActivationKey(e))
            HandleLogoClick();
    }

    private void HandleNavItemClick(DomainNavClickArgs args)
    {
        _ = HandleNavItemClickCoreAsync(args);
    }

    private async Task HandleNavItemClickCoreAsync(DomainNavClickArgs args)
    {
        // Leave onGlobalEvent before layout EventCallback SHC + NavigateTo dispose Body.
        await Task.Delay(1);
        if (_disposed)
            return;

        if (!string.IsNullOrEmpty(args.Href))
        {
            if (OnControlPanelClose.HasDelegate)
                await OnControlPanelClose.InvokeAsync();
            NavManager.NavigateTo(args.Href);
        }
        else if (!string.IsNullOrEmpty(args.Domain))
        {
            if (OnControlPanelOpen.HasDelegate)
                await OnControlPanelOpen.InvokeAsync(args.Domain);
            if (string.Equals(args.Domain, SectionOwnerConstants.Config, StringComparison.OrdinalIgnoreCase))
                NavManager.NavigateTo(ShellSectionRoutes.ConfigHome);
        }
    }
}
