<div class="@RootClass" role="@Role">
    @if (!string.IsNullOrWhiteSpace(Title))
    {
        <div class="@TitleClass">@Title</div>
    }
    <div class="@MessageClass">@Message</div>
    @ChildContent
</div>

@code {
    [Parameter] public PageMessageKind Kind { get; set; } = PageMessageKind.Info;
    [Parameter] public string? Title { get; set; }
    [Parameter] public string Message { get; set; } = "";
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string Role => Kind == PageMessageKind.Error ? "alert" : "status";

    private string RootClass
    {
        get
        {
            var baseClass = Kind switch
            {
                PageMessageKind.Error =>
                    "rounded border px-3 py-2 text-sm border-message-error bg-message-error text-message-error-text",
                PageMessageKind.Warning =>
                    "rounded border px-3 py-2 text-sm border-message-warning bg-message-warning text-message-warning-text",
                _ => $"{BoxClass} rounded border px-3 py-2 text-sm text-body"
            };
            return string.IsNullOrWhiteSpace(Class) ? baseClass : $"{baseClass} {Class}";
        }
    }

    private string TitleClass => Kind switch
    {
        PageMessageKind.Error => "font-semibold text-message-error-title",
        PageMessageKind.Warning => "font-semibold text-message-warning-title",
        _ => "font-semibold text-heading"
    };

    private string MessageClass
    {
        get
        {
            if (Kind == PageMessageKind.Error)
                return string.IsNullOrWhiteSpace(Title) ? "" : "mt-1 text-message-error-text";
            if (Kind == PageMessageKind.Warning)
                return string.IsNullOrWhiteSpace(Title) ? "" : "mt-1 text-message-warning-text";
            return string.IsNullOrWhiteSpace(Title) ? "" : "mt-1 text-muted";
        }
    }

    private string BoxClass => Kind switch
    {
        PageMessageKind.Loading => "border-default bg-surface-muted",
        PageMessageKind.Empty => "border-default bg-surface",
        PageMessageKind.Info => "border-default bg-surface",
        PageMessageKind.Forbidden => "border-default bg-surface",
        _ => "border-default bg-surface"
    };
}
