@using Apperture.Management.Ui.Shared

@if (_snapshot is null)
{
    <p class="text-xs text-muted">Recipient snapshot unavailable or invalid.</p>
}
else
{
  var considered = _snapshot.Deliverable.Count + _snapshot.Skipped.Count;
  var sentCount = DeliveredEmailCount ?? 0;
    <p class="text-xs text-muted mb-2">
        @considered recipient(s) considered · @_snapshot.Deliverable.Count deliverable · @_snapshot.Skipped.Count skipped
        @if (DeliveredEmailCount is not null)
        {
            <span> · @sentCount email delivery row(s)</span>
        }
    </p>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-3 text-xs">
        <div>
            <div class="font-semibold text-heading">Deliverable (@_snapshot.Deliverable.Count)</div>
            @if (ImplicitDeliverable.Count > 0)
            {
                <p class="mt-1 text-muted">Implicit (attention routing compatibility)</p>
                <ul class="mt-1 space-y-1 max-h-40 overflow-y-auto">
                    @foreach (var r in ImplicitDeliverable)
                    {
                        <li>@FormatEntry(r) <span class="text-muted">(@NotificationRecipientSourceLabels.Label(r.Source))</span></li>
                    }
                </ul>
            }
            @if (ExplicitDeliverable.Count > 0)
            {
                <p class="mt-2 text-muted">Explicit subscriptions and team membership</p>
                <ul class="mt-1 space-y-1 max-h-40 overflow-y-auto">
                    @foreach (var r in ExplicitDeliverable)
                    {
                        <li>@FormatEntry(r) <span class="text-muted">(@NotificationRecipientSourceLabels.Label(r.Source))</span></li>
                    }
                </ul>
            }
            @if (_snapshot.Deliverable.Count == 0)
            {
                <p class="mt-1 text-muted">No deliverable recipients in snapshot.</p>
            }
        </div>
        <div>
            <div class="font-semibold text-heading">Skipped / suppressed (@_snapshot.Skipped.Count)</div>
            @if (_snapshot.Skipped.Count == 0)
            {
                <p class="mt-1 text-muted">None.</p>
            }
            else
            {
                <ul class="mt-1 space-y-2 max-h-48 overflow-y-auto">
                    @foreach (var r in _snapshot.Skipped)
                    {
                        <li>
                            <div>@FormatEntry(r)</div>
                            <div class="text-muted">@NotificationRecipientSkipReasonLabels.Label(r.Reason)</div>
                            @if (NotificationRecipientSkipReasonLabels.HelpText(r.Reason) is { } help)
                            {
                                <div class="text-muted">@help</div>
                            }
                            @if (NotificationRecipientSkipReasonLabels.ActionGuidance(r.Reason) is { } action)
                            {
                                <div class="text-muted italic">@action</div>
                            }
                        </li>
                    }
                </ul>
            }
        </div>
    </div>
}

@code {
    [Parameter] public string? RecipientSnapshotJson { get; set; }
    [Parameter] public int? DeliveredEmailCount { get; set; }

    private NotificationRecipientSnapshotModel? _snapshot;

    protected override void OnParametersSet() =>
        _snapshot = NotificationRecipientSnapshotParser.TryParse(RecipientSnapshotJson);

    private IReadOnlyList<NotificationRecipientSnapshotEntry> ImplicitDeliverable =>
        _snapshot?.Deliverable.Where(r => NotificationRecipientSourceLabels.IsImplicitAttentionRouting(r.Source)).ToList()
        ?? [];

    private IReadOnlyList<NotificationRecipientSnapshotEntry> ExplicitDeliverable =>
        _snapshot?.Deliverable.Where(r => !NotificationRecipientSourceLabels.IsImplicitAttentionRouting(r.Source)).ToList()
        ?? [];

    private static string FormatEntry(NotificationRecipientSnapshotEntry r) =>
        r.Email
        ?? r.DisplayName
        ?? r.UserId
        ?? r.ManagedContactId
        ?? "—";
}
