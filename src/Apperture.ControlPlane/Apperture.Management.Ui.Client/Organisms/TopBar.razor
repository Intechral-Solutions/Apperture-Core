<header id="topbar" class="sticky top-0 flex h-16 w-full items-center justify-between border-b bg-surface px-4 shadow border-default">
    <HamburgerToggle IsOpen="@IsControlPanelOpen"
                     IsLocked="@IsControlPanelLocked"
                     OnToggle="OnHamburgerClick" />

    <div class="flex-1"></div>

    <div class="flex space-x-4">
        <span class="text-sm text-muted">Theme</span>
        <span class="text-sm text-muted">Alerts</span>
        <span class="text-sm text-muted">Profile</span>
    </div>
</header>

@code {
    [Parameter] public bool IsControlPanelLocked { get; set; }
    [Parameter] public bool IsControlPanelOpen { get; set; }
    [Parameter] public EventCallback<bool> OnHamburgerClick { get; set; }
}
