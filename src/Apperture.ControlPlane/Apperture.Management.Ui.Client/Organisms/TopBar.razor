@using Apperture.Management.Ui.Client.Molecules
@using Apperture.Management.Ui.Client.Services
@implements IDisposable

@inject NavigationManager Nav
@inject ShellOrientationService ShellOrientation
@inject TopBarMenuCoordinator Menus

<header id="topbar" class="ui-topbar w-full border-b bg-surface shadow-shell border-default">
    <div class="ui-topbar__inner flex min-h-16 w-full items-stretch gap-2 px-4 py-2 sm:gap-3">
        <div class="ui-topbar__menu flex shrink-0 items-center">
            <HamburgerToggle IsOpen="@IsControlPanelOpen"
                             IsLocked="@IsControlPanelLocked"
                             OnToggle="OnHamburgerClick" />
        </div>

        <div class="ui-topbar__orientation flex min-w-0 flex-1 flex-col justify-center">
            @* UIX-2: orientation owns location-aware refresh; do not @key-remount this subtree. *@
            <TopBarOrientation />
        </div>

        <div class="ui-topbar__utilities flex shrink-0 items-center gap-6">
            <ThemeMenu />
            <PersonalNotificationMenu />
            <UserAccountMenu />
        </div>
    </div>
</header>

@code {
    [Parameter] public bool IsControlPanelLocked { get; set; }
    [Parameter] public bool IsControlPanelOpen { get; set; }
    [Parameter] public EventCallback<bool> OnHamburgerClick { get; set; }

    private bool _disposed;

    protected override void OnInitialized()
    {
        // Clear page title overrides on navigation; orientation components re-resolve from the URI.
        Nav.LocationChanged += OnLocationChanged;
    }

    public void Dispose()
    {
        if (_disposed)
            return;
        _disposed = true;
        Nav.LocationChanged -= OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_disposed)
            return;

        Menus.CloseAll();
        ShellOrientation.ResetPageContext();
    }
}
