@using Apperture.Management.Ui.Client.Molecules
@using Apperture.Management.Ui.Shared
@using Apperture.Management.Ui.Shared.Models
@implements IDisposable

@inject NavigationManager Nav

<header id="topbar" class="sticky top-0 z-30 flex h-16 w-full items-center justify-between border-b bg-surface px-4 shadow-shell border-default">
    <HamburgerToggle IsOpen="@IsControlPanelOpen"
                     IsLocked="@IsControlPanelLocked"
                     OnToggle="OnHamburgerClick" />

    <div class="hidden min-w-0 flex-1 px-4 md:block">
        <ManagementBreadcrumbs Items="@_breadcrumbs" />
    </div>

    <div class="flex shrink-0 items-center gap-2 md:gap-4">
        <ThemeMenu />
        <UserAccountMenu />
    </div>
</header>

@code {
    [Parameter] public bool IsControlPanelLocked { get; set; }
    [Parameter] public bool IsControlPanelOpen { get; set; }
    [Parameter] public EventCallback<bool> OnHamburgerClick { get; set; }

    private IReadOnlyList<BreadcrumbItem> _breadcrumbs = [];

    protected override void OnInitialized()
    {
        Nav.LocationChanged += OnLocationChanged;
        RefreshBreadcrumbs();
    }

    public void Dispose()
    {
        Nav.LocationChanged -= OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e) =>
        _ = InvokeAsync(() =>
        {
            RefreshBreadcrumbs();
            StateHasChanged();
        });

    private void RefreshBreadcrumbs()
    {
        var path = new Uri(Nav.Uri).AbsolutePath;
        _breadcrumbs = ManagementBreadcrumbResolver.Resolve(path);
    }
}
