@using Apperture.Management.Client
@using Apperture.Management.Ui.Shared
@using Apperture.Management.Ui.Client.Organisms
@using Apperture.Management.Ui.Client.Molecules

<ManagementSection Title="Configuration &amp; readiness"
                   Layer="ManagementSection.UiLayer.Summary"
                   Help="Declaration-driven overview: settings, connections, verification, and launch impact. Fix blockers here before schedules or procedures run.">
    <div id="configuration-overview">
        @{
            var overallPill = IntegrationConfigurationOperatorUiHelpers.BuildOverallReadinessPill(Readiness);
        }
        <div class="flex flex-wrap items-center gap-2 mb-4">
            <StatusPill Label="@overallPill.Label" Semantic="@overallPill.Semantic" />
            @if (Readiness is not null)
            {
                @if (Readiness.BlockingIssueCount > 0)
                {
                    <AttentionPill Label="@($"{Readiness.BlockingIssueCount} blocking")"
                                   Semantic="@ManagementAttentionSemantic.Critical" />
                }
                @if (Readiness.AdvisoryIssueCount > 0)
                {
                    <AttentionPill Label="@($"{Readiness.AdvisoryIssueCount} advisory")"
                                   Semantic="@ManagementAttentionSemantic.Warning" />
                }
            }
            <DrillInLink Href="@IntegrationUiRoutes.Settings(IntegrationId)">Integration settings</DrillInLink>
        </div>

        @if (Declarations is not null && IntegrationConfigurationOperatorUiHelpers.HasNoConfigurationRequired(Declarations))
        {
            <EmptyState Title="No configuration required"
                        Message="This module declares no required settings or connections. Schedules and procedures can run once the integration is active and readiness passes." />
        }
        else
        {
            <div class="grid grid-cols-1 gap-3 md:grid-cols-2 lg:grid-cols-3 mb-4">
                <div class="rounded border border-default bg-surface-muted/30 p-3 text-sm">
                    <div class="text-xs font-semibold text-heading">Settings</div>
                    <div class="mt-1 text-body">@IntegrationConfigurationOperatorUiHelpers.BuildSettingsCompletionSummary(Declarations?.Settings, SettingRows)</div>
                </div>
                <div class="rounded border border-default bg-surface-muted/30 p-3 text-sm">
                    <div class="text-xs font-semibold text-heading">Connections</div>
                    <div class="mt-1 text-body">@IntegrationConfigurationOperatorUiHelpers.BuildBindingsCompletionSummary(Declarations?.Connections, Bindings)</div>
                </div>
                <div class="rounded border border-default bg-surface-muted/30 p-3 text-sm">
                    <div class="text-xs font-semibold text-heading">Verification</div>
                    <div class="mt-1 text-body">@IntegrationConfigurationOperatorUiHelpers.BuildVerificationSummary(Bindings)</div>
                </div>
                <div class="rounded border border-default bg-surface-muted/30 p-3 text-sm">
                    <div class="text-xs font-semibold text-heading">Procedures</div>
                    <div class="mt-1 text-body">@IntegrationConfigurationOperatorUiHelpers.BuildProcedureReadinessSummary(ProcedureList)</div>
                </div>
                @if (ScheduleCount > 0)
                {
                    <div class="rounded border border-default bg-surface-muted/30 p-3 text-sm">
                        <div class="text-xs font-semibold text-heading">Schedules</div>
                        <div class="mt-1 text-body">@IntegrationConfigurationOperatorUiHelpers.BuildScheduleImpactSummary(Schedules, Readiness)</div>
                    </div>
                }
            </div>

            @if (Declarations?.Connections is { Count: > 0 })
            {
                <h3 class="text-xs font-semibold text-heading mb-2">Connection requirements</h3>
                <div class="space-y-3 mb-4">
                    @foreach (var req in Declarations.Connections.OrderBy(c => c.IsRequired ? 0 : 1).ThenBy(c => c.DisplayName, StringComparer.Ordinal))
                    {
                        var binding = Bindings?.FirstOrDefault(b =>
                            string.Equals(b.SlotName, req.Key, StringComparison.Ordinal)
                            && string.Equals(b.State, "Active", StringComparison.OrdinalIgnoreCase));
                        var connectionName = binding?.ConnectionId is not null && ConnectionNames.TryGetValue(binding.ConnectionId, out var name)
                            ? name
                            : null;
                        var affectedProcedures = IntegrationConfigurationOperatorUiHelpers.GetProceduresAffectedByConnection(req.Key, Declarations.Procedures);
                        var capabilityLabel = !string.IsNullOrWhiteSpace(req.CapabilityLabel)
                            ? req.CapabilityLabel
                            : IntegrationConfigurationOperatorUiHelpers.FormatCapabilityLabel(req.CapabilityKind, req.TechnicalContractType);
                        <div id="requirement-@req.Key" class="rounded border border-default bg-surface-muted/20 p-3">
                            <div class="flex flex-wrap items-start justify-between gap-2">
                                <div class="min-w-0">
                                    <div class="text-sm font-semibold text-heading">@req.DisplayName</div>
                                    @if (!string.IsNullOrWhiteSpace(req.Description))
                                    {
                                        <div class="text-xs text-muted mt-1">@req.Description</div>
                                    }
                                    <div class="mt-2 flex flex-wrap items-center gap-2 text-xs">
                                        <StatusPill Label="@(req.IsRequired ? "Required" : "Optional")"
                                                    Semantic="@(req.IsRequired ? ManagementStatusSemantic.Warning : ManagementStatusSemantic.Neutral)" />
                                        <StatusPill Label="@capabilityLabel" Semantic="@ManagementStatusSemantic.Neutral" />
                                        @if (binding is null)
                                        {
                                            <StatusPill Label="Unbound" Semantic="@ManagementStatusSemantic.Warning" />
                                        }
                                        else
                                        {
                                            <StatusPill Label="@(connectionName ?? "Bound")" Semantic="@ManagementStatusSemantic.Success" />
                                            @if (!string.IsNullOrWhiteSpace(binding.ConnectionVerificationStatus))
                                            {
                                                <StatusPill Label="@IntegrationConfigurationOperatorUiHelpers.FormatVerificationStatusLabel(binding.ConnectionVerificationStatus)"
                                                            Semantic="@IntegrationConfigurationOperatorUiHelpers.MapVerificationStatusSemantic(binding.ConnectionVerificationStatus)" />
                                            }
                                        }
                                    </div>
                                    @if (binding?.ConnectionVerifiedAtUtc is not null)
                                    {
                                        <div class="mt-1 text-xs text-muted">
                                            Last verified: <TimestampDisplay Value="@binding.ConnectionVerifiedAtUtc" />
                                        </div>
                                    }
                                    @if (affectedProcedures.Count > 0)
                                    {
                                        <div class="mt-1 text-xs text-muted">
                                            Affects procedures: @string.Join(", ", affectedProcedures)
                                        </div>
                                    }
                                </div>
                                @if (CanManageIntegrations)
                                {
                                    <div class="flex flex-wrap gap-2 shrink-0">
                                        @if (binding is null)
                                        {
                                            <button type="button"
                                                    class="rounded bg-body px-2 py-1 text-xs text-surface hover:bg-body/90"
                                                    aria-label="@($"Bind connection for {req.DisplayName}")"
                                                    @onclick="() => OnBindRequirement.InvokeAsync(req.Key)">
                                                Bind
                                            </button>
                                        }
                                        else
                                        {
                                            <button type="button"
                                                    class="rounded bg-surface-muted px-2 py-1 text-xs text-body hover:bg-surface"
                                                    aria-label="@($"Change binding for {req.DisplayName}")"
                                                    @onclick="() => OnBindRequirement.InvokeAsync(req.Key)">
                                                Change
                                            </button>
                                            @if (!req.IsRequired)
                                            {
                                                <button type="button"
                                                        class="rounded bg-surface-muted px-2 py-1 text-xs text-body hover:bg-surface"
                                                        aria-label="@($"Unbind {req.DisplayName}")"
                                                        @onclick="() => OnUnbindBinding.InvokeAsync(binding)">
                                                    Unbind
                                                </button>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(binding.ConnectionId))
                                            {
                                                <a class="rounded bg-surface-muted px-2 py-1 text-xs text-body hover:bg-surface"
                                                   href="@($"/connections/{Uri.EscapeDataString(binding.ConnectionId)}")"
                                                   aria-label="@($"Verify connection for {req.DisplayName}")">
                                                    Verify
                                                </a>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                            <details class="mt-2 text-xs text-muted">
                                <summary class="cursor-pointer">Technical details</summary>
                                <div class="mt-1 space-y-1 font-mono break-all">
                                    <div>Requirement key: @req.Key</div>
                                    <div>Contract type: @req.TechnicalContractType</div>
                                    <div>Verification: @IntegrationConfigurationOperatorUiHelpers.FormatVerificationExpectationLabel(req.VerificationExpectation)</div>
                                    @if (binding?.ConnectionId is not null)
                                    {
                                        <div>Connection id: @binding.ConnectionId</div>
                                    }
                                </div>
                            </details>
                        </div>
                    }
                </div>
            }

            @if (Readiness is { Issues.Length: > 0 })
            {
                <h3 class="text-xs font-semibold text-heading mb-2">Readiness reasons</h3>
                @foreach (var group in IntegrationConfigurationOperatorUiHelpers.GroupIssuesByCategory(Readiness.Issues, IntegrationId))
                {
                    <div class="mb-3">
                        <div class="text-xs font-medium text-muted mb-1">@HumanizeCategory(group.Key)</div>
                        <ul class="space-y-2">
                            @foreach (var issue in group.Value)
                            {
                                <li class="rounded border border-default bg-surface-muted/30 p-2 text-sm">
                                    <div class="flex flex-wrap items-center gap-2">
                                        <AttentionPill Label="@issue.SeverityLabel"
                                                       Semantic="@MapSeveritySemantic(issue.SeverityLabel)" />
                                        <span class="font-medium">@issue.Title</span>
                                    </div>
                                    <div class="mt-1 text-xs text-body">@issue.Explanation</div>
                                    @if (!string.IsNullOrWhiteSpace(issue.AffectedKey))
                                    {
                                        <div class="mt-1 text-xs text-muted">Affected: @issue.AffectedKey</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(issue.RemediationHint))
                                    {
                                        <div class="mt-1 text-xs text-muted">@issue.RemediationHint</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(issue.RemediationHref))
                                    {
                                        <div class="mt-2">
                                            <DrillInLink Href="@issue.RemediationHref">Fix this</DrillInLink>
                                        </div>
                                    }
                                    <details class="mt-1 text-xs text-muted">
                                        <summary class="cursor-pointer">Reason code</summary>
                                        <span class="font-mono">@issue.Code</span>
                                    </details>
                                </li>
                            }
                        </ul>
                    </div>
                }
            }
        }
    </div>
</ManagementSection>

@code {
    [Parameter, EditorRequired] public string IntegrationId { get; set; } = "";
    [Parameter] public IntegrationReadinessDto? Readiness { get; set; }
    [Parameter] public IntegrationConfigurationDeclarationsDto? Declarations { get; set; }
    [Parameter] public IReadOnlyList<IntegrationBindingSummaryDto>? Bindings { get; set; }
    [Parameter] public IReadOnlyList<PlatformSettingResolvedDto>? SettingRows { get; set; }
    [Parameter] public IntegrationProcedureListDto? ProcedureList { get; set; }
    [Parameter] public IReadOnlyList<ScheduleDto>? Schedules { get; set; }
    [Parameter] public int ScheduleCount { get; set; }
    [Parameter] public IReadOnlyDictionary<string, string> ConnectionNames { get; set; } =
        new Dictionary<string, string>(StringComparer.Ordinal);
    [Parameter] public bool CanManageIntegrations { get; set; }
    [Parameter] public EventCallback<string> OnBindRequirement { get; set; }
    [Parameter] public EventCallback<IntegrationBindingSummaryDto> OnUnbindBinding { get; set; }

    private static string HumanizeCategory(string category) => category switch
    {
        IntegrationConfigurationOperatorUiHelpers.CategorySettings => "Settings",
        IntegrationConfigurationOperatorUiHelpers.CategorySecrets => "Secrets",
        IntegrationConfigurationOperatorUiHelpers.CategoryBindings => "Bindings",
        IntegrationConfigurationOperatorUiHelpers.CategoryVerification => "Verification",
        IntegrationConfigurationOperatorUiHelpers.CategoryModule => "Module",
        IntegrationConfigurationOperatorUiHelpers.CategoryProcedure => "Procedures",
        IntegrationConfigurationOperatorUiHelpers.CategorySchedule => "Schedules",
        _ => category
    };

    private static ManagementAttentionSemantic MapSeveritySemantic(string severityLabel) =>
        severityLabel switch
        {
            "Blocking" => ManagementAttentionSemantic.Critical,
            "Advisory" => ManagementAttentionSemantic.Warning,
            _ => ManagementAttentionSemantic.Info
        };
}
