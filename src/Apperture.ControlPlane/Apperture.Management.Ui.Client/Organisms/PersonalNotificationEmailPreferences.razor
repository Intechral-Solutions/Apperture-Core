@using Apperture.Management.Client
@inject IManagementClient Client

<section class="mt-6 rounded border border-default bg-surface p-4" aria-labelledby="email-prefs-heading">
    <h2 id="email-prefs-heading" class="text-base font-semibold text-heading">Email preferences</h2>
    <p class="mt-1 text-sm text-muted">
        Enabling email allows matching notifications to create email deliveries for your account.
        Disabling email suppresses email only — you may still see notifications in this inbox when routing applies.
        Daily digest and journal delivery are not available yet.
        Administrators may still assign team subscriptions or other routing for your organization.
    </p>

    @if (!string.IsNullOrEmpty(_error))
    {
        <p class="mt-3 text-sm text-danger">@_error</p>
    }

    @if (_loading)
    {
        <p class="mt-3 text-sm text-muted">Loading preferences…</p>
    }
    else if (_preferences.Count == 0)
    {
        <p class="mt-3 text-sm text-muted">No email notification preferences are available for your account.</p>
    }
    else
    {
        <ul class="mt-4 divide-y divide-default">
            @foreach (var pref in _preferences)
            {
                <li class="flex flex-wrap items-start justify-between gap-3 py-3">
                    <div class="min-w-0 flex-1">
                        <div class="text-sm font-medium text-heading">@pref.DisplayName</div>
                        @if (!string.IsNullOrWhiteSpace(pref.Description))
                        {
                            <p class="mt-1 text-sm text-muted">@pref.Description</p>
                        }
                        @if (pref.HasGlobalEmailOptOut && !pref.EmailEnabled)
                        {
                            <p class="mt-1 text-xs text-muted">Email delivery is off for this notification.</p>
                        }
                    </div>
                    <label class="inline-flex items-center gap-2 text-sm">
                        <input type="checkbox"
                               class="h-4 w-4"
                               checked="@pref.EmailEnabled"
                               disabled="@IsBusy(pref.DefinitionId)"
                               @onchange="e => ToggleAsync(pref, e)" />
                        Email
                    </label>
                </li>
            }
        </ul>
    }
</section>

@code {
    private List<PersonalNotificationEmailPreferenceDto> _preferences = [];
    private bool _loading = true;
    private string? _error;
    private readonly HashSet<string> _busy = new(StringComparer.Ordinal);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _preferences = (await Client.GetMyNotificationEmailPreferencesAsync()).ToList();
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
            _preferences = [];
        }
        finally
        {
            _loading = false;
        }
    }

    private bool IsBusy(string definitionId) => _busy.Contains(definitionId);

    private async Task ToggleAsync(PersonalNotificationEmailPreferenceDto pref, ChangeEventArgs e)
    {
        var enabled = e.Value is bool b && b;
        _busy.Add(pref.DefinitionId);
        _error = null;
        try
        {
            var updated = await Client.SetMyNotificationEmailPreferenceAsync(pref.DefinitionId, enabled);
            var idx = _preferences.FindIndex(x => x.DefinitionId == pref.DefinitionId);
            if (idx >= 0)
                _preferences[idx] = updated;
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy.Remove(pref.DefinitionId);
        }
    }
}
