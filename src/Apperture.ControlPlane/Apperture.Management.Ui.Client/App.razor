@using Apperture.Management.Ui.Client.Services
@using Microsoft.JSInterop
@inject ThemeService ThemeService
@inject SessionStateService SessionStateService
@inject AuthSignInOptionsService AuthSignInOptionsService
@inject AppearancePreferenceCoordinator AppearancePreferences
@inject IOperatorDisplayTimeZone OperatorDisplayTimeZone
@inject ShellBootstrapState ShellBootstrap
@inject ResourceContextViewState ViewState
@inject IJSRuntime Js

<AuthRouteGate>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <RouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(MainLayout)">
                <p>Coming soon.</p>
            </LayoutView>
        </NotFound>
    </Router>
</AuthRouteGate>

@code {
    private bool _bootstrapStarted;

    protected override void OnAfterRender(bool firstRender)
    {
        if (!firstRender || _bootstrapStarted)
            return;

        // UIX-2: do not await RefreshAsync inside OnAfterRenderAsync. Session notify mounts
        // AuthRouteGate → MainLayout while App would still be mid-callback → parentNode.
        _bootstrapStarted = true;
        _ = BootstrapAsync();
    }

    private async Task BootstrapAsync()
    {
        // #region agent log
        try { await Js.InvokeVoidAsync("appertureShell.debugLog", "App.razor:BootstrapAsync", "bootstrap-start", "H3", new { runId = "post-fix", instanceId = GetHashCode() }); } catch { /* ignore */ }
        // #endregion

        try
        {
            await ThemeService.InitializeAsync();
        }
        catch (JSException)
        {
            /* Prerender or JS not available */
        }
        catch (InvalidOperationException)
        {
            /* JS interop not ready */
        }

        // SWM-5: Me (preference) before display-TZ resolve so stored DisplayTimeZoneId can win.
        await SessionStateService.RefreshAsync();
        // AUP-1: the account appearance preference outranks the browser value the theme service
        // booted with, so reconcile once the session is known.
        await AppearancePreferences.ReconcileAsync();
        // SWM-4/5: non-blocking; pages may briefly show UTC then upgrade to pref/browser IANA.
        await OperatorDisplayTimeZone.EnsureResolvedAsync();
        await AuthSignInOptionsService.RefreshAsync();

        // CTX-3A Plan 3 Finding 1: the View selector's shell-wide state must be initialized on every
        // boot, not only after an operator happens to mutate an Application from its detail page.
        // Requires SessionStateService.User (read via SessionStateService.RefreshAsync() above) to
        // already be populated so a signed-in operator's remembered view preference can be read from
        // localStorage; must run before MarkReady() so the selector/resolved scope are correct the
        // moment MainLayout mounts. Same JS-interop-unavailable exception pattern as ThemeService
        // above. Unlike ThemeService, this call also reaches the management API
        // (IManagementClient.GetResourceContextsAsync, via ManagementClient.GetFromJsonAsync) which
        // throws HttpRequestException on any non-success response and -- unlike SessionStateService/
        // AuthSignInOptionsService's own RefreshAsync -- ResourceContextViewState does not catch that
        // internally; also caught here so a transient API failure degrades to "selector stays hidden"
        // rather than hanging ShellBootstrap.MarkReady() (and the whole app) forever.
        try
        {
            await ViewState.InitializeAsync();
        }
        catch (JSException)
        {
            /* Prerender or JS not available */
        }
        catch (InvalidOperationException)
        {
            /* JS interop not ready */
        }
        catch (HttpRequestException)
        {
            /* Management API unreachable; selector stays hidden until a later refresh succeeds */
        }

        // UIX-2: only then allow AuthRouteGate to mount MainLayout (with capabilities).
        ShellBootstrap.MarkReady();

        // #region agent log
        try { await Js.InvokeVoidAsync("appertureShell.debugLog", "App.razor:BootstrapAsync", "bootstrap-markReady", "H3", new { runId = "post-fix", instanceId = GetHashCode(), shellBootstrapReady = true }); } catch { /* ignore */ }
        // #endregion
    }
}
