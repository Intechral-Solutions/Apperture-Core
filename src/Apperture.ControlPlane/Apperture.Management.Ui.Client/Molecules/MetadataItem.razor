<div class="ui-metadata-item">
    <div class="ui-metadata-item__label">@Label</div>
    @if (ChildContent is not null)
    {
        <div class="@ValueClass">@ChildContent</div>
    }
    else
    {
        <div class="@ValueClass">@Value</div>
    }
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string? Value { get; set; }
    [Parameter] public bool Monospace { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string ValueClass =>
        Monospace ? "ui-metadata-item__value ui-metadata-item__value--mono" : "ui-metadata-item__value";
}
