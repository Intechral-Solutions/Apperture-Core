@using Apperture.Management.Client

@if (Status is not null)
{
    <section class="rounded border border-default bg-surface p-3 text-xs" aria-labelledby="cutover-status-heading">
        <h2 id="cutover-status-heading" class="text-sm font-semibold text-heading">Notification pipeline cutover status</h2>
        <p class="mt-1 text-muted">Read-only preflight for expected-run-missing cutover. Does not change flags or send mail.</p>

        <dl class="mt-3 grid grid-cols-1 gap-2 md:grid-cols-2">
            <div>
                <dt class="text-muted">Active delivery path</dt>
                <dd class="font-medium">@Status.ActiveDeliveryPathLabel</dd>
            </div>
            <div>
                <dt class="text-muted">Platform pipeline</dt>
                <dd>@(Status.UsePlatformPipelineEnabled ? "Enabled" : "Disabled")</dd>
            </div>
            <div>
                <dt class="text-muted">Legacy Epic 69 path</dt>
                <dd>@(Status.LegacyEpic69PathActive ? "Active" : "Bypassed")</dd>
            </div>
            <div>
                <dt class="text-muted">Critical preflight</dt>
                <dd class="@(Status.CriticalPreflightPassed ? "text-success" : "text-warning")">
                    @(Status.CriticalPreflightPassed ? "Passed" : "Review items below")
                </dd>
            </div>
        </dl>

        @if (Status.OperatingModeLabels.Count > 0)
        {
            <p class="mt-2 text-muted">
                Operating mode: @string.Join(" · ", Status.OperatingModeLabels)
            </p>
        }

        @if (Status.ConfigurationWarnings.Count > 0)
        {
            <ul class="mt-2 list-disc list-inside text-warning">
                @foreach (var w in Status.ConfigurationWarnings)
                {
                    <li>@w.Message</li>
                }
            </ul>
        }

        <div class="mt-3">
            <div class="font-semibold text-heading mb-1">Preflight checks</div>
            <ul class="space-y-2">
                @foreach (var check in Status.PreflightChecks)
                {
                    <li class="rounded border border-default p-2 @PreflightRowClass(check)">
                        <div class="font-medium">@check.Label — @(check.Passed ? "OK" : "Needs attention")</div>
                        @if (!string.IsNullOrWhiteSpace(check.Guidance))
                        {
                            <p class="mt-1 text-muted">@check.Guidance</p>
                        }
                    </li>
                }
            </ul>
        </div>

        <p class="mt-3 text-muted">
            After cutover, operators use platform instances, outbox, personal inbox (S9 email preferences), and delivery diagnostics (S10).
            Roll back by setting <code class="font-mono">Notifications:UsePlatformPipeline:Enabled=false</code>.
        </p>
    </section>
}

@code {
    [Parameter] public NotificationPipelineCutoverStatusDto? Status { get; set; }

    private static string PreflightRowClass(NotificationPipelineCutoverPreflightCheckDto check) =>
        check.Passed ? "bg-success-light" : "bg-warning-light";
}
