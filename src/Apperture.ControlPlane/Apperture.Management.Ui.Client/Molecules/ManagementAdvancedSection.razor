<details class="ui-advanced-section @Class" open="@InitiallyOpen">
    <summary>@Title</summary>
    <div class="ui-advanced-section__body">
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <p class="mb-2 text-xs text-muted">@Subtitle</p>
        }
        @ChildContent
    </div>
</details>

@code {
    [Parameter] public string Title { get; set; } = "Advanced";
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public bool InitiallyOpen { get; set; }
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
