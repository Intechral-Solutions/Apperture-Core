@using Apperture.Management.Ui.Shared

@if (Preference == ThemePreference.Light)
{
    <svg class="@EffectiveClass"
         viewBox="0 0 24 24"
         fill="none"
         stroke="currentColor"
         stroke-width="2"
         stroke-linecap="round"
         stroke-linejoin="round"
         aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M17.66 6.34l1.41-1.41" />
    </svg>
}
else if (Preference == ThemePreference.Dark)
{
    <svg class="@EffectiveClass"
         viewBox="0 0 24 24"
         fill="none"
         stroke="currentColor"
         stroke-width="2"
         stroke-linecap="round"
         stroke-linejoin="round"
         aria-hidden="true">
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z" />
    </svg>
}
else
{
    @* System: monitor — follows OS / environment *@
    <svg class="@EffectiveClass"
         viewBox="0 0 24 24"
         fill="none"
         stroke="currentColor"
         stroke-width="2"
         stroke-linecap="round"
         stroke-linejoin="round"
         aria-hidden="true">
        <rect x="2" y="3" width="20" height="14" rx="2" ry="2" />
        <line x1="8" y1="21" x2="16" y2="21" />
        <line x1="12" y1="17" x2="12" y2="21" />
    </svg>
}

@code {
    [Parameter] public ThemePreference Preference { get; set; }

    [Parameter] public string? Class { get; set; }

    private string EffectiveClass => string.IsNullOrWhiteSpace(Class) ? "h-5 w-5 shrink-0" : Class!;
}
