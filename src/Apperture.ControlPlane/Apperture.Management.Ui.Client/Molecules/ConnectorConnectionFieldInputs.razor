@using Apperture.Management.Client

@if (Definition is not null)
{
    @foreach (var field in Definition.Fields)
    {
        <div>
            <label class="block text-xs text-muted">
                @field.DisplayName
                @if (field.IsRequired)
                {
                    <span class="ml-1 text-warning">(required)</span>
                }
                @if (field.IsSecret)
                {
                    <span class="ml-1 text-muted">(stored as secret)</span>
                }
            </label>
            <input type="@(field.IsSecret ? "password" : "text")"
                   class="ui-input mt-1"
                   value="@GetValue(field)"
                   @oninput="e => OnFieldChanged(field, e.Value?.ToString())"
                   placeholder="@field.Key" />
            @if (!string.IsNullOrWhiteSpace(field.Description))
            {
                <div class="mt-1 text-xs text-muted">@field.Description</div>
            }
        </div>
    }
}

@code {
    [Parameter] public ConnectorDefinitionCatalogDto? Definition { get; set; }

    [Parameter] public Dictionary<string, string> ConfigValues { get; set; } = null!;

    [Parameter] public Dictionary<string, string> SecretValues { get; set; } = null!;

    // HSK-A: ConfigValues/SecretValues are the SAME dictionary instances owned by the parent page, so
    // mutating them here does not by itself cause the parent to re-render (Blazor's automatic
    // post-event re-render only applies to the component that owns the event handler -- this
    // component -- not its ancestors). Parents that need live eligibility (e.g. a Create button that
    // depends on these values) must pass OnFieldValueChanged (commonly "StateHasChanged") so they
    // re-render on every keystroke.
    [Parameter] public EventCallback OnFieldValueChanged { get; set; }

    private string GetValue(ConnectionFieldCatalogDto field) =>
        field.IsSecret
            ? (SecretValues.TryGetValue(field.Key, out var s) ? s : "")
            : (ConfigValues.TryGetValue(field.Key, out var c) ? c : "");

    private async Task OnFieldChanged(ConnectionFieldCatalogDto field, string? value)
    {
        if (field.IsSecret)
            SecretValues[field.Key] = value ?? "";
        else
            ConfigValues[field.Key] = value ?? "";

        if (OnFieldValueChanged.HasDelegate)
            await OnFieldValueChanged.InvokeAsync();
    }
}
