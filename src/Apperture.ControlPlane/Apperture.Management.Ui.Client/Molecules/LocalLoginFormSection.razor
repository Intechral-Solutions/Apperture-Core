@using System.Net.Http
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Organisms
@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Shared.Auth
@using Microsoft.AspNetCore.Components.Forms
@inject IManagementClient Client
@inject SessionStateService Session
@inject NavigationManager Nav

<div class="space-y-4">
    <EditForm Model="_model" OnValidSubmit="SubmitAsync">
        <div>
            <label class="text-xs text-muted">Username</label>
            <InputText @bind-Value="_model.Username" class="mt-1 w-full rounded border border-default bg-surface px-2 py-2 text-sm" autocomplete="username" />
        </div>
        <div>
            <label class="text-xs text-muted">Password</label>
            <InputText type="password" @bind-Value="_model.Password" class="mt-1 w-full rounded border border-default bg-surface px-2 py-2 text-sm" autocomplete="current-password" />
        </div>
        <div class="mt-6 space-y-3">
            @if (!string.IsNullOrEmpty(_error))
            {
                <PageMessage Kind="PageMessageKind.Error" Message="@_error" />
            }
            <button type="submit" class="w-full rounded bg-surface-muted px-3 py-2 text-sm font-medium text-heading hover:bg-surface disabled:opacity-50" disabled="@_busy">
                @(_busy ? "Signing in…" : "Sign in")
            </button>
        </div>
    </EditForm>
</div>

@code {
    [Parameter] public string? ReturnPath { get; set; }

    private readonly LoginModel _model = new();
    private string? _error;
    private bool _busy;

    private async Task SubmitAsync()
    {
        _error = null;
        _busy = true;
        try
        {
            await Client.LocalLoginAsync(new LocalLoginRequest(_model.Username.Trim(), _model.Password));
            await Session.RefreshAsync();
            var safe = LoginRouteHelper.NormalizeReturnUrl(ReturnPath) ?? LoginRouteHelper.DefaultPostLoginPath;
            Nav.NavigateTo(safe);
        }
        catch (HttpRequestException)
        {
            _error = "Sign-in failed. Check your username and password.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class LoginModel
    {
        public string Username { get; set; } = "";
        public string? Password { get; set; }
    }
}
