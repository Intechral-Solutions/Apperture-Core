@using System.Net.Http
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Organisms
@using Apperture.Management.Ui.Shared.Auth
@using Microsoft.AspNetCore.Components.Forms
@inject IManagementClient Client
@inject NavigationManager Nav

<div class="space-y-4">
    <EditForm Model="_model" OnValidSubmit="SubmitAsync">
        <div>
            <label class="text-xs text-muted" for="local-login-username">Username</label>
            <InputText id="local-login-username"
                       @bind-Value="_model.Username"
                       class="ui-input mt-1"
                       autocomplete="username" />
        </div>
        <div>
            <label class="text-xs text-muted" for="local-login-password">Password</label>
            <InputText id="local-login-password"
                       type="password"
                       @bind-Value="_model.Password"
                       class="ui-input mt-1"
                       autocomplete="current-password" />
        </div>
        <div class="mt-6 space-y-3">
            @if (!string.IsNullOrEmpty(_error))
            {
                <PageMessage Kind="PageMessageKind.Error" Message="@_error" />
            }
            <button type="submit" class="btn btn-primary w-full" disabled="@_busy">
                @(_busy ? "Signing in…" : "Sign in")
            </button>
        </div>
    </EditForm>
</div>

@code {
    [Parameter] public string? ReturnPath { get; set; }

    private readonly LoginModel _model = new();
    private string? _error;
    private bool _busy;

    private async Task SubmitAsync()
    {
        _error = null;
        _busy = true;
        try
        {
            await Client.LocalLoginAsync(new LocalLoginRequest(_model.Username.Trim(), _model.Password));
            var safe = LoginRouteHelper.NormalizeReturnUrl(ReturnPath) ?? LoginRouteHelper.DefaultPostLoginPath;
            // Full reload for a fresh WASM circuit + cookie jar. Do not warm session on this circuit first:
            // that would let AuthRouteGate SPA-navigate into MainLayout, then forceLoad tear it down mid-mount.
            Nav.NavigateTo(safe, forceLoad: true);
        }
        catch (HttpRequestException)
        {
            _error = "Sign-in failed. Check your username and password.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private sealed class LoginModel
    {
        public string Username { get; set; } = "";
        public string? Password { get; set; }
    }
}
