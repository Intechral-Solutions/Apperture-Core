@using System.Net.Http
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Organisms
@using Apperture.Management.Ui.Shared.Auth
@using Microsoft.AspNetCore.Components.Forms
@inject IManagementClient Client
@inject NavigationManager Nav

<div class="space-y-4">
    <EditForm Model="_model" OnValidSubmit="SubmitAsync">
        @if (!_awaitingMfa)
        {
            <div>
                <label class="block text-sm font-medium text-heading" for="local-login-username">Username</label>
                <InputText id="local-login-username"
                           @bind-Value="_model.Username"
                           class="ui-input mt-1"
                           autocomplete="username" />
            </div>
            <div>
                <label class="block text-sm font-medium text-heading" for="local-login-password">Password</label>
                <InputText id="local-login-password"
                           type="password"
                           @bind-Value="_model.Password"
                           class="ui-input mt-1"
                           autocomplete="current-password" />
            </div>
        }
        else
        {
            <p class="text-sm text-muted">Enter the 6-digit code from your authenticator app, or a recovery code.</p>
            <div>
                <label class="block text-sm font-medium text-heading" for="local-login-totp">Authenticator code</label>
                <InputText id="local-login-totp"
                           @bind-Value="_model.TotpCode"
                           class="ui-input mt-1"
                           autocomplete="one-time-code"
                           inputmode="numeric" />
            </div>
            <div>
                <label class="block text-sm font-medium text-heading" for="local-login-recovery">Recovery code</label>
                <InputText id="local-login-recovery"
                           @bind-Value="_model.RecoveryCode"
                           class="ui-input mt-1"
                           autocomplete="off" />
            </div>
        }
        <div class="mt-6 space-y-3">
            @if (!string.IsNullOrEmpty(_error))
            {
                <PageMessage Kind="PageMessageKind.Error" Message="@_error" />
            }
            <button type="submit" class="btn btn-primary w-full" disabled="@_busy">
                @(_busy ? "Signing in…" : _awaitingMfa ? "Continue" : "Sign in")
            </button>
            @if (_awaitingMfa)
            {
                <button type="button" class="btn btn-secondary w-full" disabled="@_busy" @onclick="CancelMfa">
                    Back
                </button>
            }
        </div>
    </EditForm>
</div>

@code {
    [Parameter] public string? ReturnPath { get; set; }

    private readonly LoginModel _model = new();
    private string? _error;
    private bool _busy;
    private bool _awaitingMfa;

    private async Task SubmitAsync()
    {
        _error = null;
        _busy = true;
        try
        {
            if (!_awaitingMfa)
            {
                var result = await Client.LocalLoginAsync(new LocalLoginRequest(_model.Username.Trim(), _model.Password));
                if (result.RequiresMfa)
                {
                    _awaitingMfa = true;
                    _model.Password = null;
                    return;
                }

                NavigateAfterLogin();
                return;
            }

            var totp = string.IsNullOrWhiteSpace(_model.TotpCode) ? null : _model.TotpCode.Trim();
            var recovery = string.IsNullOrWhiteSpace(_model.RecoveryCode) ? null : _model.RecoveryCode.Trim();
            if ((totp is null) == (recovery is null))
            {
                _error = "Enter an authenticator code or a recovery code, not both.";
                return;
            }

            await Client.CompleteLocalMfaAsync(new LocalMfaChallengeRequest(totp, recovery));
            NavigateAfterLogin();
        }
        catch (HttpRequestException)
        {
            _error = _awaitingMfa
                ? "Verification failed. Check the authenticator or recovery code."
                : "Sign-in failed. Check your username and password.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private void CancelMfa()
    {
        _awaitingMfa = false;
        _model.TotpCode = "";
        _model.RecoveryCode = "";
        _error = null;
    }

    private void NavigateAfterLogin()
    {
        var safe = LoginRouteHelper.NormalizeReturnUrl(ReturnPath) ?? LoginRouteHelper.DefaultPostLoginPath;
        Nav.NavigateTo(safe, forceLoad: true);
    }

    private sealed class LoginModel
    {
        public string Username { get; set; } = "";
        public string? Password { get; set; }
        public string TotpCode { get; set; } = "";
        public string RecoveryCode { get; set; } = "";
    }
}
