@using Apperture.Core.Domain.Identity

<div class="space-y-3">
    <div>
        <label class="block text-sm font-medium text-heading" for="@PasswordId">@PasswordLabel</label>
        <div class="mt-1 flex max-w-md items-center gap-2">
            <input id="@PasswordId"
                   type="@(_revealPassword ? "text" : "password")"
                   autocomplete="new-password"
                   class="ui-input flex-1"
                   value="@Password"
                   disabled="@Disabled"
                   @oninput="OnPasswordInput" />
            <button type="button"
                    class="text-xs text-muted underline hover:text-heading"
                    @onclick="() => _revealPassword = !_revealPassword">
                @(_revealPassword ? "Hide" : "Show")
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Password))
    {
        <PasswordStrengthIndicator Evaluation="_form.Evaluation" Class="max-w-md" />
    }

    <div>
        <label class="block text-sm font-medium text-heading" for="@ConfirmId">@ConfirmLabel</label>
        <div class="mt-1 flex max-w-md items-center gap-2">
            <input id="@ConfirmId"
                   type="@(_revealConfirm ? "text" : "password")"
                   autocomplete="new-password"
                   class="ui-input flex-1"
                   value="@Confirmation"
                   disabled="@Disabled"
                   aria-invalid="@(_form.ConfirmationTouched && !_form.PasswordsMatch ? "true" : null)"
                   @oninput="OnConfirmInput" />
            <button type="button"
                    class="text-xs text-muted underline hover:text-heading"
                    @onclick="() => _revealConfirm = !_revealConfirm">
                @(_revealConfirm ? "Hide" : "Show")
            </button>
        </div>
        @if (_form.ConfirmationTouched && !string.IsNullOrEmpty(Confirmation))
        {
            @if (_form.PasswordsMatch && _form.Evaluation.IsAcceptable)
            {
                <p class="mt-1 text-xs text-muted" role="status">Passwords match ✓</p>
            }
            else if (!_form.PasswordsMatch)
            {
                <p class="mt-1 text-xs text-message-error" role="alert">Passwords do not match</p>
            }
        }
    </div>
</div>

@code {
    [Parameter] public string Password { get; set; } = "";
    [Parameter] public EventCallback<string> PasswordChanged { get; set; }
    [Parameter] public string Confirmation { get; set; } = "";
    [Parameter] public EventCallback<string> ConfirmationChanged { get; set; }
    [Parameter] public PasswordEvaluationContext? Context { get; set; }
    [Parameter] public EventCallback<bool> IsValidChanged { get; set; }
    [Parameter] public string PasswordId { get; set; } = "new-password";
    [Parameter] public string ConfirmId { get; set; } = "confirm-password";
    [Parameter] public string PasswordLabel { get; set; } = "New password";
    [Parameter] public string ConfirmLabel { get; set; } = "Confirm password";
    [Parameter] public bool Disabled { get; set; }

    private PasswordSetupFormState _form = PasswordSetupFormState.Evaluate("", "");
    private bool _revealPassword;
    private bool _revealConfirm;
    private bool _confirmTouched;
    private bool _lastValid;

    public bool PasswordsMatch => _form.PasswordsMatch;

    public bool IsValid => _form.IsReady;

    public void Reset()
    {
        Password = "";
        Confirmation = "";
        _confirmTouched = false;
        _form = PasswordSetupFormState.Evaluate("", "");
        _revealPassword = false;
        _revealConfirm = false;
        _lastValid = false;
    }

    protected override async Task OnParametersSetAsync()
    {
        RefreshForm();
        await PublishValidityAsync();
    }

    private async Task OnPasswordInput(ChangeEventArgs args)
    {
        Password = args.Value?.ToString() ?? "";
        RefreshForm();
        await PasswordChanged.InvokeAsync(Password);
        await PublishValidityAsync();
    }

    private async Task OnConfirmInput(ChangeEventArgs args)
    {
        Confirmation = args.Value?.ToString() ?? "";
        _confirmTouched = true;
        RefreshForm();
        await ConfirmationChanged.InvokeAsync(Confirmation);
        await PublishValidityAsync();
    }

    private void RefreshForm() =>
        _form = PasswordSetupFormState.Evaluate(Password, Confirmation, _confirmTouched, Context);

    private async Task PublishValidityAsync()
    {
        if (_lastValid == IsValid)
            return;
        _lastValid = IsValid;
        await IsValidChanged.InvokeAsync(IsValid);
    }
}
