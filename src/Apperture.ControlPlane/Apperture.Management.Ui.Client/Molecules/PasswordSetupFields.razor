@using Apperture.Core.Domain.Identity
@using Blazor.Heroicons.Solid
@using Microsoft.AspNetCore.Components.Forms
@implements IDisposable

<div class="ui-password-setup">
    <ValidatedFieldShell Label="@PasswordLabel"
                         For="@PasswordId"
                         Validation="_session.PasswordValidation"
                         AdornmentSlots="2">
        <Control>
            <input @ref="_passwordElement"
                   id="@PasswordId"
                   type="@(_revealPassword ? "text" : "password")"
                   autocomplete="new-password"
                   class="ui-input ui-input--adorned"
                   value="@_session.Password"
                   disabled="@Disabled"
                   aria-invalid="@(_session.PasswordValidation.Kind == FieldValidationKind.Invalid ? "true" : null)"
                   @oninput="OnPasswordInput" />
        </Control>
        <Adornments>
            <button type="button"
                    class="@VisibilityClass(_revealPassword)"
                    aria-label="@(_revealPassword ? "Hide password" : "Show password")"
                    aria-pressed="@_revealPassword"
                    disabled="@Disabled"
                    @onclick="TogglePasswordVisibility">
                <EyeIcon class="h-4 w-4" />
            </button>
        </Adornments>
        <ChildContent>
            <PasswordStrengthIndicator Evaluation="_session.Form.Evaluation"
                                       Neutral="@PasswordStrengthDisplay.IsNeutral(_session.Password)" />
            @if (ShowPolicyChecks)
            {
                <ul class="ui-password-checks">
                    @foreach (var check in _session.Form.Evaluation.Checks)
                    {
                        <li class="@(check.Passed ? "ui-password-checks__item--ok" : "ui-password-checks__item--fail")">
                            <span aria-hidden="true">@(check.Passed ? "✓" : "✕")</span>
                            <span>@check.Message</span>
                        </li>
                    }
                </ul>
            }
        </ChildContent>
    </ValidatedFieldShell>

    <ValidatedFieldShell Label="@ConfirmLabel"
                         For="@ConfirmId"
                         Validation="_session.ConfirmationValidation"
                         AdornmentSlots="2">
        <Control>
            <input @ref="_confirmElement"
                   id="@ConfirmId"
                   type="@(_revealConfirm ? "text" : "password")"
                   autocomplete="new-password"
                   class="ui-input ui-input--adorned"
                   value="@_session.Confirmation"
                   disabled="@Disabled"
                   aria-invalid="@(_session.ConfirmationValidation.Kind == FieldValidationKind.Invalid ? "true" : null)"
                   @oninput="OnConfirmInput" />
        </Control>
        <Adornments>
            <button type="button"
                    class="@VisibilityClass(_revealConfirm)"
                    aria-label="@(_revealConfirm ? "Hide password" : "Show password")"
                    aria-pressed="@_revealConfirm"
                    disabled="@Disabled"
                    @onclick="ToggleConfirmVisibility">
                <EyeIcon class="h-4 w-4" />
            </button>
        </Adornments>
        <ChildContent>
            @if (_session.ConfirmationValidation.Kind != FieldValidationKind.Pristine && _session.Form.PasswordsMatch)
            {
                <p class="ui-password-match" role="status">Passwords match ✓</p>
            }
        </ChildContent>
    </ValidatedFieldShell>
</div>

@code {
    [Parameter] public EventCallback<string> PasswordChanged { get; set; }
    [Parameter] public EventCallback<string> ConfirmationChanged { get; set; }
    [Parameter] public EventCallback<bool> IsValidChanged { get; set; }
    [Parameter] public PasswordEvaluationContext? Context { get; set; }
    [Parameter] public PasswordPolicyProfile? Profile { get; set; }
    [Parameter] public string PasswordId { get; set; } = "new-password";
    [Parameter] public string ConfirmId { get; set; } = "confirm-password";
    [Parameter] public string PasswordLabel { get; set; } = "New password";
    [Parameter] public string ConfirmLabel { get; set; } = "Confirm password";
    [Parameter] public bool Disabled { get; set; }

    [CascadingParameter] private EditContext? EditContext { get; set; }

    private readonly PasswordSetupSession _session = new();
    private ValidationMessageStore? _messages;
    private ElementReference _passwordElement;
    private ElementReference _confirmElement;
    private bool _revealPassword;
    private bool _revealConfirm;
    private bool _lastValid;
    private bool _subscribed;

    public bool IsValid => _session.Form.IsReady;

    public bool ShowFormAttention => _session.ShowFormAttention;

    public PasswordSetupSession Session => _session;

    private bool ShowPolicyChecks =>
        _session.PasswordTouched || _session.SubmitAttempted;

    public bool ValidateForSubmit()
    {
        var ready = _session.ValidateForSubmit();
        PushEditContextMessages();
        _ = FocusFirstInvalidAsync();
        _ = PublishValidityAsync();
        return ready;
    }

    public void ApplyServerError(string? passwordMessage = null, string? confirmationMessage = null)
    {
        _session.ApplyServerError(passwordMessage, confirmationMessage);
        PushEditContextMessages();
    }

    public void Reset()
    {
        _session.Reset();
        _revealPassword = false;
        _revealConfirm = false;
        _lastValid = false;
        _messages?.Clear();
        EditContext?.NotifyValidationStateChanged();
    }

    protected override void OnParametersSet()
    {
        _session.SetProfile(Profile);
        _session.SetContext(Context);
        EnsureEditContextSubscription();
    }

    public void Dispose()
    {
        if (EditContext is null || !_subscribed)
            return;
        EditContext.OnValidationRequested -= OnValidationRequested;
        _subscribed = false;
    }

    private void EnsureEditContextSubscription()
    {
        if (EditContext is null || _subscribed)
            return;
        _messages = new ValidationMessageStore(EditContext);
        EditContext.OnValidationRequested += OnValidationRequested;
        _subscribed = true;
    }

    private void OnValidationRequested(object? sender, ValidationRequestedEventArgs args)
    {
        _session.ValidateForSubmit();
        PushEditContextMessages();
        _ = FocusFirstInvalidAsync();
    }

    private async Task OnPasswordInput(ChangeEventArgs args)
    {
        _session.SetPassword(args.Value?.ToString());
        PushEditContextMessages();
        await PasswordChanged.InvokeAsync(_session.Password);
        await PublishValidityAsync();
    }

    private async Task OnConfirmInput(ChangeEventArgs args)
    {
        _session.SetConfirmation(args.Value?.ToString());
        PushEditContextMessages();
        await ConfirmationChanged.InvokeAsync(_session.Confirmation);
        await PublishValidityAsync();
    }

    private void TogglePasswordVisibility() => _revealPassword = !_revealPassword;

    private void ToggleConfirmVisibility() => _revealConfirm = !_revealConfirm;

    private static string VisibilityClass(bool visible) =>
        visible
            ? "ui-password-visibility ui-password-visibility--visible"
            : "ui-password-visibility ui-password-visibility--hidden";

    private void PushEditContextMessages()
    {
        if (EditContext is null || _messages is null)
            return;

        _messages.Clear();
        if (_session.PasswordValidation.Kind == FieldValidationKind.Invalid && _session.PasswordValidation.Message is not null)
            _messages.Add(CreateField(PasswordSetupSession.PasswordFieldKey), _session.PasswordValidation.Message);
        if (_session.ConfirmationValidation.Kind == FieldValidationKind.Invalid && _session.ConfirmationValidation.Message is not null)
            _messages.Add(CreateField(PasswordSetupSession.ConfirmationFieldKey), _session.ConfirmationValidation.Message);
        EditContext.NotifyValidationStateChanged();
    }

    private FieldIdentifier CreateField(string name) => new(_session, name);

    private async Task FocusFirstInvalidAsync()
    {
        try
        {
            if (_session.FirstInvalidFieldKey == PasswordSetupSession.PasswordFieldKey)
                await _passwordElement.FocusAsync();
            else if (_session.FirstInvalidFieldKey == PasswordSetupSession.ConfirmationFieldKey)
                await _confirmElement.FocusAsync();
        }
        catch (InvalidOperationException)
        {
            // Element not yet rendered.
        }
    }

    private async Task PublishValidityAsync()
    {
        if (_lastValid == IsValid)
            return;
        _lastValid = IsValid;
        await IsValidChanged.InvokeAsync(IsValid);
    }
}
