@using Apperture.Management.Ui.Shared.Models

<div class="ui-topbar-orientation min-w-0">
    @if (Parents.Count > 0)
    {
        <ManagementBreadcrumbs Items="@Parents" />
    }
    @if (!string.IsNullOrWhiteSpace(Title) || !string.IsNullOrWhiteSpace(Subtitle))
    {
        <div class="ui-topbar__heading-line">
            @if (!string.IsNullOrWhiteSpace(Title))
            {
                <div class="ui-topbar__title truncate" role="heading" aria-level="1">@Title</div>
            }
            @if (!string.IsNullOrWhiteSpace(Subtitle))
            {
                <p class="ui-topbar__subtitle truncate">@Subtitle</p>
            }
        </div>
    }
</div>

@code {
    [Parameter] public IReadOnlyList<BreadcrumbItem> Parents { get; set; } = [];
    [Parameter] public string? Title { get; set; }
    [Parameter] public string? Subtitle { get; set; }
}
