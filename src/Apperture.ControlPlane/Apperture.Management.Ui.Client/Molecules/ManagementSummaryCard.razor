@if (!string.IsNullOrWhiteSpace(Href))
{
    <a href="@Href" class="ui-summary-card @Class">
        <div class="flex items-start justify-between gap-2">
            <h2 class="text-base font-semibold text-heading">@Title</h2>
            @if (!string.IsNullOrWhiteSpace(Attention))
            {
                <AttentionPill Label="@Attention" DashboardAttention="@Attention" />
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <p class="mt-2 text-sm text-body">@Description</p>
        }
        @if (ChildContent is not null)
        {
            <div class="mt-3">@ChildContent</div>
        }
    </a>
}
else
{
    <div class="ui-summary-card ui-summary-card--static @Class">
        <div class="flex items-start justify-between gap-2">
            <h2 class="text-base font-semibold text-heading">@Title</h2>
            @if (!string.IsNullOrWhiteSpace(Attention))
            {
                <AttentionPill Label="@Attention" DashboardAttention="@Attention" />
            }
        </div>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <p class="mt-2 text-sm text-body">@Description</p>
        }
        @if (ChildContent is not null)
        {
            <div class="mt-3">@ChildContent</div>
        }
    </div>
}

@code {
    [Parameter] public string Title { get; set; } = "";
    [Parameter] public string? Description { get; set; }
    [Parameter] public string? Href { get; set; }
    [Parameter] public string? Attention { get; set; }
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
