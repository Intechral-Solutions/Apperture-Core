@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Rendering
@using Apperture.Management.Ui.Shared.Models

@if (!string.IsNullOrEmpty(Href))
{
    <a href="@Href"
       class="@EffectiveContainerStyle"
       aria-label="@AriaLabel"
       @onclick="@RaiseClick"
       @onclick:preventDefault="@(OnItemClick.HasDelegate)">
        <span class="@EffectiveNavButtonStyle inline-flex">
            <DynamicComponent Type="@IconType" Parameters="EffectiveIconParameters" />
        </span>
        <div class="@TooltipStyle">@Tooltip</div>
    </a>
}
else
{
    <div class="@EffectiveContainerStyle" @onclick="@RaiseClick">
        <button type="button" class="@EffectiveNavButtonStyle" aria-label="@AriaLabel">
            <DynamicComponent Type="@IconType" Parameters="EffectiveIconParameters" />
        </button>
        <div class="@TooltipStyle">@Tooltip</div>
    </div>
}

@code {
    [Parameter] public string? Href { get; set; }
    [Parameter] public string? Domain { get; set; }
    [Parameter] public Type IconType { get; set; } = default!;
    [Parameter] public string Tooltip { get; set; } = string.Empty;
    /// <summary>Optional accessible name for the rail control (logo/gear use custom markup separately).</summary>
    [Parameter] public string? AriaLabel { get; set; }
    [Parameter] public string? CurrentDomain { get; set; }
    [Parameter] public string? CurrentPageUri { get; set; }
    [Parameter] public string ContainerStyle { get; set; } = "group relative inline-block";
    /// <summary>When true, uses blue glow on icon instead of tile background for hover/active.</summary>
    [Parameter] public bool UseGlowEffect { get; set; }
    [Parameter]
    public string NavButtonStyle { get; set; } =
        "p-3 rounded-sm transition-colors duration-200 " +
        "group-hover:bg-slate-400 dark:group-hover:bg-slate-600 group-hover:bg-opacity-80 " +
        "h-12 w-12 mx-auto rounded-md transition-all duration-300 flex flex-col items-center justify-center cursor-pointer relative";
    [Parameter]
    public string IconStyle { get; set; } =
        "h-6 w-6 text-body opacity-60 group-hover:opacity-90 transition-all duration-200";
    [Parameter]
    public string TooltipStyle { get; set; } =
        "absolute left-full top-1/2 transform -translate-y-1/2 -translate-x-1 " +
        "bg-slate-300 dark:bg-slate-700 dark:text-white text-sm rounded px-2 py-1 " +
        "opacity-0 group-hover:opacity-100 transition-opacity duration-200 whitespace-nowrap z-10 pointer-events-none";
    [Parameter] public EventCallback<DomainNavClickArgs> OnItemClick { get; set; }

    private bool IsActive =>
        !string.IsNullOrEmpty(Domain) &&
        !string.IsNullOrEmpty(CurrentDomain) &&
        string.Equals(Domain, CurrentDomain, StringComparison.OrdinalIgnoreCase);

    private string EffectiveContainerStyle =>
        ContainerStyle + (UseGlowEffect && IsActive ? " nav-rail-item-glowing" : "");

    private string EffectiveNavButtonStyle =>
        IsActive && !UseGlowEffect
            ? NavButtonStyle + " bg-slate-400 dark:bg-slate-600 bg-opacity-30 dark:bg-opacity-30"
            : NavButtonStyle;

    private string EffectiveIconClass =>
        (IsActive ? $"{IconStyle} opacity-100" : IconStyle) +
        (UseGlowEffect ? " nav-rail-icon-glow" : "");

    private IDictionary<string, object> EffectiveIconParameters =>
        new Dictionary<string, object> { ["class"] = EffectiveIconClass };

    private async Task RaiseClick()
    {
        if (OnItemClick.HasDelegate)
        {
            await OnItemClick.InvokeAsync(new DomainNavClickArgs { Domain = Domain, Href = Href });
        }
    }
}
