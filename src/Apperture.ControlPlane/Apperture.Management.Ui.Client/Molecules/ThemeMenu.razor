@using System.Net.Http
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Shared
@implements IDisposable
@inject ThemeService ThemeService
@inject SessionStateService Session
@inject IManagementClient Client

<div class="relative" @onclick:stopPropagation="true">
    <button type="button"
            class="flex items-center justify-center rounded p-2 text-body hover:bg-surface-muted"
            aria-expanded="@_open"
            aria-haspopup="true"
            aria-label="@($"Appearance: {Label(ThemeService.Current)}")"
            title="@Label(ThemeService.Current)"
            @onclick="Toggle">
        <ThemePreferenceIcon Preference="ThemeService.Current" Class="h-5 w-5 shrink-0 text-heading" />
    </button>
    @if (_open)
    {
        <div class="absolute end-0 z-50 mt-1 min-w-52 rounded border border-default bg-surface py-1 text-sm shadow-lg"
             role="menu"
             aria-label="Theme options">
            @foreach (var p in _prefs)
            {
                var active = ThemeService.Current == p;
                <button type="button"
                        role="menuitemradio"
                        aria-checked="@active"
                        class="flex w-full items-center gap-3 px-3 py-2 text-start hover:bg-surface-muted @(active ? "bg-surface-muted/80" : "")"
                        @onclick="() => SelectAsync(p)">
                    <ThemePreferenceIcon Preference="p" Class="h-5 w-5 shrink-0 text-body" />
                    <span class="flex-1 @(active ? "font-medium text-heading" : "text-body")">@Label(p)</span>
                    <span class="flex h-5 w-5 shrink-0 items-center justify-center" aria-hidden="true">
                        @if (active)
                        {
                            <svg class="h-4 w-4 text-heading"
                                 viewBox="0 0 20 20"
                                 fill="currentColor"
                                 aria-hidden="true">
                                <path fill-rule="evenodd"
                                      d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                                      clip-rule="evenodd" />
                            </svg>
                        }
                    </span>
                </button>
            }
        </div>
    }
</div>

@code {
    private static readonly ThemePreference[] _prefs = [ThemePreference.Light, ThemePreference.Dark, ThemePreference.System];

    private bool _open;

    protected override void OnInitialized() => ThemeService.Changed += OnThemeChanged;

    private void OnThemeChanged() => _ = InvokeAsync(StateHasChanged);

    private void Toggle() => _open = !_open;

    private async Task SelectAsync(ThemePreference p)
    {
        _open = false;

        // Apply locally first so the theme switches immediately even if the account save is slow.
        await ThemeService.SetPreferenceAsync(p);

        if (Session.State != SessionLoadState.Authenticated)
            return;

        // Signed in, so this becomes the account preference and follows the operator to other
        // browsers. A failure here is silent: the theme is already applied and stored locally, and
        // the header menu is not the place to report a background save problem.
        try
        {
            var current = await Client.GetAccountPreferencesAsync();
            await Client.UpdateAccountPreferencesAsync(new UpdateUserPreferencesRequestDto
            {
                Appearance = ThemePreferenceParser.ToStorageValue(p),
                TimeFormat = current.TimeFormat,
                TimeZoneId = current.TimeZoneId
            });
            await Session.RefreshAsync();
        }
        catch (HttpRequestException)
        {
            // Local preference stands; the account preferences page can save it explicitly.
        }
    }

    public void Dispose() => ThemeService.Changed -= OnThemeChanged;

    private static string Label(ThemePreference p) => p switch
    {
        ThemePreference.Light => "Light",
        ThemePreference.Dark => "Dark",
        ThemePreference.System => "System",
        _ => p.ToString()
    };
}
