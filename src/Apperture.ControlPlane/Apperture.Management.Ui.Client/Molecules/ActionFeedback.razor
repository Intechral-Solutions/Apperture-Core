<PageMessage Kind="@Kind" Title="@Title" Message="@Message">
    @ChildContent
</PageMessage>

@code {
    [Parameter] public PageMessageKind Kind { get; set; } = PageMessageKind.Info;
    [Parameter] public string Title { get; set; } = "Action";
    [Parameter] public string Message { get; set; } = "";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
