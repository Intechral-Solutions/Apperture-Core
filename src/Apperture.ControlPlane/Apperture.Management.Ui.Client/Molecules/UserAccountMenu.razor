@using System.Net.Http
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Atoms
@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Shared
@using Apperture.Management.Ui.Shared.Options
@using Microsoft.Extensions.Options
@implements IDisposable
@inject SessionStateService Session
@inject IManagementClient Client
@inject ShellHostNavigation HostNav
@inject IOptions<ShellUiOptions> ShellOpts
@inject AuthSignInOptionsService SignInOptions
@inject NavigationManager Nav
@inject TopBarMenuCoordinator Menus
<div class="relative ml-3" @onclick:stopPropagation="true">
    @if (Session.State is SessionLoadState.Unknown or SessionLoadState.Loading)
    {
        <span class="text-xs text-muted">Signing in…</span>
    }
    else if (Session.State == SessionLoadState.ForbiddenUnlinked)
    {
        <a href="@AccountUiRoutes.Profile"
           class="rounded px-3 py-1.5 text-sm text-message-warning hover:bg-surface-muted"
           title="Contact an administrator to link your Entra account">
            Account not linked
        </a>
    }
    else if (Session.State == SessionLoadState.Authenticated && Session.User is not null)
    {
        <button type="button"
                class="flex items-center justify-center rounded p-1.5 hover:bg-surface-muted"
                aria-expanded="@IsOpen"
                aria-haspopup="true"
                aria-label="@($"Account menu for {Session.User.DisplayName}")"
                title="@Session.User.DisplayName"
                @onclick="Toggle">
            <AccountAvatar DisplayName="@Session.User.DisplayName" SizeClass="ui-topbar-account-avatar" />
        </button>
        @if (IsOpen)
        {
            <div class="absolute right-0 z-50 mt-1 min-w-56 rounded border border-default bg-surface py-1 text-sm shadow-lg">
                <div class="px-3 py-2">
                    <span class="block truncate font-medium text-heading">@Session.User.DisplayName</span>
                    <span class="block truncate text-xs text-muted" title="@SecondaryIdentity(Session.User)">@SecondaryIdentity(Session.User)</span>
                </div>
                <hr class="my-1 border-default" />
                <a href="@AccountUiRoutes.Profile" class="block px-3 py-2 text-body hover:bg-surface-muted">Profile</a>
                <a href="@AccountUiRoutes.Notifications" class="block px-3 py-2 text-body hover:bg-surface-muted">Notifications</a>
                <a href="@AccountUiRoutes.Preferences" class="block px-3 py-2 text-body hover:bg-surface-muted">Appearance</a>
                <a href="@AccountUiRoutes.Security" class="block px-3 py-2 text-body hover:bg-surface-muted">Security</a>
                <hr class="my-1 border-default" />
                <button type="button" class="block w-full px-3 py-2 text-start text-body hover:bg-surface-muted" @onclick="SignOutLocalAsync">
                    Sign out
                </button>
                @if (UseEntraSignOut)
                {
                    <button type="button" class="block w-full px-3 py-2 text-start text-xs text-muted hover:bg-surface-muted" @onclick="SignOutHostAsync">
                        Sign out (end IdP session)
                    </button>
                }
            </div>
        }
    }
    else
    {
        <button type="button"
                class="rounded px-3 py-1.5 text-sm font-medium text-heading hover:bg-surface-muted"
                @onclick="GoSignInAsync">
            Sign in
        </button>
    }
</div>

@code {
    private bool IsOpen => Menus.IsOpen(TopBarMenuCoordinator.Ids.Account);

    private bool UseEntraSignOut =>
        ShellOpts.Value.UseEntraSignIn || (SignInOptions.Current?.EntraSignInEnabled ?? false);

    protected override void OnInitialized() => Menus.Changed += OnMenusChanged;

    private void OnMenusChanged() => _ = InvokeAsync(StateHasChanged);

    private void Toggle() => Menus.Toggle(TopBarMenuCoordinator.Ids.Account);

    private Task GoSignInAsync()
    {
        if (ShellOpts.Value.UseEntraSignIn)
        {
            var host = HostNav.GetManagementHostBase(Nav);
            var url = new Uri(host, "signin").ToString();
            Nav.NavigateTo(url, forceLoad: true);
            return Task.CompletedTask;
        }

        Nav.NavigateTo("/login");
        return Task.CompletedTask;
    }

    private async Task SignOutLocalAsync()
    {
        Menus.Close(TopBarMenuCoordinator.Ids.Account);
        try
        {
            await Client.LocalLogoutAsync();
        }
        catch (HttpRequestException)
        {
            /* cookie may already be cleared */
        }

        await Session.RefreshAsync();
        await SignInOptions.RefreshAsync();
        Nav.NavigateTo("/login");
    }

    private void SignOutHostAsync()
    {
        Menus.Close(TopBarMenuCoordinator.Ids.Account);
        var host = HostNav.GetManagementHostBase(Nav);
        var url = new Uri(host, "signout").ToString();
        Nav.NavigateTo(url, forceLoad: true);
    }

    private static string SecondaryIdentity(MeResponse user)
    {
        if (!string.IsNullOrWhiteSpace(user.SignInSource) && !string.Equals(user.SignInSource, "Unknown", StringComparison.Ordinal))
            return FormatSignInSource(user.SignInSource);
        if (!string.IsNullOrWhiteSpace(user.UserPrincipal))
            return user.UserPrincipal;
        if (!string.IsNullOrWhiteSpace(user.DisplayName))
            return user.DisplayName;
        return user.UserId;
    }

    private static string FormatSignInSource(string source) =>
        source switch
        {
            "Local" => "Local sign-in",
            "Entra" => "Entra ID",
            _ => source
        };

    public void Dispose() => Menus.Changed -= OnMenusChanged;
}
