@page "/runtimes/{RuntimeId}/controls/shutdown/requests"
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Organisms
@inject IManagementClient Client

<div class="p-4 ui-page-stack">
    <PageHeader Eyebrow="Runtimes"
                Title="Shutdown requests"
                Subtitle="@($"Runtime {RuntimeId}")">
        <Toolbar>
            <a href="/control/center" class="ui-toolbar-btn">Back to Control Center</a>
        </Toolbar>
    </PageHeader>

    @if (!string.IsNullOrEmpty(_error))
    {
        <ErrorState Message="@_error" />
    }
    else if (_requests is null)
    {
        <LoadingState Message="Loading…" />
    }
    else
    {
        <div class="ui-data-table">
            <table class="ui-data-table__table min-w-full text-left text-body">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Status</th>
                        <th>Requested</th>
                        <th>Requested by</th>
                        <th>Applied</th>
                        <th>Applied by</th>
                        <th>Last error</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in _requests)
                    {
                        <tr>
                            <td class="font-mono text-xs">
                                <a class="underline" href="@($"/runtimes/{RuntimeId}/controls/shutdown/requests/{r.Id}")">@r.Id</a>
                            </td>
                            <td class="font-semibold">@r.Status</td>
                            <td>@FmtWhen(r.RequestedAt)</td>
                            <td>@r.RequestedBy</td>
                            <td>@((r.AppliedAt is null) ? "" : FmtWhen(r.AppliedAt.Value))</td>
                            <td>@r.AppliedBy</td>
                            <td class="text-xs break-all">@r.LastError</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    [Parameter] public string RuntimeId { get; set; } = "";

    private IReadOnlyList<RuntimeControlRequestDto>? _requests;
    private string? _error;
    private string? _dataLoadKey;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        var key = RuntimeId ?? "";
        if (key == _dataLoadKey)
            return;
        _dataLoadKey = key;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _requests = null;
        _error = null;
        try
        {
            _requests = await Client.GetRuntimeShutdownRequestsAsync(RuntimeId);
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
    }

    private static string FmtWhen(DateTimeOffset dt) => dt.ToLocalTime().ToString("u");
}
