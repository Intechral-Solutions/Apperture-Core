@page "/control/center"
@using System.Globalization
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Shared
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities
@inject NavigationManager Nav
@inject IOperatorDisplayTimeZone DisplayTimeZone
@implements IDisposable

<div class="p-4 ui-page-stack">
    <PageHeader Eyebrow="Operations"
                Title="Control Center"
                Subtitle="What needs attention now — blocked work, failures, and recent outcomes. Use Dashboard for a cross-domain summary.">
        <Toolbar>
            <button type="button"
                    class="ui-toolbar-btn"
                    disabled="@_loading"
                    @onclick="LoadAsync">
                Refresh
            </button>
        </Toolbar>
    </PageHeader>

    @if (!string.IsNullOrEmpty(_error))
    {
        <ErrorState Message="@_error" />
    }
    else if (_dto is null)
    {
        <LoadingState />
    }
    else
    {
        <ManagementSection Title="Summary"
                           Layer="ManagementSection.UiLayer.Summary"
                           Help="Current operator posture from control center and optional runtime health snapshots.">
            <div class="flex flex-wrap items-center gap-2">
                <StatusPill Label="@($"Blocked work: {BlockedWorkCount}")" Semantic="@(BlockedWorkCount > 0 ? ManagementStatusSemantic.Blocking : ManagementStatusSemantic.Neutral)" />
                <StatusPill Label="@($"Attention: {AttentionCount}")" Semantic="@(AttentionCount > 0 ? ManagementStatusSemantic.Warning : ManagementStatusSemantic.Success)" />
                <StatusPill Label="@($"Recent activity: {RecentActivityCount}")" Semantic="@(RecentActivityCount > 0 ? ManagementStatusSemantic.Pending : ManagementStatusSemantic.Neutral)" />
                @if (_capabilities?.CanViewRuntimeHealth == true && _health is not null)
                {
                    <StatusPill Label="@($"Platform: {_health.OverallStatus}")" RuntimeHealthStatus="@_health.OverallStatus" />
                }
                else if (_capabilities?.CanViewRuntimeHealth == false || _healthForbidden)
                {
                    <StatusPill Label="Platform health unavailable" Semantic="ManagementStatusSemantic.Forbidden" />
                }
                @if (_capabilities?.CanViewRuntimeHealth == true && _schedulerStatus is not null)
                {
                    <StatusPill Label="@($"Scheduler: {_schedulerStatus.Status}")" Semantic="@MapSchedulerStatus(_schedulerStatus.Status)" />
                }
            </div>

            <div class="ui-summary-card-grid">
                <ManagementSummaryCard Title="Blocked work"
                                       Description="Inspect deferred and retry-eligible work."
                                       Href="/control/blocked-work"
                                       Attention="@(BlockedWorkCount > 0 ? "Warning" : null)" />
                <ManagementSummaryCard Title="Integrations"
                                       Description="Fleet health and remediation."
                                       Href="/integrations" />
                <ManagementSummaryCard Title="Runs"
                                       Description="Review execution history and statuses."
                                       Href="/runs" />
                <ManagementSummaryCard Title="Schedules"
                                       Description="Check schedule definitions and health."
                                       Href="/schedules" />
                <ManagementSummaryCard Title="Audit"
                                       Description="Trace operational events."
                                       Href="/control/audit" />
            </div>
        </ManagementSection>

        <ManagementSection Title="Action needed"
                           Layer="ManagementSection.UiLayer.Summary"
                           Help="Cross-domain attention items ranked for immediate triage.">
            @if (_dto.AttentionItems.Count == 0)
            {
                <PageMessage Kind="PageMessageKind.Info" Message="Nothing needs attention right now." />
            }
            else
            {
                <div class="space-y-2">
                    @foreach (var it in _dto.AttentionItems)
                    {
                        <div class="rounded border border-default bg-surface-muted p-3">
                            <div class="flex items-start justify-between gap-3">
                                <div class="min-w-0">
                                    <div class="text-sm font-semibold">@OperatorAttentionUiHelpers.FormatAttentionSummaryForDisplay(it.Summary)</div>
                                    <div class="mt-1 flex flex-wrap items-center gap-2">
                                        <AttentionPill Label="@it.Severity" DashboardAttention="@it.Severity" />
                                        <span class="text-xs text-muted">@FmtWhen(it.CreatedAtIso)</span>
                                    </div>
                                    <details class="mt-2 text-xs text-muted">
                                        <summary class="cursor-pointer">Technical details</summary>
                                        <div class="mt-1 font-mono">@it.AttentionKind · @it.TargetKind / @it.TargetId</div>
                                    </details>
                                </div>
                                @{
                                    var attentionHref = OperatorAttentionUiHelpers.GetControlCenterAttentionHref(it);
                                }
                                @if (!string.IsNullOrWhiteSpace(attentionHref))
                                {
                                    <DrillInLink Href="@attentionHref">Open</DrillInLink>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </ManagementSection>

        @if (ProblematicActivities.Count > 0)
        {
            <ManagementSection Title="Recent problems"
                               Layer="ManagementSection.UiLayer.Summary"
                               Help="Failed or rejected activity in the last 24 hours.">
                <div class="space-y-2">
                    @foreach (var a in ProblematicActivities.Take(5))
                    {
                        <div class="rounded border border-default bg-surface-muted p-3 flex items-start justify-between gap-3">
                            <div class="min-w-0">
                                <div class="text-sm font-semibold">@a.OutcomeSummary</div>
                                <div class="mt-1 flex flex-wrap items-center gap-2 text-xs text-muted">
                                    <StatusPill Label="@a.CurrentNormalizedStatus" Semantic="@MapActivityStatus(a.CurrentNormalizedStatus)" />
                                    <span>@FmtWhen(a.RequestedAtIso)</span>
                                </div>
                            </div>
                            <DrillInLink Href="@a.DetailLink">Open</DrillInLink>
                        </div>
                    }
                </div>
                @if (ProblematicActivities.Count > 5)
                {
                    <div class="mt-2">
                        <DrillInLink Href="/runs?status=Failed">View all failed runs</DrillInLink>
                    </div>
                }
            </ManagementSection>
        }

        @if (_capabilities?.CanViewRuntimeHealth == true && _health is not null)
        {
            <ManagementSection Title="Platform health"
                               Layer="ManagementSection.UiLayer.Summary"
                               Help="Runtime health snapshot — expand diagnostics below for anomalies and degradation reasons.">
                <div class="flex flex-wrap items-center gap-3">
                    <div>
                        <span class="text-xs text-muted">Status</span>
                        <span class="ml-2">
                            <StatusPill Label="@_health.OverallStatus" RuntimeHealthStatus="@_health.OverallStatus" />
                        </span>
                    </div>
                    @{
                        var counts = Epic33UiDisplayHelpers.GetPlatformHealthCounts(_health);
                        var degradedCount = counts.DegradedModuleCount;
                        var blockedSchedules = counts.BlockedScheduleCount;
                        var blockedWorkCount = counts.BlockedWorkCount;
                    }
                    @if (degradedCount > 0)
                    {
                        <DrillInLink Href="/modules">@degradedCount degraded module(s)</DrillInLink>
                    }
                    @if (blockedSchedules > 0)
                    {
                        <DrillInLink Href="/schedules">@blockedSchedules blocked schedule(s)</DrillInLink>
                    }
                    @if (blockedWorkCount > 0)
                    {
                        <DrillInLink Href="/control/blocked-work">@blockedWorkCount blocked work item(s)</DrillInLink>
                    }
                    <DrillInLink Href="/control/audit">Audit</DrillInLink>
                </div>
            </ManagementSection>
        }
        else if (_capabilities?.CanViewRuntimeHealth == true && !string.IsNullOrEmpty(_healthError))
        {
            <ManagementSection Title="Platform health"
                               Layer="ManagementSection.UiLayer.Detail"
                               Help="Runtime health snapshot (Epic 30).">
                <ErrorState Title="Health snapshot unavailable" Message="@_healthError" />
            </ManagementSection>
        }
        else if (_capabilities?.CanViewRuntimeHealth == false || _healthForbidden)
        {
            <ManagementSection Title="Platform health"
                               Layer="ManagementSection.UiLayer.Detail">
                <ForbiddenState Title="Platform health unavailable"
                                Message="You do not have permission to view runtime health." />
            </ManagementSection>
        }

        @if (_capabilities?.CanViewRuntimeHealth == true && _schedulerStatus is not null)
        {
            <ManagementSection Title="Scheduler runtime"
                               Layer="ManagementSection.UiLayer.Summary"
                               Help="Background WorkerHost dispatch timer heartbeat (SWM-6). Manual recovery run-cycle does not write this heartbeat."
                               Class="mt-4">
                <div class="flex flex-wrap items-start gap-4">
                    <div>
                        <span class="text-xs text-muted">Status</span>
                        <div class="mt-1">
                            <StatusPill Label="@_schedulerStatus.Status" Semantic="@MapSchedulerStatus(_schedulerStatus.Status)" />
                        </div>
                    </div>
                    <div>
                        <span class="text-xs text-muted">Plane</span>
                        <div class="mt-1 font-mono text-sm">@(_schedulerStatus.ObservedRuntimePlaneId ?? "—")</div>
                    </div>
                    <div>
                        <span class="text-xs text-muted">Host id</span>
                        <div class="mt-1 font-mono text-sm">@(_schedulerStatus.ObservedHostId ?? "—")</div>
                    </div>
                    <div>
                        <span class="text-xs text-muted">Last cycle</span>
                        <div class="mt-1 text-sm">
                            <TimestampDisplay Value="@_schedulerStatus.LastCycleCompletedUtc" />
                        </div>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_schedulerStatus.LastErrorSummary))
                    {
                        <div>
                            <span class="text-xs text-muted">Last error</span>
                            <div class="mt-1 text-sm text-danger">@_schedulerStatus.LastErrorSummary</div>
                        </div>
                    }
                </div>
                @if (!string.IsNullOrWhiteSpace(_schedulerStatus.Guidance))
                {
                    <div class="mt-2 text-xs text-muted">@_schedulerStatus.Guidance</div>
                }
                <details class="mt-3 text-xs text-muted">
                    <summary class="cursor-pointer">Technical details</summary>
                    <div class="mt-2 space-y-1 font-mono">
                        <div>Expected plane: @_schedulerStatus.ExpectedManagementPlaneId</div>
                        <div>Alignment: @_schedulerStatus.Alignment / Stale: @_schedulerStatus.IsStale</div>
                        <div>Poll interval: @(_schedulerStatus.PollIntervalSeconds?.ToString() ?? "—")s</div>
                        <div>Assignments/Due/Stale/Candidates: @_schedulerStatus.AssignmentCount / @_schedulerStatus.DueCount / @_schedulerStatus.StaleCount / @_schedulerStatus.CandidateCount</div>
                        <div>Claimed/Dispatched/Skipped: @_schedulerStatus.ClaimedCount / @_schedulerStatus.DispatchedCount / @_schedulerStatus.SkippedCount</div>
                        <div>Started: <TimestampDisplay Value="@_schedulerStatus.LastCycleStartedUtc" CssClass="inline" /></div>
                        <div>Completed: <TimestampDisplay Value="@_schedulerStatus.LastCycleCompletedUtc" CssClass="inline" /></div>
                        <div>Last successful: <TimestampDisplay Value="@_schedulerStatus.LastSuccessfulCycleUtc" CssClass="inline" /></div>
                        <div>Heartbeat updated: <TimestampDisplay Value="@_schedulerStatus.UpdatedUtc" CssClass="inline" /></div>
                    </div>
                </details>
            </ManagementSection>
        }
        <ManagementSection Title="Recent activity"
                           Layer="ManagementSection.UiLayer.Detail"
                           Help="Executions and durable runtime control requests."
                           Class="mt-4">
            @if (_dto.RecentActivity.Count == 0)
            {
                <EmptyState Message="No activity in the last 24 hours. Runs and control requests will appear here after workflows execute." />
            }
                else
                {
                    <div class="ui-data-table">
                        <table class="ui-data-table__table min-w-full text-left text-body">
                            <thead class="border-b border-default text-xs text-muted">
                                <tr>
                                    <th class="px-2 py-2">When</th>
                                    <th class="px-2 py-2">Status</th>
                                    <th class="px-2 py-2">Activity</th>
                                    <th class="px-2 py-2">Target</th>
                                    <th class="px-2 py-2">Outcome</th>
                                    <th class="px-2 py-2">Actions</th>
                                    <th class="px-2 py-2">Open</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in _dto.RecentActivity)
                                {
                                    <tr class="border-b border-default">
                                        <td class="px-2 py-2">
                                            <div class="font-mono text-xs">@FmtWhen(a.RequestedAtIso)</div>
                                        </td>
                                        <td class="px-2 py-2">
                                            <div class="font-semibold">
                                                <StatusPill Label="@a.CurrentNormalizedStatus"
                                                            Semantic="@MapActivityStatus(a.CurrentNormalizedStatus)" />
                                            </div>
                                            <div class="text-xs text-muted">@a.ActivitySource</div>
                                        </td>
                                        <td class="px-2 py-2">
                                            <div class="font-mono text-xs">@a.ActivityKind</div>
                                            <div class="font-mono text-xs text-muted">@a.ActivityId</div>
                                        </td>
                                        <td class="px-2 py-2">
                                            <div class="font-mono text-xs">@a.TargetKind</div>
                                            <div class="font-mono text-xs text-muted">@a.TargetId</div>
                                        </td>
                                        <td class="px-2 py-2">
                                            <div class="font-semibold text-xs">@a.Outcome</div>
                                            <div class="text-xs text-muted">@a.OutcomeSummary</div>
                                        </td>
                                        <td class="px-2 py-2">
                                            @if (a.AvailableActions.Count == 0)
                                            {
                                                <div class="text-xs text-muted">-</div>
                                            }
                                            else
                                            {
                                                <div class="space-y-1">
                                                    @foreach (var act in a.AvailableActions)
                                                    {
                                                        <div class="text-xs">
                                                            <span class="font-mono">@act.ActionKind</span>:
                                                            <span class="font-semibold">@act.AvailabilityState</span>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </td>
                                        <td class="px-2 py-2">
                                            <DrillInLink Href="@a.DetailLink">Open</DrillInLink>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
        </ManagementSection>

        <ManagementAdvancedSection Title="Control targets and diagnostics"
                                   Subtitle="Action availability per target, runtime anomalies, and verbose platform details."
                                   InitiallyOpen="false">
            <ManagementSection Title="Targets"
                               Layer="ManagementSection.UiLayer.Detail"
                               Help="Server-projected action availability for operations, workflows, and runtimes.">
                @if (_dto.Targets.Count == 0)
                {
                    <EmptyState Message="No control targets are visible to your account." />
                }
                else
                {
                    <div class="space-y-3">
                        @foreach (var t in _dto.Targets)
                        {
                            <div class="rounded border border-default bg-surface-muted p-3">
                                <div class="flex items-start justify-between gap-2">
                                    <div class="min-w-0">
                                        <div class="text-sm font-semibold">@t.DisplayName</div>
                                        <div class="text-xs text-muted">
                                            <span class="font-mono">@t.TargetKind</span> / <span class="font-mono">@t.TargetId</span>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(t.GroupKey))
                                        {
                                            <div class="text-xs text-muted">Group: <span class="font-mono">@t.GroupKey</span></div>
                                        }
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(t.DetailLink))
                                    {
                                        <DrillInLink Href="@t.DetailLink">Open</DrillInLink>
                                    }
                                </div>
                                <div class="mt-2">
                                    @if (t.AvailableActions.Count == 0)
                                    {
                                        <div class="text-xs text-muted">No actions.</div>
                                    }
                                    else
                                    {
                                        <div class="space-y-1">
                                            @foreach (var a in t.AvailableActions)
                                            {
                                                <div class="text-xs">
                                                    <span class="font-mono">@a.ActionKind</span>:
                                                    <span class="font-semibold">@a.AvailabilityState</span>
                                                    @if (!string.IsNullOrWhiteSpace(a.ReasonCode))
                                                    {
                                                        <span class="text-muted">(<span class="font-mono">@a.ReasonCode</span>)</span>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </ManagementSection>

            @if (_capabilities?.CanViewRuntimeHealth == true && _health is not null && _health.Anomalies.Count > 0)
            {
                <div class="mt-4">
                    <div class="text-xs font-semibold text-heading">Recent anomalies</div>
                    <div class="mt-1 space-y-1">
                        @foreach (var a in _health.Anomalies.Take(10))
                        {
                            <div class="text-xs">
                                <span class="font-mono">@a.AnomalyKind</span> / @a.Summary
                                @if (!string.IsNullOrEmpty(a.RunId))
                                {
                                    <DrillInLink Href="@($"/runs/{a.RunId}")">Run</DrillInLink>
                                }
                                @if (!string.IsNullOrEmpty(a.ScheduleId))
                                {
                                    <DrillInLink Href="@($"/schedules/{a.ScheduleId}")">Schedule</DrillInLink>
                                }
                                @if (!string.IsNullOrEmpty(a.ModuleId))
                                {
                                    <DrillInLink Href="@($"/modules/{a.ModuleId}")">Module</DrillInLink>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            @if (_capabilities?.CanViewRuntimeHealth == true && _health is not null)
            {
                <div class="mt-4 space-y-3">
                    <div>
                        <div class="text-xs font-semibold text-heading">Degradation reasons</div>
                        @if (_health.DegradationReasons.Count == 0)
                        {
                            <div class="text-xs text-muted mt-1">None reported.</div>
                        }
                        else
                        {
                            <ul class="mt-1 list-disc pl-4 text-xs text-body">
                                @foreach (var reason in _health.DegradationReasons)
                                {
                                    <li>@reason</li>
                                }
                            </ul>
                        }
                    </div>
                    <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
                        <div>
                            <div class="text-xs font-semibold text-heading">Restart-bound surfaces</div>
                            <div class="mt-1 space-y-1">
                                @foreach (var item in _health.RestartBoundSurfaces)
                                {
                                    <div class="text-xs font-mono">@item</div>
                                }
                                @if (_health.RestartBoundSurfaces.Count == 0)
                                {
                                    <div class="text-xs text-muted">None</div>
                                }
                            </div>
                        </div>
                        <div>
                            <div class="text-xs font-semibold text-heading">Not yet implemented surfaces</div>
                            <div class="mt-1 space-y-1">
                                @foreach (var item in _health.NotYetImplementedSurfaces)
                                {
                                    <div class="text-xs font-mono">@item</div>
                                }
                                @if (_health.NotYetImplementedSurfaces.Count == 0)
                                {
                                    <div class="text-xs text-muted">None</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
            else if (_capabilities?.CanViewRuntimeHealth == false || _healthForbidden)
            {
                <div class="mt-4 text-xs text-muted">Diagnostics are unavailable without runtime health access.</div>
            }
        </ManagementAdvancedSection>
    }
</div>

@code {
    private ControlCenterDto? _dto;
    private RuntimeHealthSnapshotDto? _health;
    private SchedulerStatusSnapshotDto? _schedulerStatus;
    private OperatorCapabilitiesDto? _capabilities;
    private bool _healthForbidden;
    private string? _healthError;
    private bool _loading;
    private string? _error;
    private readonly NavigationLoadGuard _loadGuard = new();
    private CancellationTokenSource? _loadCts;

    protected override async Task OnInitializedAsync()
    {
        DisplayTimeZone.Changed += OnDisplayZoneChanged;
        await DisplayTimeZone.EnsureResolvedAsync();
        await LoadCapabilitiesAsync();
        await LoadAsync();
    }

    private void OnDisplayZoneChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        DisplayTimeZone.Changed -= OnDisplayZoneChanged;
        _loadCts?.Cancel();
        _loadCts?.Dispose();
    }

    private CancellationToken BeginLoad(out int generation)
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = new CancellationTokenSource();
        generation = _loadGuard.Begin();
        return _loadCts.Token;
    }

    private async Task LoadCapabilitiesAsync()
    {
        try
        {
            _capabilities = await Capabilities.GetCapabilitiesAsync();
        }
        catch
        {
            _capabilities = new OperatorCapabilitiesDto(false, false, false, false, false, false, false);
        }
    }

    private async Task LoadAsync()
    {
        var cancellationToken = BeginLoad(out var generation);
        _loading = true;
        _error = null;
        _healthForbidden = false;
        _healthError = null;
        try
        {
            if (!_loadGuard.IsCurrent(generation))
                return;

            var center = await Client.GetControlCenterAsync(cancellationToken);
            if (!_loadGuard.IsCurrent(generation))
                return;

            _dto = center;

            if (_capabilities?.CanViewRuntimeHealth == true)
            {
                try
                {
                    _health = await Client.GetRuntimeHealthAsync(cancellationToken: cancellationToken);
                }
                catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
                {
                    if (_loadGuard.IsCurrent(generation))
                        _healthForbidden = true;
                }
                catch (HttpRequestException ex)
                {
                    if (_loadGuard.IsCurrent(generation))
                        _healthError = ex.Message;
                }
                catch (OperationCanceledException)
                {
                    // Superseded navigation; ignore.
                }

                if (!_healthForbidden)
                {
                    try
                    {
                        _schedulerStatus = await Client.GetSchedulerStatusAsync(cancellationToken: cancellationToken);
                    }
                    catch (HttpRequestException)
                    {
                        // Keep platform health; scheduler summary optional if endpoint fails.
                        if (_loadGuard.IsCurrent(generation))
                            _schedulerStatus = null;
                    }
                    catch (OperationCanceledException)
                    {
                        // Superseded navigation; ignore.
                    }
                }
            }
        }
        catch (OperationCanceledException)
        {
            // Superseded navigation; ignore.
        }
        catch (HttpRequestException ex)
        {
            if (_loadGuard.IsCurrent(generation))
            {
                _error = ex.Message;
                _dto = null;
            }
        }
        finally
        {
            if (_loadGuard.IsCurrent(generation))
                _loading = false;
        }
    }

    private string FmtWhen(string iso)
    {
        if (!DateTimeOffset.TryParse(iso, CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind, out var dt))
            return iso;

        return OperatorTimestampFormat.FormatPrimary(
            dt,
            DisplayTimeZone.TimeZoneId,
            DisplayTimeZone.Source,
            showUtcDetail: false);
    }

    private int BlockedWorkCount =>
        _health is null ? 0 : Epic33UiDisplayHelpers.GetPlatformHealthCounts(_health).BlockedWorkCount;

    private int AttentionCount => _dto?.AttentionItems.Count ?? 0;

    private int RecentActivityCount => _dto?.RecentActivity.Count ?? 0;

    private IReadOnlyList<ControlActivitySummaryDto> ProblematicActivities =>
        _dto?.RecentActivity.Where(OperatorAttentionUiHelpers.IsProblematicActivity).ToList()
        ?? [];

    private static ManagementStatusSemantic MapSchedulerStatus(string? status) =>
        string.Equals(status, "Healthy", StringComparison.OrdinalIgnoreCase)
            ? ManagementStatusSemantic.Success
            : string.Equals(status, "Warning", StringComparison.OrdinalIgnoreCase)
                ? ManagementStatusSemantic.Warning
                : ManagementStatusSemantic.Unknown;

    private static ManagementStatusSemantic MapActivityStatus(string? status)
    {
        if (string.IsNullOrWhiteSpace(status))
            return ManagementStatusSemantic.Unknown;

        return status.Trim().ToLowerInvariant() switch
        {
            "completed" or "succeeded" or "success" => ManagementStatusSemantic.Success,
            "failed" or "faulted" or "error" or "rejected" => ManagementStatusSemantic.Error,
            "running" or "pending" or "queued" or "requested" or "in_progress" or "inprogress" =>
                ManagementStatusSemantic.Pending,
            "cancelled" or "canceled" => ManagementStatusSemantic.Warning,
            _ => ManagementStatusSemantic.Neutral
        };
    }
}

