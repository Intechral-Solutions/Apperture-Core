@page "/control/center"
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Shared
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities
@inject NavigationManager Nav

<div class="p-4 ui-page-stack">
    <PageHeader Eyebrow="Operations"
                Title="Control Center"
                Subtitle="Unified control targets, recent activity, attention, and platform health signals.">
        <Toolbar>
            <button class="rounded bg-surface-muted px-3 py-2 text-sm text-body hover:bg-surface"
                    disabled="@_loading"
                    @onclick="LoadAsync">
                Refresh
            </button>
        </Toolbar>
    </PageHeader>

    @if (!string.IsNullOrEmpty(_error))
    {
        <ErrorState Message="@_error" />
    }
    else if (_dto is null)
    {
        <LoadingState />
    }
    else
    {
        <ManagementSection Title="Summary"
                           Layer="ManagementSection.UiLayer.Summary"
                           Help="Current operator posture from control center and optional runtime health snapshots.">
            <div class="flex flex-wrap items-center gap-2">
                <StatusPill Label="@($"Blocked work: {BlockedWorkCount}")" Semantic="@(BlockedWorkCount > 0 ? ManagementStatusSemantic.Blocking : ManagementStatusSemantic.Neutral)" />
                <StatusPill Label="@($"Attention: {AttentionCount}")" Semantic="@(AttentionCount > 0 ? ManagementStatusSemantic.Warning : ManagementStatusSemantic.Success)" />
                <StatusPill Label="@($"Recent activity: {RecentActivityCount}")" Semantic="@(RecentActivityCount > 0 ? ManagementStatusSemantic.Pending : ManagementStatusSemantic.Neutral)" />
                @if (_capabilities?.CanViewRuntimeHealth == true && _health is not null)
                {
                    <StatusPill Label="@($"Platform: {_health.OverallStatus}")" RuntimeHealthStatus="@_health.OverallStatus" />
                }
                else if (_capabilities?.CanViewRuntimeHealth == false || _healthForbidden)
                {
                    <StatusPill Label="Platform health unavailable" Semantic="ManagementStatusSemantic.Forbidden" />
                }
            </div>

            <div class="ui-summary-card-grid">
                <ManagementSummaryCard Title="Blocked work"
                                       Description="Inspect deferred and retry-eligible work."
                                       Href="/control/blocked-work" />
                <ManagementSummaryCard Title="Runs"
                                       Description="Review execution history and statuses."
                                       Href="/runs" />
                <ManagementSummaryCard Title="Schedules"
                                       Description="Check schedule definitions and health."
                                       Href="/schedules" />
                <ManagementSummaryCard Title="Audit"
                                       Description="Trace operational events."
                                       Href="/control/audit" />
                <ManagementSummaryCard Title="Integrations"
                                       Description="Open deployment and lifecycle details."
                                       Href="/integrations" />
            </div>
        </ManagementSection>

        @if (_capabilities?.CanViewRuntimeHealth == true && _health is not null)
        {
            <ManagementSection Title="Platform health"
                               Layer="ManagementSection.UiLayer.Detail"
                               Help="Runtime health snapshot (Epic 30).">
                <div class="flex flex-wrap items-center gap-3">
                    <div>
                        <span class="text-xs text-muted">Status</span>
                        <span class="ml-2">
                            <StatusPill Label="@_health.OverallStatus" RuntimeHealthStatus="@_health.OverallStatus" />
                        </span>
                    </div>
                    @{
                        var counts = Epic33UiDisplayHelpers.GetPlatformHealthCounts(_health);
                        var degradedCount = counts.DegradedModuleCount;
                        var blockedSchedules = counts.BlockedScheduleCount;
                        var blockedWorkCount = counts.BlockedWorkCount;
                    }
                    @if (degradedCount > 0)
                    {
                        <DrillInLink Href="/modules">@degradedCount degraded module(s)</DrillInLink>
                    }
                    @if (blockedSchedules > 0)
                    {
                        <DrillInLink Href="/schedules">@blockedSchedules blocked schedule(s)</DrillInLink>
                    }
                    @if (blockedWorkCount > 0)
                    {
                        <DrillInLink Href="/control/blocked-work">@blockedWorkCount blocked work item(s)</DrillInLink>
                    }
                    <DrillInLink Href="/control/audit">Audit</DrillInLink>
                </div>
                @if (_health.Anomalies.Count > 0)
                {
                    <div class="mt-3">
                        <div class="text-xs text-muted">Recent anomalies:</div>
                        <div class="mt-1 space-y-1">
                            @foreach (var a in _health.Anomalies.Take(5))
                            {
                                <div class="text-xs">
                                    <span class="font-mono">@a.AnomalyKind</span> / @a.Summary
                                    @if (!string.IsNullOrEmpty(a.RunId))
                                    {
                                        <DrillInLink Href="@($"/runs/{a.RunId}")">Run</DrillInLink>
                                    }
                                    @if (!string.IsNullOrEmpty(a.ScheduleId))
                                    {
                                        <DrillInLink Href="@($"/schedules/{a.ScheduleId}")">Schedule</DrillInLink>
                                    }
                                    @if (!string.IsNullOrEmpty(a.ModuleId))
                                    {
                                        <DrillInLink Href="@($"/modules/{a.ModuleId}")">Module</DrillInLink>
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }
            </ManagementSection>
        }
        else if (_capabilities?.CanViewRuntimeHealth == false || _healthForbidden)
        {
            <ManagementSection Title="Platform health"
                               Layer="ManagementSection.UiLayer.Detail">
                <ForbiddenState Title="Platform health unavailable"
                                Message="You do not have permission to view runtime health." />
            </ManagementSection>
        }
        <ManagementSection Title="Operational concerns"
                           Layer="ManagementSection.UiLayer.Detail"
                           Help="Cross-domain attention items for immediate triage.">
            @if (_dto.AttentionItems.Count == 0)
            {
                <EmptyState Message="Nothing needs attention." />
            }
            else
            {
                <div class="space-y-2">
                    @foreach (var it in _dto.AttentionItems)
                    {
                        <div class="rounded border border-default bg-surface-muted p-3">
                            <div class="flex items-start justify-between gap-3">
                                <div class="min-w-0">
                                    <div class="text-sm font-semibold">@it.Summary</div>
                                    <div class="mt-1 flex flex-wrap items-center gap-2">
                                        <AttentionPill Label="@it.Severity" DashboardAttention="@it.Severity" />
                                        <span class="text-xs text-muted font-mono">@it.AttentionKind</span>
                                    </div>
                                    <div class="text-xs text-muted mt-1">
                                        Target: <span class="font-mono">@it.TargetKind</span> / <span class="font-mono">@it.TargetId</span>
                                    </div>
                                </div>
                                @if (!string.IsNullOrWhiteSpace(GetAttentionLink(it)))
                                {
                                    var attentionHref = GetAttentionLink(it);
                                    <DrillInLink Href="@attentionHref">Open</DrillInLink>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </ManagementSection>

        <div class="grid gap-4 lg:grid-cols-3">
            <ManagementSection Title="Targets"
                               Layer="ManagementSection.UiLayer.Detail"
                               Help="Server-projected action availability."
                               Class="lg:col-span-1">
                <div class="space-y-3">
                    @foreach (var t in _dto.Targets)
                    {
                        <div class="rounded border border-default bg-surface-muted p-3">
                            <div class="flex items-start justify-between gap-2">
                                <div class="min-w-0">
                                    <div class="text-sm font-semibold">@t.DisplayName</div>
                                    <div class="text-xs text-muted">
                                        <span class="font-mono">@t.TargetKind</span> / <span class="font-mono">@t.TargetId</span>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(t.GroupKey))
                                    {
                                        <div class="text-xs text-muted">Group: <span class="font-mono">@t.GroupKey</span></div>
                                    }
                                </div>
                        @if (!string.IsNullOrWhiteSpace(t.DetailLink))
                        {
                            <DrillInLink Href="@t.DetailLink">Open</DrillInLink>
                        }
                            </div>

                            <div class="mt-2">
                                @if (t.AvailableActions.Count == 0)
                                {
                                    <div class="text-xs text-muted">No actions.</div>
                                }
                                else
                                {
                                    <div class="space-y-1">
                                        @foreach (var a in t.AvailableActions)
                                        {
                                            <div class="text-xs">
                                                <span class="font-mono">@a.ActionKind</span>:
                                                <span class="font-semibold">@a.AvailabilityState</span>
                                                @if (!string.IsNullOrWhiteSpace(a.ReasonCode))
                                                {
                                                    <span class="text-muted">(<span class="font-mono">@a.ReasonCode</span>)</span>
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </ManagementSection>

            <ManagementSection Title="Recent activity"
                               Layer="ManagementSection.UiLayer.Detail"
                               Help="Executions and durable runtime control requests."
                               Class="lg:col-span-2">
                @if (_dto.RecentActivity.Count == 0)
                {
                    <EmptyState Message="No activity found." />
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="min-w-full text-left text-sm text-body">
                            <thead class="border-b border-default text-xs text-muted">
                                <tr>
                                    <th class="px-2 py-2">When</th>
                                    <th class="px-2 py-2">Status</th>
                                    <th class="px-2 py-2">Activity</th>
                                    <th class="px-2 py-2">Target</th>
                                    <th class="px-2 py-2">Outcome</th>
                                    <th class="px-2 py-2">Actions</th>
                                    <th class="px-2 py-2">Open</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var a in _dto.RecentActivity)
                                {
                                    <tr class="border-b border-default">
                                        <td class="px-2 py-2">
                                            <div class="font-mono text-xs">@FmtWhen(a.RequestedAtIso)</div>
                                        </td>
                                        <td class="px-2 py-2">
                                            <div class="font-semibold">
                                                <StatusPill Label="@a.CurrentNormalizedStatus"
                                                            Semantic="@MapActivityStatus(a.CurrentNormalizedStatus)" />
                                            </div>
                                            <div class="text-xs text-muted">@a.ActivitySource</div>
                                        </td>
                                        <td class="px-2 py-2">
                                            <div class="font-mono text-xs">@a.ActivityKind</div>
                                            <div class="font-mono text-xs text-muted">@a.ActivityId</div>
                                        </td>
                                        <td class="px-2 py-2">
                                            <div class="font-mono text-xs">@a.TargetKind</div>
                                            <div class="font-mono text-xs text-muted">@a.TargetId</div>
                                        </td>
                                        <td class="px-2 py-2">
                                            <div class="font-semibold text-xs">@a.Outcome</div>
                                            <div class="text-xs text-muted">@a.OutcomeSummary</div>
                                        </td>
                                        <td class="px-2 py-2">
                                            @if (a.AvailableActions.Count == 0)
                                            {
                                                <div class="text-xs text-muted">-</div>
                                            }
                                            else
                                            {
                                                <div class="space-y-1">
                                                    @foreach (var act in a.AvailableActions)
                                                    {
                                                        <div class="text-xs">
                                                            <span class="font-mono">@act.ActionKind</span>:
                                                            <span class="font-semibold">@act.AvailabilityState</span>
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </td>
                                        <td class="px-2 py-2">
                                            <DrillInLink Href="@a.DetailLink">Open</DrillInLink>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </ManagementSection>
        </div>

        <ManagementAdvancedSection Title="Diagnostics and evidence"
                                   Subtitle="Low-level diagnostic records and verbose platform details."
                                   InitiallyOpen="false">
            @if (_capabilities?.CanViewRuntimeHealth == true && _health is not null)
            {
                <div class="space-y-3">
                    <div>
                        <div class="text-xs font-semibold text-heading">Degradation reasons</div>
                        @if (_health.DegradationReasons.Count == 0)
                        {
                            <div class="text-xs text-muted mt-1">None reported.</div>
                        }
                        else
                        {
                            <ul class="mt-1 list-disc pl-4 text-xs text-body">
                                @foreach (var reason in _health.DegradationReasons)
                                {
                                    <li>@reason</li>
                                }
                            </ul>
                        }
                    </div>
                    <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
                        <div>
                            <div class="text-xs font-semibold text-heading">Restart-bound surfaces</div>
                            <div class="mt-1 space-y-1">
                                @foreach (var item in _health.RestartBoundSurfaces)
                                {
                                    <div class="text-xs font-mono">@item</div>
                                }
                                @if (_health.RestartBoundSurfaces.Count == 0)
                                {
                                    <div class="text-xs text-muted">None</div>
                                }
                            </div>
                        </div>
                        <div>
                            <div class="text-xs font-semibold text-heading">Not yet implemented surfaces</div>
                            <div class="mt-1 space-y-1">
                                @foreach (var item in _health.NotYetImplementedSurfaces)
                                {
                                    <div class="text-xs font-mono">@item</div>
                                }
                                @if (_health.NotYetImplementedSurfaces.Count == 0)
                                {
                                    <div class="text-xs text-muted">None</div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="text-xs text-muted">Diagnostics are unavailable without runtime health access.</div>
            }
        </ManagementAdvancedSection>
    }
</div>

@code {
    private ControlCenterDto? _dto;
    private RuntimeHealthSnapshotDto? _health;
    private OperatorCapabilitiesDto? _capabilities;
    private bool _healthForbidden;
    private bool _loading;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        await LoadCapabilitiesAsync();
        await LoadAsync();
    }

    private async Task LoadCapabilitiesAsync()
    {
        try
        {
            _capabilities = await Capabilities.GetCapabilitiesAsync();
        }
        catch
        {
            _capabilities = new OperatorCapabilitiesDto(false, false, false, false, false, false, false);
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _dto = null;
        _health = null;
        _healthForbidden = false;
        try
        {
            _dto = await Client.GetControlCenterAsync();
            if (_capabilities?.CanViewRuntimeHealth == true)
            {
                try
                {
                    _health = await Client.GetRuntimeHealthAsync();
                }
                catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
                {
                    _healthForbidden = true;
                }
            }
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private string FmtWhen(string iso) =>
        DateTimeOffset.TryParse(iso, out var dt) ? dt.ToLocalTime().ToString("u") : iso;

    private int BlockedWorkCount =>
        _health is null ? 0 : Epic33UiDisplayHelpers.GetPlatformHealthCounts(_health).BlockedWorkCount;

    private int AttentionCount => _dto?.AttentionItems.Count ?? 0;

    private int RecentActivityCount => _dto?.RecentActivity.Count ?? 0;

    private static ManagementStatusSemantic MapActivityStatus(string? status)
    {
        if (string.IsNullOrWhiteSpace(status))
            return ManagementStatusSemantic.Unknown;

        return status.Trim().ToLowerInvariant() switch
        {
            "completed" or "succeeded" or "success" => ManagementStatusSemantic.Success,
            "failed" or "faulted" or "error" or "rejected" => ManagementStatusSemantic.Error,
            "running" or "pending" or "queued" or "requested" or "in_progress" or "inprogress" =>
                ManagementStatusSemantic.Pending,
            "cancelled" or "canceled" => ManagementStatusSemantic.Warning,
            _ => ManagementStatusSemantic.Neutral
        };
    }

    private string? GetAttentionLink(ControlAttentionItemDto it)
    {
        if (string.IsNullOrWhiteSpace(it.RelatedActivityId))
            return null;

        if (string.Equals(it.AttentionKind, "executionFailed", StringComparison.Ordinal))
            return $"/runs/{it.RelatedActivityId}";

        if (string.Equals(it.AttentionKind, "runtimeShutdownQueuedStuck", StringComparison.Ordinal))
        {
            return $"/runtimes/{it.TargetId}/controls/shutdown/requests/{it.RelatedActivityId}";
        }

        if (string.Equals(it.AttentionKind, "workflowControlRejected", StringComparison.Ordinal))
        {
            return $"/runs/{it.RelatedActivityId}";
        }

        return null;
    }
}

