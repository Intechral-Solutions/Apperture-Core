@page "/control/audit"
@using System.Net
@using Microsoft.AspNetCore.Components.Web
@using Apperture.Core.Domain.ResourceContexts
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Organisms
@using Apperture.Management.Ui.Shared
@inject IManagementClient Client
@inject ResourceContextViewState ViewState

<div class="p-4">
    <PageHeader Title="Audit Timeline"
                Subtitle="Platform audit. Filters are DB-backed. Time, category, actor, outcome.">
        <ChildContent>
            @if (!string.IsNullOrWhiteSpace(QueryRunId))
            {
                <div class="ui-detail-block mt-2 text-xs text-body">
                    <span class="text-muted">Run filter:</span>
                    <a class="ml-1 font-mono underline" href="@($"/runs/{QueryRunId.Trim()}")">Open run @QueryRunId.Trim()</a>
                </div>
            }
        </ChildContent>
        <Toolbar>
            <button class="ui-toolbar-btn"
                    disabled="@_loading"
                    @onclick="LoadAsync">
                Refresh
            </button>
        </Toolbar>
    </PageHeader>

    <div class="mt-4 flex flex-wrap gap-3">
        <div>
            <label class="text-xs text-muted">Time range</label>
            <select class="ui-input text-sm ml-1"
                    @bind="_timeRange"
                    @bind:after="LoadAsync">
                <option value="24">Last 24 hours</option>
                <option value="168">Last 7 days</option>
            </select>
        </div>
        <div>
            <label class="text-xs text-muted">Category</label>
            <select class="ui-input text-sm ml-1"
                    @bind="_actionPrefix"
                    @bind:after="LoadAsync">
                <option value="">All</option>
                <option value="execution.">Lifecycle</option>
                <option value="runtime.composition.">Runtime composition</option>
                <option value="scheduler.">Scheduler</option>
                <option value="recovery.">Recovery</option>
                <option value="module.lifecycle.">Module lifecycle</option>
                <option value="governance.">Governance</option>
            </select>
        </div>
        <div>
            <label class="text-xs text-muted">Outcome</label>
            <select class="ui-input text-sm ml-1"
                    @bind="_outcomeFilter"
                    @bind:after="LoadAsync">
                <option value="">All</option>
                <option value="success">success</option>
                <option value="succeeded">succeeded</option>
                <option value="failed">failed</option>
                <option value="blocked">blocked</option>
                <option value="Blocked">Blocked</option>
                <option value="denied">denied</option>
                <option value="requested">requested</option>
                <option value="dispatched">dispatched</option>
                <option value="recovered">recovered</option>
            </select>
        </div>
        <div>
            <label class="text-xs text-muted">Actor</label>
            <input type="text" class="ui-input text-sm font-mono ml-1"
                   placeholder="e.g. system:scheduler"
                   @bind="_actorFilter"
                   @bind:event="oninput"
                   @onkeydown="OnActorKeyDown" />
        </div>
        <div>
            <label class="text-xs text-muted">Context</label>
            <select class="ui-input text-sm ml-1"
                    @bind="_resourceContextFilter"
                    @bind:after="LoadAsync">
                <option value="">All</option>
                <option value="shared">Shared</option>
                @foreach (var app in ViewState.KnownContexts.Where(c => c.Kind == ResourceContextKinds.Application))
                {
                    <option value="@app.Id">@ViewState.DescribeContext(app.Id)</option>
                }
            </select>
            <div class="mt-0.5 text-xs text-muted">Only activity recorded against a context. Platform and account activity has no context.</div>
        </div>
        @if (!ViewState.Current.IsAll && _resourceContextFilter != ViewState.Current.ResourceContextId)
        {
            <button class="ui-link" @onclick="UseCurrentViewAsync">
                Filter to @ViewState.DescribeContext(ViewState.Current.ResourceContextId!)
            </button>
        }
    </div>

    @if (_forbidden)
    {
        <div class="mt-4">
            <ForbiddenState Message="You do not have permission to view the audit timeline." />
        </div>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <div class="mt-4">
            <ErrorState Message="@_error" />
        </div>
    }
    else if (_page is null && !_forbidden)
    {
        <div class="mt-4">
            <LoadingState Message="Loading…" />
        </div>
    }
    else
    {
        @if (_page!.Items.Count == 0)
        {
            <div class="mt-4">
                <EmptyState Message="No audit events found." />
            </div>
        }
        else
        {
            <div class="ui-data-table mt-4">
                <table class="ui-data-table__table min-w-full text-left text-body">
                    <thead>
                        <tr>
                            <th class="px-2 py-2">When</th>
                            <th class="px-2 py-2">Category</th>
                            <th class="px-2 py-2">Action</th>
                            <th class="px-2 py-2">Actor</th>
                            <th class="px-2 py-2">Outcome</th>
                            <th class="px-2 py-2"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var e in _page.Items)
                        {
                            <tr>
                                <td class="px-2 py-2">
                                    <div class="font-mono text-xs">@FmtWhen(e.Timestamp)</div>
                                </td>
                                <td class="px-2 py-2">
                                    <span class="font-mono text-xs">@e.Category</span>
                                </td>
                                <td class="px-2 py-2">
                                    <div class="font-mono text-xs">@e.Action</div>
                                    @if (!string.IsNullOrWhiteSpace(e.Summary) && e.Summary != e.Action)
                                    {
                                        <div class="text-xs text-muted truncate max-w-xs">@e.Summary</div>
                                    }
                                </td>
                                <td class="px-2 py-2">
                                    <span class="font-mono text-xs">@e.Actor</span>
                                </td>
                                <td class="px-2 py-2">
                                    <span class="text-xs">@(string.IsNullOrEmpty(e.Outcome) ? "-" : e.Outcome)</span>
                                </td>
                                <td class="px-2 py-2">
                                    @if (_expandedId == e.Id)
                                    {
                                        <button class="text-xs underline" @onclick="() => ToggleExpand(e.Id)">Hide</button>
                                    }
                                    else
                                    {
                                        <button class="text-xs underline" @onclick="() => ToggleExpand(e.Id)">Details</button>
                                    }
                                </td>
                            </tr>
                            @if (_expandedId == e.Id)
                            {
                                <tr>
                                    <td colspan="6" class="px-2 py-2">
                                        <div class="ui-detail-block space-y-2 text-xs">
                                            @if (!string.IsNullOrWhiteSpace(e.Details))
                                            {
                                                <div>
                                                    <span class="font-semibold">Details:</span>
                                                    <pre class="mt-1 whitespace-pre-wrap break-words font-mono">@e.Details</pre>
                                                </div>
                                            }
                                            @if (e.RelatedReferences.Count > 0)
                                            {
                                                <div>
                                                    <span class="font-semibold">Related:</span>
                                                    <div class="mt-1 flex flex-wrap gap-2">
                                                        @foreach (var r in e.RelatedReferences)
                                                        {
                                                            <a href="@Epic33UiDisplayHelpers.GetAuditRefLink(r)" class="font-mono underline">@r.Kind:@r.Id</a>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            @if (!string.IsNullOrEmpty(_page.NextContinuationToken))
            {
                <div class="mt-3">
                    <button class="ui-toolbar-btn"
                            disabled="@_loading"
                            @onclick="LoadMoreAsync">
                        Load more
                    </button>
                </div>
            }
        }
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "moduleId")]
    public string? QueryModuleId { get; set; }

    [SupplyParameterFromQuery(Name = "scheduleId")]
    public string? QueryScheduleId { get; set; }

    [SupplyParameterFromQuery(Name = "runId")]
    public string? QueryRunId { get; set; }

    [SupplyParameterFromQuery(Name = "hours")]
    public string? QueryHours { get; set; }

    private AuditTimelinePageDto? _page;
    private bool _loading;
    private bool _forbidden;
    private string? _error;
    private string? _expandedId;
    private string _timeRange = "24";
    private string _actionPrefix = "";
    private string _outcomeFilter = "";
    private string _actorFilter = "";
    private string _resourceContextFilter = "";
    private string? _dataLoadKey;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        ApplyQueryHoursToTimeRange();
        var key = $"{QueryModuleId}|{QueryScheduleId}|{QueryRunId}|{_timeRange}|{_resourceContextFilter}";
        if (key == _dataLoadKey)
            return;
        _dataLoadKey = key;
        await LoadAsync();
    }

    private void ApplyQueryHoursToTimeRange()
    {
        if (string.IsNullOrWhiteSpace(QueryHours))
            return;
        if (!int.TryParse(QueryHours.Trim(), out var h) || h <= 0)
            return;
        // UI select supports 24 or 168; clamp other values into closest supported bucket for a stable experience.
        _timeRange = h >= 168 ? "168" : "24";
    }

    private async Task OnActorKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
            await LoadAsync();
    }

    private Task UseCurrentViewAsync()
    {
        _resourceContextFilter = ViewState.Current.ResourceContextId!;
        return LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _forbidden = false;
        try
        {
            var hours = int.TryParse(_timeRange, out var h) ? h : 24;
            var fromUtc = DateTimeOffset.UtcNow.AddHours(-hours);
            _page = await Client.GetAuditTimelineAsync(
                fromUtc: fromUtc,
                toUtc: null,
                actor: string.IsNullOrWhiteSpace(_actorFilter) ? null : _actorFilter.Trim(),
                actionPrefix: string.IsNullOrEmpty(_actionPrefix) ? null : _actionPrefix,
                outcome: string.IsNullOrWhiteSpace(_outcomeFilter) ? null : _outcomeFilter.Trim(),
                moduleId: string.IsNullOrWhiteSpace(QueryModuleId) ? null : QueryModuleId.Trim(),
                scheduleId: string.IsNullOrWhiteSpace(QueryScheduleId) ? null : QueryScheduleId.Trim(),
                runId: string.IsNullOrWhiteSpace(QueryRunId) ? null : QueryRunId.Trim(),
                resourceContextId: string.IsNullOrWhiteSpace(_resourceContextFilter) ? null : _resourceContextFilter,
                pageSize: 50,
                cancellationToken: default);
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            _forbidden = true;
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadMoreAsync()
    {
        if (_page is null || string.IsNullOrEmpty(_page.NextContinuationToken))
            return;
        _loading = true;
        _error = null;
        try
        {
            var hours = int.TryParse(_timeRange, out var h) ? h : 24;
            var fromUtc = DateTimeOffset.UtcNow.AddHours(-hours);
            var next = await Client.GetAuditTimelineAsync(
                fromUtc: fromUtc,
                toUtc: null,
                actor: string.IsNullOrWhiteSpace(_actorFilter) ? null : _actorFilter.Trim(),
                actionPrefix: string.IsNullOrEmpty(_actionPrefix) ? null : _actionPrefix,
                outcome: string.IsNullOrWhiteSpace(_outcomeFilter) ? null : _outcomeFilter.Trim(),
                moduleId: string.IsNullOrWhiteSpace(QueryModuleId) ? null : QueryModuleId.Trim(),
                scheduleId: string.IsNullOrWhiteSpace(QueryScheduleId) ? null : QueryScheduleId.Trim(),
                runId: string.IsNullOrWhiteSpace(QueryRunId) ? null : QueryRunId.Trim(),
                resourceContextId: string.IsNullOrWhiteSpace(_resourceContextFilter) ? null : _resourceContextFilter,
                pageSize: 50,
                continuationToken: _page.NextContinuationToken,
                cancellationToken: default);
            _page = new AuditTimelinePageDto(
                _page.Items.Concat(next.Items).ToList(),
                next.NextContinuationToken);
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            _forbidden = true;
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void ToggleExpand(string id)
    {
        _expandedId = _expandedId == id ? null : id;
    }

    private string FmtWhen(DateTimeOffset dt) =>
        dt.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");

}
