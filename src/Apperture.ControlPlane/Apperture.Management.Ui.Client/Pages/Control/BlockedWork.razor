@page "/control/blocked-work"
@using Apperture.Management.Ui.Client.Molecules
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Shared
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities
@inject NavigationManager Nav

<div class="p-4 ui-page-stack">
    <div class="flex items-center justify-between gap-3">
        <div class="min-w-0">
            <h1 class="text-xl font-semibold text-heading">Blocked Work</h1>
            <div class="text-xs text-muted">Blocked deferred work with remediation eligibility. Workflow items may be retried; operation items are inspection-only.</div>
        </div>
        <div class="ui-action-row">
            <select class="rounded border border-default bg-surface px-2 py-1 text-sm"
                    disabled="@_loading"
                    @bind="_windowHours"
                    @bind:after="RefreshAsync">
                <option value="24">Last 24 hours</option>
                <option value="168">Last 7 days</option>
            </select>
            @if (_capabilities?.CanManageRecovery == true)
            {
                <button type="button"
                        class="ui-toolbar-btn"
                        disabled="@_loading"
                        @onclick="TriggerRunCycleAsync">
                    Trigger scheduler cycle
                </button>
            }
            <button type="button"
                    class="ui-toolbar-btn"
                    disabled="@_loading"
                    @onclick="RefreshAsync">
                Refresh
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <ErrorState Message="@_error" />
    }
    else if (_items is null && string.IsNullOrEmpty(_actionMessage))
    {
        <LoadingState Message="Loading…" />
    }
    else
    {
        @if (!string.IsNullOrEmpty(_actionMessage))
        {
            <ActionFeedback Message="@_actionMessage">
                @if (!string.IsNullOrEmpty(_newRunId))
                {
                    <div class="mt-2">
                        <a href="@($"/runs/{_newRunId}")" class="underline font-mono text-xs">Open new run: @_newRunId</a>
                    </div>
                }
            </ActionFeedback>
        }

        @if (_items is { Count: 0 })
        {
            <EmptyState Message="No blocked work in the selected window." />
        }
        else if (_items is not null)
        {
        <div class="ui-data-table mt-4">
            <table class="ui-data-table__table min-w-full text-left text-body">
                <thead class="border-b border-default text-xs text-muted">
                    <tr>
                        <th class="px-3 py-2">Type</th>
                        <th class="px-3 py-2">Run</th>
                        <th class="px-3 py-2">Definition</th>
                        <th class="px-3 py-2">Module</th>
                        <th class="px-3 py-2">Blocked reason</th>
                        <th class="px-3 py-2">Retry eligible</th>
                        <th class="px-3 py-2">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in _items)
                    {
                        <tr class="border-b border-default">
                            <td class="px-3 py-2 font-mono text-xs">@item.DefinitionKind</td>
                            <td class="px-3 py-2">
                                <a href="@($"/runs/{item.RunId}")" class="font-mono text-xs underline">@item.RunId</a>
                            </td>
                            <td class="px-3 py-2 font-mono text-xs">@item.DefinitionId</td>
                            <td class="px-3 py-2">
                                @if (!string.IsNullOrEmpty(item.ModuleId))
                                {
                                    <a href="@($"/modules/{item.ModuleId}")" class="font-mono text-xs underline">@item.ModuleId</a>
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }
                            </td>
                            <td class="px-3 py-2 text-xs">@item.BlockedReason</td>
                            <td class="px-3 py-2">
                                @{
                                    var retryDisplay = Epic33UiDisplayHelpers.GetBlockedWorkRetryEligibleDisplay(item);
                                    var isInspectionOnly = Epic33UiDisplayHelpers.ShowsInspectionOnly(item);
                                }
                                @if (isInspectionOnly)
                                {
                                    <span class="text-xs text-muted">@retryDisplay</span>
                                }
                                else if (retryDisplay == "Yes")
                                {
                                    <span class="text-xs font-semibold">@retryDisplay</span>
                                }
                                else
                                {
                                    <span class="text-xs text-muted">@retryDisplay</span>
                                }
                            </td>
                            <td class="px-3 py-2">
                                @switch (Epic33UiDisplayHelpers.GetBlockedWorkActionKind(item))
                                {
                                    case Epic33UiDisplayHelpers.BlockedWorkActionKind.Retry:
                                        @if (_capabilities?.CanManageRecovery == true)
                                        {
                                            <button class="rounded bg-surface-muted px-2 py-1 text-xs hover:bg-surface"
                                                    disabled="@_loading"
                                                    @onclick="() => RetryAsync(item.RunId)">
                                                Retry
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-xs text-muted">-</span>
                                        }
                                        break;
                                    case Epic33UiDisplayHelpers.BlockedWorkActionKind.ViewRun:
                                        <a href="@($"/runs/{item.RunId}")" class="text-xs underline">View run</a>
                                        break;
                                    default:
                                        <span class="text-xs text-muted">-</span>
                                        break;
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        <div class="mt-2 text-xs text-muted">
            <a href="@Epic33UiDisplayHelpers.GetRecoveryAuditLink()">View recovery audit</a>
        </div>
        }
    }
</div>

@code {
    private IReadOnlyList<BlockedWorkRemediationEntryDto>? _items;
    private OperatorCapabilitiesDto? _capabilities;
    private bool _loading;
    private string? _error;
    private string? _actionMessage;
    private string? _newRunId;
    private string _windowHours = "24";

    protected override async Task OnInitializedAsync()
    {
        await LoadCapabilitiesAsync();
        await LoadAsync();
    }

    private async Task LoadCapabilitiesAsync()
    {
        try
        {
            _capabilities = await Capabilities.GetCapabilitiesAsync();
        }
        catch
        {
            _capabilities = new OperatorCapabilitiesDto(false, false, false, false, false, false, false);
        }
    }

    private Task RefreshAsync() => LoadAsync();

    private async Task LoadAsync(bool preserveActionFeedback = false)
    {
        _loading = true;
        _error = null;
        if (!preserveActionFeedback)
        {
            _actionMessage = null;
            _newRunId = null;
        }
        try
        {
            var hours = int.TryParse(_windowHours, out var h) ? h : 24;
            _items = await Client.GetBlockedWorkAsync(windowHours: hours);
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task RetryAsync(string runId)
    {
        _loading = true;
        _actionMessage = null;
        _newRunId = null;
        try
        {
            var result = await Client.RetryBlockedWorkAsync(runId);
            if (result.Success)
            {
                _actionMessage = "Retry accepted.";
                _newRunId = result.NewRunId;
            }
            else
            {
                _actionMessage = result.InspectionOnly
                    ? "Operation retry is not supported. Inspection only."
                    : (result.ErrorMessage ?? "Retry failed.");
            }
        }
        catch (HttpRequestException ex)
        {
            _actionMessage = ex.Message;
        }
        finally
        {
            _loading = false;
        }
        await LoadAsync(preserveActionFeedback: true);
    }

    private async Task TriggerRunCycleAsync()
    {
        _loading = true;
        _actionMessage = null;
        try
        {
            await Client.TriggerSchedulerRunCycleAsync();
            _actionMessage = "Scheduler cycle triggered. Global re-evaluation for all schedules.";
        }
        catch (HttpRequestException ex)
        {
            _actionMessage = ex.Message;
        }
        finally
        {
            _loading = false;
        }
        await LoadAsync(preserveActionFeedback: true);
    }
}
