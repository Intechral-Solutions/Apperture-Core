@using Apperture.Management.Client
@using Apperture.Management.Ui.Shared
@using Apperture.Management.Ui.Client.Molecules
@using Apperture.Management.Ui.Client.Organisms

<ManagementSection Title="Summary"
                   Layer="ManagementSection.UiLayer.Summary"
                   Help="Facts from the run record and forensics; links use the same destinations as before.">
    <div class="flex flex-wrap items-center gap-2">
        <StatusPill Label="@Detail.Status" Semantic="@ManagementUiSemantics.MapRunLifecycleStatus(Detail.Status)" />
        @if (Detail.Result is not null && !string.IsNullOrWhiteSpace(Detail.Result.Outcome))
        {
            <StatusPill Label="@($"Outcome: {Detail.Result.Outcome}")"
                        Semantic="@ManagementUiSemantics.MapRunOutcomeSemantic(Detail.Result.Outcome)" />
        }
        @if (BlockedWork is not null)
        {
            <AttentionPill Label="Blocked work" Semantic="@ManagementAttentionSemantic.Warning" />
        }
    </div>

    @{
        var attentionReason = RunScheduleOperatorUiHelpers.BuildRunAttentionReason(Detail);
    }
    @if (!string.IsNullOrWhiteSpace(attentionReason))
    {
        <div class="mt-3 text-sm text-body">@attentionReason</div>
    }

    @if (!string.IsNullOrWhiteSpace(Detail.ProcedureId))
    {
        <div class="mt-2 text-sm text-body">
            <span class="text-xs text-muted">Procedure</span>
            <span class="ml-1 font-mono text-xs">@Detail.ProcedureId</span>
        </div>
    }
    else if (!string.IsNullOrWhiteSpace(Detail.ExecutionDefinitionId))
    {
        <div class="mt-2 text-sm text-body">
            <span class="text-xs text-muted">@RunScheduleOperatorUiHelpers.FormatExecutionKindLabel(Detail.ExecutionKind)</span>
            <span class="ml-1 font-mono text-xs">@Detail.ExecutionDefinitionId</span>
        </div>
    }

    @if (Detail.ForensicContext is { } fx)
    {
        <div class="mt-3 text-sm text-body">
            <span class="text-xs text-muted">Origin</span>
            <span class="ml-1">@Epic33UiDisplayHelpers.FormatRunOriginKind(fx.OriginKind)</span>
            @if (!string.IsNullOrWhiteSpace(fx.OriginDetail))
            {
                <span class="text-xs text-muted"> — @fx.OriginDetail</span>
            }
        </div>
    }

    @if (Detail.StartRequestedAt is not null)
    {
        <div class="mt-2 text-xs text-muted">
            Requested <TimestampDisplay Value="@Detail.StartRequestedAt" ShowUtcDetail="true" />
        </div>
    }

    <div class="mt-3">
        <MetadataGrid ThreeColumn="true">
            <MetadataItem Label="Created">
                <TimestampDisplay Value="@Detail.CreatedAt" ShowUtcDetail="true" />
            </MetadataItem>
            <MetadataItem Label="Completed">
                <TimestampDisplay Value="@Detail.CompletedAt" ShowUtcDetail="true" />
            </MetadataItem>
            <MetadataItem Label="@CurrentStepLabel" Monospace="true" Value="@Detail.CurrentStepName" />
        </MetadataGrid>
    </div>

    <div class="ui-summary-card-grid">
        @if (!string.IsNullOrEmpty(Detail.IntegrationId))
        {
            <ManagementSummaryCard Title="Integration"
                                   Description="Open the deployment unit for this run."
                                   Href="@($"/integrations/{Uri.EscapeDataString(Detail.IntegrationId)}")" />
        }
        @if (Detail.ForensicContext is { ScheduleId: { } sid } && !string.IsNullOrEmpty(sid))
        {
            <ManagementSummaryCard Title="Schedule (inferred)"
                                   Description="May be inferred from idempotency convention; see Investigation."
                                   Href="@($"/schedules/{Uri.EscapeDataString(sid)}")" />
        }
        <ManagementSummaryCard Title="Audit timeline"
                               Description="Events for this run id."
                               Href="@Epic33UiDisplayHelpers.GetAuditLinkForRun(RunId)" />
        <ManagementSummaryCard Title="Blocked work"
                               Description="Recovery and retry eligibility."
                               Href="@RunStatusFacets.BlockedRunsHref" />
        @if (!string.IsNullOrWhiteSpace(Detail.CorrelationKey))
        {
            <ManagementSummaryCard Title="Runs with same correlation"
                                   Description="Filtered run history."
                                   Href="@Epic33UiDisplayHelpers.GetRunsListCorrelationFilterHref(Detail.CorrelationKey)" />
        }
    </div>
</ManagementSection>

@code {
    [Parameter, EditorRequired] public RunDetailDto Detail { get; set; } = null!;
    [Parameter, EditorRequired] public string RunId { get; set; } = "";
    [Parameter] public BlockedWorkRemediationEntryDto? BlockedWork { get; set; }

    [Parameter] public string CurrentStepLabel { get; set; } = "Current step";
}
