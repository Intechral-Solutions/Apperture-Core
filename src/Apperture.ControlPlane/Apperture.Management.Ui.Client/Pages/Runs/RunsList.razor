@page "/runs"
@using Apperture.Management.Client
@using Apperture.Management.Ui.Shared
@using Apperture.Management.Ui.Client.Organisms
@using Apperture.Management.Ui.Client.Molecules
@using Apperture.Management.Ui.Client.Services
@using Microsoft.AspNetCore.Components
@using System.Globalization
@implements IDisposable
@inject IManagementClient Client
@inject NavigationManager Nav
@inject IOperatorDisplayTimeZone DisplayTimeZone

<div class="p-4 ui-page-stack">
    <PageHeader Eyebrow="Automation"
                Title="Runs"
                Subtitle="Run history and remediation. Prioritize failures and recent outcomes; open a row for actions and diagnostics.">
        <Toolbar>
            <label class="flex items-center gap-2 text-sm text-body">
                <input type="checkbox" class="h-4 w-4" @bind="_showProblemsOnly" />
                Needs attention
            </label>
            <button type="button"
                    class="ui-toolbar-btn"
                    disabled="@_loading"
                    @onclick="LoadAsync">
                Refresh
            </button>
        </Toolbar>
    </PageHeader>

    @if (_error is not null)
    {
        <ErrorState Message="@_error" />
    }
    else if (_runs is null)
    {
        <LoadingState />
    }
    else if (_runs.Count == 0)
    {
        @if (HasUrlFilters)
        {
            <EmptyState Title="No matches"
                        Message="No runs match the current filters. Clear filters or adjust criteria.">
                <a href="/runs" class="mt-3 inline-block ui-toolbar-btn">Clear filters</a>
            </EmptyState>
        }
        else
        {
            <EmptyState Title="No runs yet"
                        Message="Runs appear here after workflows or operations execute. Check Control Center for live signals or open an integration to start work." />
        }
    }
    else if (!DisplayRuns.Any())
    {
        <EmptyState Title="Nothing needs attention"
                    Message="All visible runs look healthy under the current filter.">
            <button type="button" class="mt-3 ui-toolbar-btn" @onclick="ShowAllRuns">Show all runs</button>
        </EmptyState>
    }
    else
    {
        <ManagementSection Title="Summary"
                           Layer="ManagementSection.UiLayer.Summary"
                           Help="Counts from loaded rows; server filters may narrow the set.">
            <div class="flex flex-wrap items-center gap-2">
                <StatusPill Label="@($"{DisplayRuns.Count()} run(s)")" Semantic="@ManagementStatusSemantic.Neutral" />
                @{
                    var problemCount = RunScheduleOperatorUiHelpers.CountProblematicRuns(_runs);
                }
                @if (problemCount > 0)
                {
                    <AttentionPill Label="@($"{problemCount} need attention")" Semantic="@ManagementAttentionSemantic.Warning" />
                }
                else
                {
                    <StatusPill Label="No failures in view" Semantic="@ManagementStatusSemantic.Success" />
                }
            </div>

            <div class="ui-summary-card-grid ui-summary-card-grid--wide">
                <ManagementSummaryCard Title="Control Center"
                                       Description="Live platform signals and recent problems."
                                       Href="/control/center" />
                <ManagementSummaryCard Title="Schedules"
                                       Description="Timing, outcomes, and schedule health."
                                       Href="/schedules" />
                <ManagementSummaryCard Title="Blocked work"
                                       Description="Deferred runs and retry recovery."
                                       Href="/control/blocked-work" />
                <ManagementSummaryCard Title="Integrations"
                                       Description="Deployment units owning workflows and procedures."
                                       Href="/integrations" />
            </div>
        </ManagementSection>

        <ManagementSection Title="Run history"
                           Layer="ManagementSection.UiLayer.Detail">
            <div class="ui-data-table">
                <table class="ui-data-table__table min-w-full text-left text-body">
                    <thead class="border-b border-default text-xs text-muted">
                        <tr>
                            <th class="px-3 py-2">Outcome</th>
                            <th class="px-3 py-2">Context</th>
                            <th class="px-3 py-2">When</th>
                            <th class="px-3 py-2">Links</th>
                            <th class="px-3 py-2"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in DisplayRuns)
                        {
                            var scheduleId = RunScheduleOperatorUiHelpers.TryGetScheduleIdFromCorrelation(r.CorrelationKey);
                            <tr class="border-b border-default hover:bg-surface-muted cursor-pointer"
                                @onclick="() => Open(r.RunId)">
                                <td class="px-3 py-2">
                                    <StatusPill Label="@r.Status"
                                                Semantic="@ManagementUiSemantics.MapRunLifecycleStatus(r.Status)" />
                                </td>
                                <td class="px-3 py-2">
                                    <div class="text-sm text-body">@RunScheduleOperatorUiHelpers.FormatRunListContextLine(r)</div>
                                    @if (!string.IsNullOrWhiteSpace(r.IntegrationId))
                                    {
                                        <DrillInLink Href="@Epic33UiDisplayHelpers.GetRunsListIntegrationFilterHref(r.IntegrationId)"
                                                     @onclick:stopPropagation="true">
                                            Integration @r.IntegrationId
                                        </DrillInLink>
                                    }
                                </td>
                                <td class="px-3 py-2 text-sm">@FormatWhen(r)</td>
                                <td class="px-3 py-2">
                                    <div class="flex flex-wrap gap-2 text-xs">
                                        @if (!string.IsNullOrWhiteSpace(r.IntegrationId))
                                        {
                                            <DrillInLink Href="@($"/integrations/{Uri.EscapeDataString(r.IntegrationId)}")"
                                                         @onclick:stopPropagation="true">Integration</DrillInLink>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(scheduleId))
                                        {
                                            <DrillInLink Href="@($"/schedules/{Uri.EscapeDataString(scheduleId)}")"
                                                         @onclick:stopPropagation="true">Schedule</DrillInLink>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(r.CorrelationKey))
                                        {
                                            <DrillInLink Href="@Epic33UiDisplayHelpers.GetRunsListCorrelationFilterHref(r.CorrelationKey)"
                                                         @onclick:stopPropagation="true">Correlation</DrillInLink>
                                        }
                                    </div>
                                </td>
                                <td class="px-3 py-2">
                                    <DrillInLink Href="@($"/runs/{Uri.EscapeDataString(r.RunId)}")"
                                                 @onclick:stopPropagation="true">Open</DrillInLink>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </ManagementSection>

        <ManagementAdvancedSection Title="Filters and diagnostics"
                                   Subtitle="Execution kind, URL query filters, and row identifiers."
                                   InitiallyOpen="@HasUrlFilters">
            <div class="grid grid-cols-1 gap-3 md:grid-cols-2">
                <div>
                    <label class="block text-xs text-muted">Execution kind</label>
                    <select class="mt-1 w-full rounded border border-default bg-surface px-2 py-2 text-sm"
                            disabled="@_loading"
                            @bind="_executionKindFilter"
                            @bind:after="LoadAsync">
                        <option value="">All executions</option>
                        <option value="operation">Operations</option>
                        <option value="workflow">Workflows</option>
                    </select>
                </div>
            </div>

            @if (HasUrlFilters)
            {
                <div class="mt-3 rounded border border-default bg-surface-muted px-3 py-2 text-sm text-body space-y-1">
                    @if (!string.IsNullOrWhiteSpace(QueryCorrelationKey))
                    {
                        <div>
                            <span class="text-muted">Correlation key</span>
                            <span class="ml-2 font-mono text-xs break-all">@QueryCorrelationKey</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(QueryStatus))
                    {
                        <div>
                            <span class="text-muted">Status</span>
                            <span class="ml-2 font-mono text-xs">@QueryStatus</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(QueryCreatedFromRaw))
                    {
                        <div>
                            <span class="text-muted">Created from (UTC)</span>
                            <span class="ml-2 font-mono text-xs break-all">@QueryCreatedFromRaw</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(QueryIntegrationId))
                    {
                        <div>
                            <span class="text-muted">Integration</span>
                            <span class="ml-2 font-mono text-xs break-all">@QueryIntegrationId</span>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(QueryModuleId))
                    {
                        <div>
                            <span class="text-muted">Module</span>
                            <span class="ml-2 font-mono text-xs break-all">@QueryModuleId</span>
                        </div>
                    }
                    <div>
                        <a href="/runs" class="text-xs underline">Clear URL filters</a>
                    </div>
                </div>
            }

            <details class="mt-3">
                <summary class="cursor-pointer text-xs text-muted">Row identifiers (all loaded runs)</summary>
                <div class="mt-2 space-y-1 text-xs font-mono text-muted">
                    @foreach (var r in DisplayRuns)
                    {
                        <div>@r.RunId · @r.ExecutionDefinitionId · @(r.CorrelationKey ?? "-") · @(r.RetryOfRunId ?? "-")</div>
                    }
                </div>
            </details>
        </ManagementAdvancedSection>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "correlationKey")]
    public string? QueryCorrelationKey { get; set; }

    [SupplyParameterFromQuery(Name = "status")]
    public string? QueryStatus { get; set; }

    [SupplyParameterFromQuery(Name = "createdFrom")]
    public string? QueryCreatedFromRaw { get; set; }

    [SupplyParameterFromQuery(Name = "integrationId")]
    public string? QueryIntegrationId { get; set; }

    [SupplyParameterFromQuery(Name = "moduleId")]
    public string? QueryModuleId { get; set; }

    private IReadOnlyList<RunSummaryDto>? _runs;
    private string? _executionKindFilter;
    private bool _loading;
    private bool _showProblemsOnly;
    private string? _error;
    private string? _dataLoadKey;

    protected override async Task OnInitializedAsync()
    {
        DisplayTimeZone.Changed += OnDisplayZoneChanged;
        await DisplayTimeZone.EnsureResolvedAsync();
    }

    private void OnDisplayZoneChanged() => _ = InvokeAsync(StateHasChanged);

    private string FormatWhen(RunSummaryDto run) =>
        RunScheduleOperatorUiHelpers.FormatRunListWhenLine(
            run,
            DisplayTimeZone.TimeZoneId,
            DisplayTimeZone.Source);

    private bool HasUrlFilters =>
        !string.IsNullOrWhiteSpace(QueryCorrelationKey)
        || !string.IsNullOrWhiteSpace(QueryStatus)
        || !string.IsNullOrWhiteSpace(QueryCreatedFromRaw)
        || !string.IsNullOrWhiteSpace(QueryIntegrationId)
        || !string.IsNullOrWhiteSpace(QueryModuleId);

    private IEnumerable<RunSummaryDto> DisplayRuns
    {
        get
        {
            if (_runs is null)
                return [];

            var sorted = RunScheduleOperatorUiHelpers.SortRunsForTriage(_runs);
            if (!_showProblemsOnly)
                return sorted;

            return sorted.Where(RunScheduleOperatorUiHelpers.RunNeedsAttention);
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        var key = BuildLoadKey();
        if (key == _dataLoadKey)
            return;
        await LoadAsync();
    }

    private string BuildLoadKey() =>
        $"{QueryCorrelationKey ?? ""}\u001f{QueryStatus ?? ""}\u001f{QueryCreatedFromRaw ?? ""}\u001f{QueryIntegrationId ?? ""}\u001f{QueryModuleId ?? ""}\u001f{_executionKindFilter ?? ""}";

    private void ShowAllRuns() => _showProblemsOnly = false;

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            var corr = string.IsNullOrWhiteSpace(QueryCorrelationKey) ? null : QueryCorrelationKey.Trim();
            var status = string.IsNullOrWhiteSpace(QueryStatus) ? null : QueryStatus.Trim();
            var integrationId = string.IsNullOrWhiteSpace(QueryIntegrationId) ? null : QueryIntegrationId.Trim();
            var moduleId = string.IsNullOrWhiteSpace(QueryModuleId) ? null : QueryModuleId.Trim();
            DateTimeOffset? createdFrom = null;
            if (!string.IsNullOrWhiteSpace(QueryCreatedFromRaw)
                && DateTimeOffset.TryParse(QueryCreatedFromRaw, CultureInfo.InvariantCulture, DateTimeStyles.RoundtripKind, out var parsed))
                createdFrom = parsed;

            _runs = await Client.GetRunsAsync(new RunQueryFilter(
                ExecutionKind: _executionKindFilter,
                Status: status,
                CreatedFrom: createdFrom,
                CorrelationKey: corr,
                IntegrationId: integrationId,
                ModuleId: moduleId));
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            _runs = Array.Empty<RunSummaryDto>();
            _error = "Not authorized to view runs (403).";
        }
        catch (Exception ex)
        {
            _runs = Array.Empty<RunSummaryDto>();
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            _dataLoadKey = BuildLoadKey();
        }
    }

    private void Open(string runId) => Nav.NavigateTo($"/runs/{runId}");

    public void Dispose() => DisplayTimeZone.Changed -= OnDisplayZoneChanged;
}
