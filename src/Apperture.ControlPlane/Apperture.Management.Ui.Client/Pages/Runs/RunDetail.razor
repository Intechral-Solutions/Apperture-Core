@page "/runs/{RunId}"
@using Apperture.Management.Client
@using Apperture.Management.Ui.Shared
@using System.Linq
@using Apperture.Management.Ui.Client.Molecules
@using Apperture.Management.Ui.Client.Organisms
@inject IManagementClient Client
@inject NavigationManager Nav
@implements IDisposable

<div class="p-4 ui-page-stack">
    <PageHeader Eyebrow="Runs"
                Title="Run"
                Subtitle="@RunHeaderSubtitle">
        <ChildContent>
            <div class="mt-1 font-mono text-xs text-muted break-all">@RunId</div>
        </ChildContent>
        <Toolbar>
            <button type="button"
                    class="ui-toolbar-btn"
                    disabled="@(!CanInvoke("execution.cancel"))"
                    title="@ActionReason("execution.cancel")"
                    @onclick="CancelAsync">
                Cancel
            </button>
            <button type="button"
                    class="ui-toolbar-btn"
                    disabled="@(!CanInvoke("execution.retry"))"
                    title="@ActionReason("execution.retry")"
                    @onclick="RetryAsync">
                Retry (new run)
            </button>
            <button type="button"
                    class="ui-toolbar-btn"
                    disabled="@(!CanInvoke("execution.park"))"
                    title="@ActionReason("execution.park")"
                    @onclick="ParkAsync">
                Park
            </button>
            <button type="button"
                    class="ui-toolbar-btn"
                    disabled="@(!CanInvoke("execution.resume"))"
                    title="@ActionReason("execution.resume")"
                    @onclick="ResumeAsync">
                Resume
            </button>
            <label class="flex items-center gap-2 text-sm text-body">
                <input type="checkbox" class="h-4 w-4" @bind="_pollingEnabled" />
                Poll
            </label>
            <button type="button"
                    class="ui-toolbar-btn"
                    disabled="@_loading"
                    @onclick="RefreshAsync">
                Refresh
            </button>
        </Toolbar>
    </PageHeader>

    @if (_error is not null)
    {
        <ErrorState Message="@_error" />
    }
    else if (_detail is null)
    {
        <LoadingState />
    }
    else
    {
        @if (!string.IsNullOrEmpty(_actionMessage))
        {
            <ActionFeedback Message="@_actionMessage">
                @if (!string.IsNullOrEmpty(_newRunId))
                {
                    <div class="mt-2">
                        <DrillInLink Href="@($"/runs/{_newRunId}")">Open new run: @_newRunId</DrillInLink>
                    </div>
                }
            </ActionFeedback>
        }

        <RunSummaryBand Detail="@_detail"
                        RunId="@RunId"
                        BlockedWork="@_blockedWork"
                        CurrentStepLabel="@CurrentStepLabel" />

        @if (_detail.ForensicContext is { } fxInv)
        {
            <ManagementSection Title="Investigation"
                               Layer="ManagementSection.UiLayer.Detail"
                               Help="Run forensics from persisted data and platform conventions (Epic 35).">
                <div class="grid grid-cols-1 gap-2 md:grid-cols-2">
                    <div>
                        <div class="text-xs text-muted">Outcome (derived)</div>
                        <div class="text-sm text-body">@(_detail.Result?.Outcome ?? "—")</div>
                    </div>
                    <div>
                        <div class="text-xs text-muted">Origin</div>
                        <div class="text-sm text-body">@Epic33UiDisplayHelpers.FormatRunOriginKind(fxInv.OriginKind)</div>
                        <div class="text-xs text-muted mt-1">@fxInv.OriginDetail</div>
                    </div>
                    @if (!string.IsNullOrEmpty(fxInv.ModuleId))
                    {
                        <div>
                            <div class="text-xs text-muted">@Epic33UiDisplayHelpers.RunForensicModuleLabel</div>
                            <DrillInLink Href="@($"/modules/{fxInv.ModuleId}")">@fxInv.ModuleId</DrillInLink>
                        </div>
                    }
                    @if (fxInv.ModuleExecutableNow is not null)
                    {
                        <div>
                            <div class="text-xs text-muted">Module state (current snapshot)</div>
                            <div class="text-sm text-body">@(fxInv.ModuleExecutableNow == true ? "Effectively executable" : "Not effectively executable")</div>
                            @if (!string.IsNullOrEmpty(fxInv.ModuleExecutionHint))
                            {
                                <div class="text-xs text-muted mt-1">@fxInv.ModuleExecutionHint</div>
                            }
                            <div class="text-xs text-muted mt-1">Reflects composition now, not necessarily at run start.</div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(fxInv.ScheduleId))
                    {
                        <div class="md:col-span-2">
                            <div class="text-xs text-muted">Schedule (inferred)</div>
                            <DrillInLink Href="@($"/schedules/{fxInv.ScheduleId}")">@fxInv.ScheduleId</DrillInLink>
                            @if (fxInv.ScheduleFireTimeUtc is not null)
                            {
                                <span class="text-xs text-muted ml-2">fire @fxInv.ScheduleFireTimeUtc.Value.ToLocalTime().ToString("u")</span>
                            }
                            <div class="text-xs text-muted mt-1">@Epic33UiDisplayHelpers.RunScheduleInferenceDisclaimer</div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(_detail.RetryOfRunId))
                    {
                        <div>
                            <div class="text-xs text-muted">Retry of</div>
                            <DrillInLink Href="@($"/runs/{_detail.RetryOfRunId}")">@_detail.RetryOfRunId</DrillInLink>
                        </div>
                    }
                    @if (fxInv.RetriedByRunIds.Count > 0)
                    {
                        <div class="md:col-span-2">
                            <div class="text-xs text-muted">Retried by (new runs)</div>
                            <div class="flex flex-wrap gap-2 mt-1">
                                @foreach (var rid in fxInv.RetriedByRunIds)
                                {
                                    <DrillInLink Href="@($"/runs/{rid}")">@rid</DrillInLink>
                                }
                            </div>
                        </div>
                    }
                </div>
                <div class="mt-3 text-xs font-semibold text-heading">Investigate next</div>
                <div class="mt-1 flex flex-wrap gap-2">
                    @foreach (var h in fxInv.InvestigationHints)
                    {
                        var href = Epic33UiDisplayHelpers.GetRunInvestigationHintHref(h.Kind, h.TargetId);
                        if (href == "#") { continue; }
                        <DrillInLink Href="@href">@FormatInvestigationHintLabel(h)</DrillInLink>
                    }
                </div>
            </ManagementSection>
        }

        <ManagementSection Title="Action availability"
                           Layer="ManagementSection.UiLayer.Detail"
                           Help="Server-projected action eligibility for this run.">
            @if (_actions.Count == 0)
            {
                <EmptyState Message="No actions available." />
            }
            else
            {
                <div class="grid grid-cols-1 gap-2 md:grid-cols-2">
                    @foreach (var action in _actions.OrderBy(x => x.ActionKind, StringComparer.Ordinal))
                    {
                        <div class="rounded border border-default bg-surface-muted px-2 py-2">
                            <div class="text-xs font-mono text-body">@action.ActionKind</div>
                            <div class="text-xs text-muted">@action.AvailabilityState</div>
                            @if (!string.IsNullOrWhiteSpace(action.ReasonCode))
                            {
                                <div class="text-xs text-muted">@action.ReasonCode</div>
                            }
                        </div>
                    }
                </div>
            }
        </ManagementSection>

        <ManagementSection Title="Related context"
                           Layer="ManagementSection.UiLayer.Detail"
                           Help="Linked operational context and audit.">
            <div class="flex flex-wrap gap-2">
                <DrillInLink Href="@Epic33UiDisplayHelpers.GetAuditLinkForRun(RunId)">View audit for this run</DrillInLink>
                <DrillInLink Href="/control/blocked-work">Blocked work / recovery</DrillInLink>
            </div>
            @if (_blockedWork is not null)
            {
                <div class="mt-2 rounded border border-default bg-surface-muted p-2">
                    <div class="text-xs font-semibold">Blocked work context</div>
                    <div class="text-xs text-muted">@_blockedWork.BlockedReason</div>
                    @if (_blockedWork.RetryEligibleNow && string.Equals(_blockedWork.DefinitionKind, "workflow", StringComparison.OrdinalIgnoreCase))
                    {
                        <DrillInLink Href="/control/blocked-work">Retry from Blocked Work page</DrillInLink>
                    }
                    else if (!string.IsNullOrEmpty(_blockedWork.RetryEligibleReason))
                    {
                        <div class="text-xs text-muted">@_blockedWork.RetryEligibleReason</div>
                    }
                    @if (!string.IsNullOrEmpty(_blockedWork.ModuleId))
                    {
                        <DrillInLink Href="@($"/modules/{_blockedWork.ModuleId}")">Module @_blockedWork.ModuleId</DrillInLink>
                    }
                </div>
            }
        </ManagementSection>

        <ManagementSection Title="Execution overview"
                           Layer="ManagementSection.UiLayer.Detail"
                           Help="@CurrentStepHelp">
            <div class="grid grid-cols-1 gap-2 md:grid-cols-2">
                <div>
                    <div class="text-xs text-muted">@CurrentStepLabel</div>
                    <div class="text-sm font-mono">@_detail.CurrentStepName</div>
                </div>
                @if (!string.IsNullOrEmpty(_detail.IntegrationId))
                {
                    <div>
                        <div class="text-xs text-muted">Integration</div>
                        <div class="text-sm font-mono break-all">
                            <DrillInLink Href="@($"/integrations/{_detail.IntegrationId}")">@_detail.IntegrationId</DrillInLink>
                        </div>
                    </div>
                }
                @if (!string.IsNullOrEmpty(_detail.ProcedureId))
                {
                    <div>
                        <div class="text-xs text-muted">Procedure</div>
                        <div class="text-sm font-mono break-all">@_detail.ProcedureId</div>
                    </div>
                }
            </div>
        </ManagementSection>

        <ManagementAdvancedSection Title="Technical identifiers and start request"
                                   Subtitle="Execution ids, correlation, idempotency, and persisted start metadata (ADR-0031).">
            <div class="grid grid-cols-1 gap-2 md:grid-cols-2">
                <div>
                    <div class="text-xs text-muted">Lifecycle status</div>
                    <div class="text-sm text-body">@_detail.Status</div>
                </div>
                <div>
                    <div class="text-xs text-muted">@(_detail.ExecutionKind == "operation" ? "Operation definition" : "Workflow definition")</div>
                    <div class="text-sm font-mono break-all">@_detail.ExecutionDefinitionId</div>
                </div>
                <div>
                    <div class="text-xs text-muted">@(_detail.ExecutionKind == "operation" ? "Operation instance" : "Workflow instance")</div>
                    <div class="text-sm font-mono break-all">@_detail.ExecutionInstanceId</div>
                </div>
                <div>
                    <div class="text-xs text-muted">Correlation key</div>
                    <div class="text-sm text-body break-all">@_detail.CorrelationKey</div>
                </div>
                <div>
                    <div class="text-xs text-muted">Retry of</div>
                    <div class="text-sm font-mono break-all">
                        @if (!string.IsNullOrEmpty(_detail.RetryOfRunId))
                        {
                            <DrillInLink Href="@($"/runs/{_detail.RetryOfRunId}")">@_detail.RetryOfRunId</DrillInLink>
                        }
                    </div>
                </div>
            </div>

            <div class="mt-4 rounded border border-default bg-surface-muted/30 p-3">
                <div class="text-sm font-semibold text-heading">Start request</div>
                <div class="text-xs text-muted">Persisted start metadata for this execution run.</div>
                <div class="mt-2 grid grid-cols-1 gap-2 md:grid-cols-2">
                    @if (!string.IsNullOrWhiteSpace(_detail.IntegrationId))
                    {
                        <div>
                            <div class="text-xs text-muted">Integration</div>
                            <div class="text-sm font-mono break-all">@_detail.IntegrationId</div>
                        </div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_detail.ProcedureId))
                    {
                        <div>
                            <div class="text-xs text-muted">Procedure</div>
                            <div class="text-sm font-mono break-all">@_detail.ProcedureId</div>
                        </div>
                    }
                    <div>
                        <div class="text-xs text-muted">Requested</div>
                        <div class="text-sm text-body">@Fmt(_detail.StartRequestedAt)</div>
                    </div>
                    <div>
                        <div class="text-xs text-muted">Claimed</div>
                        <div class="text-sm text-body">@Fmt(_detail.StartClaimedAt)</div>
                    </div>
                    <div>
                        <div class="text-xs text-muted">Idempotency key</div>
                        <div class="text-sm font-mono break-all">@_detail.StartIdempotencyKey</div>
                    </div>
                    <div>
                        <div class="text-xs text-muted">Correlation id</div>
                        <div class="text-sm font-mono break-all">@_detail.StartCorrelationId</div>
                    </div>
                    <div>
                        <div class="text-xs text-muted">Claimed by</div>
                        <div class="text-sm text-body">@_detail.StartClaimedBy</div>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(_detail.StartParametersJson))
                {
                    <div class="mt-2">
                        <div class="text-xs text-muted">Start parameters (JSON)</div>
                        <div class="mt-1 text-xs text-muted">
                            Full payload persisted on the start request after validation (ADR-0031). Intended for non-secret operational inputs; secret-bearing .NET types are rejected at launch. Plain strings are not redacted—do not put secrets here. May include PII or business data; a future sensitive-field model could change visibility.
                        </div>
                        <pre class="mt-1 max-h-64 overflow-auto rounded border border-default bg-surface-muted p-2 text-xs text-body"><code>@_detail.StartParametersJson</code></pre>
                    </div>
                }
            </div>
        </ManagementAdvancedSection>

        <ManagementSection Title="Result"
                           Layer="ManagementSection.UiLayer.Detail"
                           Subtitle="Outcome, summary, and captured output from persisted execution.">
                <div class="grid grid-cols-1 gap-2 md:grid-cols-2">
                    <div>
                        <div class="text-xs text-muted">Outcome</div>
                        <div class="text-sm text-body">@_detail.Result?.Outcome</div>
                    </div>
                    <div>
                        <div class="text-xs text-muted">Summary</div>
                        <div class="text-sm text-body">@_detail.Result?.Summary</div>
                    </div>
                    <div>
                        <div class="text-xs text-muted">Output availability</div>
                        <div class="text-sm font-mono text-body">@(_detail.Result?.OutputAvailability ?? "none")</div>
                    </div>
                    @if (!string.IsNullOrEmpty(_detail.Result?.OutputDisplayPolicy))
                    {
                        <div>
                            <div class="text-xs text-muted">Output display policy</div>
                            <div class="text-sm font-mono text-body">@_detail.Result.OutputDisplayPolicy</div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(_detail.Result?.DiagnosticsAvailability))
                    {
                        <div>
                            <div class="text-xs text-muted">Diagnostics availability</div>
                            <div class="text-sm font-mono text-body">@_detail.Result.DiagnosticsAvailability</div>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(_detail.Result?.DiagnosticsDisplayPolicy))
                    {
                        <div>
                            <div class="text-xs text-muted">Diagnostics display policy</div>
                            <div class="text-sm font-mono text-body">@_detail.Result.DiagnosticsDisplayPolicy</div>
                        </div>
                    }
                </div>
                @if (_detail.Error is not null)
                {
                    <div class="mt-2 rounded border border-default bg-surface-muted px-2 py-2">
                        <div class="text-xs text-muted">Failure</div>
                        <div class="text-sm text-body">@_detail.Error.Category: @_detail.Error.Message</div>
                        @if (!string.IsNullOrWhiteSpace(_detail.Error.DetailsJson))
                        {
                            <div class="text-xs font-mono break-all text-muted">@_detail.Error.DetailsJson</div>
                        }
                        else if (HasNoDiagnostics)
                        {
                            <div class="text-xs text-muted">No failure diagnostics were captured for this run.</div>
                        }
                        else if (HasUnsupportedDiagnostics)
                        {
                            <div class="text-xs text-muted">Failure diagnostics could not be captured in a supported inline form.</div>
                        }
                        else if (HasSummaryOnlyDiagnostics)
                        {
                            <div class="text-xs text-muted">Detailed diagnostics are summary-only for this failure.</div>
                        }
                        else if (HasWithheldDiagnostics)
                        {
                            <div class="text-xs text-muted">Diagnostics were withheld for this failure.</div>
                        }
                    </div>
                }
                @if (HasDisplayableOutput)
                {
                    <div class="mt-2">
                        <div class="text-xs text-muted">Captured output</div>
                        @if (IsTruncated)
                        {
                            <div class="text-xs text-muted">Output was truncated at persistence.</div>
                        }
                        <pre class="mt-1 max-h-64 overflow-auto rounded border border-default bg-surface-muted p-2 text-xs text-body"><code>@_detail.Result?.PayloadJson</code></pre>
                    </div>
                }
                else if (IsSummaryOnlyOutput)
                {
                    <div class="mt-2 text-sm text-muted">Inline JSON was not stored (module summary-only policy). See Summary above.</div>
                }
                else if (ShowOutputUnavailable)
                {
                    <div class="mt-2 text-sm text-muted">@OutputUnavailableMessage</div>
                }
        </ManagementSection>

        <ManagementSection Title="Execution timeline"
                           Layer="ManagementSection.UiLayer.Detail"
                           Subtitle="Canonical ordered history projected from persisted execution artifacts.">

                @if (_timeline is null || _timeline.Events.Count == 0)
                {
                    <div class="text-sm text-muted">No timeline events.</div>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="min-w-full text-left text-sm text-body">
                            <thead class="border-b border-default text-xs text-muted">
                                <tr>
                                    <th class="px-2 py-2">At</th>
                                    <th class="px-2 py-2">Event</th>
                                    <th class="px-2 py-2">Summary</th>
                                    <th class="px-2 py-2">Actor</th>
                                    <th class="px-2 py-2">Source</th>
                                    <th class="px-2 py-2">Metadata</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var e in _timeline.Events)
                                {
                                    <tr class="border-b border-default">
                                        <td class="px-2 py-2">@e.OccurredAt.ToLocalTime().ToString("u")</td>
                                        <td class="px-2 py-2 font-mono text-xs">@e.EventKind</td>
                                        <td class="px-2 py-2">@e.Summary</td>
                                        <td class="px-2 py-2">@e.Actor</td>
                                        <td class="px-2 py-2 font-mono text-xs">@e.SourceType/@e.SourceId</td>
                                        <td class="px-2 py-2 text-xs">
                                            @if (e.Metadata.Count == 0)
                                            {
                                                <span class="text-muted">-</span>
                                            }
                                            else
                                            {
                                                @foreach (var m in e.Metadata.OrderBy(x => x.Key, StringComparer.Ordinal))
                                                {
                                                    <div class="font-mono break-all">@m.Key=@m.Value</div>
                                                }
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
        </ManagementSection>

        <ManagementAdvancedSection Title="Supporting records (non-canonical)"
                                   Subtitle="Execution timeline above is the canonical history narrative. The records below are raw supporting evidence."
                                   InitiallyOpen="false">
                    <div class="grid gap-4">
                        <div>
                            <div class="text-sm font-semibold text-heading">Lifecycle records</div>
                            @if (_detail.LifecycleEvents.Count == 0)
                            {
                                <div class="mt-2 text-sm text-muted">No lifecycle events.</div>
                            }
                            else
                            {
                                <div class="mt-2 overflow-x-auto">
                                    <table class="min-w-full text-left text-sm text-body">
                                        <thead class="border-b border-default text-xs text-muted">
                                            <tr>
                                                <th class="px-2 py-2">At</th>
                                                <th class="px-2 py-2">Event</th>
                                                <th class="px-2 py-2">From</th>
                                                <th class="px-2 py-2">To</th>
                                                <th class="px-2 py-2">Step</th>
                                                <th class="px-2 py-2">Details</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var e in _detail.LifecycleEvents)
                                            {
                                                <tr class="border-b border-default">
                                                    <td class="px-2 py-2">@e.OccurredAt.ToLocalTime().ToString("u")</td>
                                                    <td class="px-2 py-2 font-mono text-xs">@e.EventType</td>
                                                    <td class="px-2 py-2">@e.FromStatus</td>
                                                    <td class="px-2 py-2">@e.ToStatus</td>
                                                    <td class="px-2 py-2 font-mono text-xs">@e.StepName</td>
                                                    <td class="px-2 py-2 font-mono text-xs break-all">@e.DetailsJson</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>

                        <div>
                            <div class="text-sm font-semibold text-heading">Step records</div>
                            @if (_detail.StepInstances.Count == 0)
                            {
                                <div class="mt-2 text-sm text-muted">No step instances.</div>
                            }
                            else
                            {
                                <div class="mt-2 overflow-x-auto">
                                    <table class="min-w-full text-left text-sm text-body">
                                        <thead class="border-b border-default text-xs text-muted">
                                            <tr>
                                                <th class="px-2 py-2">Step</th>
                                                <th class="px-2 py-2">Attempt</th>
                                                <th class="px-2 py-2">Status</th>
                                                <th class="px-2 py-2">Started</th>
                                                <th class="px-2 py-2">Ended</th>
                                                <th class="px-2 py-2">Error</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var s in _detail.StepInstances)
                                            {
                                                <tr class="border-b border-default">
                                                    <td class="px-2 py-2 font-mono text-xs">@s.StepName</td>
                                                    <td class="px-2 py-2">@s.Attempt</td>
                                                    <td class="px-2 py-2">@s.Status</td>
                                                    <td class="px-2 py-2">@Fmt(s.StartedAt)</td>
                                                    <td class="px-2 py-2">@Fmt(s.EndedAt)</td>
                                                    <td class="px-2 py-2 text-xs break-all">@s.Error</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>

                        <div>
                            <div class="text-sm font-semibold text-heading">External control request records</div>
                            @if (_detail.ControlRequests.Count == 0)
                            {
                                <div class="mt-2 text-sm text-muted">No external control requests.</div>
                            }
                            else
                            {
                                <div class="mt-2 overflow-x-auto">
                                    <table class="min-w-full text-left text-sm text-body">
                                        <thead class="border-b border-default text-xs text-muted">
                                            <tr>
                                                <th class="px-2 py-2">Kind</th>
                                                <th class="px-2 py-2">Status</th>
                                                <th class="px-2 py-2">Requested</th>
                                                <th class="px-2 py-2">Requested by</th>
                                                <th class="px-2 py-2">Applied</th>
                                                <th class="px-2 py-2">Applied by</th>
                                                <th class="px-2 py-2">Last error</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var c in _detail.ControlRequests)
                                            {
                                                <tr class="border-b border-default">
                                                    <td class="px-2 py-2 font-mono text-xs">@c.ControlKind</td>
                                                    <td class="px-2 py-2">@c.Status</td>
                                                    <td class="px-2 py-2">@c.RequestedAt.ToLocalTime().ToString("u")</td>
                                                    <td class="px-2 py-2">@c.RequestedBy</td>
                                                    <td class="px-2 py-2">@Fmt(c.AppliedAt)</td>
                                                    <td class="px-2 py-2">@c.AppliedBy</td>
                                                    <td class="px-2 py-2 text-xs break-all">@c.LastError</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        </div>
                    </div>
        </ManagementAdvancedSection>
    }
</div>

@code {
    [Parameter] public string RunId { get; set; } = "";

    private RunDetailDto? _detail;
    private BlockedWorkRemediationEntryDto? _blockedWork;
    private bool _loading;
    private string? _error;
    private string? _actionMessage;
    private string? _newRunId;
    private IReadOnlyList<ControlActionAvailabilityDto> _actions = Array.Empty<ControlActionAvailabilityDto>();
    private RunTimelineDto? _timeline;
    private bool _pollingEnabled;
    private PeriodicTimer? _timer;
    private CancellationTokenSource? _pollingCts;
    private string? _dataLoadKey;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        var key = RunId ?? "";
        if (key == _dataLoadKey)
            return;
        _dataLoadKey = key;
        await LoadAsync();
    }
    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pollingEnabled && _pollingCts is null)
            StartPolling();
        if (!_pollingEnabled && _pollingCts is not null)
            StopPolling();
        return Task.CompletedTask;
    }

    public void Dispose()
    {
        StopPolling();
    }

    private string CurrentStepLabel =>
        string.Equals(_detail?.Status, "parked", StringComparison.OrdinalIgnoreCase)
            ? "Next step (after resume)"
            : "Current step";

    private string CurrentStepHelp =>
        string.Equals(_detail?.Status, "parked", StringComparison.OrdinalIgnoreCase)
            ? "When parked, CurrentStepName is the saved resume pointer (the next step that will run after resume)."
            : "While running, CurrentStepName reflects current step progression.";

    private string RunHeaderSubtitle =>
        _detail is null
            ? string.Empty
            : string.Concat(
                _detail.ExecutionKind,
                " · ",
                _detail.Status,
                string.IsNullOrEmpty(_detail.IntegrationId) ? "" : $" · {_detail.IntegrationId}",
                _detail.ForensicContext is { } fx
                    ? $" · {Epic33UiDisplayHelpers.FormatRunOriginKind(fx.OriginKind)}"
                    : "");

    private bool CanInvoke(string actionKind) =>
        !_loading && string.Equals(GetAction(actionKind)?.AvailabilityState, "available", StringComparison.Ordinal);

    private string ActionReason(string actionKind) =>
        GetAction(actionKind)?.ReasonCode ?? string.Empty;

    private ControlActionAvailabilityDto? GetAction(string actionKind) =>
        _actions.FirstOrDefault(x => string.Equals(x.ActionKind, actionKind, StringComparison.Ordinal));

    private bool HasDisplayableOutput =>
        _detail?.Result is not null &&
        (string.Equals(_detail.Result.OutputAvailability, "captured", StringComparison.Ordinal) ||
         string.Equals(_detail.Result.OutputAvailability, "truncated", StringComparison.Ordinal)) &&
        !string.IsNullOrEmpty(_detail.Result.PayloadJson);

    private bool IsTruncated =>
        string.Equals(_detail?.Result?.OutputAvailability, "truncated", StringComparison.Ordinal);

    private bool IsSummaryOnlyOutput =>
        _detail?.Result is not null &&
        string.Equals(_detail.Result.OutputAvailability, "summary_only", StringComparison.Ordinal);

    private bool ShowOutputUnavailable =>
        _detail?.Result is not null &&
        (string.Equals(_detail.Result.OutputAvailability, "none", StringComparison.Ordinal) ||
         string.Equals(_detail.Result.OutputAvailability, "empty", StringComparison.Ordinal) ||
         string.Equals(_detail.Result.OutputAvailability, "unsupported", StringComparison.Ordinal));

    private string OutputUnavailableMessage =>
        _detail?.Result?.OutputAvailability switch
        {
            "none" => "No captured output for this run.",
            "empty" => "Handler returned no output.",
            "unsupported" => "Output could not be captured safely.",
            _ => "Output not available."
        };

    private bool HasSummaryOnlyDiagnostics =>
        _detail?.Result is not null
        && string.Equals(_detail.Result.DiagnosticsAvailability, "summary_only", StringComparison.Ordinal);

    private bool HasWithheldDiagnostics =>
        _detail?.Result is not null
        && string.Equals(_detail.Result.DiagnosticsAvailability, "withheld", StringComparison.Ordinal);

    private bool HasNoDiagnostics =>
        _detail?.Result is not null
        && string.Equals(_detail.Result.DiagnosticsAvailability, "none", StringComparison.Ordinal);

    private bool HasUnsupportedDiagnostics =>
        _detail?.Result is not null
        && string.Equals(_detail.Result.DiagnosticsAvailability, "unsupported", StringComparison.Ordinal);

    private Task RefreshAsync() => LoadAsync();

    private async Task LoadAsync(bool preserveActionFeedback = false)
    {
        if (string.IsNullOrWhiteSpace(RunId))
            return;

        _loading = true;
        _error = null;
        if (!preserveActionFeedback)
        {
            _actionMessage = null;
            _newRunId = null;
        }
        try
        {
            _detail = await Client.GetRunAsync(RunId);
            if (_detail is null)
            {
                _error = "Run not found (404).";
                _actions = Array.Empty<ControlActionAvailabilityDto>();
                _timeline = null;
                _blockedWork = null;
            }
            else
            {
                _actions = await Client.GetRunActionsAsync(RunId);
                _timeline = await Client.GetRunTimelineAsync(RunId);
                try { _blockedWork = await Client.GetBlockedWorkItemAsync(RunId); } catch { _blockedWork = null; }
            }
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            _error = "Not authorized to view this run (403).";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private static string Fmt(DateTimeOffset? value) =>
        value is null ? "" : value.Value.ToLocalTime().ToString("u");

    private static string FormatInvestigationHintLabel(RunInvestigationHintDto h) =>
        h.Kind.ToLowerInvariant() switch
        {
            "audit" => "Audit timeline",
            "module" => "Module",
            "schedule" => "Schedule",
            "blocked_work" => "Blocked work / recovery",
            "runtime_health" => "Control Center / health",
            _ => h.Kind
        };

    private void StartPolling()
    {
        StopPolling();
        _pollingCts = new CancellationTokenSource();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(2));
        _ = Task.Run(async () =>
        {
            try
            {
                while (await _timer.WaitForNextTickAsync(_pollingCts.Token))
                {
                    await InvokeAsync(() => LoadAsync());
                }
            }
            catch (OperationCanceledException)
            {
            }
        });
    }

    private void StopPolling()
    {
        try { _pollingCts?.Cancel(); } catch { }
        _pollingCts?.Dispose();
        _pollingCts = null;
        _timer?.Dispose();
        _timer = null;
    }

    private async Task CancelAsync()
    {
        await InvokeActionAsync(
            () => Client.CancelRunAsync(RunId),
            ok: _ => "Cancel requested (cooperative). Refresh to observe applied outcome.");
    }

    private async Task RetryAsync()
    {
        await InvokeActionAsync(
            () => Client.RetryRunAsync(RunId),
            ok: r =>
            {
                _newRunId = r.RunId;
                return $"Retry accepted. New run created: {r.RunId}. The original run remains unchanged.";
            });
    }

    private async Task ParkAsync()
    {
        await InvokeActionAsync(
            () => Client.ParkRunAsync(RunId),
            ok: _ => "Park request queued. The worker will apply park at the next safe boundary.");
    }

    private async Task ResumeAsync()
    {
        await InvokeActionAsync(
            () => Client.ResumeRunAsync(RunId),
            ok: _ => "Resume request queued. The worker will apply resume after it claims the run.");
    }

    private async Task InvokeActionAsync<T>(Func<Task<T>> action, Func<T, string> ok)
    {
        _loading = true;
        _actionMessage = null;
        _newRunId = null;
        try
        {
            var result = await action();
            _actionMessage = ok(result);
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
        {
            _actionMessage = "Not authorized for this action (403).";
        }
        catch (HttpRequestException ex) when (ex.StatusCode == System.Net.HttpStatusCode.Conflict)
        {
            _actionMessage = "Action rejected (409). The run is not eligible for that control in its current state.";
        }
        catch (HttpRequestException ex)
        {
            _actionMessage = ex.Message;
        }
        catch (Exception ex)
        {
            _actionMessage = ex.Message;
        }
        finally
        {
            _loading = false;
        }

        await LoadAsync(preserveActionFeedback: true);
        StateHasChanged();
    }
}

