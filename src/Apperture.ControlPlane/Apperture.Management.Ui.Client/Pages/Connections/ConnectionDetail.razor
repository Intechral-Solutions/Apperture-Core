@page "/connections/{ConnectionId}"
@using Apperture.Core.Domain.ResourceContexts
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Client.Molecules
@using Apperture.Management.Ui.Client.Organisms
@using Apperture.Management.Ui.Shared
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities
@inject NavigationManager Nav
@inject ShellOrientationService ShellOrientation
@inject IToastService Toasts
@inject ResourceContextViewState ViewState
@using Microsoft.AspNetCore.Components.Web

<div class="p-4 ui-page-stack">
    <PageHeader @key="@ConnectionId"
                Title="@EntityShellTitles.Detail(_connection?.Name, "Connection")"
                Subtitle="@ConnectionHeaderSubtitle">
        <ChildContent>
            <OwnershipChip ResourceContextId="@_connection?.ResourceContextId" />
        </ChildContent>
        <Toolbar>
            <a href="/connections" class="ui-toolbar-btn">Back to list</a>
            <button type="button"
                    class="ui-toolbar-btn"
                    disabled="@_loading"
                    @onclick="LoadAsync">
                Refresh
            </button>
            @if (CanTest)
            {
                <ActionButton @ref="_testButton"
                              Variant="ActionButtonVariant.Primary"
                              DefaultText="Test connection"
                              ActiveText="Testing…"
                              SuccessText="Verified"
                              ErrorText="Test failed"
                              IsInactive="@(_loading || _testing)"
                              OnClick="HandleTestClick" />
            }
            @if (CanEdit)
            {
                <button type="button"
                        class="ui-toolbar-btn"
                        disabled="@_loading"
                        @onclick="StartEditAsync">
                    Edit
                </button>
            }
            @if (CanMove)
            {
                <button type="button"
                        id="connection-move-trigger"
                        class="ui-toolbar-btn"
                        disabled="@_loading"
                        @onclick="() => _moveDialogOpen = true">
                    Move to another context…
                </button>
            }
            @if (CanRetire)
            {
                <button type="button"
                        id="connection-retire-trigger"
                        class="ui-toolbar-btn ui-toolbar-btn--danger"
                        disabled="@_loading"
                        @onclick="() => _confirmRetireOpen = true">
                    Retire
                </button>
            }
        </Toolbar>
    </PageHeader>
    <MismatchNotice OwnerResourceContextId="@_connection?.ResourceContextId"
                    ResourceKindLabel="connection"
                    ExtraCopy="@(ResourceContextIds.IsShared(_connection?.ResourceContextId) && !ViewState.Current.IsAll ? $"Integrations in {ViewState.DescribeContext(ViewState.Current.ResourceContextId!)} can use it." : null)" />
    <MoveOwnershipDialog IsOpen="@_moveDialogOpen"
                         Kind="MoveOwnershipDialog.ResourceKind.Connection"
                         ResourceId="@ConnectionId"
                         CurrentResourceContextId="@_connection?.ResourceContextId"
                         ResourceDisplayName="@_connection?.Name"
                         OnCancelled="() => _moveDialogOpen = false"
                         OnMoved="OnMovedAsync" />

    @if (!_capabilitiesLoaded)
    {
        <LoadingState Message="Loading…" />
    }
    else if (_capabilities?.CanViewConnections != true)
    {
        <ForbiddenState Message="You do not have permission to view connection details." />
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <ErrorState Message="@_error" />
    }
    else if (_connection is null)
    {
        <LoadingState Message="Loading connection…" />
    }
    else if (_editing && _editConnectorDefinition is not null)
    {
        <ManagementSection Title="Edit connection" Layer="ManagementSection.UiLayer.Detail">
                <div>
                    <label class="block text-xs text-muted">Name</label>
                    <input class="ui-input mt-1" @bind="_editName" />
                </div>
                <div class="mt-3 text-xs text-muted">Leave secret fields blank to keep the current stored value.</div>
                <ConnectorConnectionFieldInputs Definition="_editConnectorDefinition"
                                                ConfigValues="_editConfigValues"
                                                SecretValues="_editSecretValues" />
                <div class="mt-3 flex gap-2">
                    <button type="button"
                            class="btn btn-primary"
                            disabled="@_saveEditLoading"
                            @onclick="SaveEditAsync">
                        @(_saveEditLoading ? "Saving…" : "Save")
                    </button>
                    <button type="button"
                            class="btn btn-secondary"
                            disabled="@_saveEditLoading"
                            @onclick="CancelEdit">
                        Cancel
                    </button>
                </div>
        </ManagementSection>
    }
    else
    {
        <div class="space-y-4">
            @if (ConnectionWorkspacePresentation.IsRetired(_connection))
            {
                <PageMessage Kind="PageMessageKind.Info">@ConnectionWorkspacePresentation.RetiredNotice</PageMessage>
            }

            @if (!ConnectionWorkspacePresentation.IsConnectorRegistered(_connection))
            {
                <PageMessage Kind="PageMessageKind.Warning">@ConnectionWorkspacePresentation.UnregisteredConnectorNotice</PageMessage>
            }

            <ManagementSection Title="Overview" Layer="ManagementSection.UiLayer.Summary">
                <MetadataGrid>
                    <MetadataItem Label="Name" Value="@_connection.Name" />
                    <MetadataItem Label="Connector">
                        @if (!string.IsNullOrWhiteSpace(_connection.ConnectorDisplayName))
                        {
                            @if (_capabilities?.CanViewConnectorDefinitions == true)
                            {
                                <a class="ui-link" href="@ComponentCatalogPresentation.ConnectorDetailHref(_connection.ConnectorDefinitionId)">@_connection.ConnectorDisplayName</a>
                            }
                            else
                            {
                                @* The Component catalog is gated separately; without access the name is plain text. *@
                                <span>@_connection.ConnectorDisplayName</span>
                            }
                        }
                        else
                        {
                            @* Not registered in this host: show the stored id as-is, with no link and no invented name. *@
                            <span class="font-mono text-xs">@_connection.ConnectorDefinitionId</span>
                        }
                    </MetadataItem>
                    <MetadataItem Label="State">
                        <StatusPill Label="@_connection.State" Semantic="@ConnectionWorkspacePresentation.StateSemantic(_connection.State)" />
                    </MetadataItem>
                </MetadataGrid>

                <div class="mt-4" data-connection-health>
                    <div class="text-xs text-muted">Health</div>
                    <div class="mt-1 flex flex-wrap items-center gap-2">
                        <StatusPill Label="@_health.Label" Semantic="@_health.Semantic" />
                        @if (_connection.LastVerificationAtUtc is { } testedAt)
                        {
                            <span class="text-xs text-muted">Last tested @testedAt.ToString("u")</span>
                        }
                    </div>
                    @if (!string.IsNullOrWhiteSpace(_health.Detail))
                    {
                        <div class="mt-1 text-sm text-body">@_health.Detail</div>
                    }
                    @if (!string.IsNullOrWhiteSpace(_connection.LastVerificationSummary))
                    {
                        <div class="mt-2">
                            <div class="text-xs text-muted">Result of the last test</div>
                            <div class="mt-1 text-sm text-body">@_connection.LastVerificationSummary</div>
                        </div>
                    }
                </div>
            </ManagementSection>

            <ManagementSection Title="Configuration"
                               Layer="ManagementSection.UiLayer.Detail"
                               Help="Settings as stored for this connection. Secret values are never shown.">
                @if (_configurationRows.Count == 0)
                {
                    <p class="text-sm text-muted">No settings are stored for this connection.</p>
                }
                else
                {
                    <MetadataGrid>
                        @foreach (var row in _configurationRows)
                        {
                            <MetadataItem @key="@((row.IsSecret ? "secret:" : "field:") + row.Key)" Label="@row.Label">
                                @if (row.IsSecret)
                                {
                                    <StatusPill Label="@ConnectionWorkspacePresentation.SecretPresence(row.IsSet)"
                                                Semantic="@(row.IsSet ? ManagementStatusSemantic.Success : ManagementStatusSemantic.Neutral)" />
                                    @if (row.IsUndeclared && CanClearLegacySecrets)
                                    {
                                        <button type="button"
                                                id="@("connection-secret-remove-" + row.Key)"
                                                class="ui-toolbar-btn ml-2"
                                                title="This connector no longer uses this secret field. Removing it deletes the stored reference only."
                                                disabled="@_clearingSecretKey.Equals(row.Key, StringComparison.Ordinal)"
                                                @onclick="() => ClearSecretFieldAsync(row.Key)">
                                            Remove
                                        </button>
                                    }
                                }
                                else if (row.Value is not null)
                                {
                                    <span>@row.Value</span>
                                }
                                else
                                {
                                    <span class="text-muted">Not set</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(row.Description))
                                {
                                    <div class="mt-1 text-xs text-muted">@row.Description</div>
                                }
                            </MetadataItem>
                        }
                    </MetadataGrid>
                }
            </ManagementSection>

            <ManagementSection Title="Used in" Layer="ManagementSection.UiLayer.Detail">
                @if (_connection.UsedIn is { Count: > 0 })
                {
                    <ul class="space-y-1">
                        @foreach (var u in _connection.UsedIn)
                        {
                            <li>
                                @if (!string.IsNullOrEmpty(u.IntegrationId))
                                {
                                    <a href="@("/integrations/" + Uri.EscapeDataString(u.IntegrationId))"
                                       class="underline text-sm hover:text-heading">
                                        @(u.IntegrationDisplayName ?? "Integration") (@u.ModuleId, Slot @u.SlotName)
                                    </a>
                                    @if (ViewState.SelectorVisible && u.IntegrationResourceContextId is not null)
                                    {
                                        <span class="text-muted text-xs">(@ViewState.DescribeContext(u.IntegrationResourceContextId))</span>
                                    }
                                }
                                else
                                {
                                    <a href="@("/modules/" + Uri.EscapeDataString(u.ModuleId))"
                                       class="underline text-sm hover:text-heading">
                                        Module @u.ModuleId, Slot @u.SlotName (@u.ContractType)
                                    </a>
                                }
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <div class="text-sm text-muted">This connection is not used by any module slot bindings.</div>
                }
            </ManagementSection>

            @* Tools: offered only when the caller may browse this Connection AND a connector-supplied provider is registered
               in this host, and never for a retired Connection. Absent otherwise -- not disabled, not empty -- because an
               empty state would claim something about the connector that the caller has no right to know. *@
            @if (_tools is { SqlStructureBrowser: true } && !IsRetired)
            {
                <ManagementSection Title="Tools"
                                   Layer="ManagementSection.UiLayer.Detail"
                                   Help="Read-only tools for inspecting the system this connection points at.">
                    @* Keyed by the Connection, so a different Connection never inherits this one's loaded structure. *@
                    <SqlStructureBrowser @key="@_connection.Id" ConnectionId="@_connection.Id" />
                </ManagementSection>
            }

            <TechnicalDetails>
                <TechnicalDetail Label="Connection id" Value="@_connection.Id" />
                <TechnicalDetail Label="Connector definition id" Value="@_connection.ConnectorDefinitionId" />
                <TechnicalDetail Label="Scope key" Value="@(_connection.ScopeKey ?? "—")" />
                <TechnicalDetail Label="Owner id" Value="@(_connection.OwnerId ?? "—")" />
            </TechnicalDetails>
        </div>
    }
</div>

<ConfirmActionDialog IsOpen="@_confirmRetireOpen"
                     Title="Retire connection?"
                     ConfirmLabel="Retire connection"
                     Emphasis="ConfirmActionEmphasis.Caution"
                     OnConfirm="RetireAsync"
                     OnConfirmed="() => _confirmRetireOpen = false"
                     OnCancel="() => _confirmRetireOpen = false">
    <ChildContent>
        Retiring <strong>@(_connection?.Name ?? "this connection")</strong> @ConnectionWorkspacePresentation.RetireConfirmConsequence
    </ChildContent>
    <Details>
        @ConnectionWorkspacePresentation.RetireConfirmDetails
    </Details>
</ConfirmActionDialog>

@code {
    [Parameter] public string ConnectionId { get; set; } = "";

    private bool _confirmRetireOpen;
    private bool _moveDialogOpen;

    private string ConnectionHeaderSubtitle =>
        _connection is null
            ? "Connection detail"
            : $"{ConnectorLabel} · {_connection.State}";

    // Readable connector name; the stored id only when this host does not register the connector.
    private string ConnectorLabel =>
        string.IsNullOrWhiteSpace(_connection?.ConnectorDisplayName)
            ? _connection?.ConnectorDefinitionId ?? ""
            : _connection!.ConnectorDisplayName!;

    private ConnectionDto? _connection;

    // Which typed tools this Connection offers the caller. Null unless the caller may browse and a provider exists here.
    private ConnectionToolsDto? _tools;

    // Connector-declared field metadata for readable labels. Null when the connector is not registered or the caller
    // cannot read definitions; the Configuration section then falls back to the stored keys.
    private ConnectorDefinitionCatalogDto? _connectorDefinition;

    private IReadOnlyList<ConnectionConfigurationRow> _configurationRows =>
        _connection is null ? [] : ConnectionWorkspacePresentation.ConfigurationRows(_connection, _connectorDefinition);

    private ConnectionHealth _health => ConnectionWorkspacePresentation.Health(_connection!);

    // Actions follow the Connection's own facts and the caller's permissions; nothing here has a state of its own. A
    // retired Connection is read-only. An unregistered connector cannot be tested or edited (its fields are unknown), but
    // it can still be moved or retired, which need no definition. A failed verification removes nothing.
    // A failed (re)load leaves any earlier record on screen behind the error state, so it offers no actions either.
    private bool Loaded => _connection is not null && !_editing && string.IsNullOrEmpty(_error);
    private bool IsRetired => _connection is not null && ConnectionWorkspacePresentation.IsRetired(_connection);
    private bool CanTest =>
        Loaded && _connection!.SupportsVerification && !IsRetired
        && ConnectionWorkspacePresentation.IsConnectorRegistered(_connection);
    // Editing needs the connector's field definitions, so it also needs permission to read them.
    private bool CanEdit =>
        Loaded && _capabilities?.CanUpdateConnections == true && _capabilities?.CanViewConnectorDefinitions == true && !IsRetired
        && ConnectionWorkspacePresentation.IsConnectorRegistered(_connection!);
    private bool CanMove => Loaded && _capabilities?.CanUpdateConnections == true && !IsRetired;

    // Removing a stored secret field the connector no longer declares needs no definition to send, but it needs one to tell a
    // legacy field from a declared one, so it is offered only when the definition was read.
    private bool CanClearLegacySecrets =>
        Loaded && _capabilities?.CanUpdateConnections == true && _connectorDefinition is not null && !IsRetired;

    private string _clearingSecretKey = "";
    private bool CanRetire => Loaded && _capabilities?.CanRetireConnections == true && !IsRetired;

    private OperatorCapabilitiesDto? _capabilities;
    private bool _capabilitiesLoaded;
    private bool _loading;
    private bool _testing;
    private ActionButton? _testButton;
    private string? _error;

    private bool _editing;
    private bool _saveEditLoading;
    private ConnectorDefinitionCatalogDto? _editConnectorDefinition;
    private string _editName = "";
    private readonly Dictionary<string, string> _editConfigValues = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _editSecretValues = new(StringComparer.Ordinal);
    private string? _dataLoadKey;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _capabilities = await Capabilities.GetCapabilitiesAsync();
        }
        catch
        {
            _capabilities = new OperatorCapabilitiesDto(false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false);
        }
        _capabilitiesLoaded = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        if (!_capabilitiesLoaded)
            return;

        var key = ConnectionId ?? "";
        if (key == _dataLoadKey)
            return;

        _dataLoadKey = key;
        _connection = null;
        _tools = null;
        _connectorDefinition = null;
        _editing = false;
        _error = null;

        if (_capabilities?.CanViewConnections == true)
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_capabilities?.CanViewConnections != true || string.IsNullOrEmpty(ConnectionId)) return;
        _loading = true;
        _error = null;
        try
        {
            _connection = await Client.GetConnectionAsync(ConnectionId);
            if (_connection is not null)
            {
                await ViewState.EnsureContextsKnownAsync(_connection.UsedIn.Select(u => u.IntegrationResourceContextId));
                await LoadConnectorDefinitionAsync(_connection);
                await LoadToolsAsync(_connection);
            }
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            PublishShellTitle();
        }
    }

    // Presentation metadata only: a local, in-memory catalog lookup on the server -- never a remote call. It is not asked
    // for when the connector is unregistered in this host, or when the caller cannot read definitions (a guaranteed 403);
    // in both cases, and on ANY failure, the stored keys simply remain the labels. Best-effort metadata must never be
    // able to fail the page, so this deliberately catches everything.
    private async Task LoadConnectorDefinitionAsync(ConnectionDto connection)
    {
        if (_connectorDefinition is not null
            && string.Equals(_connectorDefinition.Id, connection.ConnectorDefinitionId, StringComparison.Ordinal))
            return;

        _connectorDefinition = null;
        if (!ConnectionWorkspacePresentation.IsConnectorRegistered(connection)
            || _capabilities?.CanViewConnectorDefinitions != true)
            return;

        try
        {
            _connectorDefinition = await Client.GetConnectorDefinitionAsync(connection.ConnectorDefinitionId);
        }
        catch (Exception)
        {
            _connectorDefinition = null;
        }
    }

    // A local lookup on the server (no remote call, no secret, no client). Only asked for a caller who may browse and for a
    // Connection that is not retired; and, like the definition, best-effort: it can never fail the page.
    private async Task LoadToolsAsync(ConnectionDto connection)
    {
        _tools = null;
        if (_capabilities?.CanBrowseConnections != true || ConnectionWorkspacePresentation.IsRetired(connection))
            return;

        try
        {
            _tools = await Client.GetConnectionToolsAsync(connection.Id);
        }
        catch (Exception)
        {
            _tools = null;
        }
    }

    private void PublishShellTitle() =>
        ShellOrientation.PublishForCurrentUri(
            Nav,
            EntityShellTitles.Detail(_connection?.Name, "Connection"),
            ConnectionHeaderSubtitle);

    private async Task StartEditAsync()
    {
        if (_connection is null) return;
        try
        {
            _editConnectorDefinition = await Client.GetConnectorDefinitionAsync(_connection.ConnectorDefinitionId);
        }
        catch (Exception)
        {
            // The client throws on a missing or unreadable definition rather than returning null.
            _editConnectorDefinition = null;
        }

        if (_editConnectorDefinition is null)
        {
            Toasts.Show(ToastSeverity.Error, "Connector definition not found.");
            return;
        }

        _editName = _connection.Name;
        _editConfigValues.Clear();
        _editSecretValues.Clear();
        foreach (var field in _editConnectorDefinition.Fields)
        {
            if (field.IsSecret)
                _editSecretValues[field.Key] = "";
            else if (_connection.Config.TryGetValue(field.Key, out var v))
                _editConfigValues[field.Key] = v;
            else
                _editConfigValues[field.Key] = "";
        }

        _editing = true;
    }

    private void CancelEdit()
    {
        _editing = false;
        _editConnectorDefinition = null;
    }

    private async Task SaveEditAsync()
    {
        if (_connection is null || _editConnectorDefinition is null) return;
        _saveEditLoading = true;
        _error = null;
        try
        {
            var cfg = _editConfigValues.Where(kv => !string.IsNullOrWhiteSpace(kv.Value)).ToDictionary(kv => kv.Key, kv => kv.Value);
            var secretRotations = _editSecretValues.Where(kv => !string.IsNullOrWhiteSpace(kv.Value)).ToDictionary(kv => kv.Key, kv => kv.Value);
            _connection = await Client.UpdateConnectionAsync(
                ConnectionId,
                new UpdateConnectionRequest(
                    Name: _editName.Trim(),
                    Config: cfg,
                    SecretValues: secretRotations.Count > 0 ? secretRotations : null));
            Toasts.Show(ToastSeverity.Success, "Connection updated.");
            _editing = false;
            _editConnectorDefinition = null;
            await LoadAsync();
        }
        catch (HttpRequestException ex)
        {
            // A failed save is reported and the form stays as typed; it must not replace the workspace with an error state.
            Toasts.Show(ToastSeverity.Error, ex.Message);
        }
        finally
        {
            _saveEditLoading = false;
        }
    }

    // Public so a render test can drive the same handler the Remove button calls.
    public async Task ClearSecretFieldAsync(string key)
    {
        if (_connection is null || !CanClearLegacySecrets) return;
        _clearingSecretKey = key;
        try
        {
            _connection = await Client.UpdateConnectionAsync(ConnectionId, new UpdateConnectionRequest(ClearSecretFields: [key]));
            Toasts.Show(ToastSeverity.Success, "Secret field removed.");
            await LoadAsync();
        }
        catch (HttpRequestException ex)
        {
            Toasts.Show(ToastSeverity.Error, ex.Message);
        }
        finally
        {
            _clearingSecretKey = "";
        }
    }

    private async Task OnMovedAsync()
    {
        _moveDialogOpen = false;
        // Re-fetch only. The page never navigates, and it never switches the shell View: OwnershipChip
        // re-renders from the fresh _connection, and MismatchNotice appears on its own if the current
        // View now differs from the new owner (§4.6, §8.9).
        await LoadAsync();
        Toasts.Show(ToastSeverity.Success, "Connection moved.");
    }

    // Public so a render test can open the same dialog the Retire button opens, and confirm through the same handler.
    public async Task OpenRetireConfirmAsync()
    {
        if (!CanRetire)
            return;

        _confirmRetireOpen = true;
        await InvokeAsync(StateHasChanged);
    }

    public Task ConfirmRetireAsync() => RetireAsync();

    // UIX-6: failures propagate so the confirmation dialog stays open with the reason.
    private async Task RetireAsync()
    {
        if (_connection is null || _capabilities?.CanRetireConnections != true) return;
        _loading = true;
        _error = null;
        try
        {
            await Client.RetireConnectionAsync(ConnectionId);
            Toasts.Show(ToastSeverity.Success, "Connection retired.");
            Nav.NavigateTo("/connections");
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task TestConnectionAsync()
    {
        if (string.IsNullOrWhiteSpace(ConnectionId))
            return;
        _testing = true;
        if (_testButton is not null)
            await _testButton.SetStateAsync(ActionButtonState.Active);
        _error = null;
        await InvokeAsync(StateHasChanged);
        try
        {
            _connection = await Client.TestConnectionAsync(ConnectionId);
            var summary = string.IsNullOrWhiteSpace(_connection?.LastVerificationSummary)
                ? "Test completed."
                : _connection!.LastVerificationSummary;
            // The call succeeded either way; whether the connection verified is the result. A failed or unavailable
            // verification is reported as such rather than under a success banner.
            var verified = string.Equals(_connection?.LastVerificationStatus, "Success", StringComparison.Ordinal);
            Toasts.Show(verified ? ToastSeverity.Success : ToastSeverity.Warning, summary);
            if (_testButton is not null)
                await _testButton.SetStateAsync(verified ? ActionButtonState.Success : ActionButtonState.Error);
        }
        catch (Exception ex)
        {
            // A test that could not run is reported; the workspace itself stays intact.
            Toasts.Show(ToastSeverity.Error, ex.Message);
            if (_testButton is not null)
                await _testButton.SetStateAsync(ActionButtonState.Error);
        }
        finally
        {
            _testing = false;
        }
    }

    private Task HandleTestClick(MouseEventArgs _) => TestConnectionAsync();
}
