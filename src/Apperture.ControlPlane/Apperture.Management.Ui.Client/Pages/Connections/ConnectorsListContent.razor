@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Client.Organisms
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities

<div class="mt-4">
    <div class="mb-4 flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
        <div class="text-sm text-muted space-y-1">
            <p>
                Connector definitions describe the <strong>shape</strong> of connection material (fields and secrets). They are not executable client APIs.
            </p>
            <p>
                Create <a href="/connections/new" class="underline hover:text-heading">connections</a> from these definitions; bind them to module slots under
                <a href="/integrations" class="underline hover:text-heading">Integrations</a>. Modules use typed connector clients in code.
            </p>
        </div>
        <button type="button"
                class="shrink-0 rounded bg-surface-muted px-3 py-2 text-sm text-body hover:bg-surface disabled:opacity-50"
                disabled="@_loading"
                @onclick="LoadAsync">
            Refresh
        </button>
    </div>

    @if (!_capabilitiesLoaded)
    {
        <LoadingState Message="Loading…" />
    }
    else if (_capabilities?.CanViewConnectorDefinitions != true)
    {
        <ForbiddenState Message="You do not have permission to view connector definitions." />
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <ErrorState Message="@_error" />
    }
    else if (_definitions is null)
    {
        <LoadingState Message="Loading connector definitions…" />
    }
    else if (_definitions.Count == 0)
    {
        <EmptyState Message="No connector definitions registered in this host." />
    }
    else
    {
        <div class="overflow-x-auto rounded border border-default bg-surface">
            <table class="min-w-full text-left text-sm text-body">
                <thead class="border-b border-default text-xs text-muted">
                    <tr>
                        <th class="px-3 py-2">Name</th>
                        <th class="px-3 py-2">Id</th>
                        <th class="px-3 py-2">Source</th>
                        <th class="px-3 py-2">Fields</th>
                        <th class="px-3 py-2">Capabilities</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in _definitions)
                    {
                        <tr class="border-b border-default hover:bg-surface-muted align-top">
                            <td class="px-3 py-2 font-medium">@d.Name</td>
                            <td class="px-3 py-2 font-mono text-xs">@d.Id</td>
                            <td class="px-3 py-2">@(d.ModuleId ?? "Platform")</td>
                            <td class="px-3 py-2 text-xs">@d.Fields.Count</td>
                            <td class="px-3 py-2 text-xs text-muted">@d.Capabilities</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private IReadOnlyList<ConnectorDefinitionCatalogDto>? _definitions;
    private OperatorCapabilitiesDto? _capabilities;
    private bool _capabilitiesLoaded;
    private bool _loading;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _capabilities = await Capabilities.GetCapabilitiesAsync();
        }
        catch
        {
            _capabilities = new OperatorCapabilitiesDto(false, false, false, false, false, false, false, false, false, false, false, false, false, false, false);
        }
        _capabilitiesLoaded = true;

        if (_capabilities?.CanViewConnectorDefinitions == true)
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_capabilities?.CanViewConnectorDefinitions != true) return;
        _loading = true;
        _error = null;
        try
        {
            _definitions = await Client.GetConnectorDefinitionsAsync();
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
