@page "/connections/new"
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Client.Molecules
@using Apperture.Management.Ui.Client.Organisms
@using Apperture.Management.Ui.Shared
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities
@inject NavigationManager Nav
@inject IToastService Toasts
@inject ResourceContextViewState ViewState
@using Microsoft.AspNetCore.Components.Web

<div class="p-4 ui-page-stack">
    <PageHeader Title="Add connection" Subtitle="Create a new connection">
        <Toolbar>
            <a href="/connections" class="ui-toolbar-btn">Back to list</a>
        </Toolbar>
    </PageHeader>

    @if (!_capabilitiesLoaded)
    {
        <LoadingState Message="Loading…" />
    }
    else if (_capabilities?.CanCreateConnections != true)
    {
        <ForbiddenState Message="You do not have permission to create connections." />
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <ErrorState Message="@_error" />
    }
    else
    {
        <ManagementSection Title="Connection details" Layer="ManagementSection.UiLayer.Detail">
            <div class="space-y-4 text-sm text-body">
            @if (ViewState.DirectoryUnavailable)
            {
                <PageMessage Kind="PageMessageKind.Warning"
                             Title="Application/Context information unavailable"
                             Message="Could not confirm whether this instance has any applications. Creating now could place this connection in the wrong Context.">
                    <button type="button" class="ui-link text-sm" @onclick="RetryDirectoryAsync">Retry</button>
                </PageMessage>
            }
            else if (ViewState.SelectorVisible)
            {
                <div>
                    <label class="block text-xs text-muted">Context (required)</label>
                    <div class="mt-0.5 text-xs text-muted">Choose the application this resource belongs to, or Shared.</div>
                    <select class="ui-input mt-1" @bind="_selectedResourceContextId">
                        <option value="" disabled selected="@(_selectedResourceContextId == "")">Choose…</option>
                        <option value="shared">Shared</option>
                        @foreach (var app in ViewState.KnownActiveApplications)
                        {
                            <option value="@app.Id">@app.Name</option>
                        }
                    </select>
                </div>
            }
            <div>
                <label class="block text-xs text-muted">Connector definition</label>
                <select class="ui-input mt-1"
                        @bind="_connectorDefinitionId"
                        @bind:after="OnConnectorDefinitionChangedAsync">
                    <option value="">Select…</option>
                    @foreach (var def in _connectorDefinitions)
                    {
                        <option value="@def.Id">@def.Name (@def.Id)</option>
                    }
                </select>
            </div>
            <div>
                <label class="block text-xs text-muted">Connection name</label>
                <input class="ui-input mt-1"
                       @bind="_connectionName"
                       @bind:event="oninput"
                       placeholder="e.g. Campus Nexus Production" />
            </div>
            @if (SelectedDefinition is not null)
            {
                <ConnectorConnectionFieldInputs Definition="SelectedDefinition"
                                                  ConfigValues="_configValues"
                                                  SecretValues="_secretValues"
                                                  OnFieldValueChanged="StateHasChanged" />
            }
            @if (!string.IsNullOrWhiteSpace(_selectedResourceContextId))
            {
                <div class="text-xs text-muted">Creates the connection in <strong>@DestinationLabel()</strong>.</div>
            }
            <div class="flex gap-2 pt-2">
                <ActionButton @ref="_createButton"
                              Variant="ActionButtonVariant.Primary"
                              DefaultText="Create connection"
                              ActiveText="Creating…"
                              SuccessText="Created"
                              ErrorText="Create failed"
                              IsInactive="@(!CanCreate)"
                              OnClick="HandleCreateClick" />
                <a href="/connections" class="btn btn-secondary">Cancel</a>
            </div>
            </div>
        </ManagementSection>
    }
</div>

@code {
    private OperatorCapabilitiesDto? _capabilities;
    private bool _capabilitiesLoaded;
    private string? _error;
    private bool _saving;
    private ActionButton? _createButton;

    private IReadOnlyList<ConnectorDefinitionCatalogDto> _connectorDefinitions = Array.Empty<ConnectorDefinitionCatalogDto>();
    private string _connectorDefinitionId = "";
    private string _connectionName = "";
    private string _selectedResourceContextId = "";
    private readonly Dictionary<string, string> _configValues = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string> _secretValues = new(StringComparer.Ordinal);

    private ConnectorDefinitionCatalogDto? SelectedDefinition =>
        _connectorDefinitions.FirstOrDefault(d => string.Equals(d.Id, _connectorDefinitionId, StringComparison.Ordinal));
    private bool CanCreate =>
        !_saving &&
        !string.IsNullOrWhiteSpace(_connectorDefinitionId) &&
        !string.IsNullOrWhiteSpace(_connectionName) &&
        // Plan 5 stabilization (Issue 1): never allow a submit that would omit ResourceContextId merely
        // because SelectorVisible also reads false while the directory is unavailable -- that would look
        // identical to "confirmed zero Applications" and silently land in Shared.
        !ViewState.DirectoryUnavailable &&
        (!ViewState.SelectorVisible || !string.IsNullOrWhiteSpace(_selectedResourceContextId)) &&
        ConnectorConnectionFieldValidation.AllRequiredFieldsFilled(SelectedDefinition, GetFieldValue);

    private async Task RetryDirectoryAsync() => await ViewState.RefreshContextsAsync();

    [SupplyParameterFromQuery(Name = "context")]
    public string? QueryContext { get; set; }

    protected override void OnInitialized()
    {
        // With no active Application anywhere, the Context field is hidden entirely (ViewState.SelectorVisible
        // is false) and today's behavior is unchanged byte-for-byte: the selection stays unset so the
        // submit path omits ResourceContextId.
        if (!ViewState.SelectorVisible)
        {
            _selectedResourceContextId = string.Empty;
            return;
        }

        // Preselection order (design gate §7.2): ?context= from the create link, else the tab's
        // current view, else nothing. /connections/new is Unscoped (ResourceContextViewRoutes), so
        // it does not participate in the shell's URL-authoritative rewriting/tab-state resolution --
        // the incoming query value is read here directly and validated against the known active
        // Applications (or "shared") before being honoured, rather than trusted as-is.
        if (IsKnownContextSelection(QueryContext))
        {
            _selectedResourceContextId = QueryContext!;
        }
        else if (!ViewState.Current.IsAll)
        {
            _selectedResourceContextId = ViewState.Current.ResourceContextId!;
        }
        else
        {
            _selectedResourceContextId = string.Empty; // "Choose…", submit disabled until set
        }
    }

    private bool IsKnownContextSelection(string? candidate) =>
        !string.IsNullOrWhiteSpace(candidate)
        && (string.Equals(candidate, "shared", StringComparison.Ordinal)
            || ViewState.KnownActiveApplications.Any(a => string.Equals(a.Id, candidate, StringComparison.Ordinal)));

    private string DestinationLabel() =>
        ViewState.DescribeContext(_selectedResourceContextId);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _capabilities = await Capabilities.GetCapabilitiesAsync();
            if (_capabilities?.CanCreateConnections == true)
            {
                _connectorDefinitions = await Client.GetConnectorDefinitionsAsync();
            }
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        catch
        {
            _capabilities = new OperatorCapabilitiesDto(false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false);
        }
        _capabilitiesLoaded = true;
    }

    private Task OnConnectorDefinitionChangedAsync()
    {
        ResetFieldMaps();
        return Task.CompletedTask;
    }

    private void ResetFieldMaps()
    {
        _configValues.Clear();
        _secretValues.Clear();
        if (SelectedDefinition is null)
            return;
        foreach (var field in SelectedDefinition.Fields)
        {
            if (field.IsSecret)
                _secretValues[field.Key] = "";
            else
                _configValues[field.Key] = "";
        }
    }

    private async Task CreateAsync()
    {
        if (SelectedDefinition is null || string.IsNullOrWhiteSpace(_connectionName))
            return;

        var missing = ConnectorConnectionFieldValidation.GetMissingRequiredFields(SelectedDefinition, GetFieldValue)
            .Select(f => f.DisplayName)
            .ToArray();
        if (missing.Length > 0)
        {
            _error = $"Missing required fields: {string.Join(", ", missing)}.";
            return;
        }

        _saving = true;
        if (_createButton is not null)
            await _createButton.SetStateAsync(ActionButtonState.Active);
        _error = null;
        try
        {
            var cfg = _configValues.Where(kv => !string.IsNullOrWhiteSpace(kv.Value)).ToDictionary(kv => kv.Key, kv => kv.Value);
            var secrets = _secretValues.Where(kv => !string.IsNullOrWhiteSpace(kv.Value)).ToDictionary(kv => kv.Key, kv => kv.Value);
            var created = await Client.CreateConnectionAsync(
                new CreateConnectionRequest(
                    _connectorDefinitionId,
                    _connectionName.Trim(),
                    cfg,
                    SecretRefs: new Dictionary<string, string>(),
                    SecretValues: secrets.Count > 0 ? secrets : null,
                    ResourceContextId: string.IsNullOrWhiteSpace(_selectedResourceContextId) ? null : _selectedResourceContextId));
            Toasts.Show(ToastSeverity.Success, "Connection created.");
            if (_createButton is not null)
                await _createButton.SetStateAsync(ActionButtonState.Success);
            Nav.NavigateTo("/connections/" + Uri.EscapeDataString(created.Id));
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
            Toasts.Show(ToastSeverity.Error, ex.Message);
            if (_createButton is not null)
                await _createButton.SetStateAsync(ActionButtonState.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private string GetFieldValue(ConnectionFieldCatalogDto field) =>
        field.IsSecret
            ? (_secretValues.TryGetValue(field.Key, out var s) ? s : "")
            : (_configValues.TryGetValue(field.Key, out var c) ? c : "");

    private Task HandleCreateClick(MouseEventArgs _) => CreateAsync();
}
