@page "/connections/new"
@using Apperture.Management.Ui.Client.Organisms
@inject NavigationManager Nav

<div class="p-4">
    <PageHeader Title="Add connection" Subtitle="Create a new connection">
        <Toolbar>
            <a href="/connections" class="rounded bg-surface-muted px-3 py-2 text-sm text-body hover:bg-surface">Back to list</a>
        </Toolbar>
    </PageHeader>

    <div class="mt-4 rounded border border-default bg-surface p-4 text-sm text-body">
        <div class="font-semibold text-heading">Create connection form coming in a future epic.</div>
        <div class="mt-2 text-muted">
            The API supports creating connections. A full create form will be implemented in a follow-up epic.
        </div>
    </div>
</div>
