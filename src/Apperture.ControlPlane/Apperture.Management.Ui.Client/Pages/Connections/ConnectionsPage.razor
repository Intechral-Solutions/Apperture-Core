@page "/connections"
@using Apperture.Core.Domain.ResourceContexts
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Client.Organisms
@using Apperture.Management.Ui.Shared
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities
@inject NavigationManager Nav
@inject ResourceContextViewState ViewState

<div class="p-4 ui-page-stack">
    <PageHeader Title="Connections" Subtitle="Manage connection instances and browse connector definitions (connection shape only — not executable client operations).">
        <Toolbar>
            @if (_capabilities?.CanViewConnections == true && _capabilities?.CanCreateConnections == true)
            {
                <a href="/connections/new" class="btn btn-primary">Add connection</a>
                <button type="button"
                        class="ui-toolbar-btn"
                        disabled="@_loading"
                        @onclick="LoadAsync">
                    Refresh
                </button>
            }
        </Toolbar>
    </PageHeader>

    @if (!_capabilitiesLoaded)
    {
        <LoadingState Message="Loading…" />
    }
    else if (!CanAccessPage)
    {
        <ForbiddenState Message="You do not have permission to view connections or connector definitions." />
    }
    else
    {
        @if (ShowTabs)
        {
            <div class="mt-4 flex gap-2 border-b border-default">
                @if (_capabilities?.CanViewConnections == true)
                {
                    <button type="button"
                            class="px-3 py-2 text-sm font-medium @(_activeTab == "connections" ? "text-heading border-b-2 border-body -mb-px" : "text-muted hover:text-body")"
                            @onclick="@(() => SetTab("connections"))">
                        Connections
                    </button>
                }
                @if (_capabilities?.CanViewConnectorDefinitions == true)
                {
                    <button type="button"
                            class="px-3 py-2 text-sm font-medium @(_activeTab == "connectors" ? "text-heading border-b-2 border-body -mb-px" : "text-muted hover:text-body")"
                            @onclick="@(() => SetTab("connectors"))">
                        Connectors
                    </button>
                }
            </div>
        }

        @if (_activeTab == "connections" && _capabilities?.CanViewConnections == true)
        {
            @if (ViewState.SelectorVisible && _context.State == ScopedListContextState.Ready && !_context.IsAll
                 && !ResourceContextIds.IsShared(_context.ApiFilter) && _sharedConnectionCount > 0)
            {
                <PageMessage Kind="PageMessageKind.Info">
                    Integrations in @ViewState.DescribeContext(_context.ApiFilter!) can also use
                    <a href="/connections?context=shared" class="ui-link">@_sharedConnectionCount Shared connections</a>.
                </PageMessage>
            }

            @if (_context.State == ScopedListContextState.UnknownContext)
            {
                @* The "that context doesn't exist" message is surfaced by ResourceContextViewNotices, hosted
                   once in MainLayout above the page body -- render nothing here. *@
            }
            else if (!string.IsNullOrEmpty(_error))
            {
                <ErrorState Message="@_error" />
            }
            else if (_connections is null)
            {
                <LoadingState Message="Loading connections…" />
            }
            else if (_connections.Count == 0)
            {
                <EmptyState Message="No connections found." />
            }
            else
            {
                <div class="ui-data-table">
                    <table class="ui-data-table__table min-w-full text-left text-body">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Connector</th>
                                <th>State</th>
                                <th>Scope</th>
                                <th>Used in</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in _connections)
                            {
                                <tr class="cursor-pointer"
                                    @onclick="@(() => Nav.NavigateTo("/connections/" + Uri.EscapeDataString(c.Id)))">
                                    <td class="font-medium">@c.Name</td>
                                    <td class="font-mono text-xs">@c.ConnectorDefinitionId</td>
                                    <td>@c.State</td>
                                    <td class="text-muted">@(c.ScopeKey ?? "—")</td>
                                    <td>
                                        @if (c.UsedIn is { Count: > 0 })
                                        {
                                            <div class="flex flex-wrap gap-x-2 gap-y-1">
                                                @foreach (var u in c.UsedIn)
                                                {
                                                    <a href="@("/modules/" + Uri.EscapeDataString(u.ModuleId))"
                                                       class="underline text-xs hover:text-heading"
                                                       @onclick:stopPropagation>
                                                        @u.ModuleId, @u.SlotName
                                                    </a>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-muted">—</span>
                                        }
                                    </td>
                                    <td>
                                        <a href="@("/connections/" + Uri.EscapeDataString(c.Id))" class="underline text-sm" @onclick:stopPropagation>Open</a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        }
        else if (_activeTab == "connectors" && _capabilities?.CanViewConnectorDefinitions == true)
        {
            <ConnectorsListContent />
        }
    }
</div>

@code {
    private IReadOnlyList<ConnectionDto>? _connections;
    private OperatorCapabilitiesDto? _capabilities;
    private bool _capabilitiesLoaded;
    private bool _loading;
    private string? _error;
    private string _activeTab = "connections";
    private int _sharedConnectionCount;

    [SupplyParameterFromQuery(Name = "context")]
    public string? QueryContext { get; set; }

    private ScopedListContextResolution _context = new(ScopedListContextState.AwaitingContext, null, null);
    private string? _loadedContextValue;

    private bool CanAccessPage =>
        _capabilities?.CanViewConnections == true || _capabilities?.CanViewConnectorDefinitions == true;

    private bool ShowTabs =>
        _capabilities?.CanViewConnections == true && _capabilities?.CanViewConnectorDefinitions == true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _capabilities = await Capabilities.GetCapabilitiesAsync();
        }
        catch
        {
            _capabilities = new OperatorCapabilitiesDto(false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false);
        }
        _capabilitiesLoaded = true;

        if (!CanAccessPage)
            return;

        if (_capabilities?.CanViewConnections != true && _capabilities?.CanViewConnectorDefinitions == true)
            _activeTab = "connectors";

        var uri = new Uri(Nav.Uri);
        if (!string.IsNullOrEmpty(uri.Query))
        {
            var query = uri.Query.TrimStart('?');
            foreach (var part in query.Split('&'))
            {
                var kv = part.Split('=', 2, StringSplitOptions.None);
                if (kv.Length == 2 && string.Equals(kv[0], "tab", StringComparison.OrdinalIgnoreCase))
                {
                    if (string.Equals(kv[1], "connectors", StringComparison.OrdinalIgnoreCase)
                        && _capabilities?.CanViewConnectorDefinitions == true)
                        _activeTab = "connectors";
                    else if (string.Equals(kv[1], "connections", StringComparison.OrdinalIgnoreCase)
                             && _capabilities?.CanViewConnections == true)
                        _activeTab = "connections";
                    break;
                }
            }
        }
    }

    private void SetTab(string tab)
    {
        _activeTab = tab;
        var uri = new Uri(Nav.Uri);
        var basePath = uri.GetLeftPart(UriPartial.Path);
        var queryParts = new List<string>();
        if (tab == "connectors")
            queryParts.Add("tab=connectors");
        if (!string.IsNullOrEmpty(_context.QueryValue))
            queryParts.Add("context=" + Uri.EscapeDataString(_context.QueryValue));
        var newUri = queryParts.Count > 0 ? $"{basePath}?{string.Join("&", queryParts)}" : basePath;
        if (Nav.Uri != newUri)
            Nav.NavigateTo(newUri);
    }

    protected override async Task OnParametersSetAsync()
    {
        _context = ScopedListContextFilter.Resolve(QueryContext, ViewState.KnownContexts);
        if (_context.State == ScopedListContextState.UnknownContext)
        {
            await ViewState.EnsureUrlTokenKnownAsync(_context.QueryValue);
            _context = ScopedListContextFilter.Resolve(QueryContext, ViewState.KnownContexts);
        }

        if (_context.State != ScopedListContextState.Ready)
        {
            // AwaitingContext (or still-UnknownContext after the retry): the URL is either mid-rewrite
            // -- ResourceContextViewState.OnLocationChanged is still awaiting its JS call before it
            // settles on a resolved ?context= -- or names something invalid. Either way, do not leave a
            // previously-loaded context's rows on screen while this resolves; clear them so the existing
            // loading state (or the UnknownContext branch, which renders nothing) is what's shown. Reset
            // _loadedContextValue too, so the same context resolving again afterward is treated as a
            // fresh load rather than skipped as "already loaded".
            _connections = null;
            _error = null;
            _loadedContextValue = null;
            return;
        }

        if (_context.LoadKey == _loadedContextValue)
            return;

        _loadedContextValue = _context.LoadKey;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_capabilities?.CanViewConnections != true) return;
        _loading = true;
        _error = null;
        try
        {
            _connections = await Client.GetConnectionsAsync(_context.ApiFilter);
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
            // Reset alongside _connections' implicit staleness so a later failed reload can't leave a
            // stale "N Shared connections" notice showing above the ErrorState this sets.
            _sharedConnectionCount = 0;
            _loading = false;
            return;
        }

        try
        {
            var summary = await ViewState.GetOwnershipSummaryAsync();
            _sharedConnectionCount = summary.TryGetValue(ResourceContextIds.SharedValue, out var sharedSummary)
                ? sharedSummary.ActiveConnections ?? 0
                : 0;
        }
        catch (HttpRequestException)
        {
            // The Shared-available notice is an enhancement on top of the primary connections list,
            // which has already loaded successfully at this point (see the try block above) -- a
            // transient failure fetching the ownership summary must not set _error and hide that
            // already-loaded table behind ErrorState. Degrade gracefully: suppress the notice instead.
            _sharedConnectionCount = 0;
        }

        _loading = false;
    }
}
