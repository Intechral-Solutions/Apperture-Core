@* Epic 51: Definition-aware Clients tab content. *@
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Client.Organisms
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities

<div class="mt-4">
    <div class="mb-4 flex items-center justify-between gap-4">
        <p class="text-sm text-muted">
            Available client definitions. These are higher-level abstractions over connections.
            Client usage and execution will be configured in Integrations (future).
        </p>
        <button type="button"
                class="rounded bg-surface-muted px-3 py-2 text-sm text-body hover:bg-surface disabled:opacity-50"
                disabled="@_loading"
                @onclick="LoadAsync">
            Refresh
        </button>
    </div>

    @if (!_capabilitiesLoaded)
    {
        <PageMessage Kind="PageMessageKind.Loading" Message="Loading…" />
    }
    else if (_capabilities?.CanViewConnections != true)
    {
        <PageMessage Kind="PageMessageKind.Forbidden"
                     Title="Not authorized"
                     Message="You do not have permission to view client definitions." />
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <PageMessage Kind="PageMessageKind.Error" Title="Error" Message="@_error" />
    }
    else if (_definitions is null)
    {
        <PageMessage Kind="PageMessageKind.Loading" Message="Loading client definitions…" />
    }
    else if (_definitions.Count == 0)
    {
        <PageMessage Kind="PageMessageKind.Empty" Message="No client definitions found." />
    }
    else
    {
        <div class="overflow-x-auto rounded border border-default bg-surface">
            <table class="min-w-full text-left text-sm text-body">
                <thead class="border-b border-default text-xs text-muted">
                    <tr>
                        <th class="px-3 py-2">Display Name</th>
                        <th class="px-3 py-2">Connector</th>
                        <th class="px-3 py-2">Module</th>
                        <th class="px-3 py-2">Uses Gateway</th>
                        <th class="px-3 py-2">Operations</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var d in _definitions)
                    {
                        <tr class="border-b border-default hover:bg-surface-muted">
                            <td class="px-3 py-2 font-medium">@d.DisplayName</td>
                            <td class="px-3 py-2 font-mono text-xs">@d.RequiredConnectorDefinitionId</td>
                            <td class="px-3 py-2">@(d.ModuleId ?? "Platform")</td>
                            <td class="px-3 py-2">@(d.UsesGateway ? "Yes" : "No")</td>
                            <td class="px-3 py-2">@d.Operations.Count</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private IReadOnlyList<ClientDefinitionDto>? _definitions;
    private OperatorCapabilitiesDto? _capabilities;
    private bool _capabilitiesLoaded;
    private bool _loading;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _capabilities = await Capabilities.GetCapabilitiesAsync();
        }
        catch
        {
            _capabilities = new OperatorCapabilitiesDto(false, false, false, false, false, false, false, false, false, false, false, false, false, false);
        }
        _capabilitiesLoaded = true;

        if (_capabilities?.CanViewConnections == true)
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_capabilities?.CanViewConnections != true) return;
        _loading = true;
        _error = null;
        try
        {
            _definitions = await Client.GetClientDefinitionsAsync();
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
