@page "/account"
@layout MainLayout
@implements IDisposable
@using System.Net.Http
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Organisms
@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Shared
@inject SessionStateService Session
@inject IManagementClient Client

<div class="p-4 md:p-6">
    <PageHeader Title="Account"
                Subtitle="Your platform identity and security settings." />

    @if (Session.State is SessionLoadState.Unknown or SessionLoadState.Loading)
    {
        <p class="mt-6 text-sm text-muted">Loading account…</p>
    }
    else if (Session.State == SessionLoadState.ForbiddenUnlinked)
    {
        <div class="mt-6 max-w-2xl">
            <PageMessage Kind="PageMessageKind.Warning"
                         Title="Account not linked"
                         Message="You are signed in with an organizational identity that is not linked to a platform user. Contact an administrator to link your account before using management features." />
        </div>
    }
    else if (_loadError is not null)
    {
        <div class="mt-6">
            <ErrorState Message="@_loadError" />
        </div>
    }
    else if (_me is null)
    {
        <p class="mt-6 text-sm text-muted">Sign in to view your account.</p>
    }
    else
    {
        <div class="mt-6 max-w-2xl space-y-6">
            <section class="rounded border border-default bg-surface p-4">
                <h2 class="text-sm font-medium text-heading">Identity</h2>
                <dl class="mt-3 grid gap-2 text-sm sm:grid-cols-[minmax(8rem,auto)_1fr]">
                    <dt class="text-muted">Display name</dt>
                    <dd class="text-body">@_me.DisplayName</dd>
                    <dt class="text-muted">User id</dt>
                    <dd class="font-mono text-xs text-body">@_me.UserId</dd>
                    <dt class="text-muted">Sign-in method</dt>
                    <dd class="text-body">@FormatSignInSource(_me.SignInSource)</dd>
                    @if (!string.IsNullOrWhiteSpace(_me.UserPrincipal))
                    {
                        <dt class="text-muted">Principal</dt>
                        <dd class="text-body">@_me.UserPrincipal</dd>
                    }
                </dl>
            </section>

            <section class="rounded border border-default bg-surface p-4">
                <h2 class="text-sm font-medium text-heading">Linked sign-in methods</h2>
                @if (_me.IdentityLinks.Count == 0)
                {
                    <p class="mt-2 text-sm text-muted">No linked identities recorded.</p>
                }
                else
                {
                    <ul class="mt-3 divide-y divide-default text-sm">
                        @foreach (var link in _me.IdentityLinks)
                        {
                            <li class="flex flex-wrap items-baseline justify-between gap-2 py-2">
                                <span class="text-body">@link.DisplayLabel</span>
                                <span class="text-xs text-muted">@link.Source</span>
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="rounded border border-default bg-surface p-4">
                <h2 class="text-sm font-medium text-heading">Roles</h2>
                @if (_me.RoleNames.Count == 0)
                {
                    <p class="mt-2 text-sm text-muted">No roles assigned.</p>
                }
                else
                {
                    <ul class="mt-3 flex flex-wrap gap-2">
                        @foreach (var name in _me.RoleNames)
                        {
                            <li class="rounded bg-surface-muted px-2 py-1 text-xs text-body">@name</li>
                        }
                    </ul>
                }
            </section>

            <section class="rounded border border-default bg-surface p-4">
                <h2 class="text-sm font-medium text-heading">Security</h2>
                <p class="mt-1 text-sm text-muted">
                    Local credential:
                    <span class="text-body">@FormatCredentialStatus(_me.LocalCredentialStatus)</span>
                </p>

                @if (_me.CanChangeLocalPassword)
                {
                    <form class="mt-4 space-y-3" @onsubmit="ChangePasswordAsync" @onsubmit:preventDefault="true">
                        <div>
                            <label class="block text-xs font-medium text-muted" for="current-password">Current password</label>
                            <input id="current-password"
                                   type="password"
                                   autocomplete="current-password"
                                   class="mt-1 w-full max-w-md rounded border border-default bg-surface px-3 py-2 text-sm"
                                   @bind="_currentPassword" />
                        </div>
                        <div>
                            <label class="block text-xs font-medium text-muted" for="new-password">New password</label>
                            <input id="new-password"
                                   type="password"
                                   autocomplete="new-password"
                                   class="mt-1 w-full max-w-md rounded border border-default bg-surface px-3 py-2 text-sm"
                                   @bind="_newPassword" />
                        </div>
                        @if (!string.IsNullOrEmpty(_passwordError))
                        {
                            <PageMessage Kind="PageMessageKind.Error" Message="@_passwordError" />
                        }
                        @if (_passwordSuccess)
                        {
                            <PageMessage Kind="PageMessageKind.Info" Message="Password updated successfully." />
                        }
                        <button type="submit"
                                class="rounded bg-surface-muted px-4 py-2 text-sm font-medium text-heading hover:bg-surface disabled:opacity-50"
                                disabled="@_passwordBusy">
                            @(_passwordBusy ? "Updating…" : "Change password")
                        </button>
                    </form>
                }
                else
                {
                    <div class="mt-3">
                        <PageMessage Kind="PageMessageKind.Info"
                                     Message="@PasswordChangeUnavailableMessage(_me.LocalCredentialStatus)" />
                    </div>
                }
            </section>

            @if (_me.Deferred is not null)
            {
                <section class="rounded border border-default bg-surface p-4">
                    <h2 class="text-sm font-medium text-heading">Coming later</h2>
                    <p class="mt-2 text-sm text-muted">@_me.Deferred.Message</p>
                </section>
            }
        </div>
    }
</div>

@code {
    private MeResponse? _me;
    private string? _loadError;
    private string _currentPassword = "";
    private string _newPassword = "";
    private string? _passwordError;
    private bool _passwordBusy;
    private bool _passwordSuccess;

    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;
        await LoadAsync();
    }

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
    }

    private void OnSessionChanged() => _ = InvokeAsync(LoadAsync);

    private async Task LoadAsync()
    {
        if (Session.State is SessionLoadState.Unknown or SessionLoadState.Loading or SessionLoadState.ForbiddenUnlinked)
            return;

        _loadError = null;
        try
        {
            _me = await Client.GetMeAsync();
            if (_me is null)
                _me = Session.User;
        }
        catch (HttpRequestException ex)
        {
            _loadError = ex.Message;
            _me = null;
        }
    }

    private async Task ChangePasswordAsync()
    {
        _passwordError = null;
        _passwordSuccess = false;
        _passwordBusy = true;
        try
        {
            await Client.ChangeLocalPasswordAsync(new ChangeLocalPasswordRequest(_currentPassword, _newPassword));
            _currentPassword = "";
            _newPassword = "";
            _passwordSuccess = true;
            await Session.RefreshAsync();
            _me = Session.User ?? _me;
        }
        catch (HttpRequestException ex)
        {
            _passwordError = ex.Message;
        }
        finally
        {
            _passwordBusy = false;
        }
    }

    private static string FormatSignInSource(string source) =>
        source switch
        {
            "Local" => "Local username and password",
            "Entra" => "Microsoft Entra ID",
            _ => source
        };

    private static string FormatCredentialStatus(string status) =>
        status switch
        {
            "active" => "Active",
            "disabled" => "Disabled",
            "none" => "Not configured",
            _ => status
        };

    private static string PasswordChangeUnavailableMessage(string status) =>
        status switch
        {
            "disabled" => "Local sign-in is disabled for your account. Contact an administrator to re-enable it or reset your password.",
            "none" => "This account does not have an active local password. Use your organizational sign-in or ask an administrator to set a local password.",
            _ => "Password change is not available for your account in this release."
        };
}
