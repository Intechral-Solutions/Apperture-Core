@page "/attention/contact-groups/{Id}"
@page "/attention/operational-teams/{Id}"
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Organisms
@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Shared
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities
@inject NavigationManager Nav
@inject ShellOrientationService ShellOrientation

<div class="p-4">
    <PageHeader @key="@Id"
                Eyebrow="Operational teams"
                Title="@EntityShellTitles.Detail(_detail?.Name, "Operational team")"
                Subtitle="@TeamHeaderSubtitle">
        <ChildContent>
            <div class="mt-1 font-mono text-xs text-muted break-all">@Id</div>
        </ChildContent>
        <Toolbar>
            <a href="/attention/operational-teams" class="ui-toolbar-btn">All teams</a>
        </Toolbar>
    </PageHeader>

    @if (!string.IsNullOrEmpty(_error))
    {
        <ErrorState Message="@_error" />
    }
    else if (_detail is null)
    {
        <LoadingState Message="Loading…" />
    }
    else
    {
        @if (_capabilities?.CanManageSchedules == true)
        {
            <div class="mt-4 space-y-4">
            <ManagementSection Title="Team" Layer="ManagementSection.UiLayer.Detail">
                <label class="block text-xs text-muted">Name</label>
                <input class="ui-input mt-1 max-w-md" @bind="_editName" />
                <label class="mt-3 block text-xs text-muted">Description</label>
                <input class="ui-input mt-1 max-w-xl" @bind="_editDescription" />
                <label class="mt-3 flex items-center gap-2 text-sm">
                    <input type="checkbox" @bind="_editEnabled" />
                    Enabled
                </label>
                <button type="button" class="btn btn-primary mt-3" disabled="@_savingMeta" @onclick="SaveMetaAsync">Save team</button>
            </ManagementSection>

            <ManagementSection Title="Members (one row per line)" Layer="ManagementSection.UiLayer.Detail">
                <textarea class="ui-input mt-1 min-h-[160px] font-mono" @bind="_membersRaw"></textarea>
                <div class="mt-2 text-xs text-muted">Accepted formats: <span class="font-mono">user_123</span> (principal), <span class="font-mono">mcontact_…</span> (managed contact id), email for external, or <span class="font-mono">managed,mcontact_…[,Display]</span>, <span class="font-mono">principal,…</span>, <span class="font-mono">external,…</span>.</div>
                <div class="text-xs text-muted">Manage users at <a class="underline" href="/config/governance/users">/config/governance/users</a>.</div>
                <button type="button" class="btn btn-primary mt-3" disabled="@_savingMembers" @onclick="SaveMembersAsync">Replace members</button>
            </ManagementSection>
            </div>
        }
        else
        {
            <div class="mt-4 text-sm text-muted">Read-only (schedule.manage required to edit).</div>
            <div class="mt-2 text-sm">Enabled: @(_detail.IsEnabled ? "Yes" : "No")</div>
            @if (!string.IsNullOrEmpty(_detail.Description))
            {
                <div class="mt-2 text-sm">@_detail.Description</div>
            }
        }

        <ManagementSection Title="Members" Layer="ManagementSection.UiLayer.Detail">
            @if (_detail.Members.Count == 0)
            {
                <div class="text-sm text-muted">No members.</div>
            }
            else
            {
                <div class="ui-data-table">
                    <table class="ui-data-table__table min-w-full text-left text-body">
                        <thead>
                            <tr>
                                <th>Kind</th>
                                <th>Value</th>
                                <th>Display</th>
                                <th>Enabled</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var m in _detail.Members)
                            {
                                <tr>
                                    <td class="text-xs">@m.MemberKind</td>
                                    <td class="font-mono text-xs">@MemberValue(m)</td>
                                    <td>@(m.DisplayName ?? "—")</td>
                                    <td>@(m.IsEnabled ? "Yes" : "No")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </ManagementSection>
    }
</div>

@code {
    [Parameter] public string Id { get; set; } = "";

    private string TeamHeaderSubtitle =>
        _detail is null
            ? "Operational team"
            : _detail.IsEnabled ? "Enabled" : "Disabled";

    private OperationalTeamDetailDto? _detail;
    private OperatorCapabilitiesDto? _capabilities;
    private string _editName = "";
    private string _editDescription = "";
    private bool _editEnabled = true;
    private string _membersRaw = "";
    private bool _savingMeta;
    private bool _savingMembers;
    private string? _error;

    private string? _dataLoadKey;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _capabilities = await Capabilities.GetCapabilitiesAsync();
        }
        catch
        {
            _capabilities = null;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        var key = Id ?? "";
        if (key == _dataLoadKey)
            return;

        _dataLoadKey = key;
        _detail = null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            _detail = await Client.GetOperationalTeamAsync(Id);
            if (_detail is null)
            {
                _error = "Team not found.";
                return;
            }
            _editName = _detail.Name;
            _editDescription = _detail.Description ?? "";
            _editEnabled = _detail.IsEnabled;
            _membersRaw = string.Join(
                Environment.NewLine,
                _detail.Members.Select(m =>
                    string.IsNullOrEmpty(m.DisplayName)
                        ? $"{MemberKindToken(m.MemberKind)},{MemberValue(m)}"
                        : $"{MemberKindToken(m.MemberKind)},{MemberValue(m)},{m.DisplayName}"));
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            ShellOrientation.PublishForCurrentUri(
                Nav,
                EntityShellTitles.Detail(_detail?.Name, "Operational team"),
                TeamHeaderSubtitle);
        }
    }

    private async Task SaveMetaAsync()
    {
        if (_detail is null || _capabilities?.CanManageSchedules != true)
            return;
        _savingMeta = true;
        _error = null;
        try
        {
            var updated = await Client.UpdateOperationalTeamAsync(
                Id,
                new UpdateOperationalTeamRequest(_editName, string.IsNullOrWhiteSpace(_editDescription) ? null : _editDescription, _editEnabled));
            if (updated is null)
                _error = "Update failed.";
            else
                _detail = updated;
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _savingMeta = false;
        }
    }

    private async Task SaveMembersAsync()
    {
        if (_detail is null || _capabilities?.CanManageSchedules != true)
            return;
        _savingMembers = true;
        _error = null;
        try
        {
            var lines = _membersRaw.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);
            var inputs = new List<OperationalTeamMemberInputDto>();
            foreach (var line in lines)
            {
                var parts = line.Split(',', 3, StringSplitOptions.TrimEntries);
                if (parts.Length == 0)
                    continue;

                // Convenience: plain token means principal user id unless it looks like an email.
                if (parts.Length == 1)
                {
                    var valueOnly = parts[0].Trim();
                    if (valueOnly.Length == 0)
                        continue;

                    if (LooksLikeEmail(valueOnly))
                    {
                        inputs.Add(new OperationalTeamMemberInputDto(null, "ExternalEmail", null, valueOnly, null, null, IsEnabled: true));
                    }
                    else if (valueOnly.StartsWith("mcontact_", StringComparison.OrdinalIgnoreCase))
                    {
                        inputs.Add(new OperationalTeamMemberInputDto(null, "ManagedContact", null, null, valueOnly, null, IsEnabled: true));
                    }
                    else
                    {
                        inputs.Add(new OperationalTeamMemberInputDto(null, "Principal", valueOnly, null, null, null, IsEnabled: true));
                    }
                    continue;
                }

                var kindRaw = parts[0].Trim().ToLowerInvariant();
                var value = parts[1].Trim();
                var display = parts.Length > 2 ? parts[2].Trim() : null;
                if (value.Length == 0)
                    continue;
                if (kindRaw is "principal" or "p")
                {
                    inputs.Add(new OperationalTeamMemberInputDto(null, "Principal", value, null, null, string.IsNullOrEmpty(display) ? null : display, IsEnabled: true));
                }
                else if (kindRaw is "external" or "email" or "e")
                {
                    inputs.Add(new OperationalTeamMemberInputDto(null, "ExternalEmail", null, value, null, string.IsNullOrEmpty(display) ? null : display, IsEnabled: true));
                }
                else if (kindRaw is "managed" or "mc" or "contact")
                {
                    inputs.Add(new OperationalTeamMemberInputDto(null, "ManagedContact", null, null, value, string.IsNullOrEmpty(display) ? null : display, IsEnabled: true));
                }
                else
                {
                    _error = $"Unrecognized member kind '{parts[0]}'. Use principal, external, or managed, or provide a plain user id / mcontact id / email.";
                    return;
                }
            }
            var updated = await Client.ReplaceOperationalTeamMembersAsync(
                Id,
                new ReplaceOperationalTeamMembersRequest(inputs));
            if (updated is null)
                _error = "Save members failed.";
            else
                _detail = updated;
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _savingMembers = false;
        }
    }

    private static string MemberKindToken(string kind)
    {
        if (string.Equals(kind, "Principal", StringComparison.OrdinalIgnoreCase))
            return "principal";
        if (string.Equals(kind, "ManagedContact", StringComparison.OrdinalIgnoreCase))
            return "managed";
        return "external";
    }

    private static string? MemberValue(OperationalTeamMemberDto member)
    {
        if (string.Equals(member.MemberKind, "Principal", StringComparison.OrdinalIgnoreCase))
            return member.PrincipalUserId;
        if (string.Equals(member.MemberKind, "ManagedContact", StringComparison.OrdinalIgnoreCase))
            return member.ManagedContactId;
        return member.EmailAddress;
    }

    private static bool LooksLikeEmail(string value) =>
        value.Contains('@') && value.Contains('.');
}
