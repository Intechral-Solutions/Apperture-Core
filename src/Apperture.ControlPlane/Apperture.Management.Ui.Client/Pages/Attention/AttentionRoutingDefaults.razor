@page "/attention/routing-defaults"
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Organisms
@using Apperture.Management.Ui.Client.Molecules
@using Apperture.Management.Ui.Client.Services
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities

<div class="p-4 ui-page-stack">
    <PageHeader Title="Attention routing defaults"
                Subtitle="Instance-wide routing for expected_run_missing." />

    @if (!string.IsNullOrEmpty(_error))
    {
        <ErrorState Message="@_error" />
    }
    else if (_routing is null || _groups is null)
    {
        <LoadingState Message="Loading…" />
    }
    else
    {
        <ManagementSection Title="Effective routing" Layer="ManagementSection.UiLayer.Summary">
            <MetadataGrid>
                <MetadataItem Label="Primary recipients">
                    @(_routing.PrimaryRecipients.Count > 0 ? string.Join(", ", _routing.PrimaryRecipients) : "—")
                </MetadataItem>
                <MetadataItem Label="Primary routing note" Value="@NoRouteHint(_routing.PrimaryNoRouteReason)" />
                <MetadataItem Label="Escalation recipients">
                    @(_routing.EscalationRecipients.Count > 0 ? string.Join(", ", _routing.EscalationRecipients) : "—")
                </MetadataItem>
                <MetadataItem Label="Escalation routing note" Value="@NoRouteHint(_routing.EscalationNoRouteReason)" />
                <MetadataItem Label="Has route / enabled" Value="@($"{_routing.HasRoute} / {_routing.Enabled}")" />
                <MetadataItem Label="Escalation after / reminder" Value="@($"{FmtTicks(_routing.EscalationAfterTicks)} / {FmtTicks(_routing.ReminderIntervalTicks)}")" />
            </MetadataGrid>
        </ManagementSection>

        @if (_capabilities?.CanManageSchedules == true)
        {
            <ManagementSection Title="Edit defaults" Layer="ManagementSection.UiLayer.Detail">
                <label class="flex items-center gap-2 text-sm">
                    <input type="checkbox" @bind="_editEnabled" />
                    Enabled
                </label>
                <label class="mt-2 flex items-center gap-2 text-sm">
                    <input type="checkbox" @bind="_editSendResolved" />
                    Send resolved notification
                </label>
                <label class="mt-2 flex items-center gap-2 text-sm">
                    <input type="checkbox" @bind="_editSuppressRem" />
                    Suppress reminders when acknowledged
                </label>
                <label class="mt-2 flex items-center gap-2 text-sm">
                    <input type="checkbox" @bind="_editSuppressEsc" />
                    Suppress escalation when acknowledged
                </label>
                <label class="mt-3 block text-xs text-muted">Primary operational team</label>
                <select class="ui-input mt-1 max-w-xl" @bind="_primaryGroupId">
                    <option value="">— None —</option>
                    @foreach (var g in _groups.Where(x => x.IsEnabled))
                    {
                        <option value="@g.Id">@g.Name (@g.Id)</option>
                    }
                </select>
                <label class="mt-3 block text-xs text-muted">Escalation operational team</label>
                <select class="ui-input mt-1 max-w-xl" @bind="_escalationGroupId">
                    <option value="">— None —</option>
                    @foreach (var g in _groups.Where(x => x.IsEnabled))
                    {
                        <option value="@g.Id">@g.Name (@g.Id)</option>
                    }
                </select>
                <button type="button" class="btn btn-primary mt-4" disabled="@_saving" @onclick="SaveAsync">Save</button>
            </ManagementSection>
        }
        else
        {
            <div class="text-sm text-muted">Read-only (schedule.manage required to edit).</div>
        }
    }
</div>

@code {
    private AttentionRoutingEffectiveDto? _routing;
    private IReadOnlyList<OperationalTeamSummaryDto>? _groups;
    private OperatorCapabilitiesDto? _capabilities;
    private bool _editEnabled;
    private bool _editSendResolved;
    private bool _editSuppressRem;
    private bool _editSuppressEsc;
    private string? _primaryGroupId;
    private string? _escalationGroupId;
    private bool _saving;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _capabilities = await Capabilities.GetCapabilitiesAsync();
        }
        catch
        {
            _capabilities = null;
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            _routing = await Client.GetAttentionRoutingDefaultsAsync();
            _groups = await Client.ListOperationalTeamsAsync(includeDisabled: false);
            if (_routing is not null)
            {
                _editEnabled = _routing.Enabled;
                _editSendResolved = _routing.SendResolvedNotification;
                _editSuppressRem = _routing.SuppressRemindersWhenAcknowledged;
                _editSuppressEsc = _routing.SuppressEscalationWhenAcknowledged;
                _primaryGroupId = _routing.PrimaryOperationalTeamId ?? "";
                _escalationGroupId = _routing.EscalationOperationalTeamId ?? "";
            }
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
    }

    private async Task SaveAsync()
    {
        if (_routing is null || _capabilities?.CanManageSchedules != true)
            return;
        _saving = true;
        _error = null;
        try
        {
            await Client.PutAttentionRoutingDefaultsAsync(
                new UpsertAttentionRoutingRequest(
                    _editEnabled,
                    _editSendResolved,
                    _editSuppressRem,
                    _editSuppressEsc,
                    _routing.EscalationAfterTicks,
                    _routing.ReminderIntervalTicks,
                    string.IsNullOrWhiteSpace(_primaryGroupId) ? null : _primaryGroupId,
                    string.IsNullOrWhiteSpace(_escalationGroupId) ? null : _escalationGroupId));
            await LoadAsync();
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private static string FmtTicks(long? ticks) =>
        ticks is { } t ? TimeSpan.FromTicks(t).ToString() : "—";

    private static string NoRouteHint(string? reason) => reason switch
    {
        "no_team_configured" => "No team configured for this role.",
        "team_disabled" => "Team is disabled.",
        "team_empty" => "Team has no enabled members.",
        "principal_members_no_email" => "Principal members exist, but none has a deliverable email.",
        "managed_contact_members_no_deliverable_email" => "Managed-contact members exist, but none has a deliverable email.",
        "member_recipients_no_deliverable_email" => "Team members include multiple kinds, but none yields a deliverable email address.",
        _ => ""
    };
}
