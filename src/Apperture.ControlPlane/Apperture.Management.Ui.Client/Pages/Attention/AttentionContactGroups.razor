@page "/attention/contact-groups"
@page "/attention/operational-teams"
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Organisms
@using Apperture.Management.Ui.Client.Services
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities
@inject NavigationManager Nav

<div class="p-4 ui-page-stack">
    <PageHeader Title="Operational teams"
                Subtitle="Principal-aware ownership teams for schedule attention routing (expected_run_missing).">
        <Toolbar>
            @if (_capabilities?.CanManageSchedules == true)
            {
                <button type="button"
                        class="btn btn-primary"
                        disabled="@_busy"
                        @onclick="CreateGroupAsync">
                    New team
                </button>
            }
            <button type="button"
                    class="ui-toolbar-btn"
                    disabled="@_loading"
                    @onclick="LoadAsync">
                Refresh
            </button>
        </Toolbar>
    </PageHeader>

    @if (!string.IsNullOrEmpty(_error))
    {
        <ErrorState Message="@_error" />
    }
    else if (_groups is null)
    {
        <LoadingState Message="Loading…" />
    }
    else if (_groups.Count == 0)
    {
        <EmptyState Message="No operational teams yet." />
    }
    else
    {
        <div class="ui-data-table">
            <table class="ui-data-table__table min-w-full text-left text-body">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Enabled</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var g in _groups)
                    {
                        <tr class="cursor-pointer"
                            @onclick="@(() => Nav.NavigateTo("/attention/operational-teams/" + Uri.EscapeDataString(g.Id)))">
                            <td class="font-mono text-xs">@g.Id</td>
                            <td>@g.Name</td>
                            <td>@(g.IsEnabled ? "Yes" : "No")</td>
                            <td>
                                <a href="@("/attention/operational-teams/" + Uri.EscapeDataString(g.Id))" class="underline text-sm" @onclick:stopPropagation>Open</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private IReadOnlyList<OperationalTeamSummaryDto>? _groups;
    private OperatorCapabilitiesDto? _capabilities;
    private bool _loading = true;
    private bool _busy;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _capabilities = await Capabilities.GetCapabilitiesAsync();
        }
        catch
        {
            _capabilities = null;
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _groups = await Client.ListOperationalTeamsAsync(includeDisabled: true);
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
            _groups = Array.Empty<OperationalTeamSummaryDto>();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task CreateGroupAsync()
    {
        if (_capabilities?.CanManageSchedules != true)
            return;
        _busy = true;
        _error = null;
        try
        {
            var created = await Client.CreateOperationalTeamAsync(
                new CreateOperationalTeamRequest("New operational team", null, IsEnabled: true));
            Nav.NavigateTo("/attention/operational-teams/" + Uri.EscapeDataString(created.Id));
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }
}
