@page "/modules/{ModuleId}"
@using System.Net
@using Apperture.Management.Ui.Client.Molecules
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Client.Organisms
@using Apperture.Management.Ui.Shared
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities
@inject NavigationManager Nav
@inject ShellOrientationService ShellOrientation

<div class="p-4 ui-page-stack">
    <PageHeader @key="@ModuleId"
                Eyebrow="Modules"
                Title="@EntityShellTitles.Detail(_module?.Name, "Module")"
                Subtitle="@ModuleHeaderSubtitle">
        <ChildContent>
            <div class="mt-1 font-mono text-xs text-muted break-all">@ModuleId</div>
        </ChildContent>
        <Toolbar>
            <a href="/modules" class="ui-toolbar-btn">Back to list</a>
            <button type="button"
                    class="ui-toolbar-btn"
                    disabled="@_loading"
                    @onclick="RefreshAsync">
                Refresh
            </button>
        </Toolbar>
    </PageHeader>

    @if (!string.IsNullOrEmpty(_error))
    {
        <ErrorState Message="@_error" />
    }
    else if (_loading && _module is null && string.IsNullOrEmpty(_actionMessage))
    {
        <LoadingState Message="Loading…" />
    }
    else if (_module is null && string.IsNullOrEmpty(_actionMessage))
    {
        <EmptyState Title="Module not found"
                    Message="The requested module could not be loaded." />
    }
    else
    {
        @if (!string.IsNullOrEmpty(_actionMessage))
        {
            <ActionFeedback Message="@_actionMessage" />
        }

        @if (_module is not null)
        {
        <div class="grid gap-4">
            @if (_capabilities?.CanManageModules == true)
            {
                <div class="ui-detail-block">
                    <div class="text-sm font-semibold text-heading">Lifecycle actions</div>
                    <div class="text-xs text-muted mt-1">Safe actions supported by the backend. Disabled when not applicable.</div>
                    <div class="ui-section-actions">
                        <button type="button"
                                class="ui-toolbar-btn"
                                disabled="@(_loading || !CanInstall)"
                                title="@(CanInstall ? "Install module" : "Already installed or not applicable")"
                                @onclick="InstallAsync">
                            Install
                        </button>
                        <button type="button"
                                class="ui-toolbar-btn"
                                disabled="@(_loading || !CanEnable)"
                                title="@(CanEnable ? "Enable module" : "Already enabled or not applicable")"
                                @onclick="EnableAsync">
                            Enable
                        </button>
                        <button type="button"
                                class="ui-toolbar-btn"
                                disabled="@(_loading || !CanDisable)"
                                title="@(CanDisable ? "Disable module" : "Already disabled or not applicable")"
                                @onclick="DisableAsync">
                            Disable
                        </button>
                        <button type="button"
                                class="ui-toolbar-btn"
                                disabled="@(_loading || !CanUninstall)"
                                title="@(CanUninstall ? "Uninstall module" : "Not installed or not applicable")"
                                @onclick="UninstallAsync">
                            Uninstall
                        </button>
                    </div>
                </div>
            }

            <div class="ui-detail-block">
                <div class="text-sm font-semibold text-heading">State</div>
                <div class="mt-3">
                <MetadataGrid>
                    <MetadataItem Label="Name" Value="@_module.Name" />
                    <MetadataItem Label="Version" Value="@_module.Version" />
                    <MetadataItem Label="Lifecycle state" Monospace="true" Value="@_module.State" />
                    <MetadataItem Label="Enabled (persisted)" Value="@(_module.Enabled ? "Yes" : "No")" />
                    <MetadataItem Label="Effectively active" Value="@(_module.EffectivelyActive ? "Yes" : "No")" />
                    <MetadataItem Label="Installed" Value="@(_module.Installed ? "Yes" : "No")" />
                    @if (ModuleContributionPresentation.Summary(_module.ContributionCounts) is { } contributes)
                    {
                        <MetadataItem Label="Contributes" Value="@contributes" />
                    }
                </MetadataGrid>
                </div>
                @if (_module.ValidationIssues is { Count: > 0 })
                {
                    <div class="mt-2">
                        <div class="text-xs text-muted">Validation issues / degraded reasons</div>
                        <div class="mt-1 space-y-1">
                            @foreach (var v in _module.ValidationIssues)
                            {
                                <div class="text-xs font-mono">@v.Code: @v.Message</div>
                            }
                        </div>
                    </div>
                }
            </div>

            <ManagementSection Title="Recent activity"
                               Layer="ManagementSection.UiLayer.Detail"
                               Help="@RecentActivityHelp">
                <EntityRecentActivityPanel Items="@_recentActivity"
                                           Loading="@_activityLoading"
                                           Error="@_activityError"
                                           EmptyMessage="No runs or audit events for this module in the last 7 days (or none visible to you).">
                    <FooterLinks>
                        <DrillInLink Href="@Epic33UiDisplayHelpers.GetRunsListModuleFilterHref(ModuleId)">View module runs</DrillInLink>
                        @if (_capabilities?.CanViewAudit == true)
                        {
                            <DrillInLink Href="@Epic33UiDisplayHelpers.GetAuditLinkForModule(ModuleId)">View audit for module</DrillInLink>
                        }
                    </FooterLinks>
                </EntityRecentActivityPanel>
            </ManagementSection>

            @* Components provided by this module: the same catalog projection as /components, filtered by module id (one
               query). Like "Integrations using this module" it is global -- no Context/View filter -- because Module and
               Component are both system/catalog concepts. The whole section is omitted (not shown empty) for a caller who
               can read no Component family, since an empty state would assert "this module provides none". *@
            @if (CanViewComponentFamilies && !_moduleComponentsForbidden)
            {
                <ManagementSection Title="Components provided by this module"
                                   Layer="ManagementSection.UiLayer.Detail">
                    @if (_moduleComponentsError is not null)
                    {
                        <ErrorState Message="@_moduleComponentsError" />
                    }
                    else if (_moduleComponentsLoading && _moduleComponents is null)
                    {
                        <LoadingState Message="Loading…" />
                    }
                    else if (_moduleComponents is { Count: > 0 })
                    {
                        <ul class="space-y-1">
                            @foreach (var component in _moduleComponents)
                            {
                                <li @key="(component.Kind + ':' + component.NativeId)">
                                    <a href="@ComponentCatalogPresentation.DetailHref(component.Kind, component.NativeId)"
                                       class="underline text-sm hover:text-heading">
                                        @component.DisplayName
                                    </a>
                                    <span class="text-xs text-muted"> · @ComponentCatalogPresentation.KindLabel(component.Kind)</span>
                                </li>
                            }
                        </ul>
                    }
                    else if (_moduleComponents is not null)
                    {
                        <EmptyState Message="@ComponentCatalogPresentation.ModuleComponentsEmptyMessage(CanViewAllComponentFamilies)" />
                    }
                </ManagementSection>
            }

            @if (_capabilities?.CanViewIntegrations == true)
            {
                <ManagementSection Title="Integrations using this module"
                                   Layer="ManagementSection.UiLayer.Detail">
                    @if (_moduleIntegrationsError is not null)
                    {
                        <ErrorState Message="@_moduleIntegrationsError" />
                    }
                    else if (_moduleIntegrationsLoading && _moduleIntegrations is null)
                    {
                        <LoadingState Message="Loading…" />
                    }
                    else if (_moduleIntegrations is { Count: > 0 })
                    {
                        <ul class="space-y-1">
                            @foreach (var integration in _moduleIntegrations)
                            {
                                <li>
                                    <a href="@("/integrations/" + Uri.EscapeDataString(integration.Id))"
                                       class="underline text-sm hover:text-heading">
                                        @integration.DisplayName
                                    </a>
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <EmptyState Message="No integrations currently use this module." />
                    }
                </ManagementSection>
            }

            <div class="ui-detail-block">
                <div class="text-sm font-semibold text-heading">Links</div>
                <div class="ui-action-row mt-2">
                    <a href="@Epic33UiDisplayHelpers.GetAuditLinkForModule(ModuleId)" class="ui-drill-in-link">View audit for this module</a>
                    <a href="@RunStatusFacets.BlockedRunsHref" class="ui-drill-in-link">Blocked runs</a>
                </div>
            </div>
        </div>
        }
    }
</div>

@code {
    [Parameter] public string ModuleId { get; set; } = "";

    private string ModuleHeaderSubtitle =>
        _module is null
            ? "Module detail"
            : $"{_module.Version} · {_module.State}";

    private ModuleDto? _module;
    private OperatorCapabilitiesDto? _capabilities;
    private bool _loading;
    private string? _error;
    private string? _actionMessage;
    private IReadOnlyList<EntityRecentActivityItem>? _recentActivity;
    private bool _activityLoading;
    private string? _activityError;
    private IReadOnlyList<IntegrationDto>? _moduleIntegrations;
    private bool _moduleIntegrationsLoading;
    private string? _moduleIntegrationsError;
    private IReadOnlyList<ComponentSummaryDto>? _moduleComponents;
    private bool _moduleComponentsLoading;
    private string? _moduleComponentsError;
    private bool _moduleComponentsForbidden;

    // Either Component family is enough to see the section; the server still decides per family what it returns.
    private bool CanViewComponentFamilies =>
        _capabilities?.CanViewConnectorDefinitions == true || _capabilities?.CanViewNotificationDefinitions == true;

    // A caller who can read only one family cannot conclude "none" from an empty result, so the empty copy is softened.
    private bool CanViewAllComponentFamilies =>
        _capabilities?.CanViewConnectorDefinitions == true && _capabilities?.CanViewNotificationDefinitions == true;

    private string RecentActivityHelp =>
        $"Merged from authorized runs (module definition) and audit (moduleId filter). Last {EntityRecentActivityComposer.DefaultLookback.Days} days, up to {EntityRecentActivityComposer.DefaultMaxItems} items.";

    private bool CanInstall => _module is not null && string.Equals(_module.State, "Discovered", StringComparison.OrdinalIgnoreCase);
    private bool CanEnable => _module is not null && string.Equals(_module.State, "InstalledDisabled", StringComparison.OrdinalIgnoreCase);
    private bool CanDisable => _module is not null && string.Equals(_module.State, "InstalledEnabled", StringComparison.OrdinalIgnoreCase);
    private bool CanUninstall => _module is not null && string.Equals(_module.State, "InstalledDisabled", StringComparison.OrdinalIgnoreCase);
    private string? _dataLoadKey;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        var key = ModuleId ?? "";
        if (key == _dataLoadKey)
            return;
        _dataLoadKey = key;
        _module = null;
        await LoadCapabilitiesAsync();
        await LoadAsync();
    }

    private async Task LoadCapabilitiesAsync()
    {
        try
        {
            _capabilities = await Capabilities.GetCapabilitiesAsync();
        }
        catch
        {
            _capabilities = new OperatorCapabilitiesDto(false, false, false, false, false, false, false);
        }
    }

    private Task RefreshAsync() => LoadAsync();

    private async Task LoadAsync(bool preserveActionFeedback = false)
    {
        if (string.IsNullOrWhiteSpace(ModuleId))
            return;

        _loading = true;
        _error = null;
        if (!preserveActionFeedback)
            _actionMessage = null;
        try
        {
            _module = await Client.GetModuleAsync(ModuleId);
            if (_module is not null)
            {
                // Show the Components section as loading (not a blank body) while recent activity loads first.
                _moduleComponentsLoading = CanViewComponentFamilies;
                await LoadRecentActivityAsync();
                await LoadModuleComponentsAsync();
                await LoadModuleIntegrationsAsync();
            }
            else
            {
                _recentActivity = null;
                _activityError = null;
                _moduleComponents = null;
                _moduleComponentsError = null;
                _moduleComponentsForbidden = false;
                _moduleIntegrations = null;
                _moduleIntegrationsError = null;
            }
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            // Every awaited section load has finished (or faulted) by now, so nothing may still read as loading.
            _moduleComponentsLoading = false;
            PublishShellTitle();
        }
    }

    private void PublishShellTitle() =>
        ShellOrientation.PublishForCurrentUri(
            Nav,
            EntityShellTitles.Detail(_module?.Name, "Module"),
            ModuleHeaderSubtitle);

    private async Task LoadModuleComponentsAsync()
    {
        _moduleComponentsForbidden = false;
        if (!CanViewComponentFamilies)
        {
            _moduleComponents = null;
            return;
        }

        _moduleComponentsLoading = true;
        _moduleComponentsError = null;
        _moduleComponents = null;
        try
        {
            // One catalog query filtered by this module id -- the same projection the /components page uses, so there
            // is a single contribution-discovery path. Global by design: no Context/View filter is applied.
            var result = await Client.GetComponentsAsync(moduleId: ModuleId);
            _moduleComponents = result.Items;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            // Every family was denied after all: omit the section instead of asserting the module provides none.
            _moduleComponentsForbidden = true;
        }
        catch (HttpRequestException ex)
        {
            _moduleComponentsError = ex.Message;
        }
        catch (Exception ex) when (ex is not OperationCanceledException)
        {
            // Anything else (for example a malformed payload) must not be rendered as "provides none".
            _moduleComponentsError = "Components could not be loaded.";
        }
        finally
        {
            _moduleComponentsLoading = false;
        }
    }

    private async Task LoadModuleIntegrationsAsync()
    {
        if (_capabilities?.CanViewIntegrations != true)
            return;

        _moduleIntegrationsLoading = true;
        _moduleIntegrationsError = null;
        _moduleIntegrations = null;
        try
        {
            // contextId is intentionally always null here: this section answers "where is this Module in
            // use," and Module is a system/catalog concept, not an Application-owned resource, so the
            // answer must span every ResourceContext the operator can see, not just the active shell View.
            // Do not apply the shell View/Context filter to this call (Components/Services boundary ruling,
            // docs/01-architecture/transitions/components-services-catalog/README.md). Authorization still
            // applies normally via the CanViewIntegrations guard above and the server-side IntegrationRead check.
            _moduleIntegrations = await Client.GetIntegrationsAsync(contextId: null, moduleId: ModuleId);
        }
        catch (HttpRequestException ex)
        {
            _moduleIntegrationsError = ex.Message;
        }
        finally
        {
            _moduleIntegrationsLoading = false;
        }
    }

    private async Task LoadRecentActivityAsync()
    {
        _activityLoading = true;
        _activityError = null;
        _recentActivity = null;
        try
        {
            var fromUtc = EntityRecentActivityComposer.DefaultFromUtc();
            var take = EntityRecentActivityComposer.PerSourceTake;
            var rows = new List<EntityRecentActivityItem>();

            try
            {
                var runs = await Client.GetRunsAsync(new RunQueryFilter(
                    ModuleId: ModuleId,
                    CreatedFrom: fromUtc,
                    Take: take));
                rows.AddRange(runs.Select(EntityRecentActivityComposer.FromRun));
            }
            catch (HttpRequestException ex)
            {
                _activityError = $"Runs: {ex.Message}";
            }

            if (_capabilities?.CanViewAudit == true)
            {
                try
                {
                    var auditPage = await Client.GetAuditTimelineAsync(
                        fromUtc: fromUtc,
                        moduleId: ModuleId.Trim(),
                        pageSize: take);
                    rows.AddRange(auditPage.Items.Select(e => EntityRecentActivityComposer.FromAudit(e, ModuleId)));
                }
                catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
                {
                    // Omit audit rows.
                }
                catch (HttpRequestException ex) when (_activityError is null)
                {
                    _activityError = $"Audit: {ex.Message}";
                }
                catch (HttpRequestException ex)
                {
                    _activityError = $"{_activityError} Audit: {ex.Message}";
                }
            }

            _recentActivity = EntityRecentActivityComposer.MergeAndTake(rows);
        }
        finally
        {
            _activityLoading = false;
        }
    }

    private async Task InstallAsync() => await ExecuteLifecycleAsync(() => Client.InstallModuleAsync(ModuleId));
    private async Task EnableAsync() => await ExecuteLifecycleAsync(() => Client.EnableModuleAsync(ModuleId));
    private async Task DisableAsync() => await ExecuteLifecycleAsync(() => Client.DisableModuleAsync(ModuleId));
    private async Task UninstallAsync() => await ExecuteLifecycleAsync(() => Client.UninstallModuleAsync(ModuleId));

    private async Task ExecuteLifecycleAsync(Func<Task<ModuleLifecycleActionResultDto>> action)
    {
        _loading = true;
        _actionMessage = null;
        try
        {
            var result = await action();
            _actionMessage = result.Succeeded
                ? $"Action '{result.Action}' succeeded. State: {result.State}."
                : $"Action '{result.Action}' failed. Blockers: {string.Join("; ", result.Blockers.Select(b => b.Message))}";
        }
        catch (HttpRequestException ex)
        {
            _actionMessage = ex.Message;
        }
        finally
        {
            _loading = false;
        }
        await LoadAsync(preserveActionFeedback: true);
    }
}
