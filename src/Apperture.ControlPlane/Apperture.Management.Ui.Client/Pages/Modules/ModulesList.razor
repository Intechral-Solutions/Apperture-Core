@page "/modules"
@using Apperture.Management.Client
@inject IManagementClient Client
@inject NavigationManager Nav

<div class="p-4">
    <div class="flex items-center justify-between gap-3">
        <div class="min-w-0">
            <h1 class="text-xl font-semibold text-heading">Config / Modules</h1>
            <div class="text-xs text-muted">Manage installed modules, including connector modules, and lifecycle state.</div>
        </div>
        <button class="rounded bg-surface-muted px-3 py-2 text-sm text-body hover:bg-surface"
                disabled="@_loading"
                @onclick="LoadAsync">
            Refresh
        </button>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="mt-4 rounded border border-default bg-surface px-3 py-2 text-sm text-body">
            <div class="font-semibold">Error</div>
            <div class="text-muted">@_error</div>
        </div>
    }
    else if (_modules is null)
    {
        <div class="mt-4 text-sm text-muted">Loading...</div>
    }
    else if (_modules.Count == 0)
    {
        <div class="mt-4 text-sm text-muted">No modules found.</div>
    }
    else
    {
        <div class="mt-4 overflow-x-auto rounded border border-default bg-surface">
            <table class="min-w-full text-left text-sm text-body">
                <thead class="border-b border-default text-xs text-muted">
                    <tr>
                        <th class="px-3 py-2">Id</th>
                        <th class="px-3 py-2">Name</th>
                        <th class="px-3 py-2">State</th>
                        <th class="px-3 py-2">Enabled</th>
                        <th class="px-3 py-2">Effectively active</th>
                        <th class="px-3 py-2">Validation issues</th>
                        <th class="px-3 py-2"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in _modules)
                    {
                        <tr class="border-b border-default hover:bg-surface-muted cursor-pointer"
                            @onclick="@(() => Nav.NavigateTo("/modules/" + Uri.EscapeDataString(m.Id)))">
                            <td class="px-3 py-2 font-mono text-xs">@m.Id</td>
                            <td class="px-3 py-2">@m.Name</td>
                            <td class="px-3 py-2">@m.State</td>
                            <td class="px-3 py-2">@(m.Enabled ? "Yes" : "No")</td>
                            <td class="px-3 py-2">@(m.EffectivelyActive ? "Yes" : "No")</td>
                            <td class="px-3 py-2">@(m.ValidationIssues?.Count ?? 0)</td>
                            <td class="px-3 py-2">
                                <a href="@("/modules/" + Uri.EscapeDataString(m.Id))" class="underline text-sm" @onclick:stopPropagation>Open</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private IReadOnlyList<ModuleDto>? _modules;
    private bool _loading;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _modules = await Client.GetModulesAsync();
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
