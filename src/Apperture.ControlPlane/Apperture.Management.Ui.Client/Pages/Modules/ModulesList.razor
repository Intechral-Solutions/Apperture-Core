@page "/modules"
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Organisms
@inject IManagementClient Client
@inject NavigationManager Nav

<div class="p-4 ui-page-stack">
    <PageHeader Eyebrow="Config"
                Title="Modules"
                Subtitle="Manage installed modules, including connector modules, and lifecycle state.">
        <Toolbar>
            <button type="button"
                    class="ui-toolbar-btn"
                    disabled="@_loading"
                    @onclick="LoadAsync">
                Refresh
            </button>
        </Toolbar>
    </PageHeader>

    @if (!string.IsNullOrEmpty(_error))
    {
        <ErrorState Message="@_error" />
    }
    else if (_modules is null)
    {
        <LoadingState />
    }
    else if (_modules.Count == 0)
    {
        <EmptyState Message="No modules found." />
    }
    else
    {
        <div class="ui-data-table">
            <table class="ui-data-table__table min-w-full text-left text-body">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>State</th>
                        <th>Enabled</th>
                        <th>Effectively active</th>
                        <th>Validation issues</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var m in _modules)
                    {
                        <tr class="cursor-pointer"
                            @onclick="@(() => Nav.NavigateTo("/modules/" + Uri.EscapeDataString(m.Id)))">
                            <td class="font-mono text-xs">@m.Id</td>
                            <td>@m.Name</td>
                            <td>@m.State</td>
                            <td>@(m.Enabled ? "Yes" : "No")</td>
                            <td>@(m.EffectivelyActive ? "Yes" : "No")</td>
                            <td>@(m.ValidationIssues?.Count ?? 0)</td>
                            <td>
                                <a href="@("/modules/" + Uri.EscapeDataString(m.Id))" class="underline text-sm" @onclick:stopPropagation>Open</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private IReadOnlyList<ModuleDto>? _modules;
    private bool _loading;
    private string? _error;

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _modules = await Client.GetModulesAsync();
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
