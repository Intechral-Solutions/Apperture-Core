@page "/config/auth/tenants"
@layout ConfigLayout
@using System.Net.Http
@using Apperture.Management.Client
@using Apperture.Management.Ui.Shared
@using Apperture.Management.Ui.Client.Organisms
@using Apperture.Management.Ui.Client.Services
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities
@inject AuthSignInOptionsService SignInOptions
@inject IToastService Toasts

<div class="p-4 ui-page-stack">
    <PageHeader Eyebrow="Config — Authentication"
                Title="Entra tenant setup"
                Subtitle="Register authority, client id, and the confidential client secret. The secret is stored in the platform secret store (never shown again). Validate OpenID metadata, then browse users and groups. Restart the management host after changing the active registration so OIDC picks up authority, client id, and secret." />

    @if (!_canView)
    {
        <div class="mt-4">
            <ForbiddenState Message="You do not have permission to view Entra registrations." />
        </div>
    }
    else if (_loading)
    {
        <div class="mt-4">
            <LoadingState />
        </div>
    }
    else if (_items is null)
    {
        <div class="mt-4">
            <ErrorState Message="Could not load registrations." />
        </div>
    }
    else
    {
        <div class="space-y-4 text-sm">
            @if (_overview is not null)
            {
                <PageMessage Kind="@(_overview.RuntimeMayRequireRestartToApplyChanges ? PageMessageKind.Warning : PageMessageKind.Info)"
                             Message="@_overview.RuntimeApplicationStatus" />
            }

            <p class="text-xs text-muted max-w-3xl">
                <a class="underline" href="/config/auth">← Back to authentication overview</a>
                · OID = last OpenID discovery validation. Dir = last Microsoft Graph browse. These do not create platform users.
            </p>

            <div class="ui-data-table">
                <table class="ui-data-table__table min-w-full text-left text-xs">
                    <thead>
                        <tr>
                            <th class="p-2">Name / authority</th>
                            <th class="p-2">Active</th>
                            <th class="p-2">OID</th>
                            <th class="p-2">Dir</th>
                            <th class="p-2">Secret</th>
                            <th class="p-2"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in _items)
                        {
                            <tr>
                                <td class="p-2">
                                    <div class="font-medium text-heading">@r.DisplayName</div>
                                    <div class="text-muted break-all">@r.Authority</div>
                                    <div class="text-muted">Client: @r.ClientId</div>
                                    @if (!string.IsNullOrEmpty(r.AzureTenantId))
                                    {
                                        <div class="text-muted">Azure tenant id: @r.AzureTenantId</div>
                                    }
                                </td>
                                <td class="p-2">@(r.IsActive ? "Yes" : "—")</td>
                                <td class="p-2" title="@r.LastOpenIdValidationSummary">@ShortStatus(r.OpenIdConfigurationStatus ?? "")</td>
                                <td class="p-2" title="@r.LastDirectoryDiscoverySummary">@ShortStatus(r.DirectoryDiscoveryStatus ?? "")</td>
                                <td class="p-2">@(r.ClientSecretConfigured || r.DeploymentSecretConfigured ? "ok" : "missing")</td>
                                <td class="p-2 space-y-1 whitespace-nowrap text-right">
                                    <div class="space-x-2">
                                        <a class="underline" href="/config/auth/entra/@r.Id/users">Users</a>
                                        <a class="underline" href="/config/auth/entra/@r.Id/groups">Groups</a>
                                    </div>
                                    @if (_canManage)
                                    {
                                        <div class="space-x-2">
                                            <button type="button" class="underline disabled:opacity-50" disabled="@_busy" @onclick="() => ValidateOpenIdAsync(r.Id)">Validate OIDC</button>
                                            <button type="button" class="underline disabled:opacity-50" disabled="@_busy" @onclick="() => BeginEdit(r)">Edit</button>
                                            @if (!r.IsActive && r.Enabled)
                                            {
                                                <button type="button" class="underline disabled:opacity-50" disabled="@_busy" @onclick="() => ActivateAsync(r.Id)">Activate</button>
                                            }
                                            <button type="button" class="underline text-error disabled:opacity-50" disabled="@_busy" @onclick="() => DeleteAsync(r.Id)">Delete</button>
                                        </div>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (_editing is not null)
            {
                <ManagementSection Title="Edit registration" Layer="@ManagementSection.UiLayer.Detail">
                    <div class="max-w-xl space-y-3">
                    <label class="block text-xs">Display name<input class="ui-input mt-1" @bind="_editingDisplay" /></label>
                    <label class="block text-xs">Authority (https)<input class="ui-input mt-1" @bind="_editingAuthority" /></label>
                    <label class="block text-xs">Client ID<input class="ui-input mt-1" @bind="_editingClientId" /></label>
                    <label class="block text-xs">Azure tenant id (optional, for Graph and issuer checks)<input class="ui-input mt-1" @bind="_editingAzureTenantId" /></label>
                    <label class="block text-xs">Callback path (optional)<input class="ui-input mt-1" @bind="_editingCallbackPath" /></label>
                    <label class="block text-xs">Client secret
                        <input class="ui-input mt-1"
                               type="password"
                               autocomplete="new-password"
                               placeholder="@(_editingSecretConfigured ? "Enter new value to replace" : "Enter secret value")"
                               @bind="_editingClientSecret" />
                    </label>
                    <p class="text-xs text-muted">The current secret is never shown. Leave blank to keep the stored secret.</p>
                    <label class="flex items-center gap-2 text-xs">
                        <input type="checkbox" @bind="_editingEnabled" />
                        Enabled
                    </label>
                    @if (!string.IsNullOrEmpty(_formError))
                    {
                        <PageMessage Kind="PageMessageKind.Error" Message="@_formError" />
                    }
                    <div class="flex gap-2">
                        <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="SaveEditAsync">Save</button>
                        <button type="button" class="btn btn-secondary" @onclick="CancelEdit">Cancel</button>
                    </div>
                    </div>
                </ManagementSection>
            }

            @if (_canManage)
            {
                <ManagementSection Title="Add registration" Layer="@ManagementSection.UiLayer.Detail">
                    <div class="max-w-xl space-y-3">
                    <label class="block text-xs">Display name<input class="ui-input mt-1" @bind="_newDisplay" /></label>
                    <label class="block text-xs">Authority (https) <input class="ui-input mt-1" @bind="_newAuthority" /></label>
                    <label class="block text-xs">Client ID <input class="ui-input mt-1" @bind="_newClientId" /></label>
                    <label class="block text-xs">Azure tenant id (optional)<input class="ui-input mt-1" @bind="_newAzureTenantId" /></label>
                    <label class="block text-xs">Client secret
                        <input class="ui-input mt-1"
                               type="password"
                               autocomplete="new-password"
                               placeholder="Enter secret value"
                               @bind="_newClientSecret" />
                    </label>
                    <p class="text-xs text-muted">Stored in the platform secret store. Deployment <span class="font-mono">Entra:ClientSecret</span> is used only when no stored secret exists.</p>
                    @if (!string.IsNullOrEmpty(_formError))
                    {
                        <PageMessage Kind="PageMessageKind.Error" Message="@_formError" />
                    }
                    <button type="button" class="btn btn-primary" disabled="@_busy" @onclick="CreateAsync">Create</button>
                    </div>
                </ManagementSection>
            }
        </div>
    }
</div>

@code {
    private bool _canView;
    private bool _canManage;
    private bool _loading = true;
    private bool _busy;
    private IReadOnlyList<EntraTenantListItemDto>? _items;
    private ConfigAuthOverviewDto? _overview;
    private string _newDisplay = "";
    private string _newAuthority = "";
    private string _newClientId = "";
    private string? _newAzureTenantId;
    private string _newClientSecret = "";
    private string? _formError;

    private string? _editing;
    private string _editingDisplay = "";
    private string _editingAuthority = "";
    private string _editingClientId = "";
    private string? _editingAzureTenantId;
    private string? _editingCallbackPath;
    private string _editingClientSecret = "";
    private bool _editingSecretConfigured;
    private bool _editingEnabled;
    private string? _editingRowVersion;

    private static string ShortStatus(string? s) =>
        string.IsNullOrEmpty(s) ? "—" : (s.Length > 12 ? s[..12] + "…" : s);

    protected override async Task OnInitializedAsync()
    {
        var caps = await Capabilities.GetCapabilitiesAsync();
        _canManage = caps.CanManageEntraTenants;
        _canView = caps.CanViewAuthConfiguration || _canManage;
        if (!_canView)
        {
            _loading = false;
            return;
        }

        await ReloadAsync();
        _loading = false;
    }

    private async Task ReloadAsync()
    {
        _items = await Client.GetEntraTenantsAsync();
        _overview = await Client.GetConfigAuthOverviewAsync();
    }

    private void BeginEdit(EntraTenantListItemDto r)
    {
        _formError = null;
        _editing = r.Id;
        _editingDisplay = r.DisplayName;
        _editingAuthority = r.Authority;
        _editingClientId = r.ClientId;
        _editingAzureTenantId = r.AzureTenantId;
        _editingCallbackPath = r.CallbackPath;
        _editingClientSecret = "";
        _editingSecretConfigured = r.ClientSecretConfigured || r.DeploymentSecretConfigured;
        _editingEnabled = r.Enabled;
        _editingRowVersion = r.RowVersionBase64;
    }

    private void CancelEdit()
    {
        _editing = null;
        _editingClientSecret = "";
        _formError = null;
    }

    private async Task SaveEditAsync()
    {
        if (_editing is null || string.IsNullOrWhiteSpace(_editingRowVersion))
            return;
        _formError = null;
        _busy = true;
        try
        {
            await Client.PatchEntraTenantAsync(
                _editing,
                new UpdateEntraTenantRequest(
                    _editingDisplay,
                    _editingAuthority,
                    _editingClientId,
                    UsesDeploymentSecret: true,
                    string.IsNullOrWhiteSpace(_editingCallbackPath) ? null : _editingCallbackPath.Trim(),
                    _editingEnabled,
                    _editingRowVersion,
                    string.IsNullOrWhiteSpace(_editingAzureTenantId) ? null : _editingAzureTenantId.Trim(),
                    ClientSecret: string.IsNullOrWhiteSpace(_editingClientSecret) ? null : _editingClientSecret));
            _editing = null;
            _editingClientSecret = "";
            await ReloadAsync();
            await SignInOptions.RefreshAsync();
            Toasts.Show(ToastSeverity.Success, "Registration updated.");
        }
        catch (HttpRequestException ex)
        {
            _formError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task CreateAsync()
    {
        _formError = null;
        _busy = true;
        try
        {
            var created = await Client.CreateEntraTenantAsync(new CreateEntraTenantRequest(
                _newDisplay,
                _newAuthority,
                _newClientId,
                UsesDeploymentSecret: true,
                CallbackPath: null,
                Enabled: true,
                AzureTenantId: string.IsNullOrWhiteSpace(_newAzureTenantId) ? null : _newAzureTenantId.Trim(),
                ClientSecret: string.IsNullOrWhiteSpace(_newClientSecret) ? null : _newClientSecret));
            _newDisplay = "";
            _newAuthority = "";
            _newClientId = "";
            _newAzureTenantId = null;
            _newClientSecret = "";
            await ReloadAsync();
            await SignInOptions.RefreshAsync();
            Toasts.Show(ToastSeverity.Success, $"Created registration {created.DisplayName}.");
        }
        catch (HttpRequestException ex)
        {
            _formError = ex.Message;
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ValidateOpenIdAsync(string id)
    {
        _busy = true;
        try
        {
            var result = await Client.ValidateEntraTenantOpenIdAsync(id);
            if (result is null)
            {
                Toasts.Show(ToastSeverity.Error, "Validation failed or access denied.");
                return;
            }

            await ReloadAsync();
            await SignInOptions.RefreshAsync();
            var v = result.Validation;
            Toasts.Show(
                v.Success ? ToastSeverity.Success : ToastSeverity.Warning,
                v.Summary);
        }
        catch (HttpRequestException ex)
        {
            Toasts.Show(ToastSeverity.Error, ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ActivateAsync(string id)
    {
        _busy = true;
        try
        {
            await Client.ActivateEntraTenantAsync(id);
            await ReloadAsync();
            await SignInOptions.RefreshAsync();
            Toasts.Show(ToastSeverity.Success, "Active Entra registration updated. Restart the management host if sign-in still uses old authority.");
        }
        catch (HttpRequestException ex)
        {
            Toasts.Show(ToastSeverity.Error, ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteAsync(string id)
    {
        _busy = true;
        try
        {
            await Client.DeleteEntraTenantAsync(id);
            await ReloadAsync();
            await SignInOptions.RefreshAsync();
            Toasts.Show(ToastSeverity.Success, "Registration deleted.");
        }
        catch (HttpRequestException ex)
        {
            Toasts.Show(ToastSeverity.Error, ex.Message);
        }
        finally
        {
            _busy = false;
        }
    }
}
