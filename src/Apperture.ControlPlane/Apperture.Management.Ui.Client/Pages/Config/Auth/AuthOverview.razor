@page "/config/auth"
@layout ConfigLayout
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Organisms
@using Apperture.Management.Ui.Client.Services
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities

<div class="p-4 ui-page-stack">
    <PageHeader Eyebrow="Config — Authentication"
                Title="Overview"
                Subtitle="What operators see at sign-in, how that relates to deployment and policy, and recovery paths." />

    @if (!_canView)
    {
        <ForbiddenState Message="You do not have permission to view authentication configuration." />
    }
    else if (_loading)
    {
        <LoadingState />
    }
    else if (_overview is null)
    {
        <ErrorState Message="Could not load authentication overview." />
    }
    else
    {
        <div class="max-w-3xl space-y-4 text-sm text-body">
            @if (_overview.Warnings.Count > 0)
            {
                foreach (var w in _overview.Warnings)
                {
                    <PageMessage Kind="PageMessageKind.Warning" Message="@w" />
                }
            }

            <ManagementSection Title="What users see" Layer="@ManagementSection.UiLayer.Summary">
                <p class="text-xs">@_overview.EffectiveExperienceDescription</p>
                <ul class="mt-3 list-inside list-disc space-y-1 text-xs text-muted">
                    <li>Local on primary login: @(_overview.LocalShownOnPrimaryLogin ? "yes" : "no")</li>
                    <li>Local only as fallback at <code class="ui-inline-code">/login/local</code>: @(_overview.LocalFallbackOnly ? "yes" : "no")</li>
                    <li>Entra sign-in (effective): @(_overview.EntraSignInEnabled ? "available" : "not available")</li>
                </ul>
            </ManagementSection>

            @if (_overview.AuthProviderAvailability is not null)
            {
                var ap = _overview.AuthProviderAvailability;
                <ManagementSection Title="Provider readiness" Layer="@ManagementSection.UiLayer.Summary">
                    <ul class="list-inside list-disc space-y-1 text-xs">
                        <li>Entra sign-in ready (effective): @(ap.EntraSignInReady ? "yes" : "no")</li>
                        <li>Local sign-in available: @(ap.LocalSignInAvailable ? "yes" : "no")</li>
                        <li>Active registration OID validation status: @(ap.ActiveEntraOpenIdConfigurationStatus ?? "—")</li>
                        <li>Active registration directory discovery status: @(ap.ActiveEntraDirectoryDiscoveryStatus ?? "—")</li>
                    </ul>
                    @if (!string.IsNullOrEmpty(ap.AdminDiagnosis))
                    {
                        <PageMessage Kind="PageMessageKind.Warning" Message="@ap.AdminDiagnosis" />
                    }
                </ManagementSection>
            }

            <ManagementSection Title="Entra administration" Layer="@ManagementSection.UiLayer.Summary">
                <p class="text-xs text-muted">
                    Configure tenants, validate OpenID metadata, browse directory objects, and import users into
                    <a class="underline" href="/config/contacts">managed contacts</a>:
                    <a class="underline" href="/config/auth/tenants">Entra tenant setup</a>
                </p>
            </ManagementSection>

            <ManagementSection Title="Capabilities vs policy" Layer="@ManagementSection.UiLayer.Summary">
                <ul class="list-inside list-disc space-y-1 text-xs">
                    <li>Local auth (deployment): @(_overview.LocalAuthEnabled ? "enabled" : "disabled")</li>
                    <li>Entra enabled in deployment configuration: @(_overview.EntraEnabledInDeploymentConfiguration ? "yes" : "no")</li>
                    <li>Entra configuration valid: @(_overview.EntraConfigurationValid ? "yes" : "no")</li>
                    @if (!string.IsNullOrEmpty(_overview.EntraMisconfiguredReason))
                    {
                        <li class="text-muted">@_overview.EntraMisconfiguredReason</li>
                    }
                    <li>Active Entra registration: @(string.IsNullOrEmpty(_overview.ActiveEntraRegistrationDisplayName) ? "none" : _overview.ActiveEntraRegistrationDisplayName)</li>
                    <li>Active registration is selected in persisted config: @(_overview.EntraSignInUsesActiveRegistration ? "yes" : "no")</li>
                </ul>
                <h3 class="mt-4 text-xs font-medium text-heading">Runtime application status</h3>
                <p class="mt-1 text-xs text-muted">@_overview.RuntimeApplicationStatus</p>
                @if (_overview.RuntimeMayRequireRestartToApplyChanges)
                {
                    <PageMessage Kind="PageMessageKind.Warning"
                                 Message="Runtime OIDC behavior may lag after registration changes. Restart the management host to ensure /signin uses the newly active authority and client ID." />
                }
                <h3 class="mt-4 text-xs font-medium text-heading">Chooser policy (persisted)</h3>
                <ul class="mt-1 list-inside list-disc space-y-1 text-xs text-muted">
                    <li>Show local on primary: @_overview.ShowLocalSignInInPrimaryChooser</li>
                    <li>Prefer Entra in chooser: @_overview.PreferEntraInChooser</li>
                    <li>Auto-redirect to Entra: @_overview.AutoRedirectToEntra</li>
                </ul>
            </ManagementSection>

            <ManagementSection Title="Recovery" Layer="@ManagementSection.UiLayer.Summary">
                <p class="text-xs text-muted">Local backup sign-in: <a class="underline" href="/login/local">/login/local</a></p>
            </ManagementSection>
        </div>
    }
</div>

@code {
    private bool _canView;
    private bool _loading = true;
    private ConfigAuthOverviewDto? _overview;

    protected override async Task OnInitializedAsync()
    {
        var caps = await Capabilities.GetCapabilitiesAsync();
        _canView = caps.CanViewAuthConfiguration || caps.CanManageAuthUiPolicy || caps.CanManageEntraTenants;
        if (!_canView)
        {
            _loading = false;
            return;
        }

        _overview = await Client.GetConfigAuthOverviewAsync();
        _loading = false;
    }
}
