@page "/config/auth/sign-in"
@layout ConfigLayout
@using System.Net.Http
@using Apperture.Management.Client
@using Apperture.Management.Ui.Shared
@using Apperture.Management.Ui.Client.Organisms
@using Apperture.Management.Ui.Client.Services
@inject IManagementClient Client
@inject AuthSignInOptionsService SignInOptions
@inject IOperatorCapabilitiesService Capabilities
@inject IToastService Toasts

<div class="p-4 ui-page-stack">
    <PageHeader Eyebrow="Config — Authentication"
                Title="Sign-in chooser"
                Subtitle="Primary sign-in page: which methods appear and in what order. Local sign-in availability is controlled by deployment; this page only controls chooser visibility and Entra preference." />

    @if (!_canView)
    {
        <ForbiddenState Message="You do not have permission to view sign-in configuration." />
    }
    else if (_loading)
    {
        <LoadingState />
    }
    else if (_policy is null || _opts is null)
    {
        <ErrorState Message="Could not load policy or sign-in options." />
    }
    else
    {
        <div class="max-w-xl space-y-4 text-sm text-body">
            @if (_overview?.RuntimeMayRequireRestartToApplyChanges == true)
            {
                <PageMessage Kind="PageMessageKind.Warning"
                             Message="@_overview.RuntimeApplicationStatus" />
            }

            <ManagementSection Title="Effective experience (read-only)" Layer="@ManagementSection.UiLayer.Summary">
                <p class="text-xs text-body">@(_opts.EffectiveExperienceDescription ?? "—")</p>
                @if (!string.IsNullOrEmpty(_opts.EffectiveExperience))
                {
                    <p class="mt-1 text-xs text-muted">Label: <code class="ui-inline-code">@_opts.EffectiveExperience</code></p>
                }
            </ManagementSection>

            <ManagementSection Title="Capabilities (read-only)" Layer="@ManagementSection.UiLayer.Summary">
                <ul class="list-inside list-disc space-y-1 text-xs">
                    <li>Local sign-in (deployment): @(_opts.LocalSignInEnabled ? "enabled" : "disabled")</li>
                    <li>Entra sign-in (effective): @(_opts.EntraSignInEnabled ? "enabled" : _opts.EntraMisconfigured ? "misconfigured" : "disabled")</li>
                </ul>
                <p class="mt-2 text-xs text-muted">Recovery URL when local is hidden from the primary page: <code class="ui-inline-code">/login/local</code></p>
            </ManagementSection>

            @if (_canManage)
            {
                <ManagementSection Title="Chooser policy" Layer="@ManagementSection.UiLayer.Detail">
                    <PageMessage Kind="PageMessageKind.Warning"
                                 Message="You cannot hide local sign-in from the primary page unless Entra sign-in is enabled and correctly configured. The server rejects saves that would lock operators out." />
                    <label class="flex items-center gap-2">
                        <input type="checkbox" @bind="_showLocal" />
                        <span>Show local username/password on the primary sign-in page</span>
                    </label>
                    <label class="flex items-center gap-2">
                        <input type="checkbox" @bind="_preferEntra" />
                        <span>Prefer Microsoft sign-in when both methods appear on the primary page</span>
                    </label>
                    <label class="flex items-center gap-2">
                        <input type="checkbox" @bind="_autoRedirect" />
                        <span>Automatically redirect to Microsoft sign-in when policy allows (advanced)</span>
                    </label>
                    @if (!string.IsNullOrEmpty(_saveError))
                    {
                        <PageMessage Kind="PageMessageKind.Error" Message="@_saveError" />
                    }
                    <button type="button"
                            class="btn btn-primary"
                            disabled="@_saving"
                            @onclick="SaveAsync">
                        @(_saving ? "Saving…" : "Save")
                    </button>
                </ManagementSection>
            }
            else
            {
                <p class="text-xs text-muted">You have read-only access; only users with sign-in policy permission can change these settings.</p>
            }
        </div>
    }
</div>

@code {
    private bool _canView;
    private bool _canManage;
    private bool _loading = true;
    private AuthUiPolicyDto? _policy;
    private AuthSignInOptionsDto? _opts;
    private ConfigAuthOverviewDto? _overview;
    private bool _showLocal = true;
    private bool _preferEntra;
    private bool _autoRedirect;
    private string? _saveError;
    private bool _saving;

    protected override async Task OnInitializedAsync()
    {
        var caps = await Capabilities.GetCapabilitiesAsync();
        _canManage = caps.CanManageAuthUiPolicy;
        _canView = caps.CanViewAuthConfiguration || _canManage;
        if (!_canView)
        {
            _loading = false;
            return;
        }

        await SignInOptions.RefreshAsync();
        _opts = SignInOptions.Current;
        _policy = await Client.GetAuthUiPolicyAsync();
        _overview = await Client.GetConfigAuthOverviewAsync();
        if (_policy is not null)
        {
            _showLocal = _policy.ShowLocalSignInInPrimaryChooser;
            _preferEntra = _policy.PreferEntraInChooser;
            _autoRedirect = _policy.AutoRedirectToEntra;
        }

        _loading = false;
    }

    private async Task SaveAsync()
    {
        if (_policy is null)
            return;
        _saveError = null;
        _saving = true;
        try
        {
            var req = new UpdateAuthUiPolicyRequest(
                _showLocal,
                _preferEntra,
                _autoRedirect,
                _policy.RowVersionBase64);
            _policy = await Client.PatchAuthUiPolicyAsync(req);
            await SignInOptions.RefreshAsync();
            _opts = SignInOptions.Current;
            _overview = await Client.GetConfigAuthOverviewAsync();
            Toasts.Show(ToastSeverity.Success, "Sign-in policy saved.");
        }
        catch (HttpRequestException ex)
        {
            _saveError = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }
}
