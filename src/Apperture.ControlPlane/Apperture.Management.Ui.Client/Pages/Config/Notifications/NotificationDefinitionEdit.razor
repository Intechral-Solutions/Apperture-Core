@page "/config/notifications/definitions/{DefinitionId}/edit"
@layout ConfigLayout
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Organisms
@using Apperture.Management.Ui.Client.Molecules
@using Apperture.Management.Ui.Client.Organisms.Notifications
@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Shared
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities
@inject NavigationManager Nav
@inject ShellOrientationService ShellOrientation

<div class="p-4 ui-page-stack">
    <PageHeader @key="@DefinitionId"
                Eyebrow="Notifications"
                Title="@EditTitle"
                Subtitle="@EditSubtitle">
        <ChildContent>
            <div class="mt-1 font-mono text-xs text-muted break-all">@DefinitionId</div>
        </ChildContent>
        <Toolbar>
            <DrillInLink Href="@DetailHref">Back to detail</DrillInLink>
            <DrillInLink Href="/config/notifications/definitions">Definitions</DrillInLink>
        </Toolbar>
    </PageHeader>

    @if (!_capabilitiesLoaded)
    {
        <LoadingState />
    }
    else if (!_canSave)
    {
        <ForbiddenState Title="Not authorized"
                        Message="Editing notification definitions requires notification definition manage and integration update permissions." />
    }
    else if (_loading)
    {
        <LoadingState />
    }
    else if (_detail is null)
    {
        <EmptyState Title="Definition not found"
                    Message="The definition was not found or is unavailable." />
    }
    else if (!string.Equals(_detail.Mutability, "fullyEditable", StringComparison.Ordinal))
    {
        <ManagementSection Title="Editing unavailable"
                           Layer="ManagementSection.UiLayer.Detail"
                           Help="Use the detail page to manage enablement and subscriptions for platform-managed definitions.">
            <PageMessage Kind="PageMessageKind.Warning"
                         Title="Cannot edit rule or template"
                         Message="This definition is not fully editable." />
            <div class="mt-2 text-xs">
                <DrillInLink Href="@DetailHref">Back to detail</DrillInLink>
            </div>
        </ManagementSection>
    }
    else
    {
        <ManagementSection Title="Authoring"
                           Layer="ManagementSection.UiLayer.Detail"
                           Help="Rule and template authoring for fully editable definitions. Save behavior and validation stay unchanged.">
            <NotificationDefinitionAuthoringForm Mode="NotificationDefinitionAuthoringMode.Edit"
                                                 IntegrationId="@_detail.IntegrationId"
                                                 LockIntegration="true"
                                                 DefinitionId="@DefinitionId"
                                                 InitialDetail="@_detail"
                                                 ReturnUrl="@DetailHref"
                                                 CanSave="true"
                                                 OnSaved="OnSavedAsync" />
        </ManagementSection>
    }
</div>

@code {
    [Parameter] public string DefinitionId { get; set; } = "";

    private bool _capabilitiesLoaded;
    private bool _canSave;
    private bool _loading = true;
    private NotificationDefinitionDetailDto? _detail;

    private string DetailHref => NotificationUiRoutes.DefinitionDetail(DefinitionId);
    private string EditTitle =>
        EntityShellTitles.Detail(_detail?.DisplayName, "Notification definition");
    private string EditSubtitle =>
        string.IsNullOrWhiteSpace(_detail?.DisplayName)
            ? "Update rule/template content and metadata for this definition."
            : $"Editing {_detail.DisplayName}";

    private string? _dataLoadKey;

    protected override async Task OnInitializedAsync()
    {
        var caps = await Capabilities.GetCapabilitiesAsync();
        _canSave = caps.CanManageNotificationDefinitions && caps.CanUpdateIntegrations;
        _capabilitiesLoaded = true;
        if (!_canSave)
            _loading = false;
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        if (!_capabilitiesLoaded || !_canSave)
            return;

        var key = DefinitionId ?? "";
        if (key == _dataLoadKey)
            return;

        _dataLoadKey = key;
        _detail = null;
        _loading = true;
        try
        {
            _detail = await Client.GetNotificationDefinitionAsync(DefinitionId);
        }
        finally
        {
            _loading = false;
            ShellOrientation.PublishForCurrentUri(Nav, EditTitle, EditSubtitle);
        }
    }

    private Task OnSavedAsync(string definitionId)
    {
        Nav.NavigateTo(DetailHref);
        return Task.CompletedTask;
    }
}
