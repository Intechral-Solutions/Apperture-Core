@page "/config/notifications/diagnostics"
@layout ConfigLayout
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Molecules
@using Apperture.Management.Ui.Client.Organisms
@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Shared
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities
@inject NavigationManager Nav

<div class="p-4">
    <div class="text-xs text-muted mb-1">Config — Notifications — Diagnostics</div>
    <PageHeader Title="Notification diagnostics"
                Subtitle="Cutover preflight, parity acceptance, and admin pipeline verification tools." />

    @if (!_capabilitiesLoaded)
    {
        <LoadingState Message="Loading…" />
    }
    else if (!_canView)
    {
        <div class="mt-4">
            <ForbiddenState Message="Requires integration read and notification definition read." />
        </div>
    }
    else
    {
        @if (_cutoverStatus is not null)
        {
            <div class="mt-4">
                <NotificationPipelineCutoverStatusCard Status="_cutoverStatus" />
            </div>
        }

        @if (_canManage)
        {
            <section class="mt-4 rounded border border-message-warning bg-surface p-3 text-xs">
                <h2 class="text-sm font-semibold text-heading mb-2">Pipeline verification (admin)</h2>
                <p class="text-muted mb-3">
                    Diagnostics-only actions. SMTP test does not require a notification definition.
                    Platform pipeline test uses a synthetic expected-run-missing event — start with dry-run.
                </p>

                <div class="grid gap-4 md:grid-cols-2">
                    <div class="rounded border border-default p-3">
                        <div class="font-semibold text-heading mb-2">SMTP test email</div>
                        <label class="block mb-2">
                            Recipient
                            <input class="mt-1 block w-full rounded border border-default px-2 py-1 font-mono"
                                   @bind="_smtpTestRecipient" placeholder="you@example.com" />
                        </label>
                        <button type="button"
                                class="rounded bg-surface-muted px-3 py-2 disabled:opacity-50"
                                disabled="@_busy"
                                @onclick="RunSmtpTestAsync">
                            Send SMTP test
                        </button>
                        @if (_smtpTestResult is not null)
                        {
                            <p class="mt-2 @( _smtpTestResult.Succeeded ? "text-success" : "text-error")">
                                @(_smtpTestResult.Succeeded ? "Sent." : $"Failed: {_smtpTestResult.FailureSummary}")
                            </p>
                        }
                    </div>

                    <div class="rounded border border-default p-3">
                        <div class="font-semibold text-heading mb-2">Platform pipeline test</div>
                        <label class="block mb-2">
                            Integration id *
                            <input class="mt-1 block w-full rounded border border-default px-2 py-1 font-mono"
                                   @bind="_pipelineTestIntegrationId" />
                        </label>
                        <label class="inline-flex items-center gap-2 mr-4 mb-2">
                            <input type="checkbox" @bind="_pipelineTestDryRun" />
                            Dry-run (no persist/SMTP)
                        </label>
                        <label class="inline-flex items-center gap-2 mb-2">
                            <input type="checkbox" @bind="_pipelineTestDispatch" disabled="@_pipelineTestDryRun" />
                            Dispatch immediately (live only)
                        </label>
                        <button type="button"
                                class="rounded bg-surface-muted px-3 py-2 disabled:opacity-50"
                                disabled="@_busy"
                                @onclick="RunPipelineTestAsync">
                            Run pipeline test
                        </button>
                    </div>
                </div>

                @if (_pipelineTestResult is not null)
                {
                    <div class="mt-3 rounded border border-default p-2">
                        <div class="font-semibold mb-1">
                            Pipeline test @(_pipelineTestResult.DryRun ? "(dry-run)" : "(live)")
                            · instance @(_pipelineTestResult.NotificationInstanceId ?? "—")
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_pipelineTestResult.SuppressionReason))
                        {
                            <p class="text-warning">Suppressed: @_pipelineTestResult.SuppressionReason</p>
                        }
                        <ul class="mt-1 space-y-1">
                            @foreach (var stage in _pipelineTestResult.Stages)
                            {
                                <li>
                                    <span class="font-mono">@stage.Stage</span>
                                    <span class="text-muted">(@stage.Status)</span>
                                    @if (!string.IsNullOrWhiteSpace(stage.Detail))
                                    {
                                        <span> — @stage.Detail</span>
                                    }
                                </li>
                            }
                        </ul>
                        @if (_pipelineTestResult.DeliverableRecipients.Count > 0 || _pipelineTestResult.SkippedRecipients.Count > 0)
                        {
                            <p class="mt-2 text-muted">
                                Deliverable: @_pipelineTestResult.DeliverableRecipients.Count ·
                                Skipped: @_pipelineTestResult.SkippedRecipients.Count
                            </p>
                        }
                        @if (!string.IsNullOrWhiteSpace(_pipelineTestResult.DispatchNote))
                        {
                            <p class="mt-1 text-muted">@_pipelineTestResult.DispatchNote</p>
                        }
                    </div>
                }
            </section>
        }

        <section class="mt-4 rounded border border-default bg-surface p-3 text-xs">
            <h2 class="text-sm font-semibold text-heading mb-2">Expected-run-missing cutover (instance)</h2>
            <p class="text-muted mb-3">Read-only health and flag guidance. Per-integration readiness is on the integration notifications page.</p>
            <p class="text-muted mb-3">To edit notification/platform flags, use <a href="/config/platform-settings" class="underline">Platform settings</a>.</p>
            @if (_health is not null)
            {
                <dl class="grid grid-cols-2 md:grid-cols-4 gap-3">
                    <div><dt class="text-muted">Failed deliveries</dt><dd class="font-semibold">@_health.RecentFailedDeliveryCount</dd></div>
                    <div><dt class="text-muted">Suppressed instances</dt><dd class="font-semibold">@_health.RecentSuppressedInstanceCount</dd></div>
                    <div><dt class="text-muted">Pending/delivering outbox</dt><dd class="font-semibold">@_health.RecentPendingOrDeliveringOutboxCount</dd></div>
                    <div><dt class="text-muted">As of (UTC)</dt><dd>@_health.GeneratedAtUtc.UtcDateTime.ToString("u")</dd></div>
                </dl>
            }
            else
            {
                <p class="text-muted">Health summary unavailable.</p>
            }
            @if (_configDiagnostics is not null)
            {
                <ExpectedRunMissingCutoverConfigWarnings Configuration="_configDiagnostics" />
            }
            <div class="mt-3 flex flex-wrap items-end gap-2">
                <label>
                    Integration id (cutover readiness)
                    <input class="mt-1 block rounded border border-default px-2 py-1 font-mono" @bind="_parityIntegrationId" />
                </label>
                @if (!string.IsNullOrWhiteSpace(_parityIntegrationId))
                {
                    <a class="rounded bg-surface-muted px-3 py-2 self-end"
                       href="@($"/integrations/{Uri.EscapeDataString(_parityIntegrationId.Trim())}/notifications#cutover-readiness")">
                        Open integration cutover readiness
                    </a>
                    <button type="button" class="rounded bg-surface-muted px-3 py-2 self-end disabled:opacity-50" disabled="@_busy" @onclick="LoadCutoverSignOffAsync">Load sign-off</button>
                }
            </div>
            @if (_cutoverSignOff is not null)
            {
                <p class="mt-3 text-xs">
                    Latest sign-off: <span class="font-medium">@ExpectedRunMissingCutoverSignOffUi.GetStatusLabel(_cutoverSignOff.Status)</span>
                    at @_cutoverSignOff.ReviewedAtUtc.UtcDateTime.ToString("u")
                    by @(_cutoverSignOff.ReviewedByDisplayName ?? _cutoverSignOff.ReviewedByActorId).
                    Parity at review: @(_cutoverSignOff.ParityAcceptableAtReview ? "acceptable" : "not acceptable").
                </p>
            }
            else if (_cutoverSignOffLoaded)
            {
                <p class="mt-3 text-xs text-muted">No cutover sign-off on file for this integration.</p>
            }
        </section>

        <div class="mt-4 rounded border border-default bg-surface p-3 text-xs">
            <div class="font-semibold text-heading mb-2">Integration diagnostics</div>
            <div class="flex flex-wrap items-end gap-2">
                <label>
                    Integration id (required for tables)
                    <input class="mt-1 block rounded border border-default px-2 py-1 font-mono" @bind="_integrationId" />
                </label>
                <label>
                    Definition id (optional filter)
                    <input class="mt-1 block rounded border border-default px-2 py-1 font-mono" @bind="_definitionId" />
                </label>
                <button type="button" class="rounded bg-surface-muted px-3 py-2 disabled:opacity-50" disabled="@_busy" @onclick="LoadIntegrationDiagAsync">Load</button>
            </div>
            @if (_integrationDiag is not null)
            {
                <p class="mt-2 text-muted">Suppressed instances: @_integrationDiag.RecentSuppressedInstances.Count · Failed outbox: @_integrationDiag.RecentFailedDeliveries.Count</p>
            }
        </div>

        <div class="mt-4 rounded border border-default bg-surface p-3 text-xs">
            <div class="font-semibold text-heading mb-2">Expected-run-missing parity acceptance</div>
            <div class="flex flex-wrap items-end gap-2">
                <label>
                    Integration id *
                    <input class="mt-1 block rounded border border-default px-2 py-1 font-mono" @bind="_parityIntegrationId" />
                </label>
                <label>
                    Incident id (optional)
                    <input class="mt-1 block rounded border border-default px-2 py-1 font-mono" @bind="_parityIncidentId" />
                </label>
                <label>
                    Max incidents
                    <input type="number" class="mt-1 block w-20 rounded border border-default px-2 py-1" @bind="_maxIncidents" />
                </label>
                <button type="button" class="rounded bg-surface-muted px-3 py-2 disabled:opacity-50" disabled="@_busy" @onclick="RunAcceptanceAsync">Evaluate</button>
            </div>
            @if (_acceptance is not null)
            {
                <div class="mt-3 p-2 rounded @AcceptanceBadgeClass">
                    <div class="font-semibold">@AcceptanceReadinessLabel</div>
                    <p>Incidents evaluated: @_acceptance.IncidentsEvaluated · Kinds aligned: @_acceptance.KindsAligned / @_acceptance.KindComparisonsTotal</p>
                    @if (_acceptance.BlockingFindings.Count > 0)
                    {
                        <ul class="mt-1 list-disc list-inside text-muted">
                            @foreach (var f in _acceptance.BlockingFindings)
                            {
                                <li>@f</li>
                            }
                        </ul>
                    }
                </div>
                <button type="button" class="mt-2 underline text-muted disabled:opacity-50" disabled="@_busy" @onclick="LoadFullParityAsync">Show full parity detail</button>
            }
            @if (_fullParity is not null)
            {
                <details class="mt-3">
                    <summary class="cursor-pointer font-semibold">Full parity (@_fullParity.AttentionIncidentId)</summary>
                    @foreach (var k in _fullParity.ByKind)
                    {
                        <div class="mt-2 border-t border-default pt-2">
                            <div class="font-medium">@k.NotificationKind — @k.DifferenceKind</div>
                            <p class="text-muted">@k.Summary</p>
                        </div>
                    }
                </details>
            }
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="mt-4">
                <PageMessage Kind="PageMessageKind.Error" Message="@_error" />
            </div>
        }
    }
</div>

@code {
    private bool _capabilitiesLoaded;
    private bool _canView;
    private bool _canManage;
    private bool _busy;
    private string? _error;
    private string _integrationId = "";
    private string _definitionId = "";
    private string _parityIntegrationId = "";
    private string _parityIncidentId = "";
    private int _maxIncidents = 10;
    private NotificationDeliveryHealthSummaryDto? _health;
    private NotificationIntegrationDiagnosticsDto? _integrationDiag;
    private NotificationConfigurationDiagnosticsDto? _configDiagnostics;
    private NotificationPipelineCutoverStatusDto? _cutoverStatus;
    private ExpectedRunMissingParityAcceptanceSummaryDto? _acceptance;
    private ExpectedRunMissingParityDiagnosticsDto? _fullParity;
    private ExpectedRunMissingCutoverSignOffDto? _cutoverSignOff;
    private bool _cutoverSignOffLoaded;
    private bool _parityEvaluated;
    private string _smtpTestRecipient = "";
    private string _pipelineTestIntegrationId = "";
    private bool _pipelineTestDryRun = true;
    private bool _pipelineTestDispatch;
    private NotificationSmtpTestResultDto? _smtpTestResult;
    private PlatformNotificationPipelineTestResultDto? _pipelineTestResult;

    private string AcceptanceReadinessLabel =>
        ExpectedRunMissingCutoverReadiness.GetLabel(
            ExpectedRunMissingCutoverReadiness.ResolveState(_parityEvaluated, _acceptance));

    private string AcceptanceBadgeClass =>
        ExpectedRunMissingCutoverReadiness.ResolveState(_parityEvaluated, _acceptance) switch
        {
            ExpectedRunMissingCutoverReadinessState.LooksAcceptableForCutover => "bg-success-light",
            ExpectedRunMissingCutoverReadinessState.NotReadyForCutover => "bg-message-error",
            ExpectedRunMissingCutoverReadinessState.NeedsReview => "bg-message-warning",
            _ => "bg-message-warning",
        };

    protected override async Task OnInitializedAsync()
    {
        var caps = await Capabilities.GetCapabilitiesAsync();
        _canView = caps.CanViewIntegrations && caps.CanViewNotificationDefinitions;
        _canManage = caps.CanManageNotificationDefinitions;
        _capabilitiesLoaded = true;
        if (!_canView) return;

        var q = NavigationQueryHelper.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        if (q.TryGetValue("definitionId", out var did)) _definitionId = did;
        if (q.TryGetValue("integrationId", out var iid))
        {
            _integrationId = iid;
            _parityIntegrationId = iid;
            _pipelineTestIntegrationId = iid;
        }

        try
        {
            _health = await Client.GetNotificationDeliveryHealthAsync();
            _configDiagnostics = await Client.GetNotificationConfigurationDiagnosticsAsync();
            _cutoverStatus = await Client.GetNotificationPipelineCutoverStatusAsync();
        }
        catch (Exception ex) { _error = ex.Message; }

        if (!string.IsNullOrWhiteSpace(_parityIntegrationId))
            await LoadCutoverSignOffAsync();
    }

    private async Task LoadCutoverSignOffAsync()
    {
        if (string.IsNullOrWhiteSpace(_parityIntegrationId)) return;
        _busy = true;
        _error = null;
        try
        {
            _cutoverSignOff = await Client.GetExpectedRunMissingCutoverSignOffAsync(_parityIntegrationId.Trim());
            _cutoverSignOffLoaded = true;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task LoadIntegrationDiagAsync()
    {
        if (string.IsNullOrWhiteSpace(_integrationId)) return;
        _busy = true;
        _error = null;
        try
        {
            _integrationDiag = await Client.GetNotificationIntegrationDiagnosticsAsync(
                _integrationId.Trim(),
                string.IsNullOrWhiteSpace(_definitionId) ? null : _definitionId.Trim());
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task RunAcceptanceAsync()
    {
        if (string.IsNullOrWhiteSpace(_parityIntegrationId)) return;
        _busy = true;
        _error = null;
        _fullParity = null;
        try
        {
            _acceptance = await Client.GetExpectedRunMissingParityAcceptanceAsync(
                _parityIntegrationId.Trim(),
                string.IsNullOrWhiteSpace(_parityIncidentId) ? null : _parityIncidentId.Trim(),
                _maxIncidents);
            _parityEvaluated = true;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task LoadFullParityAsync()
    {
        if (string.IsNullOrWhiteSpace(_parityIntegrationId)) return;
        _busy = true;
        try
        {
            _fullParity = await Client.GetExpectedRunMissingParityAsync(
                _parityIntegrationId.Trim(),
                string.IsNullOrWhiteSpace(_parityIncidentId) ? null : _parityIncidentId.Trim());
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task RunSmtpTestAsync()
    {
        if (string.IsNullOrWhiteSpace(_smtpTestRecipient)) return;
        _busy = true;
        _error = null;
        _smtpTestResult = null;
        try
        {
            _smtpTestResult = await Client.SendNotificationSmtpTestAsync(
                new NotificationSmtpTestRequestDto(_smtpTestRecipient.Trim()));
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task RunPipelineTestAsync()
    {
        if (string.IsNullOrWhiteSpace(_pipelineTestIntegrationId)) return;
        _busy = true;
        _error = null;
        _pipelineTestResult = null;
        try
        {
            _pipelineTestResult = await Client.RunPlatformNotificationPipelineTestAsync(
                new PlatformNotificationPipelineTestRequestDto(
                    _pipelineTestIntegrationId.Trim(),
                    DefinitionId: null,
                    DryRun: _pipelineTestDryRun,
                    DispatchImmediately: !_pipelineTestDryRun && _pipelineTestDispatch));
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
