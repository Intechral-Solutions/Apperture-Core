@page "/config/notifications/diagnostics"
@layout ConfigLayout
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Organisms
@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Shared
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities
@inject NavigationManager Nav

<div class="p-4 ui-page-stack">
    <PageHeader Eyebrow="Config — Notifications"
                Title="Notification diagnostics"
                Subtitle="Check that notifications are set up and delivering. See overall health, send a test email, or trace one integration's notifications." />

    @if (!_capabilitiesLoaded)
    {
        <LoadingState Message="Loading…" />
    }
    else if (!_canView)
    {
        <div class="mt-4">
            <ForbiddenState Message="Requires integration read and notification definition read." />
        </div>
    }
    else
    {
        <ManagementSection Title="Overall delivery health"
                           Layer="@ManagementSection.UiLayer.Summary"
                           Subtitle="Read-only. These totals cover all stored notification history, not only recent activity."
                           Help="Use Delivery health for the full breakdown and guidance on each error. To change notification settings, use Platform settings.">
            @if (_health is not null)
            {
                <dl class="grid grid-cols-2 md:grid-cols-4 gap-3 text-xs">
                    <div>
                        <dt class="text-muted">Failed deliveries</dt>
                        <dd class="font-semibold">@_health.RecentFailedDeliveryCount</dd>
                        <dd class="text-muted">Emails that could not be sent</dd>
                    </div>
                    <div>
                        <dt class="text-muted">Suppressed notifications</dt>
                        <dd class="font-semibold">@_health.RecentSuppressedInstanceCount</dd>
                        <dd class="text-muted">Created but deliberately not sent</dd>
                    </div>
                    <div>
                        <dt class="text-muted">Waiting to send</dt>
                        <dd class="font-semibold">@_health.RecentPendingOrDeliveringOutboxCount</dd>
                        <dd class="text-muted">Queued or being sent now</dd>
                    </div>
                    <div>
                        <dt class="text-muted">Counted at (UTC)</dt>
                        <dd>@_health.GeneratedAtUtc.UtcDateTime.ToString("u")</dd>
                    </div>
                </dl>
            }
            else
            {
                <p class="text-xs text-muted">Health summary unavailable.</p>
            }
            @if (_configDiagnostics is not null && _configDiagnostics.Warnings.Count > 0)
            {
                <p class="mt-3 text-xs font-semibold text-heading">Configuration warnings</p>
                <ul class="mt-1 list-inside list-disc text-xs text-muted">
                    @foreach (var w in _configDiagnostics.Warnings)
                    {
                        <li>@w.Message</li>
                    }
                </ul>
            }
            <p class="mt-3 text-xs text-muted">
                <a href="@NotificationUiRoutes.Delivery()" class="underline">Delivery health</a>
                ·
                <a href="/config/platform-settings" class="underline">Platform settings</a>
            </p>
        </ManagementSection>

        @if (_canManage)
        {
            <ManagementSection Title="Send a test email"
                               Subtitle="Checks that this instance can send email. Sends one short message to the address you enter."
                               Help="It does not use any notification, integration or recipient setting.">
                <div class="max-w-md">
                    <label class="block text-xs mb-1" for="diag-smtp-recipient">Send the test email to</label>
                    <input id="diag-smtp-recipient"
                           type="email"
                           class="ui-input"
                           autocomplete="email"
                           @bind="_smtpTestRecipient"
                           placeholder="you@example.com" />
                </div>
                <div class="mt-2">
                    <button type="button"
                            class="btn btn-secondary"
                            disabled="@(_busy || string.IsNullOrWhiteSpace(_smtpTestRecipient))"
                            @onclick="RunSmtpTestAsync">
                        Send test email
                    </button>
                </div>
                @if (_smtpTestResult is not null)
                {
                    <p class="mt-2 text-xs @( _smtpTestResult.Succeeded ? "text-success" : "text-error")" role="status">
                        @(_smtpTestResult.Succeeded ? "Test email sent." : $"Test email failed: {_smtpTestResult.FailureSummary}")
                    </p>
                }
            </ManagementSection>
        }

        <ManagementSection Title="Integration to check"
                           Subtitle="The lookup and the pipeline test below both use this integration." >
            <div class="max-w-md">
                @if (_integrationListFailed)
                {
                    <label class="block text-xs mb-1" for="diag-integration">Integration id</label>
                    <input id="diag-integration"
                           class="ui-input font-mono"
                           aria-describedby="diag-integration-help"
                           @bind="_integrationId"
                           @bind:after="OnIntegrationChanged" />
                    <p id="diag-integration-help" class="mt-1 text-xs text-muted">
                        The integration list could not be loaded, so enter the integration's id.
                    </p>
                }
                else
                {
                    <label class="block text-xs mb-1" for="diag-integration">Integration</label>
                    <select id="diag-integration"
                            class="ui-input"
                            aria-describedby="diag-integration-help"
                            @bind="_integrationId"
                            @bind:after="OnIntegrationChanged">
                        <option value="">Choose an integration…</option>
                        @if (!string.IsNullOrWhiteSpace(_integrationId) && !IntegrationListed(_integrationId))
                        {
                            <option value="@_integrationId">@_integrationId</option>
                        }
                        @foreach (var integration in _integrations)
                        {
                            <option value="@integration.Id">@integration.DisplayName</option>
                        }
                    </select>
                    <p id="diag-integration-help" class="mt-1 text-xs text-muted">
                        Pick the integration whose notifications you want to check.
                    </p>
                }
            </div>
        </ManagementSection>

        <ManagementSection Title="Look up notification activity"
                           Subtitle="Read-only. For the chosen integration, shows how many of its 50 most recent notifications were suppressed (created but not sent) and how many of its 50 most recent email deliveries failed."
                           Help="This is a summary. Open the integration's notifications for the individual records.">
            <div class="max-w-md">
                <label class="block text-xs mb-1" for="diag-definition">Notification definition id (optional)</label>
                <input id="diag-definition"
                       class="ui-input font-mono"
                       aria-describedby="diag-definition-help"
                       @bind="_definitionId" />
                <p id="diag-definition-help" class="mt-1 text-xs text-muted">
                    Limit the lookup to one notification definition. Leave empty to include them all. The id is shown on the definition's page.
                </p>
            </div>
            <div class="mt-2">
                <button type="button"
                        class="btn btn-secondary"
                        disabled="@(_busy || string.IsNullOrWhiteSpace(_integrationId))"
                        @onclick="LoadIntegrationDiagAsync">
                    Look up
                </button>
                @if (string.IsNullOrWhiteSpace(_integrationId))
                {
                    <span class="ml-2 text-xs text-muted">Choose an integration first.</span>
                }
            </div>
            @if (_integrationDiag is not null)
            {
                <p class="mt-3 text-xs" role="status">
                    Among the 50 most recent: @_integrationDiag.RecentSuppressedInstances.Count suppressed
                    @(_integrationDiag.RecentSuppressedInstances.Count == 1 ? "notification" : "notifications"),
                    @_integrationDiag.RecentFailedDeliveries.Count failed email
                    @(_integrationDiag.RecentFailedDeliveries.Count == 1 ? "delivery" : "deliveries").
                </p>
                <p class="mt-1 text-xs text-muted">
                    <a class="underline" href="@NotificationUiRoutes.IntegrationNotifications(_integrationDiag.IntegrationId)">Open this integration's notifications</a>
                </p>
            }
        </ManagementSection>

        @if (_canManage)
        {
            <ManagementAdvancedSection Title="Pipeline test (admin)"
                                       Subtitle="Tests the whole notification path for the chosen integration, using a made-up alert.">
                <p class="text-xs text-muted">
                    The test sends a made-up “expected run missing” alert for the integration. It always uses the built-in
                    <strong>Schedule expected run missing</strong> notification. It checks that the settings allow it, that the
                    rule matches, and who would receive it.
                </p>

                <div class="mt-3 max-w-xl space-y-2">
                    <label class="flex items-center gap-2 text-xs" for="diag-dry-run">
                        <input id="diag-dry-run"
                               type="checkbox"
                               aria-describedby="diag-dry-run-help"
                               @bind="_pipelineTestDryRun" />
                        Dry run (check only)
                    </label>
                    <p id="diag-dry-run-help" class="ml-6 text-xs text-muted">
                        Checks the settings, the rule and the recipients. Saves nothing and sends nothing. Recommended first.
                    </p>

                    <label class="flex items-center gap-2 text-xs" for="diag-dispatch">
                        <input id="diag-dispatch"
                               type="checkbox"
                               aria-describedby="diag-dispatch-help"
                               @bind="_pipelineTestDispatch"
                               disabled="@_pipelineTestDryRun" />
                        Send emails immediately
                    </label>
                    <p id="diag-dispatch-help" class="ml-6 text-xs text-muted">
                        Only for a live run. Without it, a live run's emails are sent by the next background send, if delivery is enabled.
                    </p>
                </div>

                @if (!_pipelineTestDryRun)
                {
                    <div class="mt-3">
                        <PageMessage Kind="PageMessageKind.Warning"
                                     Message="Live run: this creates a real notification for the integration and records it in notification history. Its emails go to the integration's real recipients when delivery is enabled." />
                    </div>
                }

                <div class="mt-3">
                    <button type="button"
                            class="btn btn-secondary"
                            disabled="@(_busy || string.IsNullOrWhiteSpace(_integrationId))"
                            @onclick="RunPipelineTestAsync">
                        @(_pipelineTestDryRun ? "Run dry-run test" : "Run live test")
                    </button>
                    @if (string.IsNullOrWhiteSpace(_integrationId))
                    {
                        <span class="ml-2 text-xs text-muted">Choose an integration first.</span>
                    }
                </div>

                @if (_pipelineTestResult is not null)
                {
                    <div class="ui-detail-block mt-3 text-xs">
                        <div class="font-semibold mb-1">
                            @(_pipelineTestResult.DryRun ? "Dry-run result" : "Live result")
                            @if (!string.IsNullOrWhiteSpace(_pipelineTestResult.NotificationInstanceId))
                            {
                                <span class="font-normal text-muted"> · </span>
                                <a class="underline font-normal" href="@NotificationUiRoutes.InstanceDetail(_pipelineTestResult.NotificationInstanceId)">Open the notification created</a>
                            }
                        </div>
                        @if (!string.IsNullOrWhiteSpace(_pipelineTestResult.SuppressionReason))
                        {
                            <p class="text-warning">Suppressed: @_pipelineTestResult.SuppressionReason</p>
                        }
                        <ul class="mt-1 space-y-1">
                            @foreach (var stage in _pipelineTestResult.Stages)
                            {
                                <li>
                                    <span class="font-semibold">@StageLabel(stage.Stage)</span>
                                    <span class="text-muted">(@stage.Status)</span>
                                    @if (!string.IsNullOrWhiteSpace(stage.Detail))
                                    {
                                        <span> — @stage.Detail</span>
                                    }
                                </li>
                            }
                        </ul>
                        @if (_pipelineTestResult.DeliverableRecipients.Count > 0 || _pipelineTestResult.SkippedRecipients.Count > 0)
                        {
                            <p class="mt-2 text-muted">
                                Would receive it: @_pipelineTestResult.DeliverableRecipients.Count ·
                                Skipped: @_pipelineTestResult.SkippedRecipients.Count
                            </p>
                        }
                        @if (!string.IsNullOrWhiteSpace(_pipelineTestResult.DispatchNote))
                        {
                            <p class="mt-1 text-muted">@_pipelineTestResult.DispatchNote</p>
                        }
                    </div>
                }
            </ManagementAdvancedSection>
        }

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="mt-4">
                <PageMessage Kind="PageMessageKind.Error" Message="@_error" />
            </div>
        }
    }
</div>

@code {
    private bool _capabilitiesLoaded;
    private bool _canView;
    private bool _canManage;
    private bool _busy;
    private string? _error;
    private string _integrationId = "";
    private string _definitionId = "";
    private IReadOnlyList<IntegrationDto> _integrations = [];
    private bool _integrationListFailed;
    private NotificationDeliveryHealthSummaryDto? _health;
    private NotificationIntegrationDiagnosticsDto? _integrationDiag;
    private NotificationConfigurationDiagnosticsDto? _configDiagnostics;
    private string _smtpTestRecipient = "";
    private bool _pipelineTestDryRun = true;
    private bool _pipelineTestDispatch;
    private NotificationSmtpTestResultDto? _smtpTestResult;
    private PlatformNotificationPipelineTestResultDto? _pipelineTestResult;

    protected override async Task OnInitializedAsync()
    {
        var caps = await Capabilities.GetCapabilitiesAsync();
        _canView = caps.CanViewIntegrations && caps.CanViewNotificationDefinitions;
        _canManage = caps.CanManageNotificationDefinitions;
        _capabilitiesLoaded = true;
        if (!_canView) return;

        var q = NavigationQueryHelper.ParseQuery(Nav.ToAbsoluteUri(Nav.Uri).Query);
        if (q.TryGetValue("definitionId", out var did)) _definitionId = did;
        if (q.TryGetValue("integrationId", out var iid)) _integrationId = iid;

        try
        {
            _health = await Client.GetNotificationDeliveryHealthAsync();
            _configDiagnostics = await Client.GetNotificationConfigurationDiagnosticsAsync();
        }
        catch (Exception ex) { _error = ex.Message; }

        try
        {
            _integrations = (await Client.GetIntegrationsAsync())
                .OrderBy(i => i.DisplayName, StringComparer.OrdinalIgnoreCase)
                .ToList();
        }
        catch (Exception)
        {
            // Fall back to typing the integration id; the tools themselves are unaffected.
            _integrationListFailed = true;
        }
    }

    private bool IntegrationListed(string id) =>
        _integrations.Any(i => string.Equals(i.Id, id, StringComparison.Ordinal));

    /// <summary>A result belongs to the integration it was run for, so clear it when the choice changes.</summary>
    private void OnIntegrationChanged()
    {
        _integrationDiag = null;
        _pipelineTestResult = null;
    }

    private static string StageLabel(string stage) => stage switch
    {
        "configuration" => "Settings check",
        "platform_event_emit" => "Alert recorded",
        "rule_evaluation" => "Rule match",
        "recipient_resolution" => "Recipients",
        "instance_creation" => "Notification created",
        "outbox_creation" => "Emails queued",
        "smtp_dispatch" => "Emails sent",
        _ => stage
    };

    private async Task LoadIntegrationDiagAsync()
    {
        if (string.IsNullOrWhiteSpace(_integrationId)) return;
        _busy = true;
        _error = null;
        try
        {
            _integrationDiag = await Client.GetNotificationIntegrationDiagnosticsAsync(
                _integrationId.Trim(),
                string.IsNullOrWhiteSpace(_definitionId) ? null : _definitionId.Trim());
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task RunSmtpTestAsync()
    {
        if (string.IsNullOrWhiteSpace(_smtpTestRecipient)) return;
        _busy = true;
        _error = null;
        _smtpTestResult = null;
        try
        {
            _smtpTestResult = await Client.SendNotificationSmtpTestAsync(
                new NotificationSmtpTestRequestDto(_smtpTestRecipient.Trim()));
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task RunPipelineTestAsync()
    {
        if (string.IsNullOrWhiteSpace(_integrationId)) return;
        _busy = true;
        _error = null;
        _pipelineTestResult = null;
        try
        {
            _pipelineTestResult = await Client.RunPlatformNotificationPipelineTestAsync(
                new PlatformNotificationPipelineTestRequestDto(
                    _integrationId.Trim(),
                    DefinitionId: null,
                    DryRun: _pipelineTestDryRun,
                    DispatchImmediately: !_pipelineTestDryRun && _pipelineTestDispatch));
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }
}
