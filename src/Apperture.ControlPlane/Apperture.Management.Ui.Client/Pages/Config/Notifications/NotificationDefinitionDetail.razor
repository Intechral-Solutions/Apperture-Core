@page "/config/notifications/definitions/{DefinitionId}"
@layout ConfigLayout
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Organisms
@using Apperture.Management.Ui.Client.Molecules
@using Apperture.Management.Ui.Client.Organisms.Notifications
@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Shared
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities
@inject NavigationManager Nav
@inject ShellOrientationService ShellOrientation

<div class="p-4 ui-page-stack">
    <PageHeader @key="@DefinitionId"
                Eyebrow="Notifications"
                Title="@DetailTitle"
                Subtitle="@DetailSubtitle">
        <ChildContent>
            <div class="mt-1 font-mono text-xs text-muted break-all">@DefinitionId</div>
        </ChildContent>
        <Toolbar>
            <a href="/config/notifications/definitions"
               class="ui-toolbar-btn">Back to definitions</a>
            @if (_canEditDefinition)
            {
                <a href="@EditHref"
                   class="ui-toolbar-btn">Edit definition</a>
            }
            @if (_canDeleteDefinition)
            {
                <button type="button"
                        id="notification-definition-delete-trigger"
                        class="ui-toolbar-btn ui-toolbar-btn--danger"
                        disabled="@_busy"
                        @onclick="() => _confirmDeleteOpen = true">Delete</button>
            }
        </Toolbar>
    </PageHeader>

    @if (!_capabilitiesLoaded)
    {
        <LoadingState />
    }
    else if (!_canView)
    {
        <ForbiddenState Title="Not authorized"
                        Message="You do not have permission to view this definition." />
    }
    else if (_loading)
    {
        <LoadingState />
    }
    else if (!string.IsNullOrEmpty(_error) && _detail is null)
    {
        <ErrorState Message="@_error" />
    }
    else if (_detail is null)
    {
        <EmptyState Title="Definition not found"
                    Message="The requested notification definition could not be loaded." />
    }
    else
    {
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="mb-4">
                <PageMessage Kind="PageMessageKind.Error" Message="@_error" />
            </div>
        }

        <ManagementSection Title="Summary"
                           Layer="ManagementSection.UiLayer.Summary"
                           Help="Definition identity, ownership, and current enablement from persisted notification metadata.">
            <div class="flex flex-wrap items-center gap-2">
                <StatusPill Label="@(_detail.IsEnabled ? "Enabled" : "Disabled")"
                            Semantic="@(_detail.IsEnabled ? ManagementStatusSemantic.Success : ManagementStatusSemantic.Neutral)" />
                <StatusPill Label="@($"Scope: {_detail.Scope}")" Semantic="@ManagementStatusSemantic.Neutral" />
                <StatusPill Label="@($"Origin: {_detail.Origin}")" Semantic="@ManagementStatusSemantic.Neutral" />
                @if (!string.IsNullOrWhiteSpace(_detail.SourceKind))
                {
                    <StatusPill Label="@($"Source: {_detail.SourceKind}")" Semantic="@ManagementStatusSemantic.Neutral" />
                }
                @if (_isRuleTemplateLocked)
                {
                    <AttentionPill Label="Rule/template locked"
                                   Semantic="@ManagementAttentionSemantic.Info" />
                }
                @if (ShowNoDeliverableRecipientsWarning)
                {
                    <AttentionPill Label="No deliverable recipients"
                                   Semantic="@ManagementAttentionSemantic.Warning" />
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(_detail.Description))
            {
                <p class="mt-3 text-xs text-muted">@_detail.Description</p>
            }

            <div class="ui-summary-card-grid">
                <ManagementSummaryCard Title="Instances"
                                       Description="Recent and historical notification instances for this definition."
                                       Href="@NotificationUiRoutes.DefinitionInstances(DefinitionId)" />
                <ManagementSummaryCard Title="Diagnostics"
                                       Description="Resolution and delivery diagnostics scoped to this definition."
                                       Href="@DiagnosticsHref" />
                <ManagementSummaryCard Title="Delivery"
                                       Description="Outbox and delivery processing posture for notification pipeline."
                                       Href="/config/notifications/delivery" />
                @if (!string.IsNullOrWhiteSpace(_detail.IntegrationId))
                {
                    <ManagementSummaryCard Title="Integration notifications"
                                           Description="Integration-scoped notification configuration and attention routing."
                                           Href="@NotificationUiRoutes.IntegrationNotifications(_detail.IntegrationId)" />
                }
                <ManagementSummaryCard Title="All definitions"
                                       Description="Return to definitions list and filter related entries."
                                       Href="/config/notifications/definitions" />
            </div>
        </ManagementSection>

        @if (_isRuleTemplateLocked)
        {
            <PageMessage Kind="PageMessageKind.Info"
                         Title="Rule and template are locked"
                         Message="Platform-built-in definitions keep rule and template fixed. You can still manage enabled state and subscriptions." />
        }

        @if (_showPlatformDefaults)
        {
            <ManagementSection Title="Platform defaults"
                               Layer="ManagementSection.UiLayer.Detail"
                               Help="Editable platform defaults for this built-in definition. Rule and template content remain fixed.">
                <div class="grid grid-cols-1 gap-3 md:grid-cols-2 text-xs" id="notification-definition-platform-defaults">
                    <label class="block">
                        <span class="text-muted">Default severity</span>
                        @if (_canManage)
                        {
                            <select class="ui-input mt-1"
                                    id="platform-default-severity"
                                    value="@_detail.DefaultSeverity"
                                    disabled="@_busy"
                                    @onchange="SetPlatformDefaultSeverityAsync">
                                <option value="">—</option>
                                @foreach (var (value, label) in NotificationSeverityOptions.All)
                                {
                                    <option value="@value">@label</option>
                                }
                            </select>
                        }
                        else
                        {
                            <div id="platform-default-severity">@(_detail.DefaultSeverity ?? "—")</div>
                        }
                    </label>
                    <label class="flex items-center gap-2">
                        @if (_canManage)
                        {
                            <input type="checkbox"
                                   id="platform-toast-default"
                                   checked="@_detail.ToastEnabledByDefault"
                                   disabled="@_busy"
                                   @onchange="SetToastEnabledByDefaultAsync" />
                        }
                        else
                        {
                            <span id="platform-toast-default">@(_detail.ToastEnabledByDefault ? "Yes" : "No")</span>
                        }
                        <span class="text-muted">Show as toast by default</span>
                    </label>
                </div>
            </ManagementSection>
        }

        <NotificationDefinitionPostCreatePrompt Visible="@_showPostCreatePrompt"
                                                CanManageSubscriptions="@_canManage"
                                                Disabled="@_busy"
                                                ViewDefinitionHref="@DetailSelfHref"
                                                IntegrationNotificationsHref="@PostCreateIntegrationNotificationsHref"
                                                OnAddSubscription="FocusSubscriptionsAsync"
                                                OnPreviewRecipients="PreviewPostCreateRecipientsAsync"
                                                OnDismiss="DismissPostCreatePromptAsync" />

        <ManagementSection Title="Definition and subscription configuration"
                           Layer="ManagementSection.UiLayer.Detail"
                           Help="Routine authoring and operational controls for metadata, recipients, preview, and recent execution evidence.">
            <div class="grid grid-cols-1 gap-1 md:grid-cols-2 text-xs">
                <div><dt class="text-muted">Mutability</dt><dd>@_detail.Mutability</dd></div>
                <div><dt class="text-muted">Primary event</dt><dd>@(_detail.PrimaryEventType ?? "—")</dd></div>
                <div><dt class="text-muted">Module</dt><dd class="font-mono break-all">@(_detail.ModuleId ?? "—")</dd></div>
                <div><dt class="text-muted">Severity</dt><dd>@(_detail.DefaultSeverity ?? "—")</dd></div>
                <div><dt class="text-muted">Updated</dt><dd>@_detail.UpdatedAtUtc.UtcDateTime.ToString("u")</dd></div>
                <div><dt class="text-muted">Integration</dt><dd class="font-mono break-all">
                    @if (!string.IsNullOrWhiteSpace(_detail.IntegrationId))
                    {
                        <DrillInLink Href="@NotificationUiRoutes.IntegrationNotifications(_detail.IntegrationId)">@_detail.IntegrationId</DrillInLink>
                    }
                    else
                    {
                        <span>—</span>
                    }
                </dd></div>
                <div><dt class="text-muted">Enabled</dt><dd>
                    @if (_canManage)
                    {
                        <input type="checkbox" checked="@_detail.IsEnabled" disabled="@_busy" @onchange="ToggleDefinitionEnabledAsync" />
                    }
                    else
                    {
                        @(_detail.IsEnabled ? "Yes" : "No")
                    }
                </dd></div>
            </div>

            <div class="mt-4 border-t border-default pt-4">
                <div class="text-sm font-semibold text-heading mb-2">Explicit subscriptions</div>
                @if (_attentionRouting is not null && HasAttentionRoutingRecipients)
                {
                    <p class="ui-detail-block text-xs">
                        Implicit attention-routing recipients may apply for this integration. They are not platform subscriptions.
                    </p>
                }
                @if (_canManage)
                {
                    <div class="mb-3 flex flex-wrap items-end gap-2 text-xs border-b border-default pb-3" id="definition-subscriptions">
                        <label>
                            Kind
                            <select class="ui-input" @bind="_addKind">
                                <option value="principal">principal</option>
                                <option value="operational_team">operational_team</option>
                                <option value="managed_contact">managed_contact</option>
                            </select>
                        </label>
                        <label class="min-w-[10rem] flex-1">
                            Ref
                            <select class="ui-input" @bind="_addRef">
                                <option value="">— select —</option>
                                @foreach (var opt in RecipientOptions)
                                {
                                    <option value="@opt.Id">@opt.Label</option>
                                }
                            </select>
                        </label>
                        <label>
                            Delivery mode
                            <select class="ui-input" @bind="_addDeliveryMode">
                                @foreach (var mode in NotificationDeliveryModeOptions.All)
                                {
                                    <option value="@mode.Value">@mode.Label</option>
                                }
                            </select>
                        </label>
                        @if (_addKind == "managed_contact" && _canManageContacts)
                        {
                            <label class="flex items-center gap-1">
                                <input type="checkbox" @bind="_createContactIfMissing" />
                                Create contact if missing
                            </label>
                        }
                        <button type="button" class="btn btn-secondary" disabled="@_busy" @onclick="AddSubscriptionAsync">Add</button>
                    </div>
                }
                @if (_subscriptions is { Count: 0 })
                {
                    <div class="ui-detail-block text-xs">
                        <p class="font-medium text-heading">No explicit subscriptions yet</p>
                        <p class="mt-1 text-muted">@GetEmptySubscriptionsMessage()</p>
                    </div>
                }
                else if (_subscriptions is not null)
                {
                    <div class="ui-data-table">
                    <table class="ui-data-table__table min-w-full text-left text-xs">
                        <thead class="text-muted">
                            <tr>
                                <th class="p-1">Kind</th>
                                <th class="p-1">Ref</th>
                                <th class="p-1">Mode</th>
                                <th class="p-1">Enabled</th>
                                <th class="p-1"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var s in _subscriptions)
                            {
                                <tr class="border-t border-default">
                                    <td class="p-1">@s.RecipientKind</td>
                                    <td class="p-1 font-mono break-all">@s.RecipientRef</td>
                                    <td class="p-1">
                                        @if (_canManage)
                                        {
                                            <select class="ui-input ui-input--narrow" value="@s.DeliveryMode" disabled="@_busy" @onchange="e => PatchSubscriptionDeliveryModeAsync(s, e)">
                                                @foreach (var mode in NotificationDeliveryModeOptions.All)
                                                {
                                                    <option value="@mode.Value">@mode.Label</option>
                                                }
                                            </select>
                                        }
                                        else
                                        {
                                            @s.DeliveryMode
                                        }
                                    </td>
                                    <td class="p-1">
                                        @if (_canManage)
                                        {
                                            <input type="checkbox" checked="@s.IsEnabled" disabled="@_busy" @onchange="e => PatchSubscriptionEnabledAsync(s, e)" />
                                        }
                                        else
                                        {
                                            @(s.IsEnabled ? "Yes" : "No")
                                        }
                                    </td>
                                    <td class="p-1">
                                        @if (_canManage)
                                        {
                                            <button type="button" class="underline text-muted disabled:opacity-50" disabled="@_busy" @onclick="() => RemoveSubscriptionAsync(s)">Remove</button>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                }
            </div>

            <div class="mt-4 border-t border-default pt-4">
                <div class="text-sm font-semibold text-heading mb-2">Render preview</div>
                <div class="flex items-center justify-between gap-2 mb-2">
                    <p class="text-xs text-muted">Uses a sample event payload and does not send delivery.</p>
                    <button type="button" class="btn btn-secondary text-xs" disabled="@_busy" @onclick="RenderPreviewAsync">Preview</button>
                </div>
                @if (_preview is not null)
                {
                    <div class="text-xs space-y-1">
                        <div><span class="text-muted">Subject:</span> @_preview.Subject</div>
                        <div><span class="text-muted">Summary:</span> @_preview.Summary</div>
                        @if (!string.IsNullOrWhiteSpace(_preview.BodyText))
                        {
                            <pre class="ui-code-block mt-1 whitespace-pre-wrap">@_preview.BodyText</pre>
                        }
                    </div>
                }
                else
                {
                    <p class="text-xs text-muted">No preview yet.</p>
                }
            </div>

            <div class="mt-4 border-t border-default pt-4">
                <div class="text-sm font-semibold text-heading mb-2">Recipient preview</div>
                <div class="flex flex-wrap items-end gap-2 text-xs">
                    <label>
                        Integration id
                        <input class="ui-input font-mono" @bind="_resolveIntegrationId" />
                    </label>
                    <button type="button" class="btn btn-secondary" disabled="@_busy" @onclick="ResolveRecipientsAsync">Preview</button>
                </div>
                @if (_recipientPreviewRefreshedAt is not null)
                {
                    <p class="mt-2 text-xs text-muted">Last refreshed @_recipientPreviewRefreshedAt.Value.UtcDateTime.ToString("u") UTC.</p>
                }
                <NotificationRecipientResolutionDisplay Resolution="_resolution" />
                @if (ShowNoDeliverableRecipientsWarning)
                {
                    <p class="mt-2 rounded border border-message-warning bg-message-warning p-2 text-xs">
                        No deliverable recipients for this definition. Platform delivery will not create outbox rows until at least one explicit subscription resolves to a deliverable recipient.
                    </p>
                }
            </div>

            <div class="mt-4 border-t border-default pt-4">
                <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                    <div class="text-sm font-semibold text-heading">Recent instances</div>
                    <DrillInLink Href="@NotificationUiRoutes.DefinitionInstances(DefinitionId)">View all instances</DrillInLink>
                </div>
                @if (_recentInstances is { Count: 0 })
                {
                    <p class="text-xs text-muted">No recent instances.</p>
                }
                else if (_recentInstances is not null)
                {
                    <div class="ui-data-table">
                    <table class="ui-data-table__table min-w-full text-left text-xs">
                        <thead class="text-muted">
                            <tr>
                                <th class="p-1">Created</th>
                                <th class="p-1">Status</th>
                                <th class="p-1">Kind</th>
                                <th class="p-1"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var i in _recentInstances)
                            {
                                <tr>
                                    <td class="p-1">@i.CreatedAtUtc.UtcDateTime.ToString("u")</td>
                                    <td class="p-1">@i.Status</td>
                                    <td class="p-1">@i.NotificationKind</td>
                                    <td class="p-1"><DrillInLink Href="@NotificationUiRoutes.InstanceDetail(i.Id)">Open</DrillInLink></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                    </div>
                }
                <div class="mt-2 text-xs">
                    <DrillInLink Href="@DiagnosticsHref">Diagnostics for this definition</DrillInLink>
                </div>
            </div>
        </ManagementSection>

        <ManagementAdvancedSection Title="Technical payloads and identifiers"
                                   Subtitle="Raw definition internals, JSON payloads, and low-frequency diagnostics."
                                   InitiallyOpen="false">
            <div class="grid grid-cols-1 gap-2 md:grid-cols-2 text-xs">
                <div><dt class="text-muted">Definition id</dt><dd class="font-mono break-all">@_detail.Id</dd></div>
                <div><dt class="text-muted">Source kind</dt><dd>@_detail.SourceKind</dd></div>
                <div><dt class="text-muted">Primary event type</dt><dd class="font-mono break-all">@(_detail.PrimaryEventType ?? "—")</dd></div>
                <div><dt class="text-muted">Integration id</dt><dd class="font-mono break-all">@(_detail.IntegrationId ?? "—")</dd></div>
                <div><dt class="text-muted">Module id</dt><dd class="font-mono break-all">@(_detail.ModuleId ?? "—")</dd></div>
                <div><dt class="text-muted">Updated</dt><dd>@_detail.UpdatedAtUtc.UtcDateTime.ToString("u")</dd></div>
            </div>

            <div class="mt-4">
                <div class="font-semibold text-heading mb-2 text-sm">Rule JSON (read-only)</div>
                <pre class="ui-code-block overflow-x-auto text-xs">@_detail.RuleJson</pre>
            </div>

            <div class="mt-4">
                <div class="font-semibold text-heading mb-2 text-sm">Template JSON (read-only)</div>
                <pre class="ui-code-block overflow-x-auto text-xs">@_detail.TemplateJson</pre>
            </div>
        </ManagementAdvancedSection>
    }
</div>

<ConfirmActionDialog IsOpen="@_confirmDeleteOpen"
                     Title="Delete notification definition?"
                     ConfirmLabel="Delete definition"
                     Emphasis="ConfirmActionEmphasis.Destructive"
                     OnConfirm="DeleteDefinitionAsync"
                     OnConfirmed="NavigateToDefinitionsList"
                     OnCancel="() => _confirmDeleteOpen = false">
    <ChildContent>
        Deleting <strong>@(_detail?.DisplayName ?? "this notification definition")</strong> permanently removes it. This cannot be undone.
    </ChildContent>
    <Details>
        Subscriptions and per-user overrides for this definition are removed with it. Historical notification instances already sent are preserved.
    </Details>
</ConfirmActionDialog>

@code {
    [Parameter] public string DefinitionId { get; set; } = "";

    [SupplyParameterFromQuery(Name = NotificationPostCreateNavigation.CreatedDefinitionIdQuery)]
    public string? CreatedDefinitionIdQuery { get; set; }

    [SupplyParameterFromQuery(Name = NotificationPostCreateNavigation.IntegrationIdQuery)]
    public string? IntegrationIdQuery { get; set; }

    private bool _capabilitiesLoaded;
    private bool _canView;
    private bool _canManage;
    private bool _canManageDefinitions;
    private bool _canUpdateIntegrations;
    private bool _canManageContacts;
    private bool _loading = true;
    private bool _busy;
    private bool _confirmDeleteOpen;
    private string? _error;
    private NotificationDefinitionDetailDto? _detail;
    private IReadOnlyList<NotificationSubscriptionDto>? _subscriptions;
    private IReadOnlyList<NotificationInstanceSummaryDto>? _recentInstances;
    private RenderedNotificationSnapshotDto? _preview;
    private NotificationRecipientResolutionPreviewDto? _resolution;
    private string _addKind = "principal";
    private string _addRef = "";
    private string _addDeliveryMode = "immediate";
    private bool _createContactIfMissing;
    private string _resolveIntegrationId = "";
    private bool _showPostCreatePrompt;
    private DateTimeOffset? _recipientPreviewRefreshedAt;
    private AttentionRoutingEffectiveDto? _attentionRouting;
    private IReadOnlyList<UserListDto> _users = [];
    private IReadOnlyList<OperationalTeamSummaryDto> _teams = [];
    private IReadOnlyList<ManagedContactSummaryDto> _contacts = [];

    private string DiagnosticsHref => NotificationUiRoutes.DiagnosticsForDefinition(DefinitionId);

    private string EditHref => NotificationUiRoutes.DefinitionEdit(DefinitionId);

    private string DetailSelfHref => NotificationUiRoutes.DefinitionDetail(DefinitionId);

    private string DetailTitle =>
        string.IsNullOrWhiteSpace(_detail?.DisplayName) ? "Notification definition" : _detail!.DisplayName;

    private string DetailSubtitle
    {
        get
        {
            if (_detail is null)
                return "Definition detail";
            var enabled = _detail.IsEnabled ? "Enabled" : "Disabled";
            var source = string.IsNullOrWhiteSpace(_detail.SourceKind) ? "Source: unknown" : $"Source: {_detail.SourceKind}";
            var scope = string.IsNullOrWhiteSpace(_detail.Scope) ? "Scope: unknown" : $"Scope: {_detail.Scope}";
            return $"{enabled} · {scope} · {source}";
        }
    }

    private string? PostCreateIntegrationNotificationsHref
    {
        get
        {
            var integrationId = _detail?.IntegrationId ?? IntegrationIdQuery;
            return string.IsNullOrWhiteSpace(integrationId)
                ? null
                : NotificationPostCreateNavigation.IntegrationNotificationsAfterCreate(integrationId.Trim(), DefinitionId);
        }
    }

    private bool _isRuleTemplateLocked =>
        _detail is not null
        && !string.Equals(_detail.Mutability, "fullyEditable", StringComparison.Ordinal);

    private bool _canEditDefinition =>
        _canManage
        && _detail is not null
        && string.Equals(_detail.Mutability, "fullyEditable", StringComparison.Ordinal);

    private bool _canDeleteDefinition =>
        _canManage
        && _detail is not null
        && string.Equals(_detail.Origin, "userCreated", StringComparison.OrdinalIgnoreCase);

    // CMP-X: built-ins cannot reach DefaultSeverity/ToastEnabledByDefault through the fullyEditable-gated
    // authoring form, even though the store already accepts changes to those two fields for them (only
    // RuleJson/TemplateJson are refused). Gated on Origin, matching _canDeleteDefinition's convention, not
    // on Mutability -- this section's eligibility is "is this a built-in", not "is rule/template locked".
    private bool _showPlatformDefaults =>
        _detail is not null
        && (_detail.Origin == "platformBuiltIn" || _detail.Origin == "moduleBuiltIn");

    private bool HasAttentionRoutingRecipients =>
        _attentionRouting is not null
        && (_attentionRouting.PrimaryRecipients.Count > 0 || _attentionRouting.EscalationRecipients.Count > 0);

    private bool ShowNoDeliverableRecipientsWarning =>
        _detail is not null
        && string.Equals(_detail.Origin, "userCreated", StringComparison.OrdinalIgnoreCase)
        && _resolution is not null
        && _resolution.Deliverable.Count == 0;

    private IEnumerable<(string Id, string Label)> RecipientOptions => _addKind switch
    {
        "operational_team" => _teams.Select(t => (t.Id, $"{t.Name} ({t.Id})")),
        "managed_contact" => _contacts.Select(c => (c.Id, $"{c.DisplayName} ({c.Id})")),
        _ => _users.Select(u => (u.UserId, $"{u.DisplayName} ({u.UserId})"))
    };

    private string? _dataLoadKey;

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        var key = DefinitionId ?? "";
        if (key == _dataLoadKey)
            return;
        _dataLoadKey = key;
        _detail = null;
        if (!_capabilitiesLoaded)
            return;
        if (!_canView)
            return;
        await LoadAsync();
    }

    protected override async Task OnInitializedAsync()
    {
        var caps = await Capabilities.GetCapabilitiesAsync();
        _canView = caps.CanViewNotificationDefinitions;
        _canManageDefinitions = caps.CanManageNotificationDefinitions;
        _canUpdateIntegrations = caps.CanUpdateIntegrations;
        _canManageContacts = caps.CanManageManagedContacts;
        _capabilitiesLoaded = true;
        if (!_canView)
        {
            _loading = false;
            return;
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _busy = true;
        _loading = true;
        _error = null;
        _detail = null;
        try
        {
            _detail = await Client.GetNotificationDefinitionAsync(DefinitionId);
            if (_detail is null)
                return;

            _canManage = _canManageDefinitions
                && (string.IsNullOrWhiteSpace(_detail.IntegrationId) || _canUpdateIntegrations);

            _resolveIntegrationId = _detail.IntegrationId ?? _resolveIntegrationId;
            _subscriptions = await Client.ListNotificationSubscriptionsByDefinitionAsync(DefinitionId);
            _recentInstances = await Client.ListNotificationInstancesAsync(definitionId: DefinitionId, take: 10);

            if (_canManage)
            {
                var userPage = await Client.GetUserPageAsync(0, 200);
                _users = userPage.Items;
                _teams = await Client.ListOperationalTeamsAsync(includeDisabled: false);
                _contacts = await Client.ListManagedContactsAsync(null, 200) ?? [];
            }

            if (!string.IsNullOrWhiteSpace(_detail.IntegrationId))
            {
                try
                {
                    _attentionRouting = await Client.GetIntegrationAttentionRoutingAsync(_detail.IntegrationId);
                }
                catch
                {
                    _attentionRouting = null;
                }
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
            _loading = false;
            ShellOrientation.PublishForCurrentUri(Nav, DetailTitle, DetailSubtitle);
        }

        await ApplyPostCreateContextAsync();
    }

    private async Task ApplyPostCreateContextAsync()
    {
        if (string.IsNullOrWhiteSpace(CreatedDefinitionIdQuery))
            return;
        if (!string.Equals(CreatedDefinitionIdQuery.Trim(), DefinitionId, StringComparison.Ordinal))
            return;

        _showPostCreatePrompt = true;
        if (!string.IsNullOrWhiteSpace(IntegrationIdQuery))
            _resolveIntegrationId = IntegrationIdQuery.Trim();
        else if (!string.IsNullOrWhiteSpace(_detail?.IntegrationId))
            _resolveIntegrationId = _detail.IntegrationId;

        await ResolveRecipientsAsync();
    }

    private async Task ToggleDefinitionEnabledAsync(ChangeEventArgs e)
    {
        if (!_canManage || _detail is null)
            return;
        var enabled = ParseCheckbox(e);
        _busy = true;
        _error = null;
