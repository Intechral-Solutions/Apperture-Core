    private static bool ParseCheckbox(ChangeEventArgs e) =>
        e.Value is bool b ? b : string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);

    private string GetEmptySubscriptionsMessage()
    {
        if (_detail is null)
            return "Add explicit subscriptions so platform delivery can create outbox rows.";

        if (string.Equals(_detail.Id, "platform.schedule.expected_run_missing", StringComparison.Ordinal))
        {
            if (!string.IsNullOrWhiteSpace(_detail.IntegrationId))
                return "Attention routing may still supply implicit recipients on the integration notifications page. Add explicit subscriptions when you want platform subscription control.";
            return "Add explicit subscriptions for platform pipeline delivery of expected-run-missing notifications.";
        }

        if (string.Equals(_detail.Origin, "userCreated", StringComparison.OrdinalIgnoreCase))
            return "No recipients are configured. Platform delivery will not create outbox rows until you add at least one explicit subscription.";

        return "Add explicit subscriptions so platform delivery can create outbox rows for this definition.";
    }

