@page "/config/notifications"
@layout ConfigLayout
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Organisms
@using Apperture.Management.Ui.Client.Services
@inject IOperatorCapabilitiesService Capabilities

<div class="p-4 ui-page-stack">
    <PageHeader Eyebrow="Config"
                Title="Notifications"
                Subtitle="Platform notification definitions, delivery instances, and diagnostics. No live send from the UI in this phase." />

    @if (!_capabilitiesLoaded)
    {
        <LoadingState Message="Loading…" />
    }
    else if (!_canView)
    {
        <ForbiddenState Message="You do not have permission to view notification definitions." />
    }
    else
    {
        <div class="ui-summary-card-grid">
            <ManagementSummaryCard Title="Definitions"
                                   Description="Browse definitions, subscriptions, and render preview."
                                   Href="/config/notifications/definitions" />
            <ManagementSummaryCard Title="Instances"
                                   Description="Rendered instances and suppression reasons."
                                   Href="/config/notifications/instances" />
            <ManagementSummaryCard Title="Delivery"
                                   Description="Outbox health and failed or pending deliveries by integration."
                                   Href="/config/notifications/delivery" />
            <ManagementSummaryCard Title="Diagnostics"
                                   Description="Delivery health, SMTP test, and platform pipeline verification (read-only unless you run an admin test)."
                                   Href="/config/notifications/diagnostics" />
        </div>
    }
</div>

@code {
    private bool _capabilitiesLoaded;
    private bool _canView;

    protected override async Task OnInitializedAsync()
    {
        var caps = await Capabilities.GetCapabilitiesAsync();
        _canView = caps.CanViewNotificationDefinitions;
        _capabilitiesLoaded = true;
    }
}
