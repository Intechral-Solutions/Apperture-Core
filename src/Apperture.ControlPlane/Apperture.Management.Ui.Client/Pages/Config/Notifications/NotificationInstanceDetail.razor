@page "/config/notifications/instances/{InstanceId}"
@layout ConfigLayout
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Organisms
@using Apperture.Management.Ui.Client.Organisms.Notifications
@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Shared
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities

<div class="p-4">
    <div class="text-xs text-muted mb-1">
        <a class="underline" href="/config/notifications/instances">Instances</a> — @InstanceId
    </div>

    @if (!_capabilitiesLoaded)
    {
        <LoadingState Message="Loading…" />
    }
    else if (!_canView)
    {
        <div class="mt-4">
            <ForbiddenState Message="You do not have permission to view this instance." />
        </div>
    }
    else if (_loading)
    {
        <LoadingState Message="Loading…" />
    }
    else if (_detail is null)
    {
        <EmptyState Message="Instance not found." />
    }
    else
    {
        <PageHeader Title="@_detail.RenderedSubject" Subtitle="@InstanceSubtitle" />

        <div class="mt-4 space-y-4 text-sm">
            <section class="rounded border border-default bg-surface p-3 text-xs">
                <div class="font-semibold text-heading mb-2">Metadata</div>
                <dl class="grid grid-cols-1 gap-1 md:grid-cols-2">
                    <div><dt class="text-muted">Notification kind</dt><dd>@_detail.NotificationKind</dd></div>
                    <div><dt class="text-muted">Status</dt><dd>@_detail.Status</dd></div>
                    <div><dt class="text-muted">Suppression</dt><dd>@(_detail.SuppressionReason ?? "—")</dd></div>
                    <div><dt class="text-muted">Template hash</dt><dd class="font-mono break-all">@_detail.TemplateVersionHash</dd></div>
                    <div><dt class="text-muted">Definition</dt><dd><a class="underline font-mono" href="@NotificationUiRoutes.DefinitionDetail(_detail.NotificationDefinitionId)">@_detail.NotificationDefinitionId</a></dd></div>
                    <div><dt class="text-muted">Integration</dt><dd>
                        @if (!string.IsNullOrWhiteSpace(_detail.IntegrationId))
                        {
                            <a class="underline font-mono" href="@NotificationUiRoutes.IntegrationNotifications(_detail.IntegrationId)">@_detail.IntegrationId</a>
                        }
                        else
                        {
                            <span>—</span>
                        }
                    </dd></div>
                    <div><dt class="text-muted">Incident</dt><dd>
                        @if (!string.IsNullOrWhiteSpace(_detail.AttentionIncidentId) && !string.IsNullOrWhiteSpace(_detail.IntegrationId))
                        {
                            <a class="underline font-mono" href="@NotificationUiRoutes.IntegrationScheduleDiagnostics(_detail.IntegrationId, _detail.AttentionIncidentId)">@_detail.AttentionIncidentId</a>
                        }
                        else
                        {
                            <span class="font-mono">@(_detail.AttentionIncidentId ?? "—")</span>
                        }
                    </dd></div>
                    <div><dt class="text-muted">Created</dt><dd>@_detail.CreatedAtUtc.UtcDateTime.ToString("u")</dd></div>
                    <div><dt class="text-muted">Updated</dt><dd>@_detail.UpdatedAtUtc.UtcDateTime.ToString("u")</dd></div>
                </dl>
                @if (!string.IsNullOrWhiteSpace(_detail.IntegrationId))
                {
                    <div class="mt-2 flex flex-wrap gap-3 text-xs">
                        <a class="underline" href="@NotificationUiRoutes.IntegrationNotifications(_detail.IntegrationId)">Integration notifications</a>
                        <a class="underline" href="@NotificationUiRoutes.IntegrationScheduleDiagnostics(_detail.IntegrationId)">Schedule diagnostics</a>
                    </div>
                }
            </section>

            <section class="rounded border border-default bg-surface p-3">
                <div class="font-semibold text-heading mb-2 text-sm">Rendered content</div>
                <dl class="text-xs space-y-1">
                    <div><dt class="text-muted inline">Subject:</dt> <dd class="inline">@_detail.RenderedSubject</dd></div>
                    <div><dt class="text-muted inline">Summary:</dt> <dd class="inline">@_detail.RenderedSummary</dd></div>
                </dl>
                @if (!string.IsNullOrWhiteSpace(_detail.RenderedBodyText))
                {
                    <details class="mt-2 text-xs" open>
                        <summary class="cursor-pointer text-muted">Body</summary>
                        <pre class="mt-1 bg-surface-muted p-2 rounded whitespace-pre-wrap">@_detail.RenderedBodyText</pre>
                    </details>
                }
            </section>

            <section class="rounded border border-default bg-surface p-3">
                <div class="font-semibold text-heading mb-2 text-sm">Recipient snapshot</div>
                <NotificationRecipientSnapshotDisplay RecipientSnapshotJson="@_detail.RecipientSnapshotJson" />
            </section>

            <section class="rounded border border-default bg-surface p-3">
                <details class="text-xs">
                    <summary class="cursor-pointer font-semibold text-heading">Render context JSON</summary>
                    <pre class="mt-2 bg-surface-muted p-2 rounded overflow-x-auto max-h-64">@_detail.RenderContextJson</pre>
                </details>
            </section>

            <section class="rounded border border-default bg-surface p-3">
                <div class="font-semibold text-heading mb-2 text-sm">Delivery outbox</div>
                @if (_outbox is { Count: 0 })
                {
                    <p class="text-xs text-muted">No outbox rows.</p>
                }
                else if (_outbox is not null)
                {
                    <table class="min-w-full text-left text-xs">
                        <thead class="text-muted">
                            <tr>
                                <th class="p-1">Recipient</th>
                                <th class="p-1">Source</th>
                                <th class="p-1">Status</th>
                                <th class="p-1">Attempts</th>
                                <th class="p-1">Last error</th>
                                <th class="p-1">Sent</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var o in _outbox)
                            {
                                <tr class="border-t border-default">
                                    <td class="p-1">@(o.RecipientDisplayName ?? o.RecipientEmail)</td>
                                    <td class="p-1">@NotificationRecipientSourceLabels.Label(o.RecipientSource)</td>
                                    <td class="p-1">@o.Status</td>
                                    <td class="p-1">@o.AttemptCount</td>
                                    <td class="p-1 break-all">@(o.LastError ?? "—")</td>
                                    <td class="p-1">@(o.SentAtUtc?.UtcDateTime.ToString("u") ?? "—")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </section>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="mt-4">
                <PageMessage Kind="PageMessageKind.Error" Message="@_error" />
            </div>
        }
    }
</div>

@code {
    [Parameter] public string InstanceId { get; set; } = "";

    private bool _capabilitiesLoaded;
    private bool _canView;
    private bool _loading = true;
    private string? _error;
    private NotificationInstanceDetailDto? _detail;
    private IReadOnlyList<NotificationDeliveryOutboxDto>? _outbox;

    private string InstanceSubtitle =>
        _detail is null ? "" : $"{_detail.NotificationKind} / {_detail.Status}";

    protected override async Task OnInitializedAsync()
    {
        var caps = await Capabilities.GetCapabilitiesAsync();
        _canView = caps.CanViewNotificationDefinitions;
        _capabilitiesLoaded = true;
        if (!_canView)
        {
            _loading = false;
            return;
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _detail = await Client.GetNotificationInstanceAsync(InstanceId);
            if (_detail is not null)
                _outbox = await Client.ListNotificationInstanceOutboxAsync(InstanceId);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
