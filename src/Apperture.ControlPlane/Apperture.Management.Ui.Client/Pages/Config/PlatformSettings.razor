@page "/config/platform-settings"
@layout ConfigLayout
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Services
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities

<div class="p-4">
    <div class="text-xs text-muted mb-1">Config — Platform settings</div>
    <PageHeader Title="Platform settings"
                Subtitle="Instance-scoped runtime flags. Values resolve as Database override, configuration default, then definition default." />

    @if (!_loaded)
    {
        <LoadingState />
    }
    else if (!_canView)
    {
        <ForbiddenState Message="You do not have permission to view platform settings." />
    }
    else
    {
        <div class="mt-4 space-y-4">
            @foreach (var row in _rows)
            {
                <section class="rounded border border-default bg-surface p-3">
                    <div class="flex items-center justify-between gap-3">
                        <div>
                            <div class="font-medium text-heading">@row.DisplayName</div>
                            <div class="text-xs text-muted">@row.Key</div>
                            <div class="text-xs text-body mt-1">@row.Description</div>
                        </div>
                        <div class="text-xs text-muted">Source: @row.Source</div>
                    </div>
                    <div class="mt-3 flex items-center gap-2">
                        <input class="rounded border border-default px-2 py-1 text-sm min-w-64"
                               value="@GetEditValue(row.Key)"
                               @oninput="e => SetEditValue(row.Key, e.Value?.ToString())"
                               disabled="@(!_canManage)" />
                        <button class="rounded bg-surface-muted px-3 py-1 text-sm disabled:opacity-50"
                                disabled="@(!_canManage)"
                                @onclick="() => SaveAsync(row)">
                            Save
                        </button>
                        <button class="rounded bg-surface-muted px-3 py-1 text-sm disabled:opacity-50"
                                disabled="@(!_canManage)"
                                @onclick="() => ResetAsync(row.Key)">
                            Reset
                        </button>
                    </div>
                </section>
            }
        </div>
    }
</div>

@code {
    private bool _loaded;
    private bool _canView;
    private bool _canManage;
    private List<PlatformSettingResolvedDto> _rows = [];
    private readonly Dictionary<string, string> _editValues = new(StringComparer.Ordinal);

    protected override async Task OnInitializedAsync()
    {
        var caps = await Capabilities.GetCapabilitiesAsync();
        _canManage = caps.CanManagePlatformSettings;
        _canView = caps.CanViewPlatformSettings || _canManage;
        if (_canView)
            await LoadAsync();
        _loaded = true;
    }

    private async Task LoadAsync()
    {
        var rows = await Client.ListPlatformSettingsAsync() ?? Array.Empty<PlatformSettingResolvedDto>();
        _rows = rows.OrderBy(x => x.Category).ThenBy(x => x.DisplayName).ToList();
        foreach (var row in _rows)
            _editValues[row.Key] = row.CurrentValue;
    }

    private string GetEditValue(string key) =>
        _editValues.TryGetValue(key, out var value) ? value : string.Empty;

    private void SetEditValue(string key, string? value) => _editValues[key] = value ?? string.Empty;

    private async Task SaveAsync(PlatformSettingResolvedDto row)
    {
        var value = GetEditValue(row.Key);
        var updated = await Client.SetPlatformSettingAsync(row.Key, new UpdatePlatformSettingRequest(value, row.RowVersionBase64));
        ReplaceRow(updated);
    }

    private async Task ResetAsync(string key)
    {
        var updated = await Client.ResetPlatformSettingAsync(key);
        if (updated is not null)
            ReplaceRow(updated);
    }

    private void ReplaceRow(PlatformSettingResolvedDto updated)
    {
        var index = _rows.FindIndex(x => string.Equals(x.Key, updated.Key, StringComparison.Ordinal));
        if (index >= 0)
            _rows[index] = updated;
        _editValues[updated.Key] = updated.CurrentValue;
    }
}
