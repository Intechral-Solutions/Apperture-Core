@page "/config/platform-settings"
@layout ConfigLayout
@using System.Net.Http
@using Apperture.Management.Client
@using Apperture.Management.Ui.Shared
@using Apperture.Management.Ui.Client.Organisms
@using Apperture.Management.Ui.Client.Services
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities
@inject IToastService Toasts
@inject IJSRuntime JSRuntime

<div class="p-4 ui-page-stack">
    <div class="text-xs text-muted mb-1">Config — Platform settings</div>
    <PageHeader Title="Platform settings"
                Subtitle="Instance-scoped runtime flags stored as platform database overrides. Values never write back to appsettings files." />

    @if (!_loaded)
    {
        <LoadingState />
    }
    else if (!_canView)
    {
        <ForbiddenState Message="You do not have permission to view platform settings." />
    }
    else if (!string.IsNullOrEmpty(_loadError))
    {
        <ErrorState Message="@_loadError" />
    }
    else
    {
        <PageMessage Kind="PageMessageKind.Info"
                     Class="mt-4 max-w-3xl"
                     Title="How platform settings work"
                     Message="Save creates a platform override in the database. Precedence is: platform override, then configuration default (appsettings/environment), then definition default. Reset removes the database override and restores the next source. Changes are recorded in the audit log." />

        @if (!_canManage)
        {
            <p class="mt-3 text-xs text-muted max-w-3xl">You have read-only access. Users with platform settings manage permission can save and reset overrides.</p>
        }

        <div class="mt-6 space-y-8">
            @foreach (var group in _categoryGroups)
            {
                <ManagementSection Title="@PlatformSettingUiHelpers.GetCategoryTitle(group.Key)"
                                   Layer="ManagementSection.UiLayer.Detail">
                    <div class="space-y-4">
                        @foreach (var row in group)
                        {
                            <PlatformSettingRow Row="row"
                                                CanManage="_canManage"
                                                EditValue="@GetEditValue(row.Key)"
                                                EditValues="@GetEditValues(row)"
                                                IsSaving="@(string.Equals(_savingKey, row.Key, StringComparison.Ordinal))"
                                                Error="@GetError(row.Key)"
                                                EditValueChanged="@(v => SetEditValue(row.Key, v))"
                                                EditValuesChanged="@(v => SetEditValues(row.Key, v))"
                                                OnSave="@(() => SaveAsync(row))"
                                                OnReset="@(() => ResetAsync(row))" />
                        }
                    </div>
                </ManagementSection>
            }
        </div>

        <p class="mt-6 text-xs text-muted max-w-3xl">
            Audit: set and reset actions appear in the <a class="underline" href="/control/audit">audit timeline</a> with action names <code class="rounded bg-surface-muted px-1">platform.settings.set</code> and <code class="rounded bg-surface-muted px-1">platform.settings.reset</code>.
        </p>
    }
</div>

@code {
    private bool _loaded;
    private bool _canView;
    private bool _canManage;
    private string? _loadError;
    private string? _savingKey;
    private List<PlatformSettingResolvedDto> _rows = [];
    private readonly Dictionary<string, string> _editValues = new(StringComparer.Ordinal);
    private readonly Dictionary<string, List<string>> _editArrayValues = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string?> _errors = new(StringComparer.Ordinal);

    private IEnumerable<IGrouping<string, PlatformSettingResolvedDto>> _categoryGroups =>
        _rows
            .GroupBy(x => x.Category)
            .OrderBy(g => PlatformSettingUiHelpers.GetCategoryOrder(g.Key));

    protected override async Task OnInitializedAsync()
    {
        var caps = await Capabilities.GetCapabilitiesAsync();
        _canManage = caps.CanManagePlatformSettings;
        _canView = caps.CanViewPlatformSettings || _canManage;
        if (_canView)
            await LoadAsync();
        _loaded = true;
    }

    private async Task LoadAsync()
    {
        _loadError = null;
        try
        {
            var rows = await Client.ListPlatformSettingsAsync();
            if (rows is null)
            {
                _loadError = "Could not load platform settings.";
                return;
            }

            _rows = rows
                .OrderBy(x => PlatformSettingUiHelpers.GetCategoryOrder(x.Category))
                .ThenBy(x => x.DisplayName, StringComparer.Ordinal)
                .ToList();
            _editValues.Clear();
            _editArrayValues.Clear();
            _errors.Clear();
            foreach (var row in _rows)
                SyncEditState(row);
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
    }

    private string GetEditValue(string key) =>
        _editValues.TryGetValue(key, out var value) ? value : string.Empty;

    private IReadOnlyList<string> GetEditValues(PlatformSettingResolvedDto row) =>
        _editArrayValues.TryGetValue(row.Key, out var values)
            ? values
            : row.CurrentValues?.ToList() ?? [];

    private void SetEditValue(string key, string? value)
    {
        _editValues[key] = value ?? string.Empty;
        _errors.Remove(key);
    }

    private void SetEditValues(string key, IReadOnlyList<string> values)
    {
        _editArrayValues[key] = values.ToList();
        _errors.Remove(key);
    }

    private string? GetError(string key) =>
        _errors.TryGetValue(key, out var error) ? error : null;

    private async Task SaveAsync(PlatformSettingResolvedDto row)
    {
        _errors.Remove(row.Key);
        _savingKey = row.Key;
        try
        {
            PlatformSettingResolvedDto updated;
            if (PlatformSettingUiHelpers.IsMultiSelect(row.InputKind))
            {
                updated = await Client.SetPlatformSettingAsync(
                    row.Key,
                    new UpdatePlatformSettingRequest(
                        Values: GetEditValues(row).ToList(),
                        RowVersionBase64: row.RowVersionBase64));
            }
            else
            {
                updated = await Client.SetPlatformSettingAsync(
                    row.Key,
                    new UpdatePlatformSettingRequest(
                        Value: GetEditValue(row.Key),
                        RowVersionBase64: row.RowVersionBase64));
            }

            ReplaceRow(updated);
            Toasts.Show(ToastSeverity.Success, $"Saved {row.DisplayName}.");
        }
        catch (HttpRequestException ex)
        {
            _errors[row.Key] = ex.Message;
        }
        finally
        {
            _savingKey = null;
        }
    }

    private async Task ResetAsync(PlatformSettingResolvedDto row)
    {
        if (PlatformSettingUiHelpers.IsPlatformOverride(row.Source))
        {
            var confirmed = await JSRuntime.InvokeAsync<bool>(
                "confirm",
                $"Reset \"{row.DisplayName}\"? This removes the platform override and restores the inherited default.");
            if (!confirmed)
                return;
        }

        _errors.Remove(row.Key);
        _savingKey = row.Key;
        try
        {
            var updated = await Client.ResetPlatformSettingAsync(row.Key);
            if (updated is null)
            {
                _errors[row.Key] = "Reset failed or setting was not found.";
                return;
            }

            ReplaceRow(updated);
            Toasts.Show(ToastSeverity.Success, $"Reset {row.DisplayName} to inherited default.");
        }
        catch (HttpRequestException ex)
        {
            _errors[row.Key] = ex.Message;
        }
        finally
        {
            _savingKey = null;
        }
    }

    private void ReplaceRow(PlatformSettingResolvedDto updated)
    {
        var index = _rows.FindIndex(x => string.Equals(x.Key, updated.Key, StringComparison.Ordinal));
        if (index >= 0)
            _rows[index] = updated;
        SyncEditState(updated);
        _errors.Remove(updated.Key);
    }

    private void SyncEditState(PlatformSettingResolvedDto row)
    {
        _editValues[row.Key] = row.CurrentValue;
        _editArrayValues[row.Key] = row.CurrentValues?.ToList() ?? [];
    }
}
