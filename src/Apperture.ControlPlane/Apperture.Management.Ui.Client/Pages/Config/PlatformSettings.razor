@page "/config/platform-settings"
@layout ConfigLayout
@using System.Net.Http
@using Apperture.Management.Client
@using Apperture.Management.Ui.Shared
@using Apperture.Management.Ui.Client.Organisms
@using Apperture.Management.Ui.Client.Services
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities
@inject IToastService Toasts
<div class="p-4 ui-page-stack">
    <div class="text-xs text-muted mb-1">Config — Platform settings</div>
    <PageHeader Title="Platform settings"
                Subtitle="Instance-scoped runtime flags stored as platform database overrides. Values never write back to appsettings files." />

    @if (!_loaded)
    {
        <LoadingState />
    }
    else if (!_canView)
    {
        <ForbiddenState Message="You do not have permission to view platform settings." />
    }
    else if (!string.IsNullOrEmpty(_loadError))
    {
        <ErrorState Message="@_loadError" />
    }
    else
    {
        <PageMessage Kind="PageMessageKind.Info"
                     Class="mt-4 max-w-3xl"
                     Title="How platform settings work"
                     Message="Save creates a platform override in the database. Precedence is: platform override, then configuration default (appsettings/environment), then definition default. Sensitive settings store passwords in the platform secret store and never return the value. Leave a password field blank to keep the current secret; use Clear to remove a platform-managed secret override. Reset removes the database override and restores the next source. Changes are recorded in the audit log." />

        @if (!_canManage)
        {
            <p class="mt-3 text-xs text-muted max-w-3xl">You have read-only access. Users with platform settings manage permission can save and reset overrides.</p>
        }

        <div class="mt-6">
            <PlatformSettingsEditor Rows="_rows"
                                    ActiveCategory="@_activeCategory"
                                    ActiveCategoryChanged="OnActiveCategoryChanged"
                                    CanManage="_canManage"
                                    SavingKey="_savingKey"
                                    GetEditValue="GetEditValue"
                                    GetEditValues="GetEditValues"
                                    GetError="GetError"
                                    EditValueChanged="OnEditValueChanged"
                                    EditValuesChanged="OnEditValuesChanged"
                                    OnSave="SaveAsync"
                                    OnClear="RequestClearAsync"
                                    OnReset="RequestResetAsync" />
        </div>

        <p class="mt-6 text-xs text-muted max-w-3xl">
            Audit: set and reset actions appear in the <a class="underline" href="/control/audit">audit timeline</a> with action names <code class="ui-inline-code">platform.settings.set</code> and <code class="ui-inline-code">platform.settings.reset</code>.
        </p>
    }
</div>

<ConfirmActionDialog IsOpen="@(_pendingSettingAction is not null)"
                     Title="@PendingSettingTitle"
                     ConfirmLabel="@PendingSettingConfirmLabel"
                     Emphasis="ConfirmActionEmphasis.Caution"
                     OnConfirm="RunPendingSettingActionAsync"
                     OnConfirmed="ClearPendingSettingAction"
                     OnCancel="ClearPendingSettingAction">
    <ChildContent>
        @PendingSettingConsequence
    </ChildContent>
</ConfirmActionDialog>

@code {
    private enum PendingSettingActionKind { Clear, Reset }

    private (PlatformSettingResolvedDto Row, PendingSettingActionKind Kind)? _pendingSettingAction;

    private bool _loaded;
    private bool _canView;
    private bool _canManage;
    private string? _loadError;
    private string? _savingKey;
    private string _activeCategory = PlatformSettingUiHelpers.CategoryNotifications;
    private List<PlatformSettingResolvedDto> _rows = [];
    private readonly Dictionary<string, string> _editValues = new(StringComparer.Ordinal);
    private readonly Dictionary<string, List<string>> _editArrayValues = new(StringComparer.Ordinal);
    private readonly Dictionary<string, string?> _errors = new(StringComparer.Ordinal);

    protected override async Task OnInitializedAsync()
    {
        var caps = await Capabilities.GetCapabilitiesAsync();
        _canManage = caps.CanManagePlatformSettings;
        _canView = caps.CanViewPlatformSettings || _canManage;
        if (_canView)
            await LoadAsync();
        _loaded = true;
    }

    private async Task LoadAsync()
    {
        _loadError = null;
        try
        {
            var rows = await Client.ListPlatformSettingsAsync();
            if (rows is null)
            {
                _loadError = "Could not load platform settings.";
                return;
            }

            _rows = rows
                .OrderBy(x => PlatformSettingUiHelpers.GetCategoryOrder(x.Category))
                .ThenBy(x => x.DisplayName, StringComparer.Ordinal)
                .ToList();
            _editValues.Clear();
            _editArrayValues.Clear();
            _errors.Clear();
            foreach (var row in _rows)
                SyncEditState(row);

            EnsureActiveCategory();
        }
        catch (Exception ex)
        {
            _loadError = ex.Message;
        }
    }

    private void EnsureActiveCategory()
    {
        var categories = PlatformSettingUiHelpers.GetOrderedCategories(_rows.Select(r => r.Category));
        if (categories.Count == 0)
        {
            _activeCategory = string.Empty;
            return;
        }

        if (!categories.Contains(_activeCategory, StringComparer.Ordinal))
            _activeCategory = categories[0];
    }

    private Task OnActiveCategoryChanged(string category)
    {
        _activeCategory = category;
        return Task.CompletedTask;
    }

    private string GetEditValue(string key) =>
        _editValues.TryGetValue(key, out var value) ? value : string.Empty;

    private IReadOnlyList<string> GetEditValues(PlatformSettingResolvedDto row) =>
        _editArrayValues.TryGetValue(row.Key, out var values)
            ? values
            : row.CurrentValues?.ToList() ?? [];

    private Task OnEditValueChanged((string Key, string Value) change)
    {
        _editValues[change.Key] = change.Value ?? string.Empty;
        _errors.Remove(change.Key);
        return Task.CompletedTask;
    }

    private Task OnEditValuesChanged((string Key, IReadOnlyList<string> Values) change)
    {
        _editArrayValues[change.Key] = change.Values.ToList();
        _errors.Remove(change.Key);
        return Task.CompletedTask;
    }

    private string? GetError(string key) =>
        _errors.TryGetValue(key, out var error) ? error : null;

    private async Task SaveAsync(PlatformSettingResolvedDto row)
    {
        _errors.Remove(row.Key);
        _savingKey = row.Key;
        try
        {
            PlatformSettingResolvedDto updated;
            if (PlatformSettingUiHelpers.IsSecret(row.InputKind, row.IsSensitive))
            {
                var secretValue = GetEditValue(row.Key);
                if (string.IsNullOrWhiteSpace(secretValue))
                {
                    _errors[row.Key] = "Enter a new value to replace the secret. Leaving the field blank keeps the current secret unchanged.";
                    return;
                }

                updated = await Client.SetPlatformSettingAsync(
                    row.Key,
                    new UpdatePlatformSettingRequest(
                        RowVersionBase64: row.RowVersionBase64,
                        SecretOperation: PlatformSettingUiHelpers.SecretOperationReplace,
                        SecretValue: secretValue));
            }
            else if (PlatformSettingUiHelpers.IsMultiSelect(row.InputKind))
            {
                updated = await Client.SetPlatformSettingAsync(
                    row.Key,
                    new UpdatePlatformSettingRequest(
                        Values: GetEditValues(row).ToList(),
                        RowVersionBase64: row.RowVersionBase64));
            }
            else
            {
                updated = await Client.SetPlatformSettingAsync(
                    row.Key,
                    new UpdatePlatformSettingRequest(
                        Value: GetEditValue(row.Key),
                        RowVersionBase64: row.RowVersionBase64));
            }

            ReplaceRow(updated);
            Toasts.Show(ToastSeverity.Success, $"Saved {row.DisplayName}.");
        }
        catch (HttpRequestException ex)
        {
            _errors[row.Key] = ex.Message;
        }
        finally
        {
            _savingKey = null;
        }
    }

    // UIX-6 — consequential setting changes confirm through ConfirmActionDialog.
    private Task RequestClearAsync(PlatformSettingResolvedDto row)
    {
        if (!row.HasPlatformOverride && !PlatformSettingUiHelpers.IsPlatformOverride(row.Source))
            return Task.CompletedTask;

        _pendingSettingAction = (row, PendingSettingActionKind.Clear);
        return Task.CompletedTask;
    }

    private Task RequestResetAsync(PlatformSettingResolvedDto row)
    {
        // Only a platform override is consequential; otherwise reset proceeds directly.
        if (!PlatformSettingUiHelpers.IsPlatformOverride(row.Source))
            return ResetAsync(row);

        _pendingSettingAction = (row, PendingSettingActionKind.Reset);
        return Task.CompletedTask;
    }

    private void ClearPendingSettingAction() => _pendingSettingAction = null;

    private async Task RunPendingSettingActionAsync()
    {
        if (_pendingSettingAction is not { } pending)
            return;

        var succeeded = pending.Kind == PendingSettingActionKind.Clear
            ? await ClearAsync(pending.Row)
            : await ResetAsync(pending.Row);

        // Keep the dialog open with the failure; the row also shows inline remediation.
        if (!succeeded)
            throw new InvalidOperationException(GetError(pending.Row.Key) ?? "The action could not be completed.");
    }

    private string PendingSettingTitle => _pendingSettingAction?.Kind == PendingSettingActionKind.Reset
        ? "Reset setting?"
        : "Clear setting?";

    private string PendingSettingConfirmLabel => _pendingSettingAction?.Kind == PendingSettingActionKind.Reset
        ? "Reset setting"
        : "Clear setting";

    private string PendingSettingConsequence
    {
        get
        {
            if (_pendingSettingAction is not { } pending)
                return "";

            var name = pending.Row.DisplayName;
            return pending.Kind == PendingSettingActionKind.Reset
                ? $"Resetting \"{name}\" removes the platform override and restores the inherited default."
                : $"Clearing \"{name}\" removes the platform override and disables the managed secret when owned by this setting.";
        }
    }

    // UIX-6: returns false on failure so the confirmation dialog can stay open with the reason.
    private async Task<bool> ClearAsync(PlatformSettingResolvedDto row)
    {
        _errors.Remove(row.Key);
        _savingKey = row.Key;
        try
        {
            var updated = await Client.SetPlatformSettingAsync(
                row.Key,
                new UpdatePlatformSettingRequest(
                    RowVersionBase64: row.RowVersionBase64,
                    SecretOperation: PlatformSettingUiHelpers.SecretOperationClear));
            ReplaceRow(updated);
            Toasts.Show(ToastSeverity.Success, $"Cleared {row.DisplayName}.");
            return true;
        }
        catch (HttpRequestException ex)
        {
            _errors[row.Key] = ex.Message;
            return false;
        }
        finally
        {
            _savingKey = null;
        }
    }

    private async Task<bool> ResetAsync(PlatformSettingResolvedDto row)
    {
        _errors.Remove(row.Key);
        _savingKey = row.Key;
        try
        {
            var updated = await Client.ResetPlatformSettingAsync(row.Key);
            if (updated is null)
            {
                _errors[row.Key] = "Reset failed or setting was not found.";
                return false;
            }

            ReplaceRow(updated);
            Toasts.Show(ToastSeverity.Success, $"Reset {row.DisplayName} to inherited default.");
            return true;
        }
        catch (HttpRequestException ex)
        {
            _errors[row.Key] = ex.Message;
            return false;
        }
        finally
        {
            _savingKey = null;
        }
    }

    private void ReplaceRow(PlatformSettingResolvedDto updated)
    {
        var index = _rows.FindIndex(x => string.Equals(x.Key, updated.Key, StringComparison.Ordinal));
        if (index >= 0)
            _rows[index] = updated;
        SyncEditState(updated);
        _errors.Remove(updated.Key);
    }

    private void SyncEditState(PlatformSettingResolvedDto row)
    {
        // Never prefill secrets; blank means leave unchanged.
        _editValues[row.Key] = PlatformSettingUiHelpers.IsSecret(row.InputKind, row.IsSensitive)
            ? string.Empty
            : row.CurrentValue;
        _editArrayValues[row.Key] = row.CurrentValues?.ToList() ?? [];
    }
}
