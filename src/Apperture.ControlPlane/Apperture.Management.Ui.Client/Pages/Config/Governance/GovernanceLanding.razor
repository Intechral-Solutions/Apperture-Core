@page "/config/governance"
@layout ConfigLayout
@using Apperture.Management.Ui.Client.Organisms

<div class="p-4 ui-page-stack">
    <PageHeader Eyebrow="Config"
                Title="Governance"
                Subtitle="Manage platform roles, user role assignments, and the permission catalog." />

    <div class="ui-summary-card-grid">
        <ManagementSummaryCard Title="Permission catalog"
                               Description="Browse available resources and permissions."
                               Href="/config/governance/catalog" />
        <ManagementSummaryCard Title="Roles"
                               Description="View and edit role definitions and their permission grants."
                               Href="/config/governance/roles" />
        <ManagementSummaryCard Title="Users"
                               Description="Inspect users and manage role assignments."
                               Href="/config/governance/users" />
    </div>
</div>
