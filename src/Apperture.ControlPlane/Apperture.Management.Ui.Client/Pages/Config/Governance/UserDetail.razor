@page "/config/governance/users/{UserId}"
@layout ConfigLayout
@using System.Net
@using Apperture.Core.Domain.Identity
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Molecules
@using Apperture.Management.Ui.Client.Organisms
@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Shared
@using System.Text.Json
@implements IDisposable
@inject SessionStateService Session
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities
@inject ShellHostNavigation HostNav
@inject IToastService Toasts
@inject NavigationManager Nav
@inject ShellOrientationService ShellOrientation

<div class="p-4">
    <PageHeader @key="@UserId"
                Title="@EntityShellTitles.Detail(_user?.DisplayName, "User")"
                Subtitle="Role assignments">
        <ChildContent>
            <div class="mt-1 text-xs text-muted">
                <a href="/config/governance/users" class="hover:underline">Users</a> / Role assignments
            </div>
            @if (_user is not null)
            {
                @* This is the page a link to the user would open, so the identity is plain text here. *@
                <div class="mt-2 text-sm text-body">
                    <UserRef User="@(new UserReferenceDto(_user.UserId, _user.Username, _user.DisplayName))" Mode="UserRefMode.Rich" CanNavigate="false" />
                </div>
            }
        </ChildContent>
        <Toolbar>
            <a href="/config/governance/users" class="ui-toolbar-btn">Back to users</a>
            <a href="@("/config/governance/users/" + Uri.EscapeDataString(UserId) + "/role-derived-access")" class="ui-toolbar-btn">View role-derived access</a>
            <button type="button"
                    class="ui-toolbar-btn"
                    disabled="@_loading"
                    @onclick="LoadAsync">
                Refresh
            </button>
            @if (CanSendSetupInvitation)
            {
                <ActionButton @ref="_invitationToolbarButton"
                              Variant="ActionButtonVariant.Secondary"
                              Class="ui-toolbar-btn"
                              DefaultText="@(InvitationAlreadyIssued ? "Resend setup invitation" : "Send setup invitation")"
                              ActiveText="Sending…"
                              SuccessText="Sent"
                              ErrorText="Send failed"
                              IsInactive="@_mutating"
                              OnClick="_ => ResendInvitationAsync()" />
            }
        </Toolbar>
    </PageHeader>

    <div class="ui-settings-callout">
        This page shows linked sign-in methods and role assignments. Administrators with <strong>user.manage</strong> can add an Entra identity link (object id) to an existing platform user.
    </div>

    @if (!_capabilitiesLoaded)
    {
        <div class="mt-4">
            <LoadingState Message="Loading…" />
        </div>
    }
    else if (_capabilities?.CanViewGovernance != true)
    {
        <div class="mt-4">
            <ForbiddenState Message="You do not have permission to view this user." />
        </div>
    }
    else if (_forbidden)
    {
        <div class="mt-4">
            <ForbiddenState Message="You do not have permission to view this user." />
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="mt-4">
                <ErrorState Message="@_error" />
            </div>
        }
        @if (_user is null)
        {
            @if (string.IsNullOrEmpty(_error))
            {
                <div class="mt-4">
                    <LoadingState Message="Loading…" />
                </div>
            }
        }
        else
        {
        <div class="mt-4 grid gap-4">
            <ManagementSection Title="User" Layer="ManagementSection.UiLayer.Summary">
                <MetadataGrid>
                    <MetadataItem Label="Username" Monospace="true" Value="@_user.Username" />
                    <MetadataItem Label="Display name" Value="@_user.DisplayName" />
                    <MetadataItem Label="Contact email" Value="@FormatContactEmail(_user)" />
                    <MetadataItem Label="Password" Value="@FormatPasswordState(_user.PasswordState)" />
                    <MetadataItem Label="Invitation" Value="@FormatInvitationState(_user.InvitationState)" />
                    <MetadataItem Label="Local sign-in" Value="@FormatLocalSignInPolicy(_user.LocalSignInPolicy, _user.IsCredentialDisabled, _user.LocalRecoverySafeguard)" />
                </MetadataGrid>
                <TechnicalDetails Dense="true" Class="mt-3">
                    <TechnicalDetail Label="User ID" Value="@_user.UserId" />
                </TechnicalDetails>
                @if (CanSendSetupInvitation)
                {
                    <div class="mt-3 space-y-2">
                        <PageMessage Kind="PageMessageKind.Info"
                                     Title="Account setup is not finished"
                                     Message="This user has not chosen a password yet. Send a new invitation to their contact email. The previous link stops working." />
                        <ActionButton @ref="_invitationButton"
                                      DefaultText="@(InvitationAlreadyIssued ? "Resend setup invitation" : "Send setup invitation")"
                                      ActiveText="Sending…"
                                      SuccessText="Invitation sent"
                                      ErrorText="Send failed"
                                      IsInactive="@_mutating"
                                      OnClick="_ => ResendInvitationAsync()" />
                    </div>
                }
            </ManagementSection>

            @if (_capabilities?.CanManageUsers == true)
            {
                <ManagementSection Title="Username" Layer="ManagementSection.UiLayer.Detail">
                    @if (_user.EmergencyAccessAccount)
                    {
                        <p class="mt-2 text-xs text-muted">The Recovery Access username is system-managed and cannot be changed here.</p>
                    }
                    else
                    {
                        <form data-rename-username
                              class="mt-2 space-y-3"
                              aria-busy="@(IsRenaming ? "true" : null)"
                              @onsubmit="RenameUsernameAsync"
                              @onsubmit:preventDefault="true">
                            <UsernameField Id="rename-username"
                                           Label="Username"
                                           Value="@_renameValue"
                                           ValueChanged="OnRenameValueChanged"
                                           Disabled="@IsRenaming"
                                           ServerError="@_renameError" />
                            <p class="text-xs text-muted">
                                Sign-in follows the new name. The previous name stays reserved for this user and is never given to anyone else.
                                Passwords, roles and signed-in sessions are not affected.
                            </p>
                            <ActionButton @ref="_renameButton"
                                          Type="submit"
                                          Variant="ActionButtonVariant.Secondary"
                                          DefaultText="Change username"
                                          ActiveText="Renaming…"
                                          SuccessText="Username changed" />
                        </form>
                    }
                </ManagementSection>
            }

            <ManagementSection Title="Linked sign-in methods" Layer="ManagementSection.UiLayer.Detail">
                @if (_user.IdentityLinks.Count == 0)
                {
                    <div class="mt-2 text-xs text-muted">No linked identities.</div>
                }
                else
                {
                    <ul class="mt-2 divide-y divide-default text-sm">
                        @foreach (var link in _user.IdentityLinks)
                        {
                            <li class="flex flex-wrap items-baseline justify-between gap-2 py-2">
                                <span class="font-mono text-xs text-body break-all">@FormatLinkLabel(link)</span>
                                <span class="text-xs text-muted">@link.Source · @FormatLinkState(link)</span>
                            </li>
                        }
                    </ul>
                }

                <div class="mt-3 text-xs text-muted space-y-1">
                    <div>Microsoft Entra: <span class="text-body">@FormatEntraAssociation(_user.EntraAssociationStatus)</span></div>
                    <div>Local sign-in: <span class="text-body">@FormatLocalSignInPolicy(_user.LocalSignInPolicy, _user.IsCredentialDisabled, _user.LocalRecoverySafeguard)</span></div>
                    @if (_user.EmergencyAccessAccount)
                    {
                        <p>This is the system-managed Recovery Access account. Native authenticator: @(_user.NativeMfaEnrolled ? "enrolled" : "not enrolled"). Recovery codes: @(_user.EmergencyRecoveryCodesPresent ? "on file" : "none"). Manage it through Emergency Access operator tooling, not ordinary user administration.</p>
                    }
                    @if (_user.LocalRecoverySafeguard)
                    {
                        <p>This local credential is temporarily retained because Emergency Access is not healthy yet.</p>
                    }
                </div>

                @if (_capabilities?.CanManageCredentials == true && _user.IsCredentialDisabled == true)
                {
                    <div class="mt-4 border-t border-default pt-3">
                        <div class="text-xs font-medium text-heading">Enable local sign-in</div>
                        @if (Session.User?.StrongAuthenticationConfigured == false)
                        {
                            <p class="mt-1 text-xs text-muted">
                                Strong authentication is not configured. Set a Microsoft Entra Conditional Access
                                authentication-context identifier on the active Entra registration before local
                                sign-in can be restored.
                            </p>
                        }
                        else
                        {
                            <p class="mt-1 text-xs text-muted">
                                Restores the existing local password. This does not change the password. Recent
                                strong authentication is required.
                            </p>
                            @if (!string.IsNullOrEmpty(_credentialError))
                            {
                                <div class="mt-2">
                                    <PageMessage Kind="PageMessageKind.Error" Message="@_credentialError" />
                                </div>
                            }
                            <button type="button"
                                    class="btn btn-secondary mt-2"
                                    disabled="@_mutating"
                                    @onclick="EnableLocalSignInAsync">
                                Enable local sign-in
                            </button>
                        }
                    </div>
                }

                @if (_capabilities?.CanManageUsers == true && !_user.EmergencyAccessAccount)
                {
                    <div class="mt-4 border-t border-default pt-3">
                        <div class="text-xs font-medium text-heading">Link a Microsoft account</div>
                        <p class="mt-1 text-xs text-muted">
                            Search your directory and select the person. The association stays pending until they
                            sign in with that Microsoft account for the first time; local sign-in is left as it is
                            until that first proof.
                        </p>
                        @if (_directoryTenantId is null)
                        {
                            <p class="mt-2 text-xs text-muted">
                                Directory search is unavailable because no Microsoft Entra registration is active. Paste an object id below instead.
                            </p>
                        }
                        else
                        {
                            <div class="mt-2 flex flex-wrap items-end gap-2">
                                <label class="min-w-[16rem] flex-1 text-xs text-muted">
                                    Search directory
                                    <input class="ui-input mt-1 text-xs"
                                           @bind="_directorySearch"
                                           @bind:event="oninput"
                                           disabled="@(_mutating || _directoryBusy)"
                                           placeholder="Name or user principal name" />
                                </label>
                                <button type="button"
                                        class="btn btn-secondary"
                                        disabled="@(_mutating || _directoryBusy)"
                                        @onclick="SearchDirectoryAsync">
                                    @(_directoryBusy ? "Searching…" : "Search")
                                </button>
                            </div>
                            @if (_directoryMessage is not null)
                            {
                                <p class="mt-2 text-xs text-muted">@_directoryMessage</p>
                            }
                            @if (_directoryResults.Count > 0)
                            {
                                <ul class="mt-2 divide-y divide-default text-sm">
                                    @foreach (var candidate in _directoryResults)
                                    {
                                        <li class="flex flex-wrap items-center justify-between gap-2 py-2">
                                            <span>
                                                <span class="text-body">@candidate.DisplayName</span>
                                                <span class="ml-2 text-xs text-muted">@(candidate.UserPrincipalName ?? candidate.Mail)</span>
                                            </span>
                                            <button type="button"
                                                    class="btn btn-secondary"
                                                    disabled="@_mutating"
                                                    @onclick="() => LinkDirectoryUserAsync(candidate.ObjectId)">
                                                Link
                                            </button>
                                        </li>
                                    }
                                </ul>
                            }
                        }

                        <div class="mt-3 text-xs font-medium text-heading">Or paste an object id</div>
                        <p class="mt-1 text-xs text-muted">
                            Use the Entra object id (oid) as a GUID. Email addresses and user principal names are not identities.
                        </p>
                        @if (!string.IsNullOrEmpty(_identityLinkError))
                        {
                            <div class="mt-2">
                                <PageMessage Kind="PageMessageKind.Error" Message="@_identityLinkError" />
                            </div>
                        }
                        <div class="mt-2 flex flex-wrap items-end gap-2">
                            <label class="min-w-[16rem] flex-1 text-xs text-muted">
                                Entra object id
                                <input class="ui-input mt-1 font-mono text-xs"
                                       @bind="_entraOidToLink"
                                       disabled="@_mutating"
                                       placeholder="00000000-0000-0000-0000-000000000000" />
                            </label>
                            <button type="button"
                                    class="btn btn-secondary"
                                    disabled="@(_mutating || string.IsNullOrWhiteSpace(_entraOidToLink))"
                                    @onclick="AddEntraLinkAsync">
                                Link object id
                            </button>
                        </div>
                    </div>
                }
            </ManagementSection>

            <ManagementSection Title="Assigned roles" Layer="ManagementSection.UiLayer.Detail">
                @if (_user.RoleIds.Count == 0)
                {
                    <div class="mt-2 text-xs text-muted">User has no assigned roles. Use the control below to assign one.</div>
                }
                else
                {
                    <div class="mt-2 space-y-2">
                        @foreach (var roleId in _user.RoleIds)
                        {
                            var roleInfo = _rolesById.GetValueOrDefault(roleId);
                            <div class="ui-detail-block flex items-center justify-between gap-2">
                                <div>
                                    <a href="@("/config/governance/roles/" + Uri.EscapeDataString(roleId))" class="font-mono text-sm underline hover:no-underline">@roleId</a>
                                    @if (roleInfo is not null)
                                    {
                                        <span class="ml-2 text-xs text-muted">@roleInfo.Name</span>
                                    }
                                </div>
                                @if (_capabilities?.CanAssignRoles == true)
                                {
                                    <button class="rounded px-2 py-1 text-xs text-error hover:bg-message-error"
                                            disabled="@_mutating"
                                            title="Remove this role from the user"
                                            @onclick="@(() => RemoveRoleAsync(roleId))">
                                        Remove
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
            </ManagementSection>

            @if (_capabilities?.CanAssignRoles == true)
            {
                <ManagementSection Title="Assign role" Layer="ManagementSection.UiLayer.Detail">
                    @if (_assignableRoles.Count == 0)
                    {
                        <div class="mt-2 text-xs text-muted">No additional roles available to assign.</div>
                    }
                    else
                    {
                        <div class="mt-2 flex flex-wrap items-center gap-2">
                            <select class="ui-input max-w-md"
                                    @bind="_selectedRoleToAssign"
                                    disabled="@_mutating">
                                <option value="">— Select role —</option>
                                @foreach (var r in _assignableRoles)
                                {
                                    <option value="@r.Id">@r.Name (@r.Id)</option>
                                }
                            </select>
                            <button type="button"
                                    class="btn btn-primary"
                                    disabled="@(_mutating || string.IsNullOrEmpty(_selectedRoleToAssign))"
                                    @onclick="AssignRoleAsync">
                                Assign
                            </button>
                        </div>
                    }
                </ManagementSection>
            }
        </div>
        }
    }
</div>

@code {
    [Parameter] public string UserId { get; set; } = "";

    private UserDetailDto? _user;
    private IReadOnlyList<RoleDto> _allRoles = Array.Empty<RoleDto>();
    private Dictionary<string, RoleDto> _rolesById = new();
    private List<RoleDto> _assignableRoles = new();
    private string _selectedRoleToAssign = "";
    private bool _loading;
    private bool _forbidden;
    private bool _mutating;
    private string? _error;
    private string? _identityLinkError;
    private string? _credentialError;
    private string _entraOidToLink = "";
    private string _directorySearch = "";
    private string? _directoryTenantId;
    private string? _directoryMessage;
    private bool _directoryBusy;
    private IReadOnlyList<EntraDirectoryUserItemDto> _directoryResults = Array.Empty<EntraDirectoryUserItemDto>();
    private OperatorCapabilitiesDto? _capabilities;
    private bool _capabilitiesLoaded;
    private string? _dataLoadKey;
    private ActionButton? _invitationButton;
    private ActionButton? _invitationToolbarButton;
    private ActionButton? _renameButton;
    private string _renameValue = "";
    private string? _renameError;

    /// <summary>
    /// The one rename this page is waiting on, if any. A rename belongs to the user it was sent for and to this exact
    /// instance: once the page moves to another user or is disposed, the operation is no longer current and whatever the
    /// server answers is reported but never applied to the form in front of the operator.
    /// </summary>
    private RenameOperation? _renameOperation;
    private bool _disposed;

    private bool IsRenaming => _renameOperation is not null;

    private bool IsCurrent(RenameOperation operation) => !_disposed && ReferenceEquals(_renameOperation, operation);

    private sealed class RenameOperation(string userId, string displayName)
    {
        public string UserId { get; } = userId;
        public string DisplayName { get; } = displayName;
    }

    private bool CanSendSetupInvitation =>
        _capabilities?.CanManageUsers == true
        && _user is { EmergencyAccessAccount: false }
        && _user.IdentityLinks.Any(l => string.Equals(l.Source, "Local", StringComparison.OrdinalIgnoreCase))
        && _user.HasLocalCredential != true;

    private bool InvitationAlreadyIssued =>
        _user?.InvitationState is "pending" or "expired" or "accepted";

    private async Task SetInvitationButtonsAsync(ActionButtonState state)
    {
        if (_invitationButton is not null)
            await _invitationButton.SetStateAsync(state);
        if (_invitationToolbarButton is not null)
            await _invitationToolbarButton.SetStateAsync(state);
    }

    protected override async Task OnInitializedAsync()
    {
        try { _capabilities = await Capabilities.GetCapabilitiesAsync(); } catch { _capabilities = new OperatorCapabilitiesDto(false, false, false, false, false, false, false, false); }
        _capabilitiesLoaded = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        if (!_capabilitiesLoaded)
            return;
        var key = UserId ?? "";
        if (key == _dataLoadKey)
            return;
        _dataLoadKey = key;
        _user = null;
        await ResetRenameFormAsync();
        ReadStepUpOutcomeFromQuery();
        await LoadAsync();
    }

    /// <summary>
    /// The rename form belongs to one user. Moving to another user abandons any rename still waiting on the server (its
    /// answer is reported when it arrives, but no longer touches this form) and returns the form, including the button's
    /// own state, to a clean start. The button is reset explicitly because the component can survive the move.
    /// </summary>
    private async Task ResetRenameFormAsync()
    {
        _renameOperation = null;
        _renameError = null;
        _renameValue = "";
        await SetRenameButtonAsync(ActionButtonState.Default);
    }

    private async Task SetRenameButtonAsync(ActionButtonState state)
    {
        if (_renameButton is not null && !_disposed)
            await _renameButton.SetStateAsync(state);
    }

    public void Dispose()
    {
        _disposed = true;
        _renameOperation = null;
    }

    private async Task LoadAsync()
    {
        if (_capabilities?.CanViewGovernance != true) return;

        _loading = true;
        _error = null;
        _identityLinkError = null;
        _forbidden = false;
        try
        {
            var previousUsername = _user?.Username;
            _user = await Client.GetUserAsync(UserId);
            if (_user is null)
            {
                _error = "User not found.";
                return;
            }

            // Keep what the operator is typing; reset the field only when the server's username moved (first load, rename).
            if (_renameValue.Length == 0 || !string.Equals(previousUsername, _user.Username, StringComparison.Ordinal))
                _renameValue = _user.Username;
            if (_capabilities?.CanManageUsers == true)
                await LoadDirectoryTenantAsync();
            _allRoles = await Client.GetRolesAsync();
            _rolesById = _allRoles.ToDictionary(r => r.Id, StringComparer.OrdinalIgnoreCase);
            var assignedSet = _user.RoleIds.ToHashSet(StringComparer.OrdinalIgnoreCase);
            _assignableRoles = _allRoles.Where(r => !assignedSet.Contains(r.Id)).ToList();
            if (!_assignableRoles.Any(r => r.Id == _selectedRoleToAssign))
                _selectedRoleToAssign = "";
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            _forbidden = true;
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            ShellOrientation.PublishForCurrentUri(
                Nav,
                EntityShellTitles.Detail(_user?.DisplayName, "User"),
                "Role assignments");
        }
    }

    private void OnRenameValueChanged(string? value)
    {
        _renameValue = value ?? "";
        _renameError = null;
    }

    /// <summary>
    /// Server-confirmed rename: nothing on the page changes until the server answers, the controls are locked and the form is
    /// busy meanwhile (so it cannot be submitted twice), the rest of the page stays visible, and on success the user is reloaded
    /// so the page shows what the server now holds. A refusal keeps the typed value and is explained beside the field.
    /// </summary>
    private async Task RenameUsernameAsync()
    {
        if (_user is null || IsRenaming || _capabilities?.CanManageUsers != true)
            return;

        var typed = _renameValue.Trim();
        if (typed.Length == 0)
        {
            _renameError = "Enter a username.";
            return;
        }

        // An invalid or reserved name is already explained beside the field; nothing is sent.
        if (UsernameRules.ToFieldValidation(typed).Kind != FieldValidationKind.Valid)
            return;

        if (string.Equals(UsernameRules.Normalize(typed), _user.Username, StringComparison.Ordinal))
        {
            _renameError = "That is already this user's username.";
            return;
        }

        var operation = new RenameOperation(UserId, _user.DisplayName);
        _renameOperation = operation;
        _renameError = null;
        var confirmed = false;
        try
        {
            await SetRenameButtonAsync(ActionButtonState.Active);

            RenameUsernameResponse result;
            try
            {
                // Deliberately not cancelled when the page moves on: abandoning a mutation client-side does not stop the
                // server applying it, so the answer is awaited and reported rather than thrown away.
                result = await Client.RenameUserAsync(operation.UserId, typed);
            }
            catch (OperationCanceledException) when (_disposed)
            {
                // The page is gone (host teardown): there is no form left to tell.
                return;
            }
            catch (Exception ex) when (TryDescribeRenameFailure(ex, out var failure))
            {
                ReportRenameFailure(operation, failure);
                return;
            }

            confirmed = true;
            await ConcludeConfirmedRenameAsync(operation, result);
        }
        finally
        {
            // Release the pending state however this ended, but only if this is still the operation the page is waiting
            // on: an older operation must never clear a newer one's busy form, or touch another user's.
            if (IsCurrent(operation))
            {
                _renameOperation = null;
                if (!confirmed)
                    await SetRenameButtonAsync(ActionButtonState.Default);
            }
        }
    }

    /// <summary>
    /// The expected ways a rename request can fail, each with what the operator should be told. Anything else is a defect
    /// and is left to propagate (the pending state is still released by the caller's <c>finally</c>).
    /// </summary>
    private static bool TryDescribeRenameFailure(Exception ex, out string message)
    {
        switch (ex)
        {
            case HttpRequestException { StatusCode: HttpStatusCode.Forbidden }:
                message = "Not authorized to manage users.";
                return true;
            case UsernameRenameException refused:
                // The server's own explanation, safe to show (for example a name another user holds or held).
                message = refused.Message;
                return true;
            case HttpRequestException:
                message = "Could not reach the server, so the username change was not confirmed. Try again.";
                return true;
            case OperationCanceledException:
                // HttpClient reports a timeout as a cancellation. The server may still have applied the change.
                message = "The server did not answer in time. The username may have changed; reload the page to check before trying again.";
                return true;
            case JsonException or NotSupportedException or InvalidOperationException:
                // The typed client throws these only when it could not read a reply it was given.
                message = "The server's response could not be read, so the username change was not confirmed. Reload the page to see the current username.";
                return true;
            default:
                message = "";
                return false;
        }
    }

    private void ReportRenameFailure(RenameOperation operation, string message)
    {
        if (IsCurrent(operation))
        {
            _renameError = message;
            return;
        }

        // The operator has moved on, so this is not shown on the form in front of them, but a failure is not silent.
        Toasts.Show(ToastSeverity.Error, $"Changing the username for {operation.DisplayName} failed. {message}", "Governance");
    }

    private async Task ConcludeConfirmedRenameAsync(RenameOperation operation, RenameUsernameResponse result)
    {
        var current = IsCurrent(operation);
        if (current)
            await SetRenameButtonAsync(ActionButtonState.Success);
        Toasts.Show(
            ToastSeverity.Success,
            current
                ? $"Username changed to {result.Username}."
                : $"Username for {operation.DisplayName} changed to {result.Username}.",
            "Governance");

        // The signed-in operator renamed themself: the shell shows the new name whichever page they are on now.
        if (Session.User is { } me && string.Equals(me.UserId, operation.UserId, StringComparison.Ordinal))
            await Session.RefreshAsync();

        // Reload only when the page is still showing the user that was renamed (never another user's page).
        if (!_disposed && string.Equals(UserId, operation.UserId, StringComparison.Ordinal))
            await LoadAsync();
    }

    private async Task AssignRoleAsync()
    {
        if (string.IsNullOrEmpty(_selectedRoleToAssign) || _user is null) return;

        _mutating = true;
        _error = null;
        try
        {
            await Client.AssignRoleAsync(UserId, _selectedRoleToAssign);
            Toasts.Show(ToastSeverity.Success, "Role assigned.", "Governance");
            await LoadAsync();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            _error = "Not authorized to assign roles.";
            Toasts.Show(ToastSeverity.Error, _error, "Role assignment");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Toasts.Show(ToastSeverity.Error, ex.Message, "Role assignment");
        }
        finally
        {
            _mutating = false;
        }
    }

    private async Task RemoveRoleAsync(string roleId)
    {
        if (_user is null) return;

        _mutating = true;
        _error = null;
        try
        {
            await Client.RemoveRoleAsync(UserId, roleId);
            Toasts.Show(ToastSeverity.Success, "Role removed.", "Governance");
            await LoadAsync();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            _error = "Not authorized to remove roles.";
            Toasts.Show(ToastSeverity.Error, _error, "Role assignment");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Toasts.Show(ToastSeverity.Error, ex.Message, "Role assignment");
        }
        finally
        {
            _mutating = false;
        }
    }

    /// <summary>
    /// Directory browse is scoped to the active registration, which is also the only directory whose
    /// object ids the platform will accept.
    /// </summary>
    private async Task LoadDirectoryTenantAsync()
    {
        try
        {
            var tenants = await Client.GetEntraTenantsAsync();
            _directoryTenantId = tenants.FirstOrDefault(t => t.IsActive && t.Enabled)?.Id;
        }
        catch (Exception)
        {
            _directoryTenantId = null;
        }
    }

    private async Task SearchDirectoryAsync()
    {
        if (_directoryTenantId is null)
            return;

        _directoryBusy = true;
        _directoryMessage = null;
        try
        {
            var result = await Client.SearchEntraDirectoryUsersAsync(_directoryTenantId, _directorySearch, top: 25);
            if (result is null)
            {
                _directoryResults = Array.Empty<EntraDirectoryUserItemDto>();
                _directoryMessage = "Not authorized to browse the directory.";
                return;
            }

            _directoryResults = result.Items;
            _directoryMessage = result.Success
                ? (result.Items.Count == 0 ? "No matching directory users." : null)
                : result.Summary;
        }
        catch (Exception ex)
        {
            _directoryResults = Array.Empty<EntraDirectoryUserItemDto>();
            _directoryMessage = ex.Message;
        }
        finally
        {
            _directoryBusy = false;
        }
    }

    private async Task LinkDirectoryUserAsync(string objectId)
    {
        _entraOidToLink = objectId;
        await AddEntraLinkAsync();
        _directoryResults = Array.Empty<EntraDirectoryUserItemDto>();
    }

    private async Task AddEntraLinkAsync()
    {
        if (_user is null || string.IsNullOrWhiteSpace(_entraOidToLink))
            return;

        _mutating = true;
        _identityLinkError = null;
        try
        {
            await Client.AddIdentityLinkAsync(
                UserId,
                new AddIdentityLinkRequest("Entra", _entraOidToLink.Trim()));
            Toasts.Show(
                ToastSeverity.Success,
                "Microsoft account associated. It becomes active after their first successful sign-in.",
                "Governance");
            _entraOidToLink = "";
            await LoadAsync();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            _identityLinkError = "Not authorized to manage users.";
        }
        catch (HttpRequestException ex)
        {
            _identityLinkError = ex.Message;
        }
        catch (Exception ex)
        {
            _identityLinkError = ex.Message;
        }
        finally
        {
            _mutating = false;
        }
    }

    /// <summary>A link is only a usable sign-in path once an authentication has proven it.</summary>
    private static string FormatLinkState(IdentityLinkDto link) =>
        link.LastAuthenticatedAt is null ? "pending first sign-in" : "active";

    private static string FormatLinkLabel(IdentityLinkDto link)
    {
        if (string.Equals(link.Source, "Entra", StringComparison.OrdinalIgnoreCase))
        {
            var id = link.ExternalId;
            var suffix = id.Length >= 4 ? id[^4..] : id;
            return $"Entra · …{suffix}";
        }

        return link.ExternalId;
    }

    private void ReadStepUpOutcomeFromQuery()
    {
        var query = new Uri(Nav.Uri).Query;
        if (string.IsNullOrEmpty(query))
            return;
        var parameters = System.Web.HttpUtility.ParseQueryString(query);
        if (parameters["steppedUp"] == "1")
        {
            _credentialError = null;
            return;
        }

        var error = parameters["error"];
        if (string.IsNullOrEmpty(error))
            return;
        _credentialError = error switch
        {
            "identity_mismatch" => "The Microsoft account that completed step-up is not the signed-in administrator.",
            "tenant_mismatch" => "The Microsoft directory that completed step-up is not the directory this instance trusts.",
            "authentication_context_not_satisfied" => "Microsoft did not report the configured authentication context. Strong authentication was not recorded.",
            "not_configured" => "Strong authentication is not configured on this instance.",
            _ => "Strong authentication did not complete. Your existing session was kept."
        };
    }

    private async Task EnableLocalSignInAsync()
    {
        _credentialError = null;
        _mutating = true;
        try
        {
            await Client.SetLocalCredentialDisabledAsync(UserId, isDisabled: false);
            Toasts.Show(ToastSeverity.Success, "Local sign-in enabled.");
            await LoadAsync();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            var returnPath = "/config/governance/users/" + Uri.EscapeDataString(UserId);
            var host = HostNav.GetManagementHostBase(Nav);
            Nav.NavigateTo(new Uri(host, "signin/step-up?returnUrl=" + Uri.EscapeDataString(returnPath)).ToString(), forceLoad: true);
        }
        catch (HttpRequestException ex)
        {
            _credentialError = ex.Message;
        }
        finally
        {
            _mutating = false;
        }
    }

    private async Task ResendInvitationAsync()
    {
        if (_user is null)
            return;

        _mutating = true;
        _error = null;
        await SetInvitationButtonsAsync(ActionButtonState.Active);
        try
        {
            var result = await Client.SendSetupInvitationAsync(_user.UserId, new SetupInvitationRequest(_user.PendingContactEmail ?? _user.ContactEmail));
            await SetInvitationButtonsAsync(result.DeliverySucceeded ? ActionButtonState.Success : ActionButtonState.Error);
            await LoadAsync();
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
            await SetInvitationButtonsAsync(ActionButtonState.Error);
        }
        finally
        {
            _mutating = false;
        }
    }

    private static string FormatContactEmail(UserDetailDto user) =>
        user.ContactEmailStatus switch
        {
            "verified" => string.IsNullOrWhiteSpace(user.ContactEmail) ? "Verified" : $"{user.ContactEmail} · Verified",
            "pending" => string.IsNullOrWhiteSpace(user.PendingContactEmail) ? "Pending" : $"{user.PendingContactEmail} · Pending",
            _ => "None"
        };

    private static string FormatPasswordState(string? state) => state switch
    {
        "set" => "Set",
        "setup_pending" => "Setup pending",
        _ => "None"
    };

    private static string FormatInvitationState(string? state) => state switch
    {
        "pending" => "Pending",
        "expired" => "Expired",
        "accepted" => "Accepted",
        _ => "None"
    };

    private static string FormatEntraAssociation(string? status) => status switch
    {
        "pending" => "Pending first sign-in",
        "proven" => "Proven / primary",
        "none" => "Not associated",
        _ => "Not associated"
    };

    private static string FormatLocalSignInPolicy(string? policy, bool? disabled, bool safeguard)
    {
        if (policy == "emergency_access")
            return "Enabled for Recovery Access";
        if (safeguard || policy == "recovery_safeguard")
            return "Enabled for emergency platform recovery";
        if (policy == "disabled" || disabled == true)
            return "Disabled";
        if (policy == "enabled" || disabled == false)
            return "Enabled";
        return "Not configured";
    }
}
