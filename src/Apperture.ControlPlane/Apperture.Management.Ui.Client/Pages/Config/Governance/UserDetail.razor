@page "/config/governance/users/{UserId}"
@layout ConfigLayout
@using System.Net
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Organisms
@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Shared
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities
@inject IToastService Toasts

<div class="p-4">
    <PageHeader Title="User — Role assignments">
        <ChildContent>
            <div class="mt-1 text-xs text-muted">
                <a href="/config/governance/users" class="hover:underline">Users</a> / Role assignments
            </div>
            <div class="mt-1 font-mono text-xs text-muted break-all">@UserId</div>
        </ChildContent>
        <Toolbar>
            <a href="/config/governance/users" class="rounded bg-surface-muted px-3 py-2 text-sm text-body hover:bg-surface">Back to users</a>
            <a href="@("/config/governance/users/" + Uri.EscapeDataString(UserId) + "/role-derived-access")" class="rounded bg-surface-muted px-3 py-2 text-sm text-body hover:bg-surface">View role-derived access</a>
            <button class="rounded bg-surface-muted px-3 py-2 text-sm text-body hover:bg-surface"
                    disabled="@_loading"
                    @onclick="LoadAsync">
                Refresh
            </button>
        </Toolbar>
    </PageHeader>

    <div class="mt-2 rounded border border-callout-info bg-callout-info px-3 py-2 text-xs text-body">
        This page manages <strong>role assignments only</strong>. User identity and credentials are not editable here. To edit role definitions, go to the role detail page.
    </div>

    @if (!_capabilitiesLoaded)
    {
        <div class="mt-4">
            <PageMessage Kind="PageMessageKind.Loading" Message="Loading…" />
        </div>
    }
    else if (_capabilities?.CanViewGovernance != true)
    {
        <div class="mt-4">
            <PageMessage Kind="PageMessageKind.Forbidden"
                         Title="Not authorized"
                         Message="You do not have permission to view this user." />
        </div>
    }
    else if (_forbidden)
    {
        <div class="mt-4">
            <PageMessage Kind="PageMessageKind.Forbidden"
                         Title="Not authorized"
                         Message="You do not have permission to view this user." />
        </div>
    }
    else
    {
        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="mt-4 rounded border border-message-error bg-message-error px-3 py-2 text-sm text-body">
                <div class="font-semibold">Error</div>
                <div class="text-muted">@_error</div>
            </div>
        }
        @if (_user is null)
        {
            <div class="mt-4 text-sm text-muted">@(string.IsNullOrEmpty(_error) ? "Loading..." : "")</div>
        }
        else
        {
        <div class="mt-4 grid gap-4">
            <div class="rounded border border-default bg-surface p-3">
                <div class="text-sm font-semibold text-heading">User</div>
                <div class="mt-2 grid grid-cols-1 gap-2 md:grid-cols-2">
                    <div>
                        <div class="text-xs text-muted">User ID</div>
                        <div class="text-sm font-mono">@_user.UserId</div>
                    </div>
                    <div>
                        <div class="text-xs text-muted">Display name</div>
                        <div class="text-sm text-body">@_user.DisplayName</div>
                    </div>
                </div>
            </div>

            <div class="rounded border border-default bg-surface p-3">
                <div class="text-sm font-semibold text-heading">Assigned roles</div>
                @if (_user.RoleIds.Count == 0)
                {
                    <div class="mt-2 text-xs text-muted">User has no assigned roles. Use the control below to assign one.</div>
                }
                else
                {
                    <div class="mt-2 space-y-2">
                        @foreach (var roleId in _user.RoleIds)
                        {
                            var roleInfo = _rolesById.GetValueOrDefault(roleId);
                            <div class="flex items-center justify-between gap-2 rounded border border-default bg-surface-muted/50 px-3 py-2">
                                <div>
                                    <a href="@("/config/governance/roles/" + Uri.EscapeDataString(roleId))" class="font-mono text-sm underline hover:no-underline">@roleId</a>
                                    @if (roleInfo is not null)
                                    {
                                        <span class="ml-2 text-xs text-muted">@roleInfo.Name</span>
                                    }
                                </div>
                                @if (_capabilities?.CanAssignRoles == true)
                                {
                                    <button class="rounded px-2 py-1 text-xs text-error hover:bg-message-error"
                                            disabled="@_mutating"
                                            title="Remove this role from the user"
                                            @onclick="@(() => RemoveRoleAsync(roleId))">
                                        Remove
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
            </div>

            @if (_capabilities?.CanAssignRoles == true)
            {
                <div class="rounded border border-default bg-surface p-3">
                    <div class="text-sm font-semibold text-heading">Assign role</div>
                    @if (_assignableRoles.Count == 0)
                    {
                        <div class="mt-2 text-xs text-muted">No additional roles available to assign.</div>
                    }
                    else
                    {
                        <div class="mt-2 flex flex-wrap items-center gap-2">
                            <select class="rounded border border-default bg-surface px-3 py-2 text-sm"
                                    @bind="_selectedRoleToAssign"
                                    disabled="@_mutating">
                                <option value="">— Select role —</option>
                                @foreach (var r in _assignableRoles)
                                {
                                    <option value="@r.Id">@r.Name (@r.Id)</option>
                                }
                            </select>
                            <button class="rounded bg-surface-muted px-3 py-2 text-sm text-body hover:bg-surface"
                                    disabled="@(_mutating || string.IsNullOrEmpty(_selectedRoleToAssign))"
                                    @onclick="AssignRoleAsync">
                                Assign
                            </button>
                        </div>
                    }
                </div>
            }
        </div>
        }
    }
</div>

@code {
    [Parameter] public string UserId { get; set; } = "";

    private UserDetailDto? _user;
    private IReadOnlyList<RoleDto> _allRoles = Array.Empty<RoleDto>();
    private Dictionary<string, RoleDto> _rolesById = new();
    private List<RoleDto> _assignableRoles = new();
    private string _selectedRoleToAssign = "";
    private bool _loading;
    private bool _forbidden;
    private bool _mutating;
    private string? _error;
    private OperatorCapabilitiesDto? _capabilities;
    private bool _capabilitiesLoaded;
    private string? _dataLoadKey;

    protected override async Task OnInitializedAsync()
    {
        try { _capabilities = await Capabilities.GetCapabilitiesAsync(); } catch { _capabilities = new OperatorCapabilitiesDto(false, false, false, false, false, false, false, false); }
        _capabilitiesLoaded = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        if (!_capabilitiesLoaded)
            return;
        var key = UserId ?? "";
        if (key == _dataLoadKey)
            return;
        _dataLoadKey = key;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_capabilities?.CanViewGovernance != true) return;

        _loading = true;
        _error = null;
        _forbidden = false;
        try
        {
            _user = await Client.GetUserAsync(UserId);
            if (_user is null)
            {
                _error = "User not found.";
                return;
            }
            _allRoles = await Client.GetRolesAsync();
            _rolesById = _allRoles.ToDictionary(r => r.Id, StringComparer.OrdinalIgnoreCase);
            var assignedSet = _user.RoleIds.ToHashSet(StringComparer.OrdinalIgnoreCase);
            _assignableRoles = _allRoles.Where(r => !assignedSet.Contains(r.Id)).ToList();
            if (!_assignableRoles.Any(r => r.Id == _selectedRoleToAssign))
                _selectedRoleToAssign = "";
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            _forbidden = true;
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task AssignRoleAsync()
    {
        if (string.IsNullOrEmpty(_selectedRoleToAssign) || _user is null) return;

        _mutating = true;
        _error = null;
        try
        {
            await Client.AssignRoleAsync(UserId, _selectedRoleToAssign);
            Toasts.Show(ToastSeverity.Success, "Role assigned.", "Governance");
            await LoadAsync();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            _error = "Not authorized to assign roles.";
            Toasts.Show(ToastSeverity.Error, _error, "Role assignment");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Toasts.Show(ToastSeverity.Error, ex.Message, "Role assignment");
        }
        finally
        {
            _mutating = false;
        }
    }

    private async Task RemoveRoleAsync(string roleId)
    {
        if (_user is null) return;

        _mutating = true;
        _error = null;
        try
        {
            await Client.RemoveRoleAsync(UserId, roleId);
            Toasts.Show(ToastSeverity.Success, "Role removed.", "Governance");
            await LoadAsync();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            _error = "Not authorized to remove roles.";
            Toasts.Show(ToastSeverity.Error, _error, "Role assignment");
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            Toasts.Show(ToastSeverity.Error, ex.Message, "Role assignment");
        }
        finally
        {
            _mutating = false;
        }
    }
}
