@page "/config"
@layout ConfigLayout

<div class="p-4 ui-page-stack">
    <PageHeader Title="Configuration"
                Eyebrow="Config"
                Subtitle="Platform administration: authentication, governance, notifications, contacts, and installed modules." />

    <ManagementSection Title="Configuration areas" Layer="@ManagementSection.UiLayer.Summary">
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            <ManagementSummaryCard Title="Authentication"
                                   Description="Overview, chooser policy, Entra tenant validation, and directory browse (users/groups)."
                                   Href="/config/auth" />
            <ManagementSummaryCard Title="Managed contacts"
                                   Description="Custom and imported people for notifications and operational teams (Epic 76)."
                                   Href="/config/contacts" />
            <ManagementSummaryCard Title="Governance"
                                   Description="Roles, users, permission catalog, and role assignment."
                                   Href="/config/governance" />
            <ManagementSummaryCard Title="Notifications"
                                   Description="Definitions, instances, delivery health, and cutover diagnostics (Epic 77)."
                                   Href="/config/notifications" />
            <ManagementSummaryCard Title="Platform settings"
                                   Description="Instance-scoped runtime flags with database overrides over configuration defaults."
                                   Href="/config/platform-settings" />
            <ManagementSummaryCard Title="Modules"
                                   Description="Installed module lifecycle, validation, and links to runs and audit."
                                   Href="/modules" />
        </div>
    </ManagementSection>
</div>
