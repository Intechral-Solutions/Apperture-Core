@page "/config"
@layout ConfigLayout

<div class="p-4 ui-page-stack">
    <PageHeader Title="Configuration"
                Eyebrow="Config"
                Subtitle="Platform administration for authentication, governance, notifications, and attention routing. Day-to-day operations use Integrations, Control Center, and Runs." />

    <ManagementSection Title="Platform administration" Layer="@ManagementSection.UiLayer.Summary">
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            <ManagementSummaryCard Title="Authentication"
                                   Description="Sign-in experience, chooser policy, and Entra tenant validation."
                                   Href="/config/auth" />
            <ManagementSummaryCard Title="Governance"
                                   Description="Roles, users, permission catalog, and role assignment."
                                   Href="/config/governance" />
            <ManagementSummaryCard Title="Notifications"
                                   Description="Definitions, instances, and delivery health."
                                   Href="/config/notifications" />
            <ManagementSummaryCard Title="Attention"
                                   Description="Operational teams, routing defaults, and managed contacts."
                                   Href="/attention/operational-teams" />
        </div>
    </ManagementSection>

    <ManagementSection Title="Platform maintenance" Layer="@ManagementSection.UiLayer.Summary">
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            <ManagementSummaryCard Title="Platform settings"
                                   Description="Instance-scoped runtime flags with database overrides."
                                   Href="/config/platform-settings" />
            <ManagementSummaryCard Title="Modules"
                                   Description="Installed module lifecycle, validation, and links to runs and audit."
                                   Href="/modules" />
        </div>
    </ManagementSection>

    <ManagementSection Title="Developer & internal" Layer="@ManagementSection.UiLayer.Summary">
        <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
            <ManagementSummaryCard Title="Developer tasks"
                                   Description="Deferred dashboard tools, diagnostics, and internal demos."
                                   Href="@ShellSectionRoutes.DeveloperTasks" />
        </div>
    </ManagementSection>
</div>
