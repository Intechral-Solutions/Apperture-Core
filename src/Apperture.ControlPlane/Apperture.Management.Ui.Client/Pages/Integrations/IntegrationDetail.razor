    private async Task SaveSettingsAsync()
    {
        if (_integration is null || _capabilities?.CanManageIntegrations != true) return;
        var cleaned = _settingsEditList
            .Where(kv => !string.IsNullOrWhiteSpace(kv.Key))
            .ToDictionary(kv => kv.Key.Trim(), kv => kv.Value ?? "");
        _settingsSaving = true;
        _error = null;
        try
        {
            _integration = await Client.UpdateIntegrationAsync(IntegrationId, new UpdateIntegrationRequest(Settings: cleaned));
            SetActionFeedback("Settings saved.");
            Toasts.Show(ToastSeverity.Success, "Settings saved.");
            _editingSettings = false;
            await ReloadAfterActionAsync();
        }
        catch (HttpRequestException ex)
        {
            SetActionFeedback(ex.Message, PageMessageKind.Error);
            Toasts.Show(ToastSeverity.Error, ex.Message);
        }
        finally
        {
            _settingsSaving = false;
        }
    }

