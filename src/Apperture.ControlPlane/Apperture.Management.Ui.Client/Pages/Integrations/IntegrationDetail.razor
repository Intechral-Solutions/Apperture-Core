    private void CancelAddBinding()
    {
        _addingBinding = false;
        _moduleSlots = null;
        _eligibleConnections = null;
        _bindingError = null;
        _addingConnectionInFlow = false;
        _inFlowCreateError = null;
        _inFlowCreateSaving = false;
    }

    private async Task OnBindingSlotChanged()
    {
        _bindingConnectionId = "";
        _bindingError = null;
        _addingConnectionInFlow = false;
        _inFlowCreateError = null;
        if (string.IsNullOrEmpty(_bindingSlot)) { _eligibleConnections = null; return; }
        var slot = _moduleSlots?.FirstOrDefault(s => s.SlotName == _bindingSlot);
        if (slot is null) { _eligibleConnections = null; return; }
        try
        {
            _eligibleConnections = await Client.GetIntegrationEligibleConnectionsAsync(IntegrationId, slot.SlotName, slot.ContractType);
        }
        catch (HttpRequestException ex)
        {
            _eligibleConnections = null;
            Toasts.Show(ToastSeverity.Error, ex.Message);
        }
    }

    private async Task CreateBindingAsync()
    {
        if (_integration is null || !_capabilities?.CanManageIntegrations == true || string.IsNullOrEmpty(_bindingSlot) || string.IsNullOrEmpty(_bindingConnectionId)) return;
        _bindingSaving = true;
        _error = null;
        _bindingError = null;
        try
        {
            await Client.CreateIntegrationBindingAsync(IntegrationId, new CreateIntegrationBindingRequest(_bindingSlot, _moduleSlots?.First(s => s.SlotName == _bindingSlot).ContractType ?? "", _bindingConnectionId));
            SetActionFeedback("Binding added.");
            Toasts.Show(ToastSeverity.Success, "Binding added.");
            _addingBinding = false;
            await ReloadAfterActionAsync();
        }
        catch (HttpRequestException ex)
        {
            _bindingError = ex.StatusCode switch
            {
                System.Net.HttpStatusCode.Forbidden => "You do not have permission to create bindings (403).",
                System.Net.HttpStatusCode.Conflict => "Binding failed due to eligibility/readiness conflict. Refresh and retry.",
                _ => ex.Message
            };
            Toasts.Show(ToastSeverity.Error, _bindingError);
        }
        finally
        {
            _bindingSaving = false;
        }
    }

    private ConnectorDefinitionCatalogDto? SelectedInFlowConnectorDefinition =>
        _connectorDefinitions.FirstOrDefault(d => string.Equals(d.Id, _inFlowConnectorDefinitionId, StringComparison.Ordinal));

    private async Task StartInFlowConnectionCreateAsync()
    {
        _addingConnectionInFlow = true;
        _inFlowCreateError = null;
        if (_connectorDefinitions.Count == 0)
        {
            try
            {
                _connectorDefinitions = await Client.GetConnectorDefinitionsAsync();
            }
            catch (HttpRequestException ex)
            {
                _inFlowCreateError = ex.Message;
                return;
            }
        }

        if (string.IsNullOrWhiteSpace(_inFlowConnectorDefinitionId))
            _inFlowConnectorDefinitionId = _connectorDefinitions.FirstOrDefault()?.Id ?? "";

        await OnInFlowConnectorDefinitionChangedAsync();
    }

    private async Task OnInFlowConnectorDefinitionChangedAsync()
    {
        _inFlowConfigValues.Clear();
        _inFlowSecretValues.Clear();
        if (SelectedInFlowConnectorDefinition is null)
            return;

        foreach (var field in SelectedInFlowConnectorDefinition.Fields)
        {
            if (field.IsSecret)
                _inFlowSecretValues[field.Key] = "";
            else
                _inFlowConfigValues[field.Key] = "";
        }

        await Task.CompletedTask;
    }

    private void CancelInFlowConnectionCreate()
    {
        _addingConnectionInFlow = false;
        _inFlowCreateError = null;
        _inFlowCreateSaving = false;
    }

    private string GetInFlowFieldValueForValidation(ConnectionFieldCatalogDto field) =>
        field.IsSecret
            ? (_inFlowSecretValues.TryGetValue(field.Key, out var secret) ? secret : "")
            : (_inFlowConfigValues.TryGetValue(field.Key, out var cfg) ? cfg : "");

    private async Task CreateConnectionInFlowAsync()
    {
        if (SelectedInFlowConnectorDefinition is null)
            return;

        _inFlowCreateError = null;
        var missing = SelectedInFlowConnectorDefinition.Fields
            .Where(f => f.IsRequired && string.IsNullOrWhiteSpace(GetInFlowFieldValueForValidation(f)))
            .Select(f => f.DisplayName)
            .ToArray();
        if (missing.Length > 0)
        {
            _inFlowCreateError = $"Missing required fields: {string.Join(", ", missing)}.";
            return;
        }

        _inFlowCreateSaving = true;
        try
        {
            var secrets = _inFlowSecretValues.Where(kv => !string.IsNullOrWhiteSpace(kv.Value)).ToDictionary(kv => kv.Key, kv => kv.Value);
            var created = await Client.CreateConnectionAsync(
                new CreateConnectionRequest(
                    _inFlowConnectorDefinitionId,
                    _inFlowConnectionName.Trim(),
                    _inFlowConfigValues.Where(kv => !string.IsNullOrWhiteSpace(kv.Value)).ToDictionary(kv => kv.Key, kv => kv.Value),
                    SecretRefs: new Dictionary<string, string>(),
                    SecretValues: secrets.Count > 0 ? secrets : null));

            var slot = _moduleSlots?.FirstOrDefault(s => string.Equals(s.SlotName, _bindingSlot, StringComparison.Ordinal));
            if (slot is not null)
                _eligibleConnections = await Client.GetIntegrationEligibleConnectionsAsync(IntegrationId, slot.SlotName, slot.ContractType);

            var nowEligible = _eligibleConnections?.FirstOrDefault(c => string.Equals(c.Id, created.Id, StringComparison.Ordinal));
            if (nowEligible is not null)
            {
                _bindingConnectionId = nowEligible.Id;
                _addingConnectionInFlow = false;
                SetActionFeedback("Connection created and selected for binding.");
                Toasts.Show(ToastSeverity.Success, "Connection created and selected for binding.");
            }
            else
            {
                _inFlowCreateError = "Connection was created, but it is not eligible for this slot. Select a compatible connector/contract and try again.";
            }
        }
        catch (HttpRequestException ex)
        {
            if (ex.StatusCode == System.Net.HttpStatusCode.Forbidden)
                _inFlowCreateError = "You do not have permission to create connections (403).";
            else
                _inFlowCreateError = ex.Message;
        }
        finally
        {
            _inFlowCreateSaving = false;
        }
    }

    private async Task RemoveBindingAsync(IntegrationBindingDto b)
    {
        if (_capabilities?.CanManageIntegrations != true) return;
        if (!await JSRuntime.InvokeAsync<bool>("confirm", $"Remove binding for slot {b.SlotName}?")) return;
        try
        {
            await Client.DeleteIntegrationBindingAsync(IntegrationId, b.Id);
            SetActionFeedback("Binding removed.");
            Toasts.Show(ToastSeverity.Success, "Binding removed.");
            await ReloadAfterActionAsync();
        }
        catch (HttpRequestException ex)
        {
            SetActionFeedback(ex.Message, PageMessageKind.Error);
            Toasts.Show(ToastSeverity.Error, ex.Message);
        }
    }

    private async Task StartAddSchedule()
    {
        _addingSchedule = true;
        _scheduleName = "";
        _scheduleCron = "0 0 * * *";
        _scheduleTimeZone = "UTC";
        _scheduleWorkflowId = "";
        if (_integration is not null)
            _workflows = await Client.GetWorkflowsAsync(_integration.ModuleId);
    }

    private void CancelAddSchedule()
    {
        _addingSchedule = false;
    }

    private async Task CreateScheduleAsync()
    {
        if (_integration is null || !_capabilities?.CanManageIntegrations == true || string.IsNullOrWhiteSpace(_scheduleName) || string.IsNullOrWhiteSpace(_scheduleCron) || string.IsNullOrWhiteSpace(_scheduleWorkflowId)) return;
        _scheduleSaving = true;
        _error = null;
        try
        {
            var targetConfig = System.Text.Json.JsonSerializer.Serialize(new { workflowDefinitionId = _scheduleWorkflowId });
            await Client.CreateIntegrationScheduleAsync(IntegrationId, new CreateIntegrationScheduleRequest(
                _scheduleName.Trim(),
                _scheduleCron.Trim(),
                string.IsNullOrWhiteSpace(_scheduleTimeZone) ? "UTC" : _scheduleTimeZone.Trim(),
                true,
                0,
                targetConfig));
            SetActionFeedback("Schedule created.");
            Toasts.Show(ToastSeverity.Success, "Schedule created.");
            _addingSchedule = false;
            await ReloadAfterActionAsync();
        }
        catch (HttpRequestException ex)
        {
            SetActionFeedback(ex.Message, PageMessageKind.Error);
            Toasts.Show(ToastSeverity.Error, ex.Message);
        }
        catch (ScheduleValidationException ex)
        {
            var validationMsg = string.Join(" ", ex.Errors);
            SetActionFeedback(validationMsg, PageMessageKind.Error);
            Toasts.Show(ToastSeverity.Error, validationMsg);
        }
        finally
        {
            _scheduleSaving = false;
        }
    }

    private static bool IsBindingIssue(IntegrationReadinessIssueDto issue) =>
        BindingIssueCodes.Contains(issue.Code, StringComparer.Ordinal);

    private bool HasAllRequiredSlotsBound()
    {
        if (_requiredSlots is not { Length: > 0 })
            return true;
        if (_bindings is null)
            return false;
        foreach (var slot in _requiredSlots)
        {
            var bound = _bindings.Any(b =>
                string.Equals(b.SlotName, slot.SlotName, StringComparison.Ordinal)
                && string.Equals(b.State, "Active", StringComparison.OrdinalIgnoreCase));
            if (!bound)
                return false;
        }

        return true;
    }

    private void RecomputeWizardStates()
    {
        var states = new[]
        {
            new WizardStepState(
                WizardStepBindings,
                string.Equals(_wizard.CurrentStepId, WizardStepBindings, StringComparison.Ordinal)
                    ? WizardStepStatus.Current
                    : (HasAllRequiredSlotsBound() ? WizardStepStatus.Complete : WizardStepStatus.Pending)),
            new WizardStepState(
                WizardStepReadiness,
                string.Equals(_wizard.CurrentStepId, WizardStepReadiness, StringComparison.Ordinal)
                    ? WizardStepStatus.Current
                    : ((_readiness?.IsRunnable ?? false) ? WizardStepStatus.Complete : WizardStepStatus.Blocked),
                _readiness is null || _readiness.IsRunnable ? null : "Resolve readiness issues to continue."),
            new WizardStepState(
                WizardStepSchedules,
                string.Equals(_wizard.CurrentStepId, WizardStepSchedules, StringComparison.Ordinal)
                    ? WizardStepStatus.Current
                    : ((_schedules?.Count ?? 0) > 0 ? WizardStepStatus.Complete : WizardStepStatus.Pending)),
            new WizardStepState(
                WizardStepProcedures,
                string.Equals(_wizard.CurrentStepId, WizardStepProcedures, StringComparison.Ordinal)
                    ? WizardStepStatus.Current
                    : ((_procedureList?.Procedures.Count ?? 0) > 0 ? WizardStepStatus.Pending : WizardStepStatus.Blocked),
                (_procedureList?.Procedures.Count ?? 0) > 0 ? null : "No procedures are currently available.")
        };

        _wizard.SetStates(states);
        _wizardStepMap.Clear();
        foreach (var state in states)
            _wizardStepMap[state.StepId] = state;
    }

    private Task OnWizardStepSelectedAsync(string stepId)
    {
        _wizard.NavigateTo(stepId);
        RecomputeWizardStates();
        return Task.CompletedTask;
    }

    private bool WizardCanAdvance()
    {
        if (string.Equals(_wizard.CurrentStepId, WizardStepBindings, StringComparison.Ordinal))
            return HasAllRequiredSlotsBound();
        if (string.Equals(_wizard.CurrentStepId, WizardStepReadiness, StringComparison.Ordinal))
            return _readiness?.IsRunnable == true;
        if (string.Equals(_wizard.CurrentStepId, WizardStepSchedules, StringComparison.Ordinal))
            return true;
        return false;
    }

    private Task WizardPreviousAsync()
    {
        _wizard.TryMovePrevious();
        RecomputeWizardStates();
        return Task.CompletedTask;
    }

    private async Task WizardAdvanceAsync()
    {
        if (!WizardCanAdvance())
            return;
        _wizard.TryMoveNext();
        RecomputeWizardStates();
        await Task.CompletedTask;
    }

    private string CurrentWizardGuidance() => _wizard.CurrentStepId switch
    {
        WizardStepBindings => HasAllRequiredSlotsBound()
            ? "All required slots are currently bound. Continue to readiness."
            : "Add or update bindings for each required slot.",
        WizardStepReadiness => _readiness?.IsRunnable == true
            ? "Integration is runnable. Continue to schedules and procedures."
            : "Resolve each readiness blocker using the Fix now actions below.",
        WizardStepSchedules => "Attach schedules if this integration should run automatically. This step is optional.",
        WizardStepProcedures => "Procedures are the downstream operator action surface for this integration.",
        _ => "Follow the guided setup flow."
    };

    private string ReadinessRemediationCue(IntegrationReadinessIssueDto issue) => issue.Code switch
    {
        "missing_slot_binding" => "Bind this slot to a compatible active connection.",
        "inactive_binding" => "Replace or re-create the binding with an active connection.",
        "duplicate_active_binding_for_slot" => "Remove duplicate active bindings so one active binding remains for the slot.",
        "binding_contract_mismatch" => "Re-bind the slot with a connection matching the required contract.",
        "binding_missing_connection_or_capability" => "Edit this binding so it references a valid connection/capability.",
        "connection_missing" => "Update the binding to use an existing compatible connection.",
        "connection_inactive" => "Activate the referenced connection or bind a different active connection.",
        "binding_not_eligible" => "Bind to a connection eligible for this module slot and contract.",
        "connection_unverified" => "Run test-connect for the bound connection to verify remote access.",
        "connection_verification_failed" => "Fix credentials/endpoint/access, then run test-connect again.",
        "connection_verification_unavailable" => "This connector does not support verification; validate externally before go-live.",
        "integration_not_active" => "Set this integration state to Active.",
        "schedule_ownership_mismatch" => "Recreate or fix schedule association under this integration.",
        _ => "Review and apply the relevant configuration change."
    };

    private async Task RemediateReadinessIssueAsync(IntegrationReadinessIssueDto issue)
    {
        if (_capabilities?.CanManageIntegrations != true)
            return;

        if (string.Equals(issue.Code, "integration_not_active", StringComparison.Ordinal))
        {
            await SetStateAsync("Active");
            return;
        }

        if (string.Equals(issue.Code, "connection_inactive", StringComparison.Ordinal) && !string.IsNullOrWhiteSpace(issue.ConnectionId))
        {
            Nav.NavigateTo("/connections/" + Uri.EscapeDataString(issue.ConnectionId));
            return;
        }

        if ((string.Equals(issue.Code, "connection_unverified", StringComparison.Ordinal)
                || string.Equals(issue.Code, "connection_verification_failed", StringComparison.Ordinal)
                || string.Equals(issue.Code, "connection_verification_unavailable", StringComparison.Ordinal))
            && !string.IsNullOrWhiteSpace(issue.ConnectionId))
        {
            Nav.NavigateTo("/connections/" + Uri.EscapeDataString(issue.ConnectionId));
            return;
        }

        if (string.Equals(issue.Code, "schedule_ownership_mismatch", StringComparison.Ordinal))
        {
            await StartAddSchedule();
            _wizard.NavigateTo(WizardStepSchedules);
            RecomputeWizardStates();
            return;
        }

        if (IsBindingIssue(issue)
            || string.Equals(issue.Code, "connection_missing", StringComparison.Ordinal))
        {
            await StartAddBinding();
            if (!string.IsNullOrWhiteSpace(issue.SlotName))
            {
                _bindingSlot = issue.SlotName;
                await OnBindingSlotChanged();
            }
            _wizard.NavigateTo(WizardStepBindings);
            RecomputeWizardStates();
            return;
        }
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_integration is null || _capabilities?.CanManageIntegrations != true) return;
        if (!await JSRuntime.InvokeAsync<bool>("confirm", $"Delete integration \"{_integration.DisplayName}\"? This cannot be undone."))
            return;
        _deleting = true;
        _error = null;
        try
        {
            await Client.DeleteIntegrationAsync(IntegrationId);
            Toasts.Show(ToastSeverity.Success, "Integration deleted.");
            Nav.NavigateTo("/integrations");
        }
        catch (HttpRequestException ex)
        {
            SetActionFeedback(ex.Message, PageMessageKind.Error);
            Toasts.Show(ToastSeverity.Error, ex.Message);
        }
        finally
        {
            _deleting = false;
        }
    }
