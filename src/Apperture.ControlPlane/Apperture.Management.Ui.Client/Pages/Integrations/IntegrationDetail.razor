    private async Task LoadAsync(int generation, string integrationId, CancellationToken cancellationToken, bool preserveActionFeedback = false)
    {
        if (_capabilities?.CanViewIntegrations != true || string.IsNullOrWhiteSpace(integrationId))
            return;

        _loading = true;
        _error = null;
        if (!preserveActionFeedback)
            _actionMessage = null;
        try
        {
            if (!_loadGuard.IsCurrent(generation))
                return;

            var detail = await Client.GetIntegrationOperatorDetailAsync(integrationId, cancellationToken);
            if (!_loadGuard.IsCurrent(generation))
                return;

            if (detail is null)
            {
                _integration = null;
                _bindings = null;
                _schedules = null;
                _readiness = null;
                _requiredSlots = null;
                _procedureList = null;
                _procedureError = null;
                _selectedProcedureId = null;
                _selectedProcedureDetail = null;
                _procedureParamValues.Clear();
                _bindingVerificationByConnectionId.Clear();
                _recentActivity = null;
                _activityError = null;
            }
            else
            {
                _integration = new IntegrationDto(
                    detail.Id,
                    detail.DisplayName,
                    detail.ModuleId,
                    detail.ScopeKey,
                    detail.State,
                    detail.Settings,
                    detail.CreatedAt,
                    detail.UpdatedAt);
                _readiness = detail.Readiness;
                _requiredSlots = detail.RequiredSlots;
                _bindings = detail.Bindings.Select(b => new IntegrationBindingDto(
                    b.Id,
                    integrationId,
                    detail.ModuleId,
                    b.SlotName,
                    b.ContractType,
                    b.ConnectionId,
                    b.CapabilityId,
                    b.State)).ToList();
                _bindingVerificationByConnectionId.Clear();
                foreach (var b in detail.Bindings)
                {
                    if (!string.IsNullOrWhiteSpace(b.ConnectionId) && !string.IsNullOrWhiteSpace(b.ConnectionVerificationStatus))
                        _bindingVerificationByConnectionId[b.ConnectionId] = b.ConnectionVerificationStatus;
                }
                _schedules = detail.Schedules.Select(s => new ScheduleDto(
                    s.Id,
                    s.Name,
                    s.RecurrenceExpression,
                    "UTC",
                    s.Enabled,
                    0,
                    null,
                    1,
                    s.IntegrationId)).ToList();

                _procedureError = null;
                _procedureList = null;
                _selectedProcedureId = null;
                _selectedProcedureDetail = null;
                _procedureParamValues.Clear();
                _procedureLoading = true;
                try
                {
                    if (_loadGuard.IsCurrent(generation))
                        _procedureList = await Client.GetIntegrationProceduresAsync(integrationId, cancellationToken);
                }
                catch (HttpRequestException ex)
                {
                    if (_loadGuard.IsCurrent(generation))
                        _procedureError = ex.Message;
                }
                catch (OperationCanceledException)
                {
                    // Superseded navigation; ignore.
                }
                finally
                {
                    if (_loadGuard.IsCurrent(generation))
                        _procedureLoading = false;
                }

                if (_loadGuard.IsCurrent(generation))
                    await LoadRecentActivityAsync(generation, integrationId, detail.ModuleId, cancellationToken);
            }
        }
        catch (OperationCanceledException)
        {
            // Superseded navigation; ignore.
        }
        catch (HttpRequestException ex)
        {
            if (_loadGuard.IsCurrent(generation))
                _error = ex.Message;
        }
        finally
        {
            if (_loadGuard.IsCurrent(generation))
            {
                _loading = false;
                _dataLoadKey = integrationId;
                RecomputeWizardStates();
                PublishShellTitle();
            }
        }
    }

    private void PublishShellTitle() =>
        ShellOrientation.PublishForCurrentUri(
