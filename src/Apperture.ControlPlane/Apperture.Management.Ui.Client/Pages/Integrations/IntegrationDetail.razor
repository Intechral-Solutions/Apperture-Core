@page "/integrations/{IntegrationId}"
@using System.Net
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Client.Services.Wizard
@using Apperture.Management.Ui.Client.Organisms
@using Apperture.Management.Ui.Client.Molecules
@using Apperture.Management.Ui.Shared
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities
@inject NavigationManager Nav
@inject ShellOrientationService ShellOrientation
@inject IToastService Toasts
@implements IDisposable

<div class="p-4 ui-page-stack">
    <PageHeader @key="@IntegrationId"
                Eyebrow="Integrations"
                Title="@EntityShellTitles.Detail(_integration?.DisplayName, "Integration")"
                Subtitle="@SummarySubtitle">
        <ChildContent>
            <OwnershipChip ResourceContextId="@_integration?.ResourceContextId" />
        </ChildContent>
        <Toolbar>
            <a href="@($"/execute?integrationId={Uri.EscapeDataString(IntegrationId)}")" class="ui-toolbar-btn">Execute</a>
            <button type="button" class="ui-toolbar-btn" disabled="@_loading" @onclick="RefreshAsync">Refresh</button>
            @if (_capabilities?.CanManageIntegrations == true && _integration is not null)
            {
                @if (string.Equals(_integration.State, "Active", StringComparison.OrdinalIgnoreCase))
                {
                    <button type="button" class="ui-toolbar-btn" disabled="@_loading" @onclick="DeactivateIntegrationAsync">Deactivate</button>
                }
                else
                {
                    <button type="button" class="btn btn-primary text-sm" disabled="@_loading" @onclick="ActivateIntegrationAsync">Activate</button>
                }
                <button type="button" id="integration-delete-trigger" class="ui-toolbar-btn ui-toolbar-btn--danger" disabled="@_deleting" @onclick="() => _confirmDeleteOpen = true">Delete</button>
            }
        </Toolbar>
    </PageHeader>
    <IntegrationHubNav IntegrationId="@IntegrationId" ShowNotificationsTab="@(_capabilities?.CanViewNotificationDefinitions == true)" />
    <MismatchNotice OwnerResourceContextId="@_integration?.ResourceContextId" ResourceKindLabel="integration" />

    @if (!_capabilitiesLoaded)
    {
        <LoadingState />
    }
    else if (_capabilities?.CanViewIntegrations != true)
    {
        <ForbiddenState Message="You do not have permission to view integration details." />
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <ErrorState Message="@_error" />
    }
    else if (_loading)
    {
        <LoadingState Message="Loading integration…" />
    }
    else if (_integration is null)
    {
        <EmptyState Title="Integration not found" Message="The requested integration could not be loaded." />
    }
    else
    {
        <IntegrationSummaryBand Integration="@_integration"
                                Readiness="@_readiness"
                                IntegrationId="@IntegrationId"
                                ScheduleCount="@(_schedules?.Count ?? 0)"
                                EnabledScheduleCount="@EnabledScheduleCount"
                                BindingCount="@(_bindings?.Count ?? 0)"
                                RecentOutcomeSummary="@RecentOutcomeSummary"
                                NextScheduleSummary="@NextScheduleSummary"
                                ConnectionsSummary="@ConnectionsSummary" />

        @if (!string.IsNullOrEmpty(_actionMessage))
        {
            <ActionFeedback Kind="@_actionFeedbackKind" Message="@_actionMessage" />
        }

        @if (_readiness is not null)
        {
            var pill = IntegrationConfigurationOperatorUiHelpers.BuildOverallReadinessPill(_readiness);
            <ManagementSection Title="Readiness"
                               Layer="ManagementSection.UiLayer.Summary"
                               Help="Full requirement/binding detail and remediation actions live on Connections.">
                <div class="flex flex-wrap items-center gap-2">
                    <StatusPill Label="@pill.Label" Semantic="@pill.Semantic" />
                    @if (_readiness.BlockingIssueCount > 0)
                    {
                        <AttentionPill Label="@($"{_readiness.BlockingIssueCount} blocking")" Semantic="@ManagementAttentionSemantic.Critical" />
                    }
                    @if (_readiness.AdvisoryIssueCount > 0)
                    {
                        <AttentionPill Label="@($"{_readiness.AdvisoryIssueCount} advisory")" Semantic="@ManagementAttentionSemantic.Warning" />
                    }
                    <DrillInLink Href="@IntegrationUiRoutes.Connections(IntegrationId)">View connections &amp; fix issues</DrillInLink>
                </div>
            </ManagementSection>
        }

        @if (ProblematicActivity.Count > 0)
        {
            <ManagementSection Title="Needs attention"
                               Layer="ManagementSection.UiLayer.Summary"
                               Help="Failed runs or denied outcomes from recent activity.">
                <div class="space-y-2">
                    @foreach (var item in ProblematicActivity.Take(5))
                    {
                        <div class="ui-detail-block flex items-start justify-between gap-3">
                            <div class="min-w-0">
                                <div class="text-sm font-semibold">@item.Summary</div>
                                <div class="mt-1 flex flex-wrap items-center gap-2 text-xs text-muted">
                                    <StatusPill Label="@(item.StatusOrOutcome ?? item.TypeLabel)"
                                                Semantic="@EntityRecentActivityComposer.MapStatusSemantic(item.StatusOrOutcome)" />
                                    <span>@item.SourceKind · <TimestampDisplay Value="@item.TimestampUtc" /></span>
                                </div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(item.DrillInHref))
                            {
                                <DrillInLink Href="@item.DrillInHref">@item.DrillInLabel</DrillInLink>
                            }
                        </div>
                    }
                </div>
            </ManagementSection>
        }

        <ManagementSection Title="Recent activity" Layer="ManagementSection.UiLayer.Detail" Help="@RecentActivityHelp">
            <EntityRecentActivityPanel Items="@_recentActivity"
                                       Loading="@_activityLoading"
                                       Error="@_activityError"
                                       EmptyMessage="No runs or notifications for this integration in the last 7 days. Activity appears after workflows execute or notifications are delivered.">
                <FooterLinks>
                    <DrillInLink Href="@IntegrationUiRoutes.Runs(IntegrationId)">View runs for integration</DrillInLink>
                    @if (_capabilities?.CanViewAudit == true && !string.IsNullOrWhiteSpace(_integration.ModuleId))
                    {
                        <DrillInLink Href="@Epic33UiDisplayHelpers.GetAuditLinkForModule(_integration.ModuleId)">View audit for module</DrillInLink>
                    }
                </FooterLinks>
            </EntityRecentActivityPanel>
        </ManagementSection>

        @if (string.Equals(_integration.State, "Inactive", StringComparison.OrdinalIgnoreCase))
        {
            <PageMessage Kind="PageMessageKind.Warning"
                         Message="Integration is inactive. Configuration is preserved, but schedules and launches are operationally paused until re-activated." />
        }

        @if (_wizardMode)
        {
            <ManagementSection Title="Setup wizard"
                               Layer="ManagementSection.UiLayer.Detail"
                               Help="Guided sequence: bind slots, resolve readiness, attach schedules, launch procedures.">
                <WizardFlowPanel Title="Integration setup wizard"
                                 Description="Follow the guided sequence: bind required slots, resolve readiness blockers, attach schedules, then launch procedures below."
                                 Steps="@_wizard.Steps"
                                 StepStates="@_wizardStepMap"
                                 CurrentStepId="@_wizard.CurrentStepId"
                                 OnSelect="OnWizardStepSelectedAsync" />
                <div class="ui-detail-block mt-3">
                    <div class="text-sm font-semibold text-heading">Next action</div>
                    <div class="mt-1 text-xs text-muted">@CurrentWizardGuidance()</div>
                    <div class="mt-2 flex gap-2">
                        @if (string.Equals(_wizard.CurrentStepId, WizardStepBindings, StringComparison.Ordinal))
                        {
                            <a class="btn btn-primary text-xs" href="@($"{IntegrationUiRoutes.Connections(IntegrationId)}?wizard=1")">Open Connections</a>
                        }
                        else if (string.Equals(_wizard.CurrentStepId, WizardStepSchedules, StringComparison.Ordinal))
                        {
                            <a class="btn btn-secondary text-xs" href="@($"{IntegrationUiRoutes.Schedules(IntegrationId)}?wizard=1")">Open Schedules</a>
                        }
                        <button type="button" class="btn btn-secondary text-xs" @onclick="WizardPreviousAsync">Previous step</button>
                        <button type="button" class="btn btn-secondary text-xs" disabled="@(!WizardCanAdvance())" @onclick="WizardAdvanceAsync">Next step</button>
                    </div>
                </div>
            </ManagementSection>
        }

        <ManagementSection Title="Procedures"
                           Layer="ManagementSection.UiLayer.Detail"
                           Help="Module-declared operator actions (ADR-0029). Availability and launchability come from the server; blocked reasons explain what must change.">
            @if (_procedureLoading)
            {
                <LoadingState Message="Loading procedures…" />
            }
            else if (!string.IsNullOrEmpty(_procedureError))
            {
                <ErrorState Title="Procedure error" Message="@_procedureError" />
            }
            else if (_procedureList is null)
            {
                <EmptyState Message="No procedure data." />
            }
            else if (_procedureList.Procedures.Count == 0)
            {
                <EmptyState Title="No procedures"
                            Message="This module declares no operator procedures. Workflows and operations may still be available from Execute." />
            }
            else
            {
                @if (!_procedureList.IntegrationReady)
                {
                    <PageMessage Kind="PageMessageKind.Warning"
                                 Message="Integration is not runnable; procedures are listed but launch is blocked until readiness passes." />
                }
                <div class="flex flex-wrap gap-2 mb-3">
                    @foreach (var p in _procedureList.Procedures)
                    {
                        <button type="button"
                                class="btn text-xs @(string.Equals(_selectedProcedureId, p.Id, StringComparison.Ordinal) ? "btn-primary" : "btn-secondary")"
                                title="@(p.Launchable ? "Runnable" : ProcedureLaunchOperatorUiHelpers.DescribeLaunchAvailability(_procedureList.IntegrationReady, p.Launchable, p.BlockedReasonCodes, _readiness?.AdvisoryIssueCount ?? 0))"
                                @onclick="() => SelectProcedureAsync(p.Id)">
                            @p.DisplayName
                            @if (p.Launchable)
                            {
                                <span class="ml-1 text-xs text-muted">· ready</span>
                            }
                            else
                            {
                                <span class="ml-1 text-warning" title="@ProcedureLaunchOperatorUiHelpers.DescribeLaunchAvailability(_procedureList.IntegrationReady, p.Launchable, p.BlockedReasonCodes, _readiness?.AdvisoryIssueCount ?? 0)">●</span>
                            }
                        </button>
                    }
                </div>
                @if (_selectedProcedureDetail is not null)
                {
                    <div class="ui-detail-block">
                        <div class="text-sm font-semibold text-heading">@_selectedProcedureDetail.DisplayName</div>
                        @if (!string.IsNullOrEmpty(_selectedProcedureDetail.Description))
                        {
                            <div class="text-xs text-muted mt-1">@_selectedProcedureDetail.Description</div>
                        }
                        <TechnicalDetails Class="mt-1" Dense="true">
                            <TechnicalDetail Label="Procedure ID" Value="@_selectedProcedureDetail.Id" />
                            <TechnicalDetail Label="Launch kind" Value="@_selectedProcedureDetail.LaunchKind" />
                            <TechnicalDetail Label="Target definition ID" Value="@_selectedProcedureDetail.TargetDefinitionId" />
                        </TechnicalDetails>
                        @if (!_selectedProcedureDetail.Launchable && _selectedProcedureDetail.BlockedReasonCodes.Count > 0)
                        {
                            <ul class="mt-2 list-disc pl-5 text-xs text-body">
                                @foreach (var blockedCode in _selectedProcedureDetail.BlockedReasonCodes)
                                {
                                    <li>@ProcedureLaunchOperatorUiHelpers.DescribeBlockedReason(blockedCode)</li>
                                }
                            </ul>
                        }
                        <ProcedureParameterForm Fields="@_selectedProcedureDetail.ParameterFields"
                                                  Values="@_procedureParamValues"
                                                  OnChanged="RefreshProcedureValidation" />
                        @{
                            var launchDisabledReason = ProcedureLaunchOperatorUiHelpers.BuildLaunchDisabledReason(
                                _procedureLaunching,
                                _selectedProcedureDetail.Launchable,
                                _procedureList.IntegrationReady,
                                _selectedProcedureDetail.BlockedReasonCodes,
                                _procedureValidationErrors);
                        }
                        @if (_procedureValidationErrors.Count > 0)
                        {
                            <PageMessage Kind="PageMessageKind.Warning" Message="@_procedureValidationErrors[0]" />
                        }
                        <div class="mt-3 flex flex-wrap items-center gap-2">
                            <button type="button"
                                    class="btn btn-primary text-sm"
                                    disabled="@(_procedureLaunching || launchDisabledReason is not null)"
                                    title="@launchDisabledReason"
                                    @onclick="LaunchSelectedProcedureAsync">
                                Launch
                            </button>
                            <DrillInLink Href="@ProcedureLaunchOperatorUiHelpers.BuildExecuteHref(IntegrationId, "procedure", _selectedProcedureDetail.Id)">
                                Open launch page
                            </DrillInLink>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(launchDisabledReason))
                        {
                            <div class="mt-1 text-xs text-muted">@launchDisabledReason</div>
                        }
                    </div>
                }
            }
        </ManagementSection>

        <ManagementAdvancedSection Title="Identity and diagnostics"
                                   Subtitle="Raw identifiers and troubleshooting links."
                                   InitiallyOpen="false">
            <div class="space-y-4">
                <div>
                    <h3 class="text-xs font-semibold text-heading mb-2">Identity</h3>
                    <div class="grid grid-cols-1 gap-2 md:grid-cols-2 text-sm">
                        <div>
                            <div class="text-xs text-muted">Integration id</div>
                            <div class="font-mono text-body break-all">@_integration.Id</div>
                        </div>
                        <div>
                            <div class="text-xs text-muted">Module definition</div>
                            <div class="font-mono text-body">@_integration.ModuleId</div>
                        </div>
                        <div>
                            <div class="text-xs text-muted">Scope key</div>
                            <div class="text-body">@(_integration.ScopeKey ?? "—")</div>
                        </div>
                        <div>
                            <div class="text-xs text-muted">Created</div>
                            <div class="text-body">@_integration.CreatedAt.ToString("yyyy-MM-dd HH:mm")</div>
                        </div>
                        <div>
                            <div class="text-xs text-muted">Updated</div>
                            <div class="text-body">@_integration.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</div>
                        </div>
                    </div>
                </div>
                <div>
                    <h3 class="text-xs font-semibold text-heading mb-2">Related diagnostics</h3>
                    <ul class="space-y-1 text-sm">
                        <li>
                            <DrillInLink Href="@IntegrationUiRoutes.ScheduleDiagnostics(IntegrationId)">Schedule diagnostics</DrillInLink>
                            <span class="text-xs text-muted ml-1">— expected-run and evaluation troubleshooting</span>
                        </li>
                    </ul>
                </div>
                <div>
                    <h3 class="text-xs font-semibold text-heading mb-2">Runtime and lineage</h3>
                    <div class="text-xs text-muted space-y-2">
                        <p>Workflow runs started with an integration id (manual start, schedules, or retry) store <span class="font-mono">IntegrationId</span> on the run and instance. The worker resolves slots using that id when present.</p>
                        <p>Configure <span class="font-mono">Apperture:IntegrationExecution:DefaultIntegrationId</span> or environment <span class="font-mono">APERTURE_INTEGRATION_ID</span> only when a single integration is deployed per worker and persisted starts omit integration id.</p>
                    </div>
                </div>
            </div>
        </ManagementAdvancedSection>
    }
</div>

<ConfirmActionDialog IsOpen="@_confirmDeleteOpen"
                     Title="Delete integration?"
                     ConfirmLabel="Delete integration"
                     Emphasis="ConfirmActionEmphasis.Destructive"
                     OnConfirm="DeleteIntegrationAsync"
                     OnConfirmed="() => _confirmDeleteOpen = false"
                     OnCancel="() => _confirmDeleteOpen = false">
    <ChildContent>
        Deleting <strong>@(_integration?.DisplayName ?? "this integration")</strong> permanently removes its configuration. This cannot be undone.
    </ChildContent>
    <Details>
        Bindings, schedules, and settings that belong to this integration are removed with it.
    </Details>
</ConfirmActionDialog>

@code {
    [Parameter] public string IntegrationId { get; set; } = "";

    private bool _confirmDeleteOpen;

    private const string WizardStepBindings = "bindings";
    private const string WizardStepReadiness = "readiness";
    private const string WizardStepSchedules = "schedules";
    private const string WizardStepProcedures = "procedures";

    private readonly WizardFlowController _wizard = new(
        [
            new WizardStepDefinition(WizardStepBindings, "Bind required slots", "Connect required slots to eligible connections (Connections tab)."),
            new WizardStepDefinition(WizardStepReadiness, "Resolve readiness", "Fix blockers until the integration is runnable."),
            new WizardStepDefinition(WizardStepSchedules, "Attach schedules", "Optional recurring workflow triggers (Schedules tab)."),
            new WizardStepDefinition(WizardStepProcedures, "Launch procedures", "Module-declared downstream operator actions, below.")
        ]);
    private readonly Dictionary<string, WizardStepState> _wizardStepMap = new(StringComparer.Ordinal);
    private bool _wizardMode;

    private IntegrationDto? _integration;
    private IReadOnlyList<IntegrationBindingSummaryDto>? _bindings;
    private IReadOnlyList<ScheduleDto>? _schedules;
    private IntegrationReadinessDto? _readiness;
    private IntegrationModuleSlotSummaryDto[]? _requiredSlots;
    private OperatorCapabilitiesDto? _capabilities;
    private bool _capabilitiesLoaded;
    private bool _loading;
    private bool _deleting;
    private string? _error;
    private string? _actionMessage;
    private PageMessageKind _actionFeedbackKind = PageMessageKind.Info;

    private bool _procedureLoading;
    private string? _procedureError;
    private IntegrationProcedureListDto? _procedureList;
    private string? _selectedProcedureId;
    private IntegrationProcedureDetailDto? _selectedProcedureDetail;
    private readonly Dictionary<string, object?> _procedureParamValues = new(StringComparer.Ordinal);
    private bool _procedureLaunching;
    private readonly List<string> _procedureValidationErrors = [];

    private IReadOnlyList<EntityRecentActivityItem>? _recentActivity;
    private bool _activityLoading;
    private string? _activityError;

    private string RecentActivityHelp =>
        _integration is null
            ? "Recent runs (integrationId), module-scoped audit (not integration-scoped), and notification instances from existing APIs."
            : $"Runs filtered by this integration. Audit filtered by module {_integration.ModuleId} only — the audit API has no integrationId filter, so audit rows may include other integrations using the same module. Notifications are integration-scoped. Last {EntityRecentActivityComposer.DefaultLookback.Days} days, up to {EntityRecentActivityComposer.DefaultMaxItems} items.";

    private string SummarySubtitle
    {
        get
        {
            if (_integration is null)
                return "Integration overview";
            var parts = new List<string> { _integration.State };
            if (_readiness is not null)
            {
                parts.Add(_readiness.IsRunnable ? "Runnable" : "Not runnable");
                if (_readiness.BlockingIssueCount > 0)
                    parts.Add($"{_readiness.BlockingIssueCount} blocking issue(s)");
            }
            return string.Join(" · ", parts);
        }
    }

    private int EnabledScheduleCount => _schedules?.Count(s => s.Enabled) ?? 0;

    private IReadOnlyList<EntityRecentActivityItem> ProblematicActivity =>
        IntegrationOperatorUiHelpers.GetProblematicActivities(_recentActivity);

    private string? RecentOutcomeSummary => IntegrationOperatorUiHelpers.BuildRecentOutcomeSummary(_recentActivity);
    private string? NextScheduleSummary => IntegrationOperatorUiHelpers.BuildNextScheduleSummary(_schedules);

    private string ConnectionsSummary =>
        IntegrationOperatorUiHelpers.BuildConnectionsSummary(_bindings?.Count ?? 0, UnboundRequiredSlotCount, 0);

    private int UnboundRequiredSlotCount =>
        _requiredSlots?.Count(s =>
            _bindings?.Any(b => string.Equals(b.SlotName, s.SlotName, StringComparison.Ordinal)
                && string.Equals(b.State, "Active", StringComparison.OrdinalIgnoreCase)) != true) ?? 0;

    private string? _dataLoadKey;
    private string? _inFlightLoadKey;
    private readonly NavigationLoadGuard _loadGuard = new();
    private CancellationTokenSource? _loadCts;

    protected override async Task OnInitializedAsync()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var rawQuery = uri.Query.StartsWith('?') ? uri.Query[1..] : uri.Query;
        var queryValues = rawQuery
            .Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Select(part => part.Split('=', 2))
            .ToDictionary(
                parts => Uri.UnescapeDataString(parts[0]),
                parts => parts.Length > 1 ? Uri.UnescapeDataString(parts[1]) : "",
                StringComparer.OrdinalIgnoreCase);
        _wizardMode = queryValues.TryGetValue("wizard", out var wizardVal) && string.Equals(wizardVal, "1", StringComparison.Ordinal);
        if (_wizardMode && queryValues.TryGetValue("step", out var stepVal))
            _wizard.NavigateTo(stepVal);

        try
        {
            _capabilities = await Capabilities.GetCapabilitiesAsync();
        }
        catch
        {
            _capabilities = new OperatorCapabilitiesDto(false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false);
        }
        _capabilitiesLoaded = true;
        RecomputeWizardStates();
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        await TryLoadForRouteAsync();
    }

    public void Dispose()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
    }

    private int BeginLoad(out CancellationToken cancellationToken)
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = new CancellationTokenSource();
        cancellationToken = _loadCts.Token;
        return _loadGuard.Begin();
    }

    private async Task TryLoadForRouteAsync()
    {
        if (!_capabilitiesLoaded || string.IsNullOrWhiteSpace(IntegrationId))
            return;

        var key = IntegrationId;
        if (string.Equals(key, _dataLoadKey, StringComparison.Ordinal) || string.Equals(key, _inFlightLoadKey, StringComparison.Ordinal))
            return;

        _inFlightLoadKey = key;
        try
        {
            var generation = BeginLoad(out var cancellationToken);
            if (_capabilities?.CanViewIntegrations == true)
                await LoadAsync(generation, key, cancellationToken);
        }
        finally
        {
            if (string.Equals(_inFlightLoadKey, key, StringComparison.Ordinal))
                _inFlightLoadKey = null;
        }
    }

    private Task RefreshAsync()
    {
        _dataLoadKey = null;
        return TryLoadForRouteAsync();
    }

    private Task ReloadAfterActionAsync()
    {
        var generation = BeginLoad(out var cancellationToken);
        return LoadAsync(generation, IntegrationId, cancellationToken, preserveActionFeedback: true);
    }

    private void SetActionFeedback(string message, PageMessageKind kind = PageMessageKind.Info)
    {
        _actionMessage = message;
        _actionFeedbackKind = kind;
    }

    private async Task LoadAsync(int generation, string integrationId, CancellationToken cancellationToken, bool preserveActionFeedback = false)
    {
        if (_capabilities?.CanViewIntegrations != true || string.IsNullOrWhiteSpace(integrationId))
            return;

        _loading = true;
        _error = null;
        if (!preserveActionFeedback)
            _actionMessage = null;
        try
        {
            if (!_loadGuard.IsCurrent(generation))
                return;

            var detail = await Client.GetIntegrationOperatorDetailAsync(integrationId, cancellationToken);
            if (!_loadGuard.IsCurrent(generation))
                return;

            if (detail is null)
            {
                _integration = null;
                _bindings = null;
                _schedules = null;
                _readiness = null;
                _requiredSlots = null;
                _procedureList = null;
                _procedureError = null;
                _selectedProcedureId = null;
                _selectedProcedureDetail = null;
                _procedureParamValues.Clear();
                _recentActivity = null;
                _activityError = null;
            }
            else
            {
                _integration = new IntegrationDto(detail.Id, detail.DisplayName, detail.ModuleId, detail.ScopeKey, detail.State, detail.Settings, detail.CreatedAt, detail.UpdatedAt, detail.ResourceContextId);
                _readiness = detail.Readiness;
                _requiredSlots = detail.RequiredSlots;
                _bindings = detail.Bindings;
                _schedules = detail.Schedules.Select(s => new ScheduleDto(s.Id, s.Name, s.RecurrenceExpression, "UTC", s.Enabled, 0, null, 1, s.IntegrationId)).ToList();
                try
                {
                    if (_loadGuard.IsCurrent(generation))
                        _schedules = await Client.GetIntegrationSchedulesAsync(integrationId, cancellationToken);
                }
                catch (HttpRequestException) { /* keep the operator-detail fallback already assigned above */ }

                _procedureError = null;
                _procedureList = null;
                _selectedProcedureId = null;
                _selectedProcedureDetail = null;
                _procedureParamValues.Clear();
                _procedureLoading = true;
                try
                {
                    if (_loadGuard.IsCurrent(generation))
                        _procedureList = await Client.GetIntegrationProceduresAsync(integrationId, cancellationToken);
                }
                catch (HttpRequestException ex)
                {
                    if (_loadGuard.IsCurrent(generation))
                        _procedureError = ex.Message;
                }
                catch (OperationCanceledException) { }
                finally
                {
                    if (_loadGuard.IsCurrent(generation))
                        _procedureLoading = false;
                }

                if (_loadGuard.IsCurrent(generation))
                    await LoadRecentActivityAsync(generation, integrationId, detail.ModuleId, cancellationToken);
            }
        }
        catch (OperationCanceledException) { }
        catch (HttpRequestException ex)
        {
            if (_loadGuard.IsCurrent(generation))
                _error = ex.Message;
        }
        finally
        {
            if (_loadGuard.IsCurrent(generation))
            {
                _loading = false;
                _dataLoadKey = integrationId;
                RecomputeWizardStates();
                PublishShellTitle();
            }
        }
    }

    private void PublishShellTitle() =>
        ShellOrientation.PublishForCurrentUri(Nav, EntityShellTitles.Detail(_integration?.DisplayName, "Integration"), SummarySubtitle);

    private async Task LoadRecentActivityAsync(int generation, string integrationId, string moduleId, CancellationToken cancellationToken)
    {
        if (!_loadGuard.IsCurrent(generation))
            return;

        _activityLoading = true;
        _activityError = null;
        _recentActivity = null;
        try
        {
            var fromUtc = EntityRecentActivityComposer.DefaultFromUtc();
            var take = EntityRecentActivityComposer.PerSourceTake;
            var rows = new List<EntityRecentActivityItem>();

            try
            {
                var runs = await Client.GetRunsAsync(new RunQueryFilter(IntegrationId: integrationId, CreatedFrom: fromUtc, Take: take), cancellationToken);
                if (_loadGuard.IsCurrent(generation))
                    rows.AddRange(runs.Select(EntityRecentActivityComposer.FromRun));
            }
            catch (OperationCanceledException) { return; }
            catch (HttpRequestException ex)
            {
                if (_loadGuard.IsCurrent(generation))
                    _activityError = $"Runs: {ex.Message}";
            }

            if (_capabilities?.CanViewAudit == true && !string.IsNullOrWhiteSpace(moduleId))
            {
                try
                {
                    var auditPage = await Client.GetAuditTimelineAsync(fromUtc: fromUtc, moduleId: moduleId.Trim(), pageSize: take, cancellationToken: cancellationToken);
                    if (_loadGuard.IsCurrent(generation))
                        rows.AddRange(auditPage.Items.Select(e => EntityRecentActivityComposer.FromAudit(e, moduleId)));
                }
                catch (OperationCanceledException) { return; }
                catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Forbidden) { }
                catch (HttpRequestException ex) when (_loadGuard.IsCurrent(generation) && _activityError is null)
                {
                    _activityError = $"Audit: {ex.Message}";
                }
                catch (HttpRequestException ex) when (_loadGuard.IsCurrent(generation))
                {
                    _activityError = $"{_activityError} Audit: {ex.Message}";
                }
            }

            if (_capabilities?.CanViewNotificationDefinitions == true)
            {
                try
                {
                    var instances = await Client.ListNotificationInstancesAsync(integrationId: integrationId, take: take, cancellationToken: cancellationToken);
                    if (_loadGuard.IsCurrent(generation))
                        rows.AddRange(instances.Select(EntityRecentActivityComposer.FromNotification));
                }
                catch (OperationCanceledException) { return; }
                catch (HttpRequestException ex) when (_loadGuard.IsCurrent(generation) && _activityError is null)
                {
                    _activityError = $"Notifications: {ex.Message}";
                }
                catch (HttpRequestException ex) when (_loadGuard.IsCurrent(generation))
                {
                    _activityError = $"{_activityError} Notifications: {ex.Message}";
                }
            }

            if (_loadGuard.IsCurrent(generation))
                _recentActivity = EntityRecentActivityComposer.MergeAndTake(rows);
        }
        finally
        {
            if (_loadGuard.IsCurrent(generation))
                _activityLoading = false;
        }
    }

    private async Task SelectProcedureAsync(string procedureId)
    {
        var integrationId = IntegrationId;
        if (string.IsNullOrWhiteSpace(integrationId))
            return;

        _selectedProcedureId = procedureId;
        _selectedProcedureDetail = null;
        _procedureParamValues.Clear();
        _procedureError = null;
        try
        {
            var detail = await Client.GetIntegrationProcedureAsync(integrationId, procedureId);
            if (!string.Equals(IntegrationId, integrationId, StringComparison.Ordinal))
                return;

            _selectedProcedureDetail = detail;
            if (_selectedProcedureDetail is not null)
            {
                ProcedureParameterForm.SeedValues(_selectedProcedureDetail.ParameterFields, _procedureParamValues);
                RefreshProcedureValidation();
            }
        }
        catch (HttpRequestException ex)
        {
            if (string.Equals(IntegrationId, integrationId, StringComparison.Ordinal))
                _procedureError = ex.Message;
        }
    }

    private async Task LaunchSelectedProcedureAsync()
    {
        if (string.IsNullOrEmpty(_selectedProcedureId) || _selectedProcedureDetail is null)
            return;

        RefreshProcedureValidation();
        if (_procedureValidationErrors.Count > 0)
            return;

        _procedureLaunching = true;
        _procedureError = null;
        try
        {
            var outcome = await Client.LaunchIntegrationProcedureAsync(IntegrationId, _selectedProcedureId, _procedureParamValues, null, null);
            if (!outcome.Succeeded || outcome.Result is null)
            {
                var launchMsg = ProcedureLaunchOperatorUiHelpers.FormatLaunchError(outcome.ErrorCode, outcome.ErrorMessage);
                SetActionFeedback(launchMsg, PageMessageKind.Error);
                Toasts.Show(ToastSeverity.Error, launchMsg);
                return;
            }

            var successMsg = ProcedureLaunchOperatorUiHelpers.FormatLaunchSuccessMessage(outcome.Result.RunId, outcome.Result.Status);
            Toasts.Show(ToastSeverity.Success, successMsg);
            Nav.NavigateTo(ProcedureLaunchOperatorUiHelpers.GetRunDetailHref(outcome.Result.RunId));
        }
        catch (HttpRequestException ex)
        {
            SetActionFeedback(ex.Message, PageMessageKind.Error);
            Toasts.Show(ToastSeverity.Error, ex.Message);
        }
        finally
        {
            _procedureLaunching = false;
        }
    }

    private void RefreshProcedureValidation()
    {
        _procedureValidationErrors.Clear();
        if (_selectedProcedureDetail is null)
            return;
        _procedureValidationErrors.AddRange(
            ProcedureLaunchOperatorUiHelpers.ValidateProcedureParameters(_selectedProcedureDetail.ParameterFields, _procedureParamValues));
    }

