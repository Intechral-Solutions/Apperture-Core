@page "/integrations/{IntegrationId}"
@using System.Net
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Client.Services.Wizard
@using Apperture.Management.Ui.Client.Organisms
@using Apperture.Management.Ui.Client.Molecules
@using Apperture.Management.Ui.Shared
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities
@inject NavigationManager Nav
@inject ShellOrientationService ShellOrientation
@inject IJSRuntime JSRuntime
@inject IToastService Toasts
@implements IDisposable

<div class="p-4 ui-page-stack">
    <PageHeader @key="@IntegrationId"
                Eyebrow="Integrations"
                Title="@EntityShellTitles.Detail(_integration?.DisplayName, "Integration")"
                Subtitle="@SummarySubtitle">
        <Toolbar>
            <a href="/integrations" class="ui-toolbar-btn">Back to list</a>
            <a href="@($"/execute?integrationId={Uri.EscapeDataString(IntegrationId)}")"
               class="ui-toolbar-btn">
                Execute
            </a>
            <a href="@IntegrationUiRoutes.Notifications(IntegrationId)"
               class="ui-toolbar-btn">
                Notifications
            </a>
            <a href="@IntegrationUiRoutes.Settings(IntegrationId)"
               class="ui-toolbar-btn">
                Settings
            </a>
            <button type="button"
                    class="ui-toolbar-btn"
                    disabled="@_loading"
                    @onclick="RefreshAsync">
                Refresh
            </button>
            @if (_capabilities?.CanManageIntegrations == true && _integration is not null)
            {
                @if (string.Equals(_integration.State, "Active", StringComparison.OrdinalIgnoreCase))
                {
                    <button type="button"
                            class="ui-toolbar-btn"
                            disabled="@_loading"
                            @onclick="DeactivateIntegrationAsync">
                        Deactivate
                    </button>
                }
                else
                {
                    <button type="button"
                            class="rounded bg-body px-3 py-2 text-sm text-surface hover:bg-body/90 disabled:opacity-50"
                            disabled="@_loading"
                            @onclick="ActivateIntegrationAsync">
                        Activate
                    </button>
                }
            }
            @if (_capabilities?.CanManageIntegrations == true && _integration is not null)
            {
                <button type="button"
                        class="ui-toolbar-btn ui-toolbar-btn--danger"
                        disabled="@_deleting"
                        @onclick="ConfirmDeleteAsync">
                    Delete
                </button>
            }
        </Toolbar>
    </PageHeader>

    @if (!_capabilitiesLoaded)
    {
        <LoadingState />
    }
    else if (_capabilities?.CanViewIntegrations != true)
    {
        <ForbiddenState Message="You do not have permission to view integration details." />
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <ErrorState Message="@_error" />
    }
    else if (_loading)
    {
        <LoadingState Message="Loading integration…" />
    }
    else if (_integration is null)
    {
        <EmptyState Title="Integration not found"
                    Message="The requested integration could not be loaded." />
    }
    else
    {
        <IntegrationSummaryBand Integration="@_integration"
                                Readiness="@_readiness"
                                IntegrationId="@IntegrationId"
                                ScheduleCount="@(_schedules?.Count ?? 0)"
                                EnabledScheduleCount="@EnabledScheduleCount"
                                BindingCount="@(_bindings?.Count ?? 0)" />

        @if (!string.IsNullOrEmpty(_actionMessage))
        {
            <ActionFeedback Kind="@_actionFeedbackKind" Message="@_actionMessage" />
        }

        <ManagementSection Title="Recent activity"
                           Layer="ManagementSection.UiLayer.Detail"
                           Help="@RecentActivityHelp">
            <EntityRecentActivityPanel Items="@_recentActivity"
                                       Loading="@_activityLoading"
                                       Error="@_activityError"
                                       EmptyMessage="No runs, audit events, or notification instances for this integration in the last 7 days (or none visible to you).">
                <FooterLinks>
                    <DrillInLink Href="@Epic33UiDisplayHelpers.GetRunsListIntegrationFilterHref(IntegrationId)">View runs for integration</DrillInLink>
                    @if (_capabilities?.CanViewAudit == true && !string.IsNullOrWhiteSpace(_integration.ModuleId))
                    {
                        <DrillInLink Href="@Epic33UiDisplayHelpers.GetAuditLinkForModule(_integration.ModuleId)">View audit for module</DrillInLink>
                    }
                    @if (_capabilities?.CanViewNotificationDefinitions == true)
                    {
                        <DrillInLink Href="@($"/integrations/{Uri.EscapeDataString(IntegrationId)}/notifications")">Integration notifications</DrillInLink>
                    }
                </FooterLinks>
            </EntityRecentActivityPanel>
        </ManagementSection>

        @if (string.Equals(_integration.State, "Inactive", StringComparison.OrdinalIgnoreCase))
        {
            <PageMessage Kind="PageMessageKind.Warning"
                         Message="Integration is inactive. Configuration is preserved, but schedules and launches are operationally paused until re-activated." />
        }

        @if (_wizardMode)
        {
            <ManagementSection Title="Setup wizard"
                               Layer="ManagementSection.UiLayer.Detail"
                               Help="Guided sequence: bind slots, resolve readiness, attach schedules, launch procedures.">
                <WizardFlowPanel Title="Integration setup wizard"
                                 Description="Follow the guided sequence: bind required slots, resolve readiness blockers, attach schedules, then launch procedures."
                                 Steps="@_wizard.Steps"
                                 StepStates="@_wizardStepMap"
                                 CurrentStepId="@_wizard.CurrentStepId"
                                 OnSelect="OnWizardStepSelectedAsync" />
                @if (_capabilities?.CanManageIntegrations == true)
                {
                    <div class="mt-3 rounded border border-default bg-surface-muted/40 p-3">
                        <div class="text-sm font-semibold text-heading">Next action</div>
                        <div class="mt-1 text-xs text-muted">@CurrentWizardGuidance()</div>
                        <div class="mt-2 flex gap-2">
                            <button type="button"
                                    class="rounded bg-surface-muted px-2 py-1 text-sm text-body hover:bg-surface"
                                    @onclick="WizardPreviousAsync">
                                Previous step
                            </button>
                            <button type="button"
                                    class="rounded bg-body px-2 py-1 text-sm text-surface hover:bg-body/90 disabled:opacity-50"
                                    disabled="@(!WizardCanAdvance())"
                                    @onclick="WizardAdvanceAsync">
                                Next step
                            </button>
                        </div>
                    </div>
                }
            </ManagementSection>
        }

        @if (_readiness is not null)
        {
            <ManagementSection Title="Readiness"
                               Layer="ManagementSection.UiLayer.Detail"
                               Help="Derived from declared module slots, integration bindings, connections, and schedules.">
                <div class="mb-3 flex flex-wrap items-center gap-2">
                    <StatusPill Label="@(_readiness.IsRunnable ? "Runnable" : "Not runnable")"
                                Semantic="@(_readiness.IsRunnable ? ManagementStatusSemantic.Success : ManagementStatusSemantic.Warning)" />
                    <span class="text-xs text-muted">
                        Blocking: @_readiness.BlockingIssueCount · Advisory: @_readiness.AdvisoryIssueCount
                    </span>
                </div>
                @if (_readiness.Issues.Length > 0)
                {
                    <ul class="space-y-2 text-sm text-body">
                        @foreach (var issue in _readiness.Issues)
                        {
                            <li class="rounded border border-default bg-surface-muted/30 p-2">
                                <div>
                                    <span class="font-mono text-xs text-muted">@issue.Code</span>
                                    <AttentionPill Label="@issue.Severity" Semantic="@MapIssueSeverity(issue.Severity)" />
                                    <span class="ml-1">@issue.Message</span>
                                </div>
                                <div class="mt-1 text-xs text-muted">@ReadinessRemediationCue(issue)</div>
                                @if (_capabilities?.CanManageIntegrations == true)
                                {
                                    <div class="mt-2">
                                        <button type="button"
                                                class="rounded bg-surface-muted px-2 py-0.5 text-xs text-body hover:bg-surface"
                                                @onclick="() => RemediateReadinessIssueAsync(issue)">
                                            Fix now
                                        </button>
                                    </div>
                                }
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <EmptyState Message="No blocking issues detected." />
                }
            </ManagementSection>
        }

        <ManagementSection Title="Procedures"
                           Layer="ManagementSection.UiLayer.Detail"
                           Help="Module-declared operator actions (ADR-0029). Availability and launchability come from the server; blocked reasons explain what must change.">
            @if (_procedureLoading)
            {
                <LoadingState Message="Loading procedures…" />
            }
            else if (!string.IsNullOrEmpty(_procedureError))
            {
                <ErrorState Title="Procedure error" Message="@_procedureError" />
            }
            else if (_procedureList is null)
            {
                <EmptyState Message="No procedure data." />
            }
            else if (_procedureList.Procedures.Count == 0)
            {
                <EmptyState Message="This module declares no procedures." />
            }
            else
            {
                @if (!_procedureList.IntegrationReady)
                {
                    <PageMessage Kind="PageMessageKind.Warning"
                                 Message="Integration is not runnable; procedures are listed but launch is blocked until readiness passes." />
                }
                <div class="flex flex-wrap gap-2 mb-3">
                    @foreach (var p in _procedureList.Procedures)
                    {
                        <button type="button"
                                class="rounded px-2 py-1 text-xs font-mono @(string.Equals(_selectedProcedureId, p.Id, StringComparison.Ordinal) ? "bg-body text-surface" : "bg-surface-muted text-body hover:bg-surface")"
                                @onclick="() => SelectProcedureAsync(p.Id)">
                            @p.DisplayName
                            @if (!p.Launchable)
                            {
                                <span class="ml-1 text-warning" title="Blocked">●</span>
                            }
                        </button>
                    }
                </div>
                @if (_selectedProcedureDetail is not null)
                {
                    <div class="rounded border border-default bg-surface-muted/30 p-3">
                        <div class="text-sm font-semibold text-heading">@_selectedProcedureDetail.DisplayName</div>
                        @if (!string.IsNullOrEmpty(_selectedProcedureDetail.Description))
                        {
                            <div class="text-xs text-muted mt-1">@_selectedProcedureDetail.Description</div>
                        }
                        <div class="text-xs text-muted mt-1 font-mono">@_selectedProcedureDetail.Id · @_selectedProcedureDetail.LaunchKind → @_selectedProcedureDetail.TargetDefinitionId</div>
                        @if (!_selectedProcedureDetail.Launchable && _selectedProcedureDetail.BlockedReasonCodes.Count > 0)
                        {
                            <ul class="mt-2 list-disc pl-5 text-xs text-warning">
                                @foreach (var blockedCode in _selectedProcedureDetail.BlockedReasonCodes)
                                {
                                    <li><span class="font-mono">@blockedCode</span> — @DescribeBlockedReason(blockedCode)</li>
                                }
                            </ul>
                        }
                        <ProcedureParameterForm Fields="@_selectedProcedureDetail.ParameterFields" Values="@_procedureParamValues" />
                        <button type="button"
                                class="mt-3 rounded bg-body px-3 py-2 text-sm text-surface hover:bg-body/90 disabled:opacity-50"
                                disabled="@(_procedureLaunching || !_selectedProcedureDetail.Launchable)"
                                @onclick="LaunchSelectedProcedureAsync">
                            Launch
                        </button>
                    </div>
                }
            }
        </ManagementSection>

        <ManagementSection Title="Configuration"
                           Layer="ManagementSection.UiLayer.Detail"
                           Help="Module slots, instance settings, and connection bindings for this integration.">
            @if (_requiredSlots is { Length: > 0 })
            {
                <div class="mb-4">
                    <h3 class="text-xs font-semibold text-heading mb-2">Required slots</h3>
                    <p class="text-xs text-muted mb-2">Declared by the module for this integration.</p>
                    <ul class="space-y-1 text-sm">
                        @foreach (var slot in _requiredSlots)
                        {
                            var bound = _bindings?.Any(b => string.Equals(b.SlotName, slot.SlotName, StringComparison.Ordinal) && string.Equals(b.State, "Active", StringComparison.OrdinalIgnoreCase)) == true;
                            <li class="flex justify-between gap-2">
                                <span class="font-mono">@slot.SlotName</span>
                                <span class="text-muted text-xs">@slot.ContractType</span>
                                <StatusPill Label="@(bound ? "Bound" : "Unbound")"
                                            Semantic="@(bound ? ManagementStatusSemantic.Success : ManagementStatusSemantic.Warning)" />
                            </li>
                        }
                    </ul>
                </div>
            }

            <div class="mb-4">
                <h3 class="text-xs font-semibold text-heading mb-2">Module instance settings</h3>
                <p class="text-xs text-muted mb-2">Key-value pairs. Module-specific schema support is deferred.</p>
                @if (_integration.Settings is { Count: > 0 })
                {
                    <div class="space-y-2">
                        @foreach (var kv in _integration.Settings)
                        {
                            <div class="flex items-center gap-2 text-sm">
                                <span class="font-mono text-body">@kv.Key</span>
                                <span class="text-muted">=</span>
                                <span class="text-body">@kv.Value</span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <EmptyState Message="No settings configured." />
                }
                @if (_capabilities?.CanManageIntegrations == true)
                {
                    @if (_editingSettings)
                    {
                        <div class="mt-3 space-y-2">
                            @for (var i = 0; i < _settingsEditList.Count; i++)
                            {
                                var idx = i;
                                var item = _settingsEditList[idx];
                                <div class="flex gap-2 items-center">
                                    <input class="rounded border border-default bg-surface px-2 py-1 text-sm font-mono flex-1 min-w-0" value="@item.Key" @oninput="e => UpdateSettingKey(idx, e.Value?.ToString())" placeholder="Key" />
                                    <input class="rounded border border-default bg-surface px-2 py-1 text-sm flex-1 min-w-0" value="@item.Value" @oninput="e => UpdateSettingValue(idx, e.Value?.ToString())" placeholder="Value" />
                                    <button type="button" class="rounded bg-destructive/20 px-2 py-1 text-xs text-destructive-fg hover:bg-destructive/30" @onclick="() => RemoveSettingEditAt(idx)">Remove</button>
                                </div>
                            }
                            <div class="flex gap-2">
                                <button type="button" class="rounded bg-surface-muted px-2 py-1 text-sm text-body hover:bg-surface" @onclick="AddSettingRow">Add row</button>
                                <button type="button" class="rounded bg-body px-2 py-1 text-sm text-surface hover:bg-body/90 disabled:opacity-50" @onclick="SaveSettingsAsync" disabled="@_settingsSaving">Save</button>
                                <button type="button" class="rounded bg-surface-muted px-2 py-1 text-sm text-body hover:bg-surface" @onclick="CancelSettingsEdit">Cancel</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <button type="button" class="mt-2 rounded bg-surface-muted px-2 py-1 text-sm text-body hover:bg-surface" @onclick="StartSettingsEdit">Edit settings</button>
                    }
                }
            </div>

            <div>
                <h3 class="text-xs font-semibold text-heading mb-2">Connection bindings</h3>
                <p class="text-xs text-muted mb-2">Bindings belong to this Integration. Managed from this page.</p>
                @if (_bindings is { Count: > 0 })
                {
                    <ul class="space-y-1">
                        @foreach (var b in _bindings)
                        {
                            <li class="flex items-center justify-between gap-2">
                                <div>
                                    <DrillInLink Href="@("/connections/" + Uri.EscapeDataString(b.ConnectionId ?? ""))">@b.SlotName</DrillInLink>
                                    <span class="text-muted text-xs ml-1">@b.ContractType</span>
                                    @if (!string.IsNullOrEmpty(b.ConnectionId))
                                    {
                                        <span class="text-muted text-xs">→ @b.ConnectionId</span>
                                        @if (_bindingVerificationByConnectionId.TryGetValue(b.ConnectionId, out var verificationState))
                                        {
                                            <span class="text-muted text-xs">· Verify: @verificationState</span>
                                        }
                                    }
                                </div>
                                @if (_capabilities?.CanManageIntegrations == true)
                                {
                                    <button type="button" class="rounded bg-destructive/20 px-2 py-0.5 text-xs text-destructive-fg hover:bg-destructive/30" @onclick="() => RemoveBindingAsync(b)">Remove</button>
                                }
                            </li>
                        }
                    </ul>
                }
                else
                {
                    <EmptyState Message="No bindings." />
                }
                @if (_capabilities?.CanManageIntegrations == true)
                {
                    @if (_addingBinding)
                    {
                        <div class="mt-3 rounded border border-default bg-surface-muted p-3 space-y-3">
                            @if (!string.IsNullOrEmpty(_bindingError))
                            {
                                <PageMessage Kind="PageMessageKind.Warning" Message="@_bindingError" />
                            }
                            <div>
                                <label class="block text-xs text-muted">Slot</label>
                                <select class="mt-1 w-full rounded border border-default bg-surface px-2 py-1 text-sm" @bind="_bindingSlot" @bind:after="OnBindingSlotChanged">
                                    <option value="">Select…</option>
                                    @if (_moduleSlots is not null)
                                    {
                                        @foreach (var s in _moduleSlots)
                                        {
                                            <option value="@s.SlotName">@s.SlotName (@s.ContractType)</option>
                                        }
                                    }
                                </select>
                            </div>
                            <div>
                                <label class="block text-xs text-muted">Connection</label>
                                <select class="mt-1 w-full rounded border border-default bg-surface px-2 py-1 text-sm" @bind="_bindingConnectionId">
                                    <option value="">Select…</option>
                                    @if (_eligibleConnections is not null)
                                    {
                                        @foreach (var c in _eligibleConnections)
                                        {
                                            <option value="@c.Id">@c.Name</option>
                                        }
                                    }
                                </select>
                                @if (!string.IsNullOrEmpty(_bindingSlot) && (_eligibleConnections?.Count ?? 0) == 0)
                                {
                                    <div class="mt-1 text-xs text-warning">
                                        No compatible connection currently exists for this slot. Create one in flow, then bind it immediately.
                                    </div>
                                }
                            </div>
                            @if (_addingConnectionInFlow)
                            {
                                <div class="rounded border border-default bg-surface p-3 space-y-3">
                                    <div class="text-xs font-semibold text-heading">Create connection in flow</div>
                                    @if (!string.IsNullOrEmpty(_inFlowCreateError))
                                    {
                                        <PageMessage Kind="PageMessageKind.Warning" Message="@_inFlowCreateError" />
                                    }
                                    <div>
                                        <label class="block text-xs text-muted">Connector definition</label>
                                        <select class="mt-1 w-full rounded border border-default bg-surface px-2 py-1 text-sm" @bind="_inFlowConnectorDefinitionId" @bind:after="OnInFlowConnectorDefinitionChangedAsync">
                                            <option value="">Select…</option>
                                            @foreach (var def in _connectorDefinitions)
                                            {
                                                <option value="@def.Id">@def.Name (@def.Id)</option>
                                            }
                                        </select>
                                    </div>
                                    <div>
                                        <label class="block text-xs text-muted">Connection name</label>
                                        <input class="mt-1 w-full rounded border border-default bg-surface px-2 py-1 text-sm"
                                               @bind="_inFlowConnectionName"
                                               placeholder="e.g. Campus Nexus Production" />
                                    </div>
                                    @if (SelectedInFlowConnectorDefinition is not null)
                                    {
                                        <ConnectorConnectionFieldInputs Definition="SelectedInFlowConnectorDefinition"
                                                                        ConfigValues="_inFlowConfigValues"
                                                                        SecretValues="_inFlowSecretValues" />
                                    }
                                    <div class="flex gap-2">
                                        <button type="button"
                                                class="rounded bg-body px-2 py-1 text-sm text-surface hover:bg-body/90 disabled:opacity-50"
                                                disabled="@(_inFlowCreateSaving || string.IsNullOrWhiteSpace(_inFlowConnectorDefinitionId) || string.IsNullOrWhiteSpace(_inFlowConnectionName))"
                                                @onclick="CreateConnectionInFlowAsync">
                                            Create connection
                                        </button>
                                        <button type="button"
                                                class="rounded bg-surface-muted px-2 py-1 text-sm text-body hover:bg-surface"
                                                @onclick="CancelInFlowConnectionCreate">
                                            Cancel create
                                        </button>
                                    </div>
                                </div>
                            }
                            <div class="flex gap-2">
                                <button type="button" class="rounded bg-body px-2 py-1 text-sm text-surface hover:bg-body/90" @onclick="CreateBindingAsync" disabled="@(_bindingSaving || string.IsNullOrEmpty(_bindingSlot) || string.IsNullOrEmpty(_bindingConnectionId))">Add</button>
                                @if (_capabilities?.CanCreateConnections == true)
                                {
                                    <button type="button"
                                            class="rounded bg-surface-muted px-2 py-1 text-sm text-body hover:bg-surface"
                                            @onclick="StartInFlowConnectionCreateAsync"
                                            disabled="@_inFlowCreateSaving">
                                        Create connection
                                    </button>
                                }
                                <button type="button" class="rounded bg-surface-muted px-2 py-1 text-sm text-body hover:bg-surface" @onclick="CancelAddBinding">Cancel</button>
                            </div>
                        </div>
                    }
                    else
                    {
                        <button type="button" class="mt-2 rounded bg-surface-muted px-2 py-1 text-sm text-body hover:bg-surface" @onclick="StartAddBinding">Add binding</button>
                    }
                }
            </div>
        </ManagementSection>

        <div id="schedules">
        <ManagementSection Title="Schedules"
                           Layer="ManagementSection.UiLayer.Detail"
                           Help="Schedules associated with this integration.">
            @if (_schedules is { Count: > 0 })
            {
                <ul class="space-y-1">
                    @foreach (var s in _schedules)
                    {
                        <li class="flex items-center justify-between gap-2">
                            <DrillInLink Href="@("/schedules/" + Uri.EscapeDataString(s.Id))">@s.Name</DrillInLink>
                            <span class="text-muted text-xs">@s.RecurrenceExpression · @(s.Enabled ? "Enabled" : "Disabled")</span>
                        </li>
                    }
                </ul>
            }
            else
            {
                <EmptyState Message="No schedules." />
            }
            @if (_capabilities?.CanManageIntegrations == true)
            {
                @if (_addingSchedule)
                {
                    <div class="mt-3 rounded border border-default bg-surface-muted p-3 space-y-3">
                        <div>
                            <label class="block text-xs text-muted">Name</label>
                            <input class="mt-1 w-full rounded border border-default bg-surface px-2 py-1 text-sm" @bind="_scheduleName" placeholder="e.g. Daily sync" />
                        </div>
                        <div>
                            <label class="block text-xs text-muted">Cron expression</label>
                            <input class="mt-1 w-full rounded border border-default bg-surface px-2 py-1 text-sm font-mono" @bind="_scheduleCron" placeholder="0 0 * * *" />
                        </div>
                        <div>
                            <label class="block text-xs text-muted">Time zone</label>
                            <input class="mt-1 w-full rounded border border-default bg-surface px-2 py-1 text-sm" @bind="_scheduleTimeZone" placeholder="UTC" />
                        </div>
                        <div>
                            <label class="block text-xs text-muted">Workflow</label>
                            <select class="mt-1 w-full rounded border border-default bg-surface px-2 py-1 text-sm" @bind="_scheduleWorkflowId">
                                <option value="">Select…</option>
                                @if (_workflows is not null)
                                {
                                    @foreach (var w in _workflows)
                                    {
                                        <option value="@w.Id">@w.Name</option>
                                    }
                                }
                            </select>
                        </div>
                        <div class="flex gap-2">
                            <button type="button" class="rounded bg-body px-2 py-1 text-sm text-surface hover:bg-body/90" @onclick="CreateScheduleAsync" disabled="@(_scheduleSaving || string.IsNullOrWhiteSpace(_scheduleName) || string.IsNullOrWhiteSpace(_scheduleCron) || string.IsNullOrWhiteSpace(_scheduleWorkflowId))">Create</button>
                            <button type="button" class="rounded bg-surface-muted px-2 py-1 text-sm text-body hover:bg-surface" @onclick="CancelAddSchedule">Cancel</button>
                        </div>
                    </div>
                }
                else
                {
                    <button type="button" class="mt-2 rounded bg-surface-muted px-2 py-1 text-sm text-body hover:bg-surface" @onclick="StartAddSchedule">Add schedule</button>
                }
            }
        </ManagementSection>
        </div>

        <ManagementAdvancedSection Title="Identity, lineage, and diagnostics"
                                   Subtitle="Technical metadata and low-frequency troubleshooting context.">
            <div class="space-y-4">
                <div>
                    <h3 class="text-xs font-semibold text-heading mb-2">Identity</h3>
                    <div class="grid grid-cols-1 gap-2 md:grid-cols-2 text-sm">
                        <div>
                            <div class="text-xs text-muted">Integration id</div>
                            <div class="font-mono text-body break-all">@_integration.Id</div>
                        </div>
                        <div>
                            <div class="text-xs text-muted">Display name</div>
                            <div class="text-body">@_integration.DisplayName</div>
                        </div>
                        <div>
                            <div class="text-xs text-muted">Module definition</div>
                            <div class="font-mono text-body">@_integration.ModuleId</div>
                        </div>
                        <div>
                            <div class="text-xs text-muted">Scope key</div>
                            <div class="text-body">@(_integration.ScopeKey ?? "—")</div>
                        </div>
                        <div>
                            <div class="text-xs text-muted">Created</div>
                            <div class="text-body">@_integration.CreatedAt.ToString("yyyy-MM-dd HH:mm")</div>
                        </div>
                        <div>
                            <div class="text-xs text-muted">Updated</div>
                            <div class="text-body">@_integration.UpdatedAt.ToString("yyyy-MM-dd HH:mm")</div>
                        </div>
                    </div>
                </div>
                <div>
