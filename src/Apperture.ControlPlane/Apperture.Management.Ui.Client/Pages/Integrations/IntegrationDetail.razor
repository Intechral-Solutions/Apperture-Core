    protected override async Task OnInitializedAsync()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var rawQuery = uri.Query.StartsWith('?') ? uri.Query[1..] : uri.Query;
        var queryValues = rawQuery
            .Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Select(part => part.Split('=', 2))
            .ToDictionary(
                parts => Uri.UnescapeDataString(parts[0]),
                parts => parts.Length > 1 ? Uri.UnescapeDataString(parts[1]) : "",
                StringComparer.OrdinalIgnoreCase);
        _wizardMode = queryValues.TryGetValue("wizard", out var wizardVal)
            && string.Equals(wizardVal, "1", StringComparison.Ordinal);
        if (_wizardMode && queryValues.TryGetValue("step", out var stepVal))
            _wizard.NavigateTo(stepVal);

        try
        {
            _capabilities = await Capabilities.GetCapabilitiesAsync();
        }
        catch
        {
            _capabilities = new OperatorCapabilitiesDto(false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false);
        }
        _capabilitiesLoaded = true;
        RecomputeWizardStates();

        if (_capabilities?.CanViewIntegrations == true)
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_capabilities?.CanViewIntegrations != true || string.IsNullOrEmpty(IntegrationId)) return;
        _loading = true;
        _error = null;
        try
        {
            var detail = await Client.GetIntegrationOperatorDetailAsync(IntegrationId);
            if (detail is null)
            {
                _integration = null;
                _bindings = null;
                _schedules = null;
                _readiness = null;
                _requiredSlots = null;
                _procedureList = null;
                _procedureError = null;
                _selectedProcedureId = null;
                _selectedProcedureDetail = null;
                _procedureParamValues.Clear();
                _bindingVerificationByConnectionId.Clear();
            }
            else
            {
                _integration = new IntegrationDto(
                    detail.Id,
                    detail.DisplayName,
                    detail.ModuleId,
                    detail.ScopeKey,
                    detail.State,
                    detail.Settings,
                    detail.CreatedAt,
                    detail.UpdatedAt);
                _readiness = detail.Readiness;
                _requiredSlots = detail.RequiredSlots;
                _bindings = detail.Bindings.Select(b => new IntegrationBindingDto(
                    b.Id,
                    IntegrationId,
                    detail.ModuleId,
                    b.SlotName,
                    b.ContractType,
                    b.ConnectionId,
                    b.CapabilityId,
                    b.State)).ToList();
                _bindingVerificationByConnectionId.Clear();
                foreach (var b in detail.Bindings)
                {
                    if (!string.IsNullOrWhiteSpace(b.ConnectionId) && !string.IsNullOrWhiteSpace(b.ConnectionVerificationStatus))
                        _bindingVerificationByConnectionId[b.ConnectionId] = b.ConnectionVerificationStatus;
                }
                _schedules = detail.Schedules.Select(s => new ScheduleDto(
                    s.Id,
                    s.Name,
                    s.RecurrenceExpression,
                    "UTC",
                    s.Enabled,
                    0,
                    null,
                    1,
                    s.IntegrationId)).ToList();

                _procedureError = null;
                _procedureList = null;
                _selectedProcedureId = null;
                _selectedProcedureDetail = null;
                _procedureParamValues.Clear();
                _procedureLoading = true;
                try
                {
                    _procedureList = await Client.GetIntegrationProceduresAsync(IntegrationId);
                }
                catch (HttpRequestException ex)
                {
                    _procedureError = ex.Message;
                }
                finally
                {
                    _procedureLoading = false;
                }
            }
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            RecomputeWizardStates();
        }
    }

    private async Task SelectProcedureAsync(string procedureId)
    {
        _selectedProcedureId = procedureId;
        _selectedProcedureDetail = null;
        _procedureParamValues.Clear();
        _procedureError = null;
        try
        {
            _selectedProcedureDetail = await Client.GetIntegrationProcedureAsync(IntegrationId, procedureId);
            if (_selectedProcedureDetail is not null)
                ProcedureParameterForm.SeedValues(_selectedProcedureDetail.ParameterFields, _procedureParamValues);
        }
        catch (HttpRequestException ex)
        {
            _procedureError = ex.Message;
        }
    }

    private async Task LaunchSelectedProcedureAsync()
    {
        if (string.IsNullOrEmpty(_selectedProcedureId) || _selectedProcedureDetail is null)
            return;
        _procedureLaunching = true;
        _procedureError = null;
        try
        {
            var outcome = await Client.LaunchIntegrationProcedureAsync(
                IntegrationId,
                _selectedProcedureId,
                _procedureParamValues,
                null,
                null);
            if (!outcome.Succeeded || outcome.Result is null)
            {
                var detail = string.IsNullOrEmpty(outcome.ErrorMessage)
                    ? $"HTTP {outcome.StatusCode}"
                    : $"{outcome.ErrorCode ?? "error"}: {outcome.ErrorMessage}";
                Toasts.Show(ToastSeverity.Error, $"Launch failed ({detail}).");
                return;
            }

            Toasts.Show(ToastSeverity.Success, "Run requested.");
            Nav.NavigateTo($"/runs/{outcome.Result.RunId}");
        }
        catch (HttpRequestException ex)
        {
            Toasts.Show(ToastSeverity.Error, ex.Message);
        }
        finally
        {
            _procedureLaunching = false;
        }
    }

