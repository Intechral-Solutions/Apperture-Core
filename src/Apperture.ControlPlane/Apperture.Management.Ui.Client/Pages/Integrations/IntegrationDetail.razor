    protected override async Task OnInitializedAsync()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var rawQuery = uri.Query.StartsWith('?') ? uri.Query[1..] : uri.Query;
        var queryValues = rawQuery
            .Split('&', StringSplitOptions.RemoveEmptyEntries)
            .Select(part => part.Split('=', 2))
            .ToDictionary(
                parts => Uri.UnescapeDataString(parts[0]),
                parts => parts.Length > 1 ? Uri.UnescapeDataString(parts[1]) : "",
                StringComparer.OrdinalIgnoreCase);
        _wizardMode = queryValues.TryGetValue("wizard", out var wizardVal)
            && string.Equals(wizardVal, "1", StringComparison.Ordinal);
        if (_wizardMode && queryValues.TryGetValue("step", out var stepVal))
            _wizard.NavigateTo(stepVal);

        try
        {
            _capabilities = await Capabilities.GetCapabilitiesAsync();
        }
        catch
        {
            _capabilities = new OperatorCapabilitiesDto(false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false, false);
        }
        _capabilitiesLoaded = true;
        RecomputeWizardStates();
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        await TryLoadForRouteAsync();
    }

    public void Dispose()
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
    }

    private int BeginLoad(string integrationId, out CancellationToken cancellationToken)
    {
        _loadCts?.Cancel();
        _loadCts?.Dispose();
        _loadCts = new CancellationTokenSource();
        cancellationToken = _loadCts.Token;
        return _loadGuard.Begin();
    }

    private async Task TryLoadForRouteAsync()
    {
        if (!_capabilitiesLoaded)
            return;

        if (string.IsNullOrWhiteSpace(IntegrationId))
            return;

        var key = IntegrationId;
        if (string.Equals(key, _dataLoadKey, StringComparison.Ordinal)
            || string.Equals(key, _inFlightLoadKey, StringComparison.Ordinal))
        {
            return;
        }

        _inFlightLoadKey = key;
        _integration = null;
        _bindings = null;
        _schedules = null;
        _readiness = null;
        _error = null;

        try
        {
            var generation = BeginLoad(key, out var cancellationToken);
            if (_capabilities?.CanViewIntegrations == true)
                await LoadAsync(generation, key, cancellationToken);
        }
        finally
        {
            if (string.Equals(_inFlightLoadKey, key, StringComparison.Ordinal))
                _inFlightLoadKey = null;
        }
    }

    private Task RefreshAsync()
    {
        _dataLoadKey = null;
        return TryLoadForRouteAsync();
    }

    private Task ReloadAfterActionAsync()
    {
        var generation = BeginLoad(IntegrationId, out var cancellationToken);
        return LoadAsync(generation, IntegrationId, cancellationToken, preserveActionFeedback: true);
    }

    private void SetActionFeedback(string message, PageMessageKind kind = PageMessageKind.Info)
    {
        _actionMessage = message;
