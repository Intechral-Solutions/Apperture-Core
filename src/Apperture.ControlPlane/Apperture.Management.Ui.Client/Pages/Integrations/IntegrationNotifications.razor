    private ExpectedRunMissingCutoverReadinessState ReadinessState =>
        ExpectedRunMissingCutoverReadiness.ResolveState(_parityEvaluated, _parityAcceptance);

    private string ReadinessLabel => ExpectedRunMissingCutoverReadiness.GetLabel(ReadinessState);

    private string ReadinessBadgeClass => ReadinessState switch
    {
        ExpectedRunMissingCutoverReadinessState.LooksAcceptableForCutover => "bg-green-500/10",
        ExpectedRunMissingCutoverReadinessState.NotReadyForCutover => "bg-red-500/10",
        ExpectedRunMissingCutoverReadinessState.NeedsReview => "bg-amber-500/10",
        _ => "bg-surface-muted",
    };

    private string IntegrationStatusSummary =>
        ExpectedRunMissingCutoverReadiness.GetIntegrationNotificationStatusSummary(
            _builtInDefinitionEnabled,
            _recentPlatformInstanceCount,
            ReadinessState);

    private bool CanSignOffReady =>
        ReadinessState is ExpectedRunMissingCutoverReadinessState.LooksAcceptableForCutover
        or ExpectedRunMissingCutoverReadinessState.NeedsReview;

    private bool SignOffIsStale =>
        _cutoverValidation?.SignOffIsStale == true
        || (_latestSignOff is not null
            && _configDiagnostics is not null
            && ExpectedRunMissingCutoverSignOffUi.HasStaleness(_latestSignOff, _parityAcceptance, _configDiagnostics));

    private IReadOnlyList<ChecklistItem> CutoverChecklist
    {
        get
        {
            var cfg = _configDiagnostics;
            var parityOk = _parityAcceptance?.LooksAcceptableForCutover == true;
            return
            [
                new("Platform events enabled", cfg?.PlatformEventsEnabled == true, false),
                new("Notification evaluation enabled", cfg?.EvaluationEnabled == true, false),
                new("Notification instances enabled", cfg?.InstancesEnabled == true, false),
                new("Dry-run reviewed (delivery off or logs reviewed)", cfg?.DeliveryEnabled == false, true),
                new("Parity acceptance reviewed", _parityEvaluated && parityOk, _parityAcceptance is null),
                new("Delivery tested in dev/staging", false, true),
                new("Operator sign-off completed",
                    _latestSignOff?.Status == "readyForCutover",
                    _latestSignOff is null),
                new("UsePlatformPipeline only enabled after acceptance",
                    cfg?.UsePlatformPipelineEnabled != true || parityOk,
                    cfg?.UsePlatformPipelineEnabled == true && !parityOk),
            ];
        }
    }

    private IEnumerable<(string Id, string Label)> RecipientOptions => _addKind switch
    {
        "operational_team" => _teams.Select(t => (t.Id, $"{t.Name} ({t.Id})")),
        "managed_contact" => _contacts.Select(c => (c.Id, $"{c.DisplayName} ({c.Id})")),
        _ => _users.Select(u => (u.UserId, $"{u.DisplayName} ({u.UserId})"))
    };

    protected override async Task OnInitializedAsync()
    {
        var caps = await Capabilities.GetCapabilitiesAsync();
        _canView = caps.CanViewIntegrations && caps.CanViewNotificationDefinitions;
        _canManageSubscriptions = caps.CanUpdateIntegrations && caps.CanManageNotificationDefinitions;
        _canManageContacts = caps.CanManageManagedContacts;
        _capabilitiesLoaded = true;
        if (!_canView)
        {
            _loading = false;
            return;
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _busy = true;
        _error = null;
        try
        {
            var integration = await Client.GetIntegrationAsync(IntegrationId);
            _integrationName = integration?.DisplayName;

            var scoped = await Client.ListNotificationDefinitionsAsync(integrationId: IntegrationId, take: 100);
            var builtIn = await Client.GetNotificationDefinitionAsync(BuiltInExpectedRunMissingDefinitionId);
            var merged = new Dictionary<string, NotificationDefinitionSummaryDto>(StringComparer.Ordinal);
            foreach (var d in scoped)
                merged[d.Id] = d;
            _builtInDefinitionEnabled = builtIn?.IsEnabled;
            if (builtIn is not null)
            {
                merged[builtIn.Id] = new NotificationDefinitionSummaryDto(
                    builtIn.Id,
                    builtIn.DisplayName,
                    builtIn.Description,
                    builtIn.SourceKind,
                    builtIn.Origin,
                    builtIn.Scope,
                    builtIn.IntegrationId,
                    builtIn.PrimaryEventType,
                    builtIn.IsEnabled,
                    builtIn.DefaultSeverity,
                    builtIn.UpdatedAtUtc);
            }

            var diag = await Client.GetNotificationIntegrationDiagnosticsAsync(IntegrationId, take: 50);
            _instances = diag.RecentInstances.ToList();
            _recentPlatformInstanceCount = _instances.Count;
            var listInstances = await Client.ListNotificationInstancesAsync(integrationId: IntegrationId, take: 100);
            var instanceCounts = listInstances
                .GroupBy(i => i.NotificationDefinitionId)
                .ToDictionary(g => g.Key, g => g.Count());

            var mutabilityById = new Dictionary<string, string>(StringComparer.Ordinal);
            if (builtIn is not null)
                mutabilityById[builtIn.Id] = builtIn.Mutability;
            foreach (var d in scoped)
            {
                if (mutabilityById.ContainsKey(d.Id))
                    continue;
                var detail = await Client.GetNotificationDefinitionAsync(d.Id);
                mutabilityById[d.Id] = detail?.Mutability ?? "—";
            }

            _definitions = merged.Values
                .OrderBy(d => d.DisplayName)
                .Select(d => new DefinitionRow(
                    d,
                    mutabilityById.GetValueOrDefault(d.Id, "—"),
                    instanceCounts.GetValueOrDefault(d.Id)))
                .ToList();

            if (_definitions.Count > 0 && !_definitions.Any(x => x.Summary.Id == _addDefinitionId))
                _addDefinitionId = _definitions[0].Summary.Id;

            _explicitSubscriptions = (await Client.ListNotificationSubscriptionsByIntegrationAsync(IntegrationId)).ToList();
            _attentionRouting = await Client.GetIntegrationAttentionRoutingAsync(IntegrationId);

            _outboxRows = diag.RecentFailedDeliveries
                .Concat(diag.RecentOutboxRows.Where(r => r.Status is "pending" or "delivering"))
                .Take(50)
                .ToList();

            if (_canManageSubscriptions)
            {
                var userPage = await Client.GetUserPageAsync(0, 200);
                _users = userPage.Items;
                _teams = await Client.ListOperationalTeamsAsync(includeDisabled: false);
                _contacts = await Client.ListManagedContactsAsync(null, 200) ?? [];
            }

            await LoadCutoverReadinessAsync();
            await ApplyPostCreateContextAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _busy = false;
            _loading = false;
        }
    }

    private async Task ApplyPostCreateContextAsync()
    {
        if (string.IsNullOrWhiteSpace(CreatedDefinitionIdQuery))
            return;

        var createdId = CreatedDefinitionIdQuery.Trim();
        if (!_definitions.Any(d => string.Equals(d.Summary.Id, createdId, StringComparison.Ordinal)))
            return;

        _postCreateDefinitionId = createdId;
        _addDefinitionId = createdId;
        _previewDefinitionId = createdId;
        _showPostCreatePrompt = true;
        await ResolveRecipientsAsync();
    }

    private async Task LoadCutoverReadinessAsync()
    {
        var wasBusy = _busy;
        if (!wasBusy)
        {
            _busy = true;
            _error = null;
        }

        try
        {
            try
            {
                _configDiagnostics = await Client.GetNotificationConfigurationDiagnosticsAsync();
            }
            catch
            {
                // Configuration diagnostics require platform notification read; page remains usable without flags.
            }

            _parityEvaluated = true;
            _parityAcceptance = await Client.GetExpectedRunMissingParityAcceptanceAsync(IntegrationId, maxIncidents: 10);
            if (_parityAcceptance is not null)
                _parityDetail = await Client.GetExpectedRunMissingParityAsync(IntegrationId, take: 50);
            else
                _parityDetail = null;

            try
            {
                _latestSignOff = await Client.GetExpectedRunMissingCutoverSignOffAsync(IntegrationId);
            }
            catch
            {
                _latestSignOff = null;
            }

            try
            {
                _cutoverValidation = await Client.GetExpectedRunMissingCutoverValidationAsync(IntegrationId);
            }
            catch
            {
                _cutoverValidation = null;
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            if (!wasBusy)
                _busy = false;
        }
    }

    private async Task SignOffReadyAsync() =>
        await SubmitSignOffAsync("readyForCutover");

    private async Task SignOffNotReadyAsync() =>
        await SubmitSignOffAsync("notReady");

    private async Task SubmitSignOffAsync(string status)
    {
        if (!_canManageSubscriptions) return;
        _busy = true;
        _error = null;
        try
        {
            _latestSignOff = await Client.CreateExpectedRunMissingCutoverSignOffAsync(
                IntegrationId,
                new CreateExpectedRunMissingCutoverSignOffRequestDto(status, string.IsNullOrWhiteSpace(_signOffNote) ? null : _signOffNote.Trim()));
            _signOffNote = "";
            await LoadCutoverReadinessAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task RevokeSignOffAsync()
    {
        if (!_canManageSubscriptions) return;
        _busy = true;
        _error = null;
        try
        {
            _latestSignOff = await Client.RevokeExpectedRunMissingCutoverSignOffAsync(
                IntegrationId,
                new RevokeExpectedRunMissingCutoverSignOffRequestDto(string.IsNullOrWhiteSpace(_signOffNote) ? null : _signOffNote.Trim()));
            _signOffNote = "";
            await LoadCutoverReadinessAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private static string FlagLabel(bool enabled) => enabled ? "Enabled" : "Disabled";

    private async Task ToggleDefinitionAsync(string definitionId, ChangeEventArgs e)
    {
        if (!_canManageSubscriptions) return;
        _busy = true;
        try
        {
            await Client.SetNotificationDefinitionEnabledAsync(definitionId, ParseCheckbox(e));
            await LoadAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task AddSubscriptionAsync()
    {
        if (!_canManageSubscriptions || string.IsNullOrWhiteSpace(_addRef) || string.IsNullOrWhiteSpace(_addDefinitionId)) return;
        _busy = true;
        try
        {
            await Client.AddNotificationSubscriptionAsync(
                _addDefinitionId,
                new AddNotificationSubscriptionRequest(IntegrationId, _addKind, _addRef, null, _createContactIfMissing, _addDeliveryMode));
            _explicitSubscriptions = (await Client.ListNotificationSubscriptionsByIntegrationAsync(IntegrationId)).ToList();
            _addRef = "";
            _previewDefinitionId = _addDefinitionId;
            await ResolveRecipientsAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task PatchSubscriptionEnabledAsync(NotificationSubscriptionDto s, ChangeEventArgs e)
    {
        if (!_canManageSubscriptions) return;
        _busy = true;
        try
        {
            await Client.PatchNotificationSubscriptionAsync(
                s.NotificationDefinitionId,
                s.Id,
                new PatchNotificationSubscriptionRequest(ParseCheckbox(e), null));
            _explicitSubscriptions = (await Client.ListNotificationSubscriptionsByIntegrationAsync(IntegrationId)).ToList();
            if (string.Equals(s.NotificationDefinitionId, _previewDefinitionId, StringComparison.Ordinal))
                await ResolveRecipientsAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task PatchSubscriptionDeliveryModeAsync(NotificationSubscriptionDto s, ChangeEventArgs e)
    {
        if (!_canManageSubscriptions) return;
        var mode = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(mode)) return;
        _busy = true;
        try
        {
            await Client.PatchNotificationSubscriptionAsync(
                s.NotificationDefinitionId,
                s.Id,
                new PatchNotificationSubscriptionRequest(null, mode));
            _explicitSubscriptions = (await Client.ListNotificationSubscriptionsByIntegrationAsync(IntegrationId)).ToList();
            if (string.Equals(s.NotificationDefinitionId, _previewDefinitionId, StringComparison.Ordinal))
                await ResolveRecipientsAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task RemoveSubscriptionAsync(NotificationSubscriptionDto s)
    {
        if (!_canManageSubscriptions) return;
        _busy = true;
        try
        {
            await Client.RemoveNotificationSubscriptionAsync(s.NotificationDefinitionId, s.Id);
            _explicitSubscriptions = (await Client.ListNotificationSubscriptionsByIntegrationAsync(IntegrationId)).ToList();
            if (string.Equals(s.NotificationDefinitionId, _previewDefinitionId, StringComparison.Ordinal))
                await ResolveRecipientsAsync();
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private async Task ResolveRecipientsAsync()
    {
        if (string.IsNullOrWhiteSpace(_previewDefinitionId)) return;
        _busy = true;
        try
        {
            _resolution = await Client.ResolveNotificationRecipientsAsync(
                _previewDefinitionId,
                new ResolveNotificationRecipientsRequest(IntegrationId));
            _recipientPreviewRefreshedAt = DateTimeOffset.UtcNow;
        }
        catch (Exception ex) { _error = ex.Message; }
        finally { _busy = false; }
    }

    private string GetDefinitionDisplayName(string definitionId) =>
        _definitions.FirstOrDefault(d => string.Equals(d.Summary.Id, definitionId, StringComparison.Ordinal))?.Summary.DisplayName
        ?? definitionId;

    private static bool ParseCheckbox(ChangeEventArgs e) =>
        e.Value is bool b ? b : string.Equals(e.Value?.ToString(), "true", StringComparison.OrdinalIgnoreCase);

    private static string RecipientSourceLabel(string? source) => NotificationRecipientSourceLabels.Label(source);

    private bool IsPostCreateDefinition(string definitionId) =>
        !string.IsNullOrWhiteSpace(_postCreateDefinitionId)
        && string.Equals(_postCreateDefinitionId, definitionId, StringComparison.Ordinal);

    private bool HasExplicitSubscriptions(string definitionId) =>
        _explicitSubscriptions.Any(s => string.Equals(s.NotificationDefinitionId, definitionId, StringComparison.Ordinal));

    private bool HasAttentionRoutingRecipients =>
        _attentionRouting is not null
        && (_attentionRouting.PrimaryRecipients.Count > 0 || _attentionRouting.EscalationRecipients.Count > 0);

    private string GetEmptySubscriptionsMessage(string definitionId)
    {
        var row = _definitions.FirstOrDefault(d => string.Equals(d.Summary.Id, definitionId, StringComparison.Ordinal));
        if (row is null)
            return "Add explicit subscriptions so platform delivery can create outbox rows for this definition.";

        if (string.Equals(definitionId, BuiltInExpectedRunMissingDefinitionId, StringComparison.Ordinal))
        {
            if (HasAttentionRoutingRecipients)
                return "Epic 69 attention routing may still supply implicit compatibility recipients for this integration. Add explicit subscriptions for platform pipeline delivery.";
            return "Add explicit subscriptions for platform pipeline delivery of expected-run-missing notifications.";
        }

        if (string.Equals(row.Summary.Origin, "userCreated", StringComparison.OrdinalIgnoreCase))
            return "No recipients are configured. Platform delivery will not create outbox rows until you add at least one explicit subscription.";

        return "Add explicit subscriptions so platform delivery can create outbox rows for this definition.";
    }

    private Task FocusSubscriptionsAsync()
    {
        if (!string.IsNullOrWhiteSpace(_postCreateDefinitionId))
            _addDefinitionId = _postCreateDefinitionId;
        Nav.NavigateTo($"/integrations/{Uri.EscapeDataString(IntegrationId)}/notifications#explicit-subscriptions", replace: true);
        return Task.CompletedTask;
    }

    private async Task PreviewPostCreateRecipientsAsync()
    {
        if (!string.IsNullOrWhiteSpace(_postCreateDefinitionId))
            _previewDefinitionId = _postCreateDefinitionId;
        await ResolveRecipientsAsync();
    }

    private Task DismissPostCreatePromptAsync()
    {
        _showPostCreatePrompt = false;
        CreatedDefinitionIdQuery = null;
        Nav.NavigateTo($"/integrations/{Uri.EscapeDataString(IntegrationId)}/notifications", replace: true);
        return Task.CompletedTask;
    }

    private sealed record DefinitionRow(
        NotificationDefinitionSummaryDto Summary,
        string Mutability,
        int RecentInstanceCount);

    private sealed record ChecklistItem(string Label, bool IsSatisfied, bool IsManual);
