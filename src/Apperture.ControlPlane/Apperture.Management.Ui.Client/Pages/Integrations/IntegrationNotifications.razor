@page "/integrations/{IntegrationId}/notifications"
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Molecules
@using Apperture.Management.Ui.Client.Organisms
@using Apperture.Management.Ui.Client.Organisms.Notifications
@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Shared
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities
@inject NavigationManager Nav

<div class="p-4">
    <div class="flex items-center justify-between gap-3">
        <div class="min-w-0">
            <div class="text-xs text-muted mb-1">
                <a class="underline" href="/integrations">Integrations</a>
                · <a class="underline" href="@($"/integrations/{Uri.EscapeDataString(IntegrationId)}")">@(_integrationName ?? IntegrationId)</a>
                · Notifications
            </div>
            <h1 class="text-xl font-semibold text-heading">Integration notifications</h1>
            <div class="mt-1 font-mono text-xs text-muted break-all">@IntegrationId</div>
        </div>
        <div class="flex flex-wrap gap-2">
            <a href="@($"/integrations/{Uri.EscapeDataString(IntegrationId)}")" class="rounded bg-surface-muted px-3 py-2 text-sm">Integration detail</a>
            <a href="@($"/integrations/{Uri.EscapeDataString(IntegrationId)}/schedule-diagnostics")" class="rounded bg-surface-muted px-3 py-2 text-sm">Schedule diagnostics</a>
            <a href="@ConfigDiagnosticsHref" class="rounded bg-surface-muted px-3 py-2 text-sm">Full diagnostics</a>
            <button type="button" class="rounded bg-surface-muted px-3 py-2 text-sm disabled:opacity-50" disabled="@_busy" @onclick="LoadAsync">Refresh</button>
        </div>
    </div>

    @if (!_capabilitiesLoaded)
    {
        <LoadingState Message="Loading…" />
    }
    else if (!_canView)
    {
        <div class="mt-4">
            <ForbiddenState Message="Requires integration read and notification definition read." />
        </div>
    }
    else if (_loading)
    {
        <LoadingState Message="Loading…" />
    }
    else
    {
        <p class="mt-4 text-xs text-muted">Read-only cutover readiness and diagnostics. Enabling the platform pipeline or delivery is manual per the runbook — nothing on this page changes flags or sends mail.</p>

        <NotificationDefinitionPostCreatePrompt Visible="@_showPostCreatePrompt"
                                                CanManageSubscriptions="@_canManageSubscriptions"
                                                Disabled="@_busy"
                                                ViewDefinitionHref="@PostCreateViewDefinitionHref"
                                                OnAddSubscription="FocusSubscriptionsAsync"
                                                OnPreviewRecipients="PreviewPostCreateRecipientsAsync"
                                                OnDismiss="DismissPostCreatePromptAsync" />

        <section class="mt-4 rounded border border-default bg-surface p-3" id="cutover-readiness">
            <div class="flex flex-wrap items-start justify-between gap-2">
                <h2 class="text-sm font-semibold text-heading">Expected-run-missing cutover readiness</h2>
                <div class="flex flex-wrap gap-2 text-xs">
                    <a class="underline" href="@ConfigDiagnosticsHref">Config diagnostics</a>
                    <span class="text-muted">·</span>
                    <span class="text-muted font-mono" title="Repository runbook path">@ExpectedRunMissingCutoverReadiness.RunbookDocPath</span>
                </div>
            </div>
            <p class="mt-1 text-xs text-muted">
                Compare Epic 69 attention notifications with the Epic 77 platform pipeline before setting
                <code class="font-mono">Notifications:UsePlatformPipeline</code>. Cutover is not automatic.
            </p>

            <div class="mt-3 p-2 rounded text-sm @ReadinessBadgeClass">
                <div class="font-semibold">@ReadinessLabel</div>
                <p class="mt-1 text-xs">@IntegrationStatusSummary</p>
            </div>

            @if (_cutoverValidation is not null)
            {
                <div class="mt-3 rounded border border-default bg-surface-muted/50 p-2 text-xs">
                    <div class="font-semibold text-heading">Staging cutover validation</div>
                    <p class="mt-1 text-muted">Read-only — flags are not changed by this summary.</p>
                    <ul class="mt-2 space-y-1">
                        @foreach (var label in _cutoverValidation.OperatingModeLabels)
                        {
                            <li><span class="font-medium">Mode:</span> @label</li>
                        }
                    </ul>
                    @if (_cutoverValidation.ReadinessBlockers.Count > 0)
                    {
                        <p class="mt-2 font-medium">Readiness blockers</p>
                        <ul class="list-disc list-inside text-muted">
                            @foreach (var b in _cutoverValidation.ReadinessBlockers) { <li>@b</li> }
                        </ul>
                    }
                    @if (_cutoverValidation.HasRecipientParityGap)
                    {
                        <p class="mt-2 rounded border border-amber-500/40 bg-amber-500/10 p-2">
                            Recipient parity gap: @_cutoverValidation.RecipientsMissingInPlatform recipient(s) appear in Epic 69 but not in platform subscriptions.
                            Convert external operational-team emails to managed contacts before cutover.
                        </p>
                    }
                    @if (_cutoverValidation.HasUnresolvedFailedOutbox)
                    {
                        <p class="mt-2 text-muted">@_cutoverValidation.RecentFailedOutboxCount failed platform outbox row(s) in the recent window.</p>
                    }
                    @if (_cutoverValidation.RecentSucceededOutboxCount > 0)
                    {
                        <p class="mt-1 text-muted">@_cutoverValidation.RecentSucceededOutboxCount recent succeeded platform delivery row(s).</p>
                    }
                </div>
            }

            @if (_configDiagnostics is not null)
            {
                <dl class="mt-3 grid grid-cols-2 md:grid-cols-5 gap-2 text-xs">
                    <div><dt class="text-muted">Platform events</dt><dd>@FlagLabel(_configDiagnostics.PlatformEventsEnabled)</dd></div>
                    <div><dt class="text-muted">Evaluation</dt><dd>@FlagLabel(_configDiagnostics.EvaluationEnabled)</dd></div>
                    <div><dt class="text-muted">Instances</dt><dd>@FlagLabel(_configDiagnostics.InstancesEnabled)</dd></div>
                    <div><dt class="text-muted">Delivery</dt><dd>@FlagLabel(_configDiagnostics.DeliveryEnabled)</dd></div>
                    <div><dt class="text-muted">Use platform pipeline</dt><dd>@FlagLabel(_configDiagnostics.UsePlatformPipelineEnabled)</dd></div>
                </dl>
                <ExpectedRunMissingCutoverConfigWarnings Configuration="_configDiagnostics" />
            }

            @if (_parityEvaluated && _parityAcceptance is not null)
            {
                <div class="mt-3 text-xs">
                    <p>
                        Parity evaluated @_parityAcceptance.GeneratedAtUtc.UtcDateTime.ToString("u") —
                        @_parityAcceptance.IncidentsEvaluated incident(s),
                        kinds aligned @_parityAcceptance.KindsAligned / @_parityAcceptance.KindComparisonsTotal,
                        recipients aligned @_parityAcceptance.RecipientsAligned / @_parityAcceptance.RecipientComparisonsTotal.
                    </p>
                    @if (_parityAcceptance.BlockingFindings.Count > 0)
                    {
                        <p class="mt-2 font-medium">Blocking findings</p>
                        <ul class="list-disc list-inside text-muted">
                            @foreach (var f in _parityAcceptance.BlockingFindings) { <li>@f</li> }
                        </ul>
                    }
                    @if (_parityAcceptance.NonBlockingFindings.Count > 0)
                    {
                        <p class="mt-2 font-medium">Non-blocking findings</p>
                        <ul class="list-disc list-inside text-muted">
                            @foreach (var f in _parityAcceptance.NonBlockingFindings) { <li>@f</li> }
                        </ul>
                    }
                </div>
            }
            else if (_parityEvaluated)
            {
                <p class="mt-3 text-xs text-muted">No recent expected-run-missing incidents with comparable Epic 69 and platform rows for this integration.</p>
            }

            <div class="mt-4 border-t border-default pt-3">
                <div class="text-xs font-semibold mb-2">Operator sign-off</div>
                <p class="text-xs text-muted mb-2">Sign-off records operator review for audit. It does not change configuration or enable cutover.</p>
                @if (_latestSignOff is not null)
                {
                    <dl class="grid grid-cols-1 md:grid-cols-2 gap-2 text-xs">
                        <div><dt class="text-muted">Status</dt><dd class="font-medium">@ExpectedRunMissingCutoverSignOffUi.GetStatusLabel(_latestSignOff.Status)</dd></div>
                        <div><dt class="text-muted">Reviewed</dt><dd>@_latestSignOff.ReviewedAtUtc.UtcDateTime.ToString("u") by @(_latestSignOff.ReviewedByDisplayName ?? _latestSignOff.ReviewedByActorId)</dd></div>
                        <div><dt class="text-muted">Parity at sign-off</dt><dd>@(_latestSignOff.ParityAcceptableAtReview ? "Acceptable" : "Not acceptable")</dd></div>
                        @if (!string.IsNullOrWhiteSpace(_latestSignOff.OperatorNote))
                        {
                            <div class="md:col-span-2"><dt class="text-muted">Note</dt><dd>@_latestSignOff.OperatorNote</dd></div>
                        }
                    </dl>
                    @if (SignOffIsStale)
                    {
                        <p class="mt-2 text-xs text-amber-600">Current parity or configuration warnings differ from this sign-off — review again before cutover.</p>
                    }
                }
                else
                {
                    <p class="text-xs text-muted">No sign-off recorded for this integration.</p>
                }
                @if (_canManageSubscriptions)
                {
                    <label class="mt-2 block text-xs">
                        Operator note (optional)
                        <textarea class="mt-1 block w-full max-w-xl rounded border border-default px-2 py-1 text-xs" rows="2" @bind="_signOffNote" disabled="@_busy"></textarea>
                    </label>
                    <div class="mt-2 flex flex-wrap gap-2">
                        <button type="button" class="rounded bg-green-600/20 px-3 py-1 text-xs disabled:opacity-50"
                                disabled="@(_busy || !CanSignOffReady)" @onclick="SignOffReadyAsync">
                            Sign off — ready for cutover
                        </button>
                        <button type="button" class="rounded bg-surface-muted px-3 py-1 text-xs disabled:opacity-50"
                                disabled="@_busy" @onclick="SignOffNotReadyAsync">
                            Record not ready
                        </button>
                        @if (_latestSignOff is not null && _latestSignOff.Status is not "revoked")
                        {
                            <button type="button" class="rounded bg-amber-500/20 px-3 py-1 text-xs disabled:opacity-50"
                                    disabled="@_busy" @onclick="RevokeSignOffAsync">
                                Revoke sign-off
                            </button>
                        }
                    </div>
                }
            </div>

            <div class="mt-3 flex flex-wrap gap-2 text-xs">
                <button type="button" class="rounded bg-surface-muted px-3 py-1 disabled:opacity-50" disabled="@_busy" @onclick="LoadCutoverReadinessAsync">Refresh readiness</button>
                @if (_parityDetail is not null)
                {
                    <details>
                        <summary class="cursor-pointer underline">Full parity detail</summary>
                        @foreach (var k in _parityDetail.ByKind)
                        {
                            <div class="mt-2 border-t border-default pt-1">@k.NotificationKind — @k.DifferenceKind: @k.Summary</div>
                        }
                    </details>
                }
            </div>

            <div class="mt-4 border-t border-default pt-3">
                <div class="text-xs font-semibold mb-2">Cutover checklist (display only)</div>
                <ul class="space-y-1 text-xs">
                    @foreach (var item in CutoverChecklist)
                    {
                        <li class="flex gap-2">
                            <span class="@(item.IsSatisfied ? "text-green-600" : "text-muted")">@(item.IsSatisfied ? "✓" : "○")</span>
                            <span>@item.Label@if (item.IsManual) { <span class="text-muted"> (confirm manually)</span> }</span>
                        </li>
                    }
                </ul>
            </div>
        </section>

        <section class="mt-4 rounded border border-default bg-surface p-3">
            <div class="flex flex-wrap items-center justify-between gap-2 mb-2">
                <h2 class="text-sm font-semibold text-heading">Notification definitions</h2>
                @if (_canManageSubscriptions)
                {
                    <a class="rounded bg-surface-muted px-3 py-1 text-xs hover:bg-surface"
                       href="@($"/integrations/{Uri.EscapeDataString(IntegrationId)}/notifications/definitions/new")">
                        Create definition
                    </a>
                }
            </div>
            @if (_definitions.Count == 0)
            {
                <p class="text-xs text-muted">No definitions apply to this integration.</p>
            }
            else
            {
                <table class="min-w-full text-left text-xs">
                    <thead class="text-muted">
                        <tr>
                            <th class="p-1">Name</th>
                            <th class="p-1">Id</th>
                            <th class="p-1">Origin</th>
                            <th class="p-1">Event</th>
                            <th class="p-1">Scope</th>
                            <th class="p-1">Mutability</th>
                            <th class="p-1">Enabled</th>
                            <th class="p-1">Recent instances</th>
                            <th class="p-1"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var d in _definitions)
                        {
                            <tr class="border-t border-default @(IsPostCreateDefinition(d.Summary.Id) ? "bg-amber-500/10 ring-1 ring-inset ring-amber-500/30" : "")"
                                id="@(IsPostCreateDefinition(d.Summary.Id) ? "created-definition-row" : null)">
                                <td class="p-1 font-medium">@d.Summary.DisplayName</td>
                                <td class="p-1 font-mono break-all">@d.Summary.Id</td>
                                <td class="p-1">@d.Summary.Origin</td>
                                <td class="p-1">@(d.Summary.PrimaryEventType ?? "—")</td>
                                <td class="p-1">@d.Summary.Scope</td>
                                <td class="p-1">@d.Mutability</td>
                                <td class="p-1">
                                    @if (_canManageSubscriptions)
                                    {
                                        <input type="checkbox" checked="@d.Summary.IsEnabled" disabled="@_busy" @onchange="e => ToggleDefinitionAsync(d.Summary.Id, e)" />
                                    }
                                    else
                                    {
                                        @(d.Summary.IsEnabled ? "Yes" : "No")
                                    }
                                </td>
                                <td class="p-1">@d.RecentInstanceCount</td>
                                <td class="p-1 space-x-2">
                                    <a class="underline" href="@NotificationUiRoutes.DefinitionDetail(d.Summary.Id)">Detail</a>
                                    @if (_canManageSubscriptions && string.Equals(d.Mutability, "fullyEditable", StringComparison.Ordinal))
                                    {
                                        <a class="underline" href="@NotificationUiRoutes.DefinitionEdit(d.Summary.Id)">Edit</a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>

        <section class="mt-4 rounded border border-default bg-surface p-3">
            <h2 class="text-sm font-semibold text-heading mb-2">Implicit recipients (attention routing compatibility)</h2>
            <p class="text-xs text-muted mb-2">Epic 69 attention routing — not platform notification subscriptions. Shown for parity only.</p>
            @if (_attentionRouting is null)
            {
                <p class="text-xs text-muted">No routing data.</p>
            }
            else
            {
                <dl class="grid grid-cols-1 gap-2 md:grid-cols-2 text-xs">
                    <div>
                        <dt class="text-muted">Primary (effective)</dt>
                        <dd>@(_attentionRouting.PrimaryRecipients.Count > 0 ? string.Join(", ", _attentionRouting.PrimaryRecipients) : "—")</dd>
                        <dd class="text-muted">@RecipientSourceLabel(_attentionRouting.PrimarySource)</dd>
                    </div>
                    <div>
                        <dt class="text-muted">Escalation (effective)</dt>
                        <dd>@(_attentionRouting.EscalationRecipients.Count > 0 ? string.Join(", ", _attentionRouting.EscalationRecipients) : "—")</dd>
                        <dd class="text-muted">@RecipientSourceLabel(_attentionRouting.EscalationSource)</dd>
                    </div>
                </dl>
            }
        </section>

        <section class="mt-4 rounded border border-default bg-surface p-3" id="explicit-subscriptions">
            <h2 class="text-sm font-semibold text-heading mb-2">Explicit subscriptions</h2>
            @if (_canManageSubscriptions)
            {
                <div class="mb-3 flex flex-wrap items-end gap-2 text-xs border-b border-default pb-3">
                    <label>
                        Definition
                        <select class="mt-1 block rounded border border-default px-2 py-1 font-mono" @bind="_addDefinitionId">
                            @foreach (var d in _definitions)
                            {
                                <option value="@d.Summary.Id">@d.Summary.DisplayName</option>
                            }
                        </select>
                    </label>
                    <label>
                        Kind
                        <select class="mt-1 block rounded border border-default px-2 py-1" @bind="_addKind">
                            <option value="principal">principal</option>
                            <option value="operational_team">operational_team</option>
                            <option value="managed_contact">managed_contact</option>
                        </select>
                    </label>
                    <label class="min-w-[10rem] flex-1">
                        Ref
                        <select class="mt-1 block w-full rounded border border-default px-2 py-1 font-mono" @bind="_addRef">
                            <option value="">— select —</option>
                            @foreach (var opt in RecipientOptions)
                            {
                                <option value="@opt.Id">@opt.Label</option>
                            }
                        </select>
                    </label>
                    <label>
                        Delivery mode
                        <select class="mt-1 block rounded border border-default px-2 py-1" @bind="_addDeliveryMode">
                            @foreach (var mode in NotificationDeliveryModeOptions.All)
                            {
                                <option value="@mode.Value">@mode.Label</option>
                            }
                        </select>
                    </label>
                    @if (_addKind == "managed_contact" && _canManageContacts)
                    {
                        <label class="flex items-center gap-1">
                            <input type="checkbox" @bind="_createContactIfMissing" />
                            Create contact if missing
                        </label>
                    }
                    <button type="button" class="rounded bg-surface-muted px-3 py-2 disabled:opacity-50" disabled="@_busy" @onclick="AddSubscriptionAsync">Add</button>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_addDefinitionId) && !HasExplicitSubscriptions(_addDefinitionId))
            {
                <div class="mb-3 rounded border border-default bg-surface-muted/50 p-2 text-xs">
                    <p class="font-medium text-heading">No explicit subscriptions yet</p>
                    <p class="mt-1 text-muted">@GetEmptySubscriptionsMessage(_addDefinitionId)</p>
                </div>
            }
            @if (_explicitSubscriptions.Count == 0)
            {
                <p class="text-xs text-muted">No explicit subscriptions for this integration.</p>
            }
            else
            {
                <table class="min-w-full text-left text-xs">
                    <thead class="text-muted">
                        <tr>
                            <th class="p-1">Definition</th>
                            <th class="p-1">Kind</th>
                            <th class="p-1">Ref</th>
                            <th class="p-1">Mode</th>
                            <th class="p-1">Enabled</th>
                            <th class="p-1"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in _explicitSubscriptions)
                        {
                            <tr class="border-t border-default">
                                <td class="p-1 font-mono break-all">
                                    <a class="underline" href="@NotificationUiRoutes.DefinitionDetail(s.NotificationDefinitionId)">@s.NotificationDefinitionId</a>
                                </td>
                                <td class="p-1">@s.RecipientKind</td>
                                <td class="p-1 font-mono">@s.RecipientRef</td>
                                <td class="p-1">
                                    @if (_canManageSubscriptions)
                                    {
                                        <select class="rounded border border-default px-1 py-0.5" value="@s.DeliveryMode" disabled="@_busy" @onchange="e => PatchSubscriptionDeliveryModeAsync(s, e)">
                                            @foreach (var mode in NotificationDeliveryModeOptions.All)
                                            {
                                                <option value="@mode.Value">@mode.Label</option>
                                            }
                                        </select>
                                    }
                                    else
                                    {
                                        @s.DeliveryMode
                                    }
                                </td>
                                <td class="p-1">
                                    @if (_canManageSubscriptions)
                                    {
                                        <input type="checkbox" checked="@s.IsEnabled" disabled="@_busy" @onchange="e => PatchSubscriptionEnabledAsync(s, e)" />
                                    }
                                    else
                                    {
                                        @(s.IsEnabled ? "Yes" : "No")
                                    }
                                </td>
                                <td class="p-1">
                                    @if (_canManageSubscriptions)
                                    {
                                        <button type="button" class="underline text-muted" disabled="@_busy" @onclick="() => RemoveSubscriptionAsync(s)">Remove</button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }

            <div class="mt-4 border-t border-default pt-3">
                <div class="text-xs font-semibold mb-2">Recipient resolution preview</div>
                <p class="text-xs text-muted mb-2">Preview for <span class="font-mono">@GetDefinitionDisplayName(_previewDefinitionId)</span></p>
                <div class="flex flex-wrap items-end gap-2 text-xs">
                    <label>
                        Definition
                        <select class="mt-1 block rounded border border-default px-2 py-1 font-mono" @bind="_previewDefinitionId">
                            @foreach (var d in _definitions)
                            {
                                <option value="@d.Summary.Id">@d.Summary.DisplayName</option>
                            }
                        </select>
                    </label>
                    <button type="button" class="rounded bg-surface-muted px-3 py-2 disabled:opacity-50" disabled="@_busy" @onclick="ResolveRecipientsAsync">Preview</button>
                </div>
                @if (_recipientPreviewRefreshedAt is not null)
                {
                    <p class="mt-2 text-xs text-muted">Last refreshed @_recipientPreviewRefreshedAt.Value.UtcDateTime.ToString("u") UTC.</p>
                }
                <NotificationRecipientResolutionDisplay Resolution="_resolution" />
            </div>
        </section>

        <section class="mt-4 rounded border border-default bg-surface p-3">
            <h2 class="text-sm font-semibold text-heading mb-2">Recent platform instances</h2>
            @if (_instances.Count == 0)
            {
                <p class="text-xs text-muted">None in window.</p>
            }
            else
            {
                <table class="min-w-full text-left text-xs">
                    <thead class="text-muted">
                        <tr>
                            <th class="p-1">Created</th>
                            <th class="p-1">Kind</th>
                            <th class="p-1">Status</th>
                            <th class="p-1">Suppression</th>
                            <th class="p-1">Definition</th>
                            <th class="p-1"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var i in _instances)
                        {
                            <tr class="border-t border-default">
                                <td class="p-1">@i.CreatedAtUtc.UtcDateTime.ToString("u")</td>
                                <td class="p-1">@i.NotificationKind</td>
                                <td class="p-1">@i.Status</td>
                                <td class="p-1">@(i.SuppressionReason ?? "—")</td>
                                <td class="p-1 font-mono">
                                    <a class="underline" href="@NotificationUiRoutes.DefinitionDetail(i.NotificationDefinitionId)">@i.NotificationDefinitionId</a>
                                </td>
                                <td class="p-1"><a class="underline" href="@NotificationUiRoutes.InstanceDetail(i.Id)">Open</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>

        <section class="mt-4 rounded border border-default bg-surface p-3">
            <h2 class="text-sm font-semibold text-heading mb-2">Recent delivery outbox</h2>
            @if (_outboxRows.Count == 0)
            {
                <p class="text-xs text-muted">None in window.</p>
            }
            else
            {
                <table class="min-w-full text-left text-xs">
                    <thead class="text-muted">
                        <tr>
                            <th class="p-1">Recipient</th>
                            <th class="p-1">Kind</th>
                            <th class="p-1">Status</th>
                            <th class="p-1">Source</th>
                            <th class="p-1">Error</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in _outboxRows)
                        {
                            <tr class="border-t border-default">
                                <td class="p-1">@o.RecipientEmail</td>
                                <td class="p-1">@o.NotificationKind</td>
                                <td class="p-1">@o.Status</td>
                                <td class="p-1">@(o.RecipientSource ?? "—")</td>
                                <td class="p-1 break-all">@(o.LastError ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </section>

        @if (!string.IsNullOrEmpty(_error))
        {
            <p class="mt-4 text-sm text-muted">@_error</p>
        }
    }
</div>

@code {
    private const string BuiltInExpectedRunMissingDefinitionId = "platform.schedule.expected_run_missing";

    [Parameter] public string IntegrationId { get; set; } = "";

    [SupplyParameterFromQuery(Name = NotificationPostCreateNavigation.CreatedDefinitionIdQuery)]
    public string? CreatedDefinitionIdQuery { get; set; }

    private bool _capabilitiesLoaded;
    private bool _canView;
    private bool _canManageSubscriptions;
    private bool _canManageContacts;
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private string? _integrationName;
    private List<DefinitionRow> _definitions = [];
    private List<NotificationSubscriptionDto> _explicitSubscriptions = [];
    private List<NotificationInstanceDiagnosticDto> _instances = [];
    private List<NotificationOutboxDiagnosticDto> _outboxRows = [];
    private AttentionRoutingEffectiveDto? _attentionRouting;
