@page "/integrations/{IntegrationId}/schedule-diagnostics"
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Shared
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities
@inject NavigationManager Nav

<div class="p-4">
    <div class="flex items-center justify-between gap-3">
        <div class="min-w-0">
            <h1 class="text-xl font-semibold text-heading">Schedule diagnostics</h1>
            <div class="mt-1 font-mono text-xs text-muted break-all">@IntegrationId</div>
        </div>
        <div class="flex items-center gap-2">
            <a href="/integrations" class="rounded bg-surface-muted px-3 py-2 text-sm text-body hover:bg-surface">Back to fleet</a>
            <button type="button"
                    class="rounded bg-surface-muted px-3 py-2 text-sm text-body hover:bg-surface disabled:opacity-50"
                    disabled="@_loading"
                    @onclick="LoadAsync">
                Refresh
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="mt-4 rounded border border-default bg-surface px-3 py-2 text-sm text-body">
            <div class="font-semibold">Error</div>
            <div class="text-muted">@_error</div>
        </div>
    }
    else if (_loading || _diagnostics is null)
    {
        <div class="mt-4 text-sm text-muted">Loading…</div>
    }
    else
    {
        <div class="mt-4 space-y-4">
            <div class="rounded border border-default bg-surface p-3">
                <div class="text-sm font-semibold text-heading mb-2">Current status</div>

                <div class="grid grid-cols-1 gap-2 md:grid-cols-2">
                    <div>
                        <div class="text-xs text-muted">Evaluation status</div>
                        <div class="text-sm text-body">@_diagnostics.EvaluationStatus</div>
                        @if (_diagnostics.InGrace && !string.IsNullOrWhiteSpace(_diagnostics.GraceReason) && _diagnostics.GraceAnchorUtc is { } ga)
                        {
                            <div class="mt-1 text-xs text-muted">Grace: @ga.UtcDateTime.ToString("u") (@_diagnostics.GraceReason)</div>
                        }
                    </div>

                    <div>
                        <div class="text-xs text-muted">Schedule enabled</div>
                        <div class="text-sm text-body">
                            @if (_diagnostics.ReferenceScheduleEnabled is bool enabled)
                            {
                                @((enabled) ? "Yes" : "No")
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </div>
                        @if (!_diagnostics.HasRecurringScheduleExpectation)
                        {
                            <div class="mt-1 text-xs text-muted">Recurring expectation not applied.</div>
                        }
                    </div>
                </div>

                @if (_diagnostics.MostRecentExpectedFireUtc is { } mre)
                {
                    <div class="mt-2 text-xs text-muted">Most recent expected fire: @mre.UtcDateTime.ToString("u")</div>
                }
            </div>

            <div class="rounded border border-default bg-surface p-3">
                <div class="text-sm font-semibold text-heading mb-2">Core evidence</div>

                <div class="grid grid-cols-1 gap-2 md:grid-cols-2">
                    <div>
                        <div class="text-xs text-muted">Last satisfying schedule-origin run</div>
                        @if (!string.IsNullOrWhiteSpace(_diagnostics.LastSatisfyingScheduleOriginAuthorizedRunId))
                        {
                            <div class="text-sm text-body">
                                <a class="underline" href="@("/runs/" + Uri.EscapeDataString(_diagnostics.LastSatisfyingScheduleOriginAuthorizedRunId!))">
                                    @_diagnostics.LastSatisfyingScheduleOriginAuthorizedRunId
                                </a>
                                @if (_diagnostics.LastSatisfyingScheduleOriginAuthorizedRunAt is { } art)
                                {
                                    <span class="ml-2 text-xs text-muted">(@art.UtcDateTime.ToString("u"))</span>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-sm text-muted">—</div>
                        }
                    </div>

                    <div>
                        <div class="text-xs text-muted">Last authorized run (any kind)</div>
                        @if (!string.IsNullOrWhiteSpace(_diagnostics.LastAuthorizedRunId))
                        {
                            <div class="text-sm text-body">
                                <a class="underline" href="@("/runs/" + Uri.EscapeDataString(_diagnostics.LastAuthorizedRunId!))">
                                    @_diagnostics.LastAuthorizedRunId
                                </a>
                                @if (!string.IsNullOrWhiteSpace(_diagnostics.LastAuthorizedRunStatus))
                                {
                                    <span class="ml-2 text-xs text-muted">status: @_diagnostics.LastAuthorizedRunStatus</span>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-sm text-muted">—</div>
                        }
                        @if (_diagnostics.LastAuthorizedRunAt is { } lat)
                        {
                            <div class="text-xs text-muted mt-1">at: @lat.UtcDateTime.ToString("u")</div>
                        }
                    </div>
                </div>

                <div class="mt-3 grid grid-cols-1 gap-2 md:grid-cols-3">
                    <div>
                        <div class="text-xs text-muted">Last enabled at (UTC)</div>
                        <div class="text-sm text-body">@Fmt(_diagnostics.LastScheduleEnabledAtUtc)</div>
                    </div>
                    <div>
                        <div class="text-xs text-muted">Last disabled at (UTC)</div>
                        <div class="text-sm text-body">@Fmt(_diagnostics.LastScheduleDisabledAtUtc)</div>
                    </div>
                    <div>
                        <div class="text-xs text-muted">Material change at (UTC)</div>
                        <div class="text-sm text-body">@Fmt(_diagnostics.MaterialScheduleSemanticsChangedAtUtc)</div>
                    </div>
                </div>
            </div>

            <div class="rounded border border-default bg-surface p-3">
                <div class="text-sm font-semibold text-heading mb-2">Recent expected fires</div>
                @if (_diagnostics.RecentExpectedFires is { Count: > 0 })
                {
                    <div class="overflow-x-auto rounded border border-default">
                        <table class="min-w-full text-left text-sm text-body">
                            <thead class="border-b border-default text-xs text-muted">
                                <tr>
                                    <th class="px-3 py-2">Expected fire</th>
                                    <th class="px-3 py-2">Outcome</th>
                                    <th class="px-3 py-2">Satisfied by run</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var e in _diagnostics.RecentExpectedFires)
                                {
                                    <tr class="border-b border-default">
                                        <td class="px-3 py-2 font-mono text-xs">@e.ExpectedFireUtc.UtcDateTime.ToString("u")</td>
                                        <td class="px-3 py-2">
                                            @e.Outcome
                                            @if (!string.IsNullOrWhiteSpace(e.SuppressedByGraceReason))
                                            {
                                                <span class="ml-2 text-xs text-muted">(@e.SuppressedByGraceReason)</span>
                                            }
                                        </td>
                                        <td class="px-3 py-2">
                                            @if (!string.IsNullOrWhiteSpace(e.SatisfyingScheduleOriginAuthorizedRunId))
                                            {
                                                <a class="underline" href="@("/runs/" + Uri.EscapeDataString(e.SatisfyingScheduleOriginAuthorizedRunId!))">
                                                    @e.SatisfyingScheduleOriginAuthorizedRunId
                                                </a>
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-sm text-muted">No expected-fire evidence for the current recurring expectation window.</div>
                }
            </div>

            <div class="rounded border border-default bg-surface p-3">
                <div class="text-sm font-semibold text-heading mb-2">Expected-run-missing incident history</div>
                @if (_diagnostics.RecentAttentionIncidents is { Count: > 0 })
                {
                    <div class="overflow-x-auto rounded border border-default">
                        <table class="min-w-full text-left text-sm text-body">
                            <thead class="border-b border-default text-xs text-muted">
                                <tr>
                                    <th class="px-3 py-2">Started</th>
                                    <th class="px-3 py-2">Status</th>
                                    <th class="px-3 py-2">Last observed</th>
                                    <th class="px-3 py-2">Resolved</th>
                                    <th class="px-3 py-2">Acknowledged</th>
                                    <th class="px-3 py-2"></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var i in _diagnostics.RecentAttentionIncidents)
                                {
                                    <tr class="border-b border-default">
                                        <td class="px-3 py-2 font-mono text-xs">@i.StartedAtUtc.UtcDateTime.ToString("u")</td>
                                        <td class="px-3 py-2">@i.Status</td>
                                        <td class="px-3 py-2 font-mono text-xs">@i.LastObservedAtUtc.UtcDateTime.ToString("u")</td>
                                        <td class="px-3 py-2 text-xs">
                                            @if (i.ResolvedAtUtc is { } ra)
                                            {
                                                <span>@ra.UtcDateTime.ToString("u")</span>
                                                @if (!string.IsNullOrWhiteSpace(i.ResolutionReason))
                                                {
                                                    <div class="text-muted">@i.ResolutionReason</div>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td class="px-3 py-2 text-xs">
                                            @if (i.AcknowledgedAtUtc is { } aa)
                                            {
                                                <div>@aa.UtcDateTime.ToString("u")</div>
                                                @if (!string.IsNullOrWhiteSpace(i.AcknowledgedBy))
                                                {
                                                    <div class="text-muted">by @i.AcknowledgedBy</div>
                                                }
                                            }
                                            else
                                            {
                                                <span class="text-muted">—</span>
                                            }
                                        </td>
                                        <td class="px-3 py-2">
                                            @if (string.Equals(i.Status, "Active", StringComparison.OrdinalIgnoreCase))
                                            {
                                                <button type="button"
                                                        class="rounded bg-surface-muted px-2 py-1 text-xs text-body hover:bg-surface disabled:opacity-50"
                                                        disabled="@_ackBusy"
                                                        @onclick="async () => await AcknowledgeIncidentAsync(i.Id)">
                                                    Acknowledge
                                                </button>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-sm text-muted">No persisted incidents for this condition yet.</div>
                }
            </div>

            <div class="rounded border border-default bg-surface p-3">
                <div class="text-sm font-semibold text-heading mb-2">Attention routing (expected_run_missing)</div>
                @if (_diagnostics.AttentionRouting is { } rt)
                {
                    <div class="grid grid-cols-1 gap-2 md:grid-cols-2 text-sm text-body">
                        <div>
                            <div class="text-xs text-muted">Primary recipients</div>
                            <div>@(rt.PrimaryRecipients.Count > 0 ? string.Join(", ", rt.PrimaryRecipients) : "—")</div>
                            <div class="mt-1 text-xs text-muted">Source: @RoutingSourceLabel(rt.PrimarySource)</div>
                        </div>
                        <div>
                            <div class="text-xs text-muted">Escalation recipients</div>
                            <div>@(rt.EscalationRecipients.Count > 0 ? string.Join(", ", rt.EscalationRecipients) : "—")</div>
                            <div class="mt-1 text-xs text-muted">Source: @RoutingSourceLabel(rt.EscalationSource)</div>
                        </div>
                        <div>
                            <div class="text-xs text-muted">Has route / enabled</div>
                            <div>@rt.HasRoute / @rt.Enabled</div>
                        </div>
                        <div>
                            <div class="text-xs text-muted">Escalation after / reminder interval</div>
                            <div>@FmtTicks(rt.EscalationAfterTicks) / @FmtTicks(rt.ReminderIntervalTicks)</div>
                        </div>
                        <div>
                            <div class="text-xs text-muted">Resolved / suppress reminders / suppress escalation when ack</div>
                            <div>@rt.SendResolvedNotification / @rt.SuppressRemindersWhenAcknowledged / @rt.SuppressEscalationWhenAcknowledged</div>
                        </div>
                    </div>
                    <div class="mt-3 space-y-2">
                        <div class="text-xs font-semibold text-heading">Integration override</div>
                        <label class="block text-xs text-muted">Primary (comma-separated)</label>
                        <input class="w-full rounded border border-default bg-surface px-2 py-1 text-sm font-mono" @bind="_routingPrimary" />
                        <label class="block text-xs text-muted">Escalation (comma-separated)</label>
                        <input class="w-full rounded border border-default bg-surface px-2 py-1 text-sm font-mono" @bind="_routingEscalation" />
                        <div class="flex flex-wrap gap-2 items-center">
                            <button type="button" class="rounded bg-surface-muted px-3 py-1 text-sm disabled:opacity-50" disabled="@_routingSaveBusy" @onclick="SaveRoutingAsync">Save integration override</button>
                            @if (!string.IsNullOrEmpty(_routingSaveError))
                            {
                                <span class="text-xs text-muted">@_routingSaveError</span>
                            }
                        </div>
                    </div>
                }
            </div>

            <div class="rounded border border-default bg-surface p-3">
                <div class="text-sm font-semibold text-heading mb-2">Notification evidence</div>
                @if (_diagnostics.RecentAttentionIncidentNotifications is { Count: > 0 })
                {
                    <div class="overflow-x-auto rounded border border-default">
                        <table class="min-w-full text-left text-sm text-body">
                            <thead class="border-b border-default text-xs text-muted">
                                <tr>
                                    <th class="px-3 py-2">Created</th>
                                    <th class="px-3 py-2">Kind</th>
                                    <th class="px-3 py-2">Recipient</th>
                                    <th class="px-3 py-2">Status</th>
                                    <th class="px-3 py-2">Resolved from</th>
                                    <th class="px-3 py-2">Flags</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var n in _diagnostics.RecentAttentionIncidentNotifications)
                                {
                                    <tr class="border-b border-default">
                                        <td class="px-3 py-2 font-mono text-xs">@n.CreatedAtUtc.UtcDateTime.ToString("u")</td>
                                        <td class="px-3 py-2">@n.NotificationKind</td>
                                        <td class="px-3 py-2 font-mono text-xs">@(string.IsNullOrEmpty(n.Recipient) ? "—" : n.Recipient)</td>
                                        <td class="px-3 py-2 text-xs">@n.Status@if (n.SuppressionReason is { } sr) { <span class="text-muted">(@sr)</span> }</td>
                                        <td class="px-3 py-2 text-xs">@RoutingSourceLabel(n.RecipientResolvedFrom)</td>
                                        <td class="px-3 py-2 text-xs">@if (n.WasEscalation) { <span>esc </span> }@if (n.EscalationThresholdApplied) { <span>thr </span> }@if (n.SuppressedDueToAcknowledgment) { <span>ack </span> }</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-sm text-muted">No notification rows for recent incidents.</div>
                }
            </div>

            <div class="rounded border border-default bg-surface p-3">
                <div class="text-sm font-semibold text-heading mb-2">Navigation</div>
                <div class="flex flex-wrap gap-2">
                    @if (!string.IsNullOrWhiteSpace(_diagnostics.ReferenceScheduleId))
                    {
                        <a href="@("/schedules/" + Uri.EscapeDataString(_diagnostics.ReferenceScheduleId!))" class="text-sm underline">Schedule</a>
                    }
                    @if (!string.IsNullOrWhiteSpace(_diagnostics.LastSatisfyingScheduleOriginAuthorizedRunId))
                    {
                        <a href="@("/runs/" + Uri.EscapeDataString(_diagnostics.LastSatisfyingScheduleOriginAuthorizedRunId!))" class="text-sm underline">Satisfying run</a>
                    }
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string IntegrationId { get; set; } = "";

    private IntegrationScheduleDiagnosticsDto? _diagnostics;
    private OperatorCapabilitiesDto? _capabilities;
    private bool _loading = true;
    private bool _ackBusy;
    private string? _error;
    private string _routingPrimary = "";
    private string _routingEscalation = "";
    private bool _routingSaveBusy;
    private string? _routingSaveError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _capabilities = await Capabilities.GetCapabilitiesAsync();
        }
        catch
        {
            // UI can still render read-only diagnostics even if capabilities call fails.
            _capabilities = null;
        }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        _diagnostics = null;

        try
        {
            _diagnostics = await Client.GetIntegrationScheduleDiagnosticsAsync(IntegrationId);
            SyncRoutingEditor();
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private static string Fmt(DateTimeOffset? v) =>
        v is { } x ? x.UtcDateTime.ToString("u") : "—";


    private void SyncRoutingEditor()
    {
        if (_diagnostics?.AttentionRouting is not { } rt)
        {
            _routingPrimary = "";
            _routingEscalation = "";
            return;
        }

        _routingPrimary = string.Join(", ", rt.PrimaryRecipients);
        _routingEscalation = string.Join(", ", rt.EscalationRecipients);
    }

    private static string FmtTicks(long? ticks) =>
        ticks is { } t ? System.TimeSpan.FromTicks(t).ToString() : "—";

    private static string RoutingSourceLabel(string? source) => source switch
    {
        "IntegrationOverride" => "Integration override",
        "GlobalDefault" => "Global default",
        "None" => "No route configured",
        null or "" => "—",
        _ => source,
    };

    private static List<string> ParseEmails(string raw) =>
        raw.Split(new[] { ',', ';', '\n', '\r' }, StringSplitOptions.RemoveEmptyEntries)
            .Select(s => s.Trim())
            .Where(s => s.Length > 0)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

    private async Task SaveRoutingAsync()
    {
        if (_diagnostics?.AttentionRouting is not { } rt || string.IsNullOrWhiteSpace(IntegrationId))
            return;
        _routingSaveBusy = true;
        _routingSaveError = null;
        try
        {
            var body = new UpsertAttentionRoutingRequest(
                rt.Enabled,
                rt.SendResolvedNotification,
                rt.SuppressRemindersWhenAcknowledged,
                rt.SuppressEscalationWhenAcknowledged,
                rt.EscalationAfterTicks,
                rt.ReminderIntervalTicks,
                ParseEmails(_routingPrimary),
                ParseEmails(_routingEscalation));
            await Client.PutIntegrationAttentionRoutingAsync(IntegrationId, body);
            await LoadAsync();
        }
        catch (HttpRequestException ex)
        {
            _routingSaveError = ex.Message;
        }
        finally
        {
            _routingSaveBusy = false;
        }
    }
    private async Task AcknowledgeIncidentAsync(string incidentId)
    {
        if (_ackBusy || string.IsNullOrWhiteSpace(IntegrationId))
            return;
        _ackBusy = true;
        _error = null;
        try
        {
            var ok = await Client.AcknowledgeIntegrationAttentionIncidentAsync(IntegrationId, incidentId, note: null);
            if (!ok)
                _error = "Incident not found or could not be acknowledged.";
            else
                await LoadAsync();
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _ackBusy = false;
        }
    }
}


