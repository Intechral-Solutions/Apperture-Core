@page "/integrations"
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Client.Organisms
@using Apperture.Management.Ui.Shared
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities
@inject IToastService Toasts
@inject NavigationManager Nav

<div class="p-4">
    <PageHeader Title="Integrations" Subtitle="Status and health across your integrations. Open a row for issues, schedules, recent outcomes, and next actions.">
        <Toolbar>
            @if (_capabilities?.CanManageIntegrations == true)
            {
                <a href="/integrations/new" class="ui-toolbar-btn">Create Integration</a>
            }
            <button type="button"
                    class="ui-toolbar-btn"
                    disabled="@_loading"
                    @onclick="LoadAsync">
                Refresh
            </button>
        </Toolbar>
    </PageHeader>

    @if (!_capabilitiesLoaded)
    {
        <LoadingState Message="Loading…" />
    }
    else if (_capabilities?.CanViewIntegrations != true)
    {
        <ForbiddenState Message="You do not have permission to view integrations." />
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <ErrorState Message="@_error" />
    }
    else if (_fleet is null)
    {
        <LoadingState Message="Loading integrations…" />
    }
    else if (_fleet.Count == 0)
    {
        @if (FiltersActive)
        {
            <EmptyState Title="No matches"
                        Message="No integrations match the current filters. Clear filters or adjust criteria.">
                <button type="button" class="mt-3 ui-toolbar-btn" @onclick="ClearFiltersAsync">Clear filters</button>
            </EmptyState>
        }
        else
        {
            <PageMessage Kind="PageMessageKind.Info"
                         Message="No integrations are configured yet. Create an integration to connect modules, schedules, and workflows." />
            <EmptyState Title="Get started"
                        Message="Integrations group module configuration, connections, and schedules for one operational unit.">
                @if (_capabilities?.CanManageIntegrations == true)
                {
                    <a href="/integrations/new" class="mt-3 inline-block ui-toolbar-btn">Create integration</a>
                }
            </EmptyState>
        }
    }
    else if (!DisplayFleet.Any())
    {
        <EmptyState Title="Nothing needs attention"
                    Message="All visible integrations look healthy under the current filter.">
            <button type="button" class="mt-3 ui-toolbar-btn" @onclick="ClearFiltersAsync">Show all integrations</button>
        </EmptyState>
    }
    else
    {
        <ManagementSection Title="Fleet summary" Layer="@ManagementSection.UiLayer.Summary">
            <div class="flex flex-wrap items-center gap-2">
                <StatusPill Label="@($"{_fleet.Count} integration(s)")" Semantic="ManagementStatusSemantic.Neutral" />
                @{
                    var needsAttention = _fleet.Count(IntegrationOperatorUiHelpers.FleetNeedsAttention);
                }
                @if (needsAttention > 0)
                {
                    <StatusPill Label="@($"{needsAttention} need attention")" Semantic="ManagementStatusSemantic.Warning" />
                }
                else
                {
                    <StatusPill Label="All healthy" Semantic="ManagementStatusSemantic.Success" />
                }
                <button type="button"
                        class="ui-toolbar-btn text-sm"
                        @onclick="ShowNeedsAttentionAsync">
                    Show needs attention
                </button>
            </div>
        </ManagementSection>

        <ManagementAdvancedSection Title="Fleet filters"
                                   Subtitle="Narrow the list by state, readiness, verification, and operational signals."
                                   InitiallyOpen="false">
        <div class="flex flex-wrap items-end gap-3 ui-detail-block text-sm">
            <label class="flex flex-col gap-1">
                <span class="text-xs text-muted">State</span>
                <select class="ui-input text-sm" @bind="_filterState" @bind:after="LoadAsync">
                    <option value="">All</option>
                    <option value="Active">Active</option>
                    <option value="Inactive">Inactive</option>
                    <option value="Retired">Retired</option>
                </select>
            </label>
            <label class="flex flex-col gap-1">
                <span class="text-xs text-muted">Runnable</span>
                <select class="ui-input text-sm" @bind="_filterRunnable" @bind:after="LoadAsync">
                    <option value="">All</option>
                    <option value="true">Yes</option>
                    <option value="false">No</option>
                </select>
            </label>
            <label class="flex flex-col gap-1">
                <span class="text-xs text-muted">Blocking issues</span>
                <select class="ui-input text-sm" @bind="_filterHasBlocking" @bind:after="LoadAsync">
                    <option value="">All</option>
                    <option value="true">Has blocking</option>
                    <option value="false">None</option>
                </select>
            </label>
            <label class="flex flex-col gap-1">
                <span class="text-xs text-muted">Advisory issues</span>
                <select class="ui-input text-sm" @bind="_filterHasAdvisory" @bind:after="LoadAsync">
                    <option value="">All</option>
                    <option value="true">Has advisory</option>
                    <option value="false">None</option>
                </select>
            </label>
            <label class="flex flex-col gap-1">
                <span class="text-xs text-muted">Verification</span>
                <select class="ui-input text-sm" @bind="_filterVerificationConcern" @bind:after="LoadAsync">
                    <option value="">All</option>
                    <option value="true">Any concern</option>
                </select>
            </label>
            <label class="flex flex-col gap-1">
                <span class="text-xs text-muted">Run failures (window)</span>
                <select class="ui-input text-sm" @bind="_filterHasOperationalFailure" @bind:after="LoadAsync">
                    <option value="">All</option>
                    <option value="true">Has recent failures</option>
                    <option value="false">No recent failures</option>
                </select>
            </label>
            <label class="flex flex-col gap-1">
                <span class="text-xs text-muted">Unexpected silence</span>
                <select class="ui-input text-sm" @bind="_filterHasUnexpectedSilence" @bind:after="LoadAsync">
                    <option value="">All</option>
                    <option value="true">Expected run missing</option>
                    <option value="false">Not silent</option>
                </select>
            </label>
            <label class="flex flex-col gap-1">
                <span class="text-xs text-muted">Sort</span>
                <select class="ui-input text-sm" @bind="_sort" @bind:after="LoadAsync">
                    <option value="">Name (A–Z)</option>
                    <option value="-updatedAt">Updated (newest)</option>
                    <option value="updatedAt">Updated (oldest)</option>
                    <option value="moduleId">Module id</option>
                    <option value="-recentFailedCount">Recent failures (most)</option>
                    <option value="-lastFailedAt">Last failed (newest)</option>
                    <option value="-unexpectedSilence">Unexpected silence first</option>
                </select>
            </label>
        </div>
        </ManagementAdvancedSection>

        <div class="ui-data-table mt-4">
            <table class="ui-data-table__table min-w-full text-left text-body">
                <thead>
                    <tr>
                        <th class="px-3 py-2">Integration</th>
                        <th class="px-3 py-2">Health</th>
                        <th class="px-3 py-2">Recent outcomes (7d)</th>
                        <th class="px-3 py-2">Schedules</th>
                        <th class="px-3 py-2">Attention</th>
                        <th class="px-3 py-2"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var row in DisplayFleet)
                    {
                        <tr class="cursor-pointer"
                            @onclick="@(() => Nav.NavigateTo("/integrations/" + Uri.EscapeDataString(row.Id)))">
                            <td class="px-3 py-2">
                                <div class="font-medium">@row.DisplayName</div>
                                <div class="text-xs text-muted">@row.OperationalState</div>
                            </td>
                            <td class="px-3 py-2">
                                <div class="flex flex-wrap gap-1">
                                    <StatusPill Label="@(row.Readiness.IsRunnable ? "Runnable" : "Not runnable")"
                                                Semantic="@(row.Readiness.IsRunnable ? ManagementStatusSemantic.Success : ManagementStatusSemantic.Warning)" />
                                </div>
                                <div class="mt-1 text-xs text-muted">@IntegrationOperatorUiHelpers.FleetOperatorSummaryLine(row)</div>
                            </td>
                            <td class="px-3 py-2 text-sm" @onclick:stopPropagation="true">
                                @if (string.Equals(row.OperationalState, "Active", StringComparison.OrdinalIgnoreCase))
                                {
                                    <div class="space-y-1">
                                        <div>
                                            <span class="text-muted">Failed:</span>
                                            <span class="ml-1">@row.OperationalRuns.RecentFailedRunCount</span>
                                            @if (row.OperationalRuns.MostRecentAuthorizedRunFailed)
                                            {
                                                <span class="ml-1 text-xs text-muted">(latest run failed)</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(row.OperationalRuns.MostRecentFailedRunId))
                                        {
                                            <a class="text-xs underline"
                                               href="@("/runs/" + Uri.EscapeDataString(row.OperationalRuns.MostRecentFailedRunId!))">Last failed run</a>
                                        }
                                        @if (row.OperationalRuns.EvidenceWindowStartUtc is { } since)
                                        {
                                            <div>
                                                <a class="text-xs underline"
                                                   href="@RunsListHref(row.Id, since)">Recent runs</a>
                                            </div>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="px-3 py-2 text-sm" @onclick:stopPropagation="true">
                                @{
                                    var showExpectedRunsColumn = string.Equals(row.OperationalState, "Active", StringComparison.OrdinalIgnoreCase)
                                        && (row.ExpectedRuns.HasRecurringScheduleExpectation
                                            || !string.IsNullOrWhiteSpace(row.ExpectedRuns.OperatorSummaryLine));
                                }
                                @if (showExpectedRunsColumn)
                                {
                                    @if (!string.IsNullOrWhiteSpace(row.ExpectedRuns.OperatorSummaryLine))
                                    {
                                        <div class="@(row.ExpectedRuns.HasUnexpectedSilence ? "text-warning text-xs" : "text-muted text-xs")">@row.ExpectedRuns.OperatorSummaryLine</div>
                                    }
                                    @if (row.ExpectedRuns.ExpectedRunInGracePeriod
                                        && row.ExpectedRuns.ExpectedRunGraceAnchorUtc is { } graceAnchor
                                        && !string.IsNullOrWhiteSpace(row.ExpectedRuns.ExpectedRunGraceReason))
                                    {
                                        <div class="text-muted text-xs">Grace anchor: @graceAnchor.UtcDateTime.ToString("u") (@row.ExpectedRuns.ExpectedRunGraceReason)</div>
                                    }

                                    <div class="mt-1">
                                        <a class="text-xs underline" href="@($"/integrations/{Uri.EscapeDataString(row.Id)}/notifications")">Notifications</a>
                                    </div>
                                    @if (row.HasActiveExpectedRunMissingIncident)
                                    {
                                        <div class="mt-1 text-xs text-warning">Active expected-run-missing incident (see diagnostics).</div>
                                    }

                                    @if (row.ExpectedRuns.HasRecurringScheduleExpectation)
                                    {
                                        @if (row.ExpectedRuns.LastExpectedFireUtc is { } lastExpected)
                                        {
                                            <div class="text-muted text-xs">Last expected fire: @lastExpected.UtcDateTime.ToString("u")</div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(row.ExpectedRuns.LastScheduleOriginAuthorizedRunId))
                                        {
                                            <div class="mt-1">
                                                <a class="text-xs underline"
                                                   href="@("/runs/" + Uri.EscapeDataString(row.ExpectedRuns.LastScheduleOriginAuthorizedRunId!))">Last schedule-fired run</a>
                                            </div>
                                        }
                                        @if (!string.IsNullOrWhiteSpace(row.ExpectedRuns.ReferenceScheduleId))
                                        {
                                            <div class="mt-1 flex flex-wrap gap-x-2 gap-y-1">
                                                <a class="text-xs underline" href="@("/schedules/" + Uri.EscapeDataString(row.ExpectedRuns.ReferenceScheduleId!))">Schedule</a>
                                                <a class="text-xs underline" href="@($"/integrations/{Uri.EscapeDataString(row.Id)}#schedules")">Integration schedules</a>
                                            </div>
                                        }
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }
                            </td>
                            <td class="px-3 py-2">
                                <div class="flex flex-wrap gap-1">
                                    @foreach (var t in row.AttentionTokens.Take(3))
                                    {
                                        <AttentionPill Label="@IntegrationOperatorUiHelpers.FormatAttentionToken(t)"
                                                       Semantic="@ManagementAttentionSemantic.Warning" />
                                    }
                                </div>
                                <details class="mt-1 text-xs text-muted">
                                    <summary class="cursor-pointer">Technical tokens</summary>
                                    <div class="font-mono">@string.Join(", ", row.AttentionTokens)</div>
                                </details>
                            </td>
                            <td class="px-3 py-2 whitespace-nowrap" @onclick:stopPropagation="true">
                                <a href="@("/integrations/" + Uri.EscapeDataString(row.Id))" class="mr-2 underline text-sm">Open</a>
                                @if (_capabilities?.CanManageIntegrations == true &&
                                     (string.Equals(row.OperationalState, "Active", StringComparison.OrdinalIgnoreCase) ||
                                      string.Equals(row.OperationalState, "Inactive", StringComparison.OrdinalIgnoreCase)))
                                {
                                    @if (string.Equals(row.OperationalState, "Active", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <button type="button"
                                                class="btn btn-secondary text-xs"
                                                disabled="@_loading"
                                                @onclick="@(() => DeactivateRowAsync(row.Id))">
                                            Deactivate
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button"
                                                class="btn btn-primary text-xs"
                                                disabled="@_loading"
                                                @onclick="@(() => ActivateRowAsync(row.Id))">
                                            Activate
                                        </button>
                                    }
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private IReadOnlyList<IntegrationFleetRowDto>? _fleet;
    private OperatorCapabilitiesDto? _capabilities;
    private bool _capabilitiesLoaded;
    private bool _loading;
    private string? _error;

    private string _filterState = "";
    private string _filterRunnable = "";
    private string _filterHasBlocking = "";
    private string _filterHasAdvisory = "";
    private string _filterVerificationConcern = "";
    private string _filterHasOperationalFailure = "";
    private string _filterHasUnexpectedSilence = "";
    private string _sort = "";

    private bool FiltersActive =>
        !string.IsNullOrWhiteSpace(_filterState)
        || !string.IsNullOrWhiteSpace(_filterRunnable)
        || !string.IsNullOrWhiteSpace(_filterHasBlocking)
        || !string.IsNullOrWhiteSpace(_filterHasAdvisory)
        || !string.IsNullOrWhiteSpace(_filterVerificationConcern)
        || !string.IsNullOrWhiteSpace(_filterHasOperationalFailure)
        || !string.IsNullOrWhiteSpace(_filterHasUnexpectedSilence)
        || !string.IsNullOrWhiteSpace(_sort)
        || _showNeedsAttentionOnly;

    private bool _showNeedsAttentionOnly;

    private IEnumerable<IntegrationFleetRowDto> DisplayFleet
    {
        get
        {
            if (_fleet is null)
                return [];

            IEnumerable<IntegrationFleetRowDto> rows = _fleet;
            if (string.IsNullOrWhiteSpace(_sort))
                rows = rows.OrderBy(IntegrationOperatorUiHelpers.FleetAttentionRank).ThenBy(r => r.DisplayName, StringComparer.OrdinalIgnoreCase);

            if (_showNeedsAttentionOnly)
                rows = rows.Where(IntegrationOperatorUiHelpers.FleetNeedsAttention);

            return rows;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _capabilities = await Capabilities.GetCapabilitiesAsync();
        }
        catch
        {
            _capabilities = new OperatorCapabilitiesDto(false, false, false, false, false, false, false, false, false, false, false, false, false, false);
        }
        _capabilitiesLoaded = true;

        if (_capabilities?.CanViewIntegrations == true)
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_capabilities?.CanViewIntegrations != true) return;
        _loading = true;
        _error = null;
        try
        {
            var q = new IntegrationFleetQueryParams(
                State: string.IsNullOrWhiteSpace(_filterState) ? null : _filterState,
                Runnable: ParseNullableBool(_filterRunnable),
                HasBlocking: ParseNullableBool(_filterHasBlocking),
                HasAdvisory: ParseNullableBool(_filterHasAdvisory),
                VerificationConcern: ParseNullableBool(_filterVerificationConcern),
                HasOperationalFailure: ParseNullableBool(_filterHasOperationalFailure),
                HasUnexpectedSilence: ParseNullableBool(_filterHasUnexpectedSilence),
                Sort: string.IsNullOrWhiteSpace(_sort) ? null : _sort);
            _fleet = await Client.GetIntegrationFleetAsync(q);
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private static bool? ParseNullableBool(string s)
    {
        if (string.IsNullOrEmpty(s)) return null;
        if (string.Equals(s, "true", StringComparison.OrdinalIgnoreCase)) return true;
        if (string.Equals(s, "false", StringComparison.OrdinalIgnoreCase)) return false;
        return null;
    }

    private static string RunsListHref(string integrationId, DateTimeOffset evidenceSinceUtc) =>
        "/runs?integrationId=" + Uri.EscapeDataString(integrationId)
        + "&createdFrom=" + Uri.EscapeDataString(evidenceSinceUtc.ToString("o"));

    private static string VerificationLabel(IntegrationFleetAttentionFlagsDto f)
    {
        if (f.HasVerificationFailed) return "Failed";
        if (f.HasVerificationUnavailable) return "Unavailable";
        if (f.HasVerificationUnverified) return "Unverified";
        return "OK";
    }

    private async Task ClearFiltersAsync()
    {
        _filterState = "";
        _filterRunnable = "";
        _filterHasBlocking = "";
        _filterHasAdvisory = "";
        _filterVerificationConcern = "";
        _filterHasOperationalFailure = "";
        _filterHasUnexpectedSilence = "";
        _sort = "";
        _showNeedsAttentionOnly = false;
        await LoadAsync();
    }

    private Task ShowNeedsAttentionAsync()
    {
        _showNeedsAttentionOnly = true;
        return Task.CompletedTask;
    }

    private async Task ActivateRowAsync(string id)
    {
        try
        {
            await Client.ActivateIntegrationAsync(id);
            Toasts.Show(ToastSeverity.Success, "Integration activated.");
            await LoadAsync();
        }
        catch (HttpRequestException ex)
        {
            Toasts.Show(ToastSeverity.Error, ex.Message);
        }
    }

    private async Task DeactivateRowAsync(string id)
    {
        try
        {
            await Client.DeactivateIntegrationAsync(id);
            Toasts.Show(ToastSeverity.Success, "Integration deactivated.");
            await LoadAsync();
        }
        catch (HttpRequestException ex)
        {
            Toasts.Show(ToastSeverity.Error, ex.Message);
        }
    }
}
