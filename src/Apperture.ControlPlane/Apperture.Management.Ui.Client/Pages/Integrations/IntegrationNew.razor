@page "/integrations/new"
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Client.Services.Wizard
@using Apperture.Management.Ui.Client.Organisms
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities
@inject NavigationManager Nav
@inject ResourceContextViewState ViewState

<div class="p-4">
    <PageHeader Title="Integration Authoring Wizard" Subtitle="Create an integration, then continue directly to bindings, readiness remediation, schedules, and procedures.">
        <Toolbar>
            <a href="/integrations" class="ui-toolbar-btn">Back to list</a>
        </Toolbar>
    </PageHeader>

    @if (!_capabilitiesLoaded)
    {
        <LoadingState Message="Loading…" />
    }
    else if (_capabilities?.CanManageIntegrations != true)
    {
        <ForbiddenState Message="You do not have permission to create integrations." />
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <ErrorState Message="@_error" />
    }
    else
    {
        <div class="mt-4 grid grid-cols-1 gap-4 lg:grid-cols-[320px,1fr]">
            <WizardFlowPanel Title="Authoring flow"
                             Description="Integration is the deployment center: choose module, capture metadata, create, then continue in detail wizard."
                             Steps="@_wizard.Steps"
                             StepStates="@_wizardStepMap"
                             CurrentStepId="@_wizard.CurrentStepId"
                             OnSelect="OnWizardStepSelectedAsync" />

            <div class="ui-section-panel">
                @if (string.Equals(_wizard.CurrentStepId, StepChooseModule, StringComparison.Ordinal))
                {
                    <div class="text-sm font-semibold text-heading">Step 1: Select module</div>
                    <div class="mt-1 text-xs text-muted">Only effectively active modules are shown.</div>
                    @if (_modulesLoading)
                    {
                        <LoadingState Message="Loading modules…" />
                    }
                    else if (_availableModules.Count == 0)
                    {
                        <EmptyState Message="No eligible modules are currently active." />
                    }
                    else
                    {
                        <div class="mt-3">
                            <label class="block text-sm font-medium text-heading">Module definition</label>
                            <select class="ui-input mt-1 w-full text-sm"
                                    @bind="_moduleId"
                                    @bind:after="OnModuleChanged">
                                <option value="">Select…</option>
                                @foreach (var m in _availableModules)
                                {
                                    <option value="@m.Id">@m.Name (@m.Id)</option>
                                }
                            </select>
                            @if (!string.IsNullOrWhiteSpace(SelectedModuleDescription))
                            {
                                <div class="mt-2 text-xs text-muted">@SelectedModuleDescription</div>
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="text-sm font-semibold text-heading">Step 2: Integration metadata</div>
                    <div class="mt-1 text-xs text-muted">This creates the integration and routes you to configuration/remediation.</div>
                    <form class="mt-3 grid gap-4 md:grid-cols-2" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
                        @if (ViewState.DirectoryUnavailable)
                        {
                            <div class="md:col-span-2">
                                <PageMessage Kind="PageMessageKind.Warning"
                                             Title="Application/Context information unavailable"
                                             Message="Could not confirm whether this instance has any applications. Creating now could place this integration in the wrong Context.">
                                    <button type="button" class="ui-link text-sm" @onclick="RetryDirectoryAsync">Retry</button>
                                </PageMessage>
                            </div>
                        }
                        else if (ViewState.SelectorVisible)
                        {
                            <div class="md:col-span-2">
                                <label class="block text-sm font-medium text-heading">Context (required)</label>
                                <div class="mt-0.5 text-xs text-muted">Choose the application this resource belongs to, or Shared.</div>
                                <select class="ui-input mt-1 w-full" @bind="_selectedResourceContextId">
                                    <option value="" disabled selected="@(_selectedResourceContextId == "")">Choose…</option>
                                    <option value="shared">Shared</option>
                                    @foreach (var app in ViewState.KnownActiveApplications)
                                    {
                                        <option value="@app.Id">@app.Name</option>
                                    }
                                </select>
                            </div>
                        }
                        <div>
                            <label class="block text-sm font-medium text-heading">Display Name (required)</label>
                            <input class="ui-input mt-1 w-full text-sm"
                                   @bind="_displayName"
                                   required />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-heading">Module definition</label>
                            <input class="ui-input mt-1 w-full text-sm font-mono"
                                   value="@_moduleId"
                                   readonly />
                        </div>
                        <div class="md:col-span-2">
                            <ManagementAdvancedSection Title="Advanced" InitiallyOpen="false">
                                <label class="block text-sm font-medium text-heading">Authorization scope key (optional)</label>
                                <input class="ui-input mt-1 w-full text-sm font-mono"
                                       @bind="_scopeKey"
                                       placeholder="instance (default if empty)" />
                                <div class="mt-0.5 text-xs text-muted">Advanced authorization scope, unrelated to the Context. Leave empty for instance scope.</div>
                            </ManagementAdvancedSection>
                        </div>
                        <div class="md:col-span-2">
                            @if (!string.IsNullOrWhiteSpace(_selectedResourceContextId))
                            {
                                <div class="mb-2 text-sm text-muted">Creates the integration in <strong>@DestinationLabel()</strong>.</div>
                            }
                            <button type="submit"
                                    class="btn btn-primary"
                                    disabled="@(_submitting || !CanCreate())">
                                @(_submitting ? "Creating…" : "Create Integration")
                            </button>
                        </div>
                    </form>
                }

                <div class="mt-4 flex gap-2">
                    <button type="button"
                            class="btn btn-secondary text-sm"
                            disabled="@(!CanMovePrevious())"
                            @onclick="MovePreviousAsync">
                        Previous
                    </button>
                    <button type="button"
                            class="btn btn-primary text-sm"
                            disabled="@(!CanMoveNext())"
                            @onclick="MoveNextAsync">
                        Next
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private const string StepChooseModule = "module";
    private const string StepMetadata = "metadata";

    private readonly WizardFlowController _wizard = new(
        [
            new WizardStepDefinition(StepChooseModule, "Choose module", "Pick an eligible module to instantiate."),
            new WizardStepDefinition(StepMetadata, "Set metadata", "Name and scope for the integration.")
        ]);

    private readonly Dictionary<string, WizardStepState> _wizardStepMap = new(StringComparer.Ordinal);
    private IReadOnlyList<ModuleDto> _availableModules = Array.Empty<ModuleDto>();
    private bool _modulesLoading;

    private string _displayName = "";
    private string _moduleId = "";
    private string? _scopeKey;
    private string _selectedResourceContextId = "";
    private OperatorCapabilitiesDto? _capabilities;
    private bool _capabilitiesLoaded;
    private bool _submitting;
    private string? _error;
    private string? SelectedModuleDescription =>
        _availableModules.FirstOrDefault(m => string.Equals(m.Id, _moduleId, StringComparison.Ordinal))?.Description;

    [SupplyParameterFromQuery(Name = "context")]
    public string? QueryContext { get; set; }

    protected override void OnInitialized()
    {
        // With no active Application anywhere, the Context field is hidden entirely (ViewState.SelectorVisible
        // is false) and today's behavior is unchanged byte-for-byte: the selection stays unset so the
        // submit path omits ResourceContextId.
        if (!ViewState.SelectorVisible)
        {
            _selectedResourceContextId = string.Empty;
            return;
        }

        // Preselection order (design gate §7.2): ?context= from the create link, else the tab's
        // current view, else nothing. /integrations/new is Unscoped (ResourceContextViewRoutes), so
        // it does not participate in the shell's URL-authoritative rewriting/tab-state resolution --
        // the incoming query value is read here directly and validated against the known active
        // Applications (or "shared") before being honoured, rather than trusted as-is.
        if (IsKnownContextSelection(QueryContext))
        {
            _selectedResourceContextId = QueryContext!;
        }
        else if (!ViewState.Current.IsAll)
        {
            _selectedResourceContextId = ViewState.Current.ResourceContextId!;
        }
        else
        {
            _selectedResourceContextId = string.Empty; // "Choose…", submit disabled until set
        }
    }

    private bool IsKnownContextSelection(string? candidate) =>
        !string.IsNullOrWhiteSpace(candidate)
        && (string.Equals(candidate, "shared", StringComparison.Ordinal)
            || ViewState.KnownActiveApplications.Any(a => string.Equals(a.Id, candidate, StringComparison.Ordinal)));

    private string DestinationLabel() =>
        ViewState.DescribeContext(_selectedResourceContextId);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _capabilities = await Capabilities.GetCapabilitiesAsync();
            if (_capabilities?.CanManageIntegrations == true)
                await LoadEligibleModulesAsync();
        }
        catch
        {
            _capabilities = new OperatorCapabilitiesDto(false, false, false, false, false, false, false, false, false, false, false, false, false, false);
        }
        _capabilitiesLoaded = true;
        RecomputeWizardStates();
    }

    private async Task LoadEligibleModulesAsync()
    {
        _modulesLoading = true;
        try
        {
            var modules = await Client.GetModulesAsync();
            _availableModules = modules
                .Where(m => m.EffectivelyActive)
                .OrderBy(m => m.Name, StringComparer.OrdinalIgnoreCase)
                .ThenBy(m => m.Id, StringComparer.Ordinal)
                .ToArray();
        }
        finally
        {
            _modulesLoading = false;
        }
    }

    private bool CanMoveNext()
    {
        if (string.Equals(_wizard.CurrentStepId, StepChooseModule, StringComparison.Ordinal))
            return !string.IsNullOrWhiteSpace(_moduleId);
        return false;
    }

    private bool CanMovePrevious() =>
        string.Equals(_wizard.CurrentStepId, StepMetadata, StringComparison.Ordinal);

    private bool CanCreate() =>
        !string.IsNullOrWhiteSpace(_displayName)
        && !string.IsNullOrWhiteSpace(_moduleId)
        && _capabilities?.CanManageIntegrations == true
        // Plan 5 stabilization (Issue 1): while the directory is unavailable, never allow a submit that
        // would omit ResourceContextId merely because SelectorVisible also reads false in that state --
        // that would look identical to "confirmed zero Applications" and silently land in Shared.
        && !ViewState.DirectoryUnavailable
        && (!ViewState.SelectorVisible || !string.IsNullOrWhiteSpace(_selectedResourceContextId));

    private async Task RetryDirectoryAsync() => await ViewState.RefreshContextsAsync();

    private Task MoveNextAsync()
    {
        if (CanMoveNext())
        {
            if (string.Equals(_wizard.CurrentStepId, StepChooseModule, StringComparison.Ordinal))
                _wizard.NavigateTo(StepMetadata);
            else
                _wizard.TryMoveNext();
        }
        RecomputeWizardStates();
        return Task.CompletedTask;
    }

    private Task MovePreviousAsync()
    {
        _wizard.TryMovePrevious();
        RecomputeWizardStates();
        return Task.CompletedTask;
    }

    private Task OnWizardStepSelectedAsync(string stepId)
    {
        _wizard.NavigateTo(stepId);
        RecomputeWizardStates();
        return Task.CompletedTask;
    }

    private Task OnModuleChanged()
    {
        RecomputeWizardStates();
        return Task.CompletedTask;
    }

    private void RecomputeWizardStates()
    {
        var hasModuleSelection = !string.IsNullOrWhiteSpace(_moduleId);
        var states = new[]
        {
            new WizardStepState(
                StepChooseModule,
                string.Equals(_wizard.CurrentStepId, StepChooseModule, StringComparison.Ordinal)
                    ? WizardStepStatus.Current
                    : (hasModuleSelection ? WizardStepStatus.Complete : WizardStepStatus.Pending)),
            new WizardStepState(
                StepMetadata,
                string.Equals(_wizard.CurrentStepId, StepMetadata, StringComparison.Ordinal)
                    ? WizardStepStatus.Current
                    : (hasModuleSelection ? WizardStepStatus.Pending : WizardStepStatus.Blocked),
                hasModuleSelection ? null : "Select a module first.")
        };

        _wizard.SetStates(states);
        _wizardStepMap.Clear();
        foreach (var s in states)
            _wizardStepMap[s.StepId] = s;
    }

    private async Task SubmitAsync()
    {
        if (!CanCreate()) return;
        _submitting = true;
        _error = null;
        try
        {
            var request = new CreateIntegrationRequest(
                _displayName.Trim(), _moduleId.Trim(),
                string.IsNullOrWhiteSpace(_scopeKey) ? null : _scopeKey.Trim(),
                ResourceContextId: string.IsNullOrWhiteSpace(_selectedResourceContextId) ? null : _selectedResourceContextId);
            var integration = await Client.CreateIntegrationAsync(request);
            Nav.NavigateTo("/integrations/" + Uri.EscapeDataString(integration.Id) + "?wizard=1&step=bindings");
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _submitting = false;
        }
    }
}
