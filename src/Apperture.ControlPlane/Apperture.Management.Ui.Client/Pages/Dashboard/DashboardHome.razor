@page "/dashboard"
@layout MainLayout
@using Apperture.Management.Client
@inject IManagementClient ManagementClient

<div class="p-4">
    <div class="text-xs text-muted mb-1">Dashboard</div>
    <h1 class="text-xl font-semibold text-heading">Platform Summary</h1>
    <p class="mt-1 text-xs text-muted max-w-3xl">
        Shared operator summary for this instance. It is not personalized, not layout-managed, and not an editable dashboard product yet.
    </p>

    @if (_isLoading)
    {
        <div class="mt-4 text-sm text-muted">Loading dashboard summary...</div>
    }
    else if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <div class="mt-4 rounded border border-danger/40 bg-danger/10 text-danger p-3 text-sm">
            @_loadError
        </div>
    }
    else if (_dashboard is null || _dashboard.Cards.Count == 0)
    {
        <div class="mt-4 rounded border border-base bg-surface p-3 text-sm text-muted space-y-2">
            @if (_dashboard?.ProviderFailureCount > 0)
            {
                <p>No dashboard cards could be loaded. One or more summary sources failed; check server logs for details.</p>
            }
            else
            {
                <p>No dashboard cards are shown for your account. That usually means your role does not include the permissions needed for the available summary sources.</p>
            }
        </div>
    }
    else
    {
        <div class="mt-4 grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
            @foreach (var card in _dashboard.Cards.OrderBy(c => c.Order))
            {
                <section class="rounded border border-base bg-surface p-4">
                    <div class="flex items-start justify-between gap-2">
                        <h2 class="text-base font-semibold text-heading">@card.Title</h2>
                        <span class="@GetAttentionClasses(card.Attention)">@card.Attention</span>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(card.Summary))
                    {
                        <p class="mt-2 text-sm text-body">@card.Summary</p>
                    }

                    <dl class="mt-3 space-y-1">
                        @foreach (var fact in card.Facts)
                        {
                            <div class="flex items-center justify-between gap-2 text-sm">
                                <dt class="text-muted">@fact.Label</dt>
                                <dd class="text-heading font-medium">@fact.Value</dd>
                            </div>
                        }
                    </dl>

                    @if (card.IsPlaceholder && !string.IsNullOrWhiteSpace(card.PlaceholderReason))
                    {
                        <p class="mt-3 text-xs text-muted">Deferred: @card.PlaceholderReason</p>
                    }
                    else if (!string.IsNullOrWhiteSpace(card.NavigationHref))
                    {
                        <a href="@card.NavigationHref" class="mt-3 inline-block text-sm underline hover:no-underline">@(string.IsNullOrWhiteSpace(card.NavigationLabel) ? "Open details" : card.NavigationLabel)</a>
                    }
                </section>
            }
        </div>
    }
</div>

@code {
    private DashboardDefaultDto? _dashboard;
    private bool _isLoading = true;
    private string? _loadError;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _dashboard = await ManagementClient.GetDashboardDefaultAsync();
        }
        catch (Exception ex)
        {
            _loadError = $"Unable to load dashboard summary: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private static string GetAttentionClasses(string attention) => attention.ToLowerInvariant() switch
    {
        "critical" => "rounded bg-danger/15 text-danger px-2 py-0.5 text-xs font-medium",
        "warning" => "rounded bg-warning/15 text-warning px-2 py-0.5 text-xs font-medium",
        "info" => "rounded bg-primary/15 text-primary px-2 py-0.5 text-xs font-medium",
        _ => "rounded bg-base text-muted px-2 py-0.5 text-xs font-medium"
    };
}
