@page "/dashboard"
@layout MainLayout
@using Apperture.Management.Client
@inject IManagementClient ManagementClient

<div class="p-4 ui-page-stack">
    <PageHeader Title="Dashboard"
                Eyebrow="Operator"
                Subtitle="What is healthy, what needs attention, and where to act next. For live triage, open Control Center." />

    <ManagementSection Title="Quick links" Layer="@ManagementSection.UiLayer.Summary">
        <div class="ui-summary-card-grid">
            <ManagementSummaryCard Title="Control Center"
                                   Description="Actionable issues, blocked work, and recent activity."
                                   Href="/control/center" />
            <ManagementSummaryCard Title="Integrations"
                                   Description="Fleet health, readiness, and schedules."
                                   Href="/integrations" />
            <ManagementSummaryCard Title="Runs"
                                   Description="Recent execution outcomes and failures."
                                   Href="/runs" />
            <ManagementSummaryCard Title="Schedules"
                                   Description="Schedule definitions and firing health."
                                   Href="/schedules" />
            <ManagementSummaryCard Title="My notifications"
                                   Description="Personal notification inbox."
                                   Href="/me/notifications" />
        </div>
    </ManagementSection>

    @if (_isLoading)
    {
        <LoadingState Message="Loading dashboard summary..." />
    }
    else if (!string.IsNullOrWhiteSpace(_loadError))
    {
        <ErrorState Message="@_loadError" />
    }
    else if (_dashboard is null || _dashboard.Cards.Count == 0)
    {
        @if (_dashboard?.ProviderFailureCount > 0)
        {
            <ErrorState Title="Dashboard summary unavailable"
                       Message="No dashboard cards could be loaded. One or more summary sources failed; check server logs for details." />
        }
        else
        {
            <PageMessage Kind="PageMessageKind.Info"
                         Message="No summary cards are available for your account yet. That usually means your role does not include permissions for integration, run, or control summaries." />
            <EmptyState Title="Get started"
                        Message="Configure integrations, verify schedules, and run workflows — activity will appear here and in Control Center.">
                <div class="mt-3 flex flex-wrap gap-2">
                    <a href="/integrations" class="ui-toolbar-btn">Open integrations</a>
                    <a href="/control/center" class="ui-toolbar-btn">Open Control Center</a>
                </div>
            </EmptyState>
        }
    }
    else
    {
        <ManagementSection Title="Operational summary"
                           Layer="@ManagementSection.UiLayer.Summary"
                           Help="Permission-aware cards from live platform data. Highest-attention items appear first.">
            <div class="grid grid-cols-1 gap-4 md:grid-cols-2 xl:grid-cols-3">
                @foreach (var card in OrderedCards)
                {
                    <ManagementSummaryCard Title="@card.Title"
                                           Description="@(card.Summary ?? "No summary available.")"
                                           Href="@card.NavigationHref"
                                           Attention="@card.Attention">
                        <dl class="space-y-1">
                            @foreach (var fact in card.Facts.Take(4))
                            {
                                <div class="flex items-center justify-between gap-2 text-sm">
                                    <dt class="text-muted">@fact.Label</dt>
                                    <dd class="text-heading font-medium">@fact.Value</dd>
                                </div>
                            }
                        </dl>
                        @if (!string.IsNullOrWhiteSpace(card.NavigationHref))
                        {
                            <div class="mt-2 text-xs text-muted">
                                @(string.IsNullOrWhiteSpace(card.NavigationLabel) ? "Open details" : card.NavigationLabel) →
                            </div>
                        }
                        @if (card.IsPlaceholder && !string.IsNullOrWhiteSpace(card.PlaceholderReason))
                        {
                            <p class="mt-2 text-xs text-muted">Deferred: @card.PlaceholderReason</p>
                        }
                    </ManagementSummaryCard>
                }
            </div>
        </ManagementSection>
    }
</div>

@code {
    private DashboardDefaultDto? _dashboard;
    private bool _isLoading = true;
    private string? _loadError;

    private IEnumerable<DashboardCardDto> OrderedCards =>
        (_dashboard?.Cards ?? [])
            .OrderBy(c => OperatorAttentionUiHelpers.DashboardAttentionSortRank(c.Attention))
            .ThenBy(c => c.Order);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _dashboard = await ManagementClient.GetDashboardDefaultAsync();
        }
        catch (Exception ex)
        {
            _loadError = $"Unable to load dashboard summary: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
        }
    }
}
