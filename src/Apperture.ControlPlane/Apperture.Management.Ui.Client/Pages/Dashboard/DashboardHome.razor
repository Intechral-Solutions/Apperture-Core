@page "/dashboard"
@layout MainLayout

<div class="p-4">
    <div class="text-xs text-muted mb-1">Dashboard</div>
    <h1 class="text-xl font-semibold text-heading">Platform dashboard</h1>
    <div class="mt-4 text-sm text-body space-y-3">
