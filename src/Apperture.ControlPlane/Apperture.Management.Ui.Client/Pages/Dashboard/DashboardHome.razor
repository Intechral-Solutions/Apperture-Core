@page "/dashboard"
@layout MainLayout
@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Shared
@inject DomainMenuService DomainMenuService
@inject NavigationManager Nav

@code {
    protected override async Task OnInitializedAsync()
    {
        await DomainMenuService.WhenFetchedAsync();
        Nav.NavigateTo(ShellSectionRoutes.ControlCenterHome, replace: true);
    }
}
