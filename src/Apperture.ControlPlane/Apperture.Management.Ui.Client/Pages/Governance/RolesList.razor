@page "/config/governance/roles"
@layout ConfigLayout
@using System.Net
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Organisms
@using Apperture.Management.Ui.Client.Services
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities
@inject NavigationManager Nav

<div class="p-4 ui-page-stack">
    <PageHeader Eyebrow="Config — Governance"
                Title="Roles"
                Subtitle="Platform roles and their permission grants. Use the permission catalog to browse available actions and resources.">
        <Toolbar>
            @if (_capabilities?.CanManageRoles == true)
            {
                <a href="/config/governance/roles/new" class="ui-toolbar-btn">Create role</a>
            }
            <button type="button"
                    class="ui-toolbar-btn"
                    disabled="@_loading"
                    @onclick="LoadAsync">
                Refresh
            </button>
        </Toolbar>
    </PageHeader>

    @if (!_capabilitiesLoaded)
    {
        <LoadingState Message="Loading…" />
    }
    else if (_capabilities?.CanViewGovernance != true)
    {
        <ForbiddenState Message="You do not have permission to view roles." />
    }
    else if (_forbidden)
    {
        <ForbiddenState Message="You do not have permission to view roles." />
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <ErrorState Message="@_error" />
    }
    else if (_roles is null)
    {
        <LoadingState Message="Loading…" />
    }
    else if (_roles.Count == 0)
    {
        <EmptyState Message="No roles found." />
    }
    else
    {
        <div class="ui-data-table">
            <table class="ui-data-table__table min-w-full text-left text-body">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Name</th>
                        <th>Description</th>
                        <th>System role</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in _roles)
                    {
                        <tr class="cursor-pointer"
                            @onclick="@(() => Nav.NavigateTo("/config/governance/roles/" + Uri.EscapeDataString(r.Id)))">
                            <td class="font-mono text-xs">@r.Id</td>
                            <td>@r.Name</td>
                            <td>@(r.Description ?? "-")</td>
                            <td>@(r.IsSystemRole ? "Yes" : "No")</td>
                            <td>
                                <a href="@("/config/governance/roles/" + Uri.EscapeDataString(r.Id))" class="underline text-sm" @onclick:stopPropagation>View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private IReadOnlyList<RoleDto>? _roles;
    private bool _loading;
    private bool _forbidden;
    private string? _error;
    private OperatorCapabilitiesDto? _capabilities;
    private bool _capabilitiesLoaded;

    protected override async Task OnInitializedAsync()
    {
        try { _capabilities = await Capabilities.GetCapabilitiesAsync(); } catch { _capabilities = new OperatorCapabilitiesDto(false, false, false, false, false, false, false); }
        _capabilitiesLoaded = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_capabilities?.CanViewGovernance != true) return;

        _loading = true;
        _error = null;
        _forbidden = false;
        try
        {
            _roles = await Client.GetRolesAsync();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            _forbidden = true;
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
