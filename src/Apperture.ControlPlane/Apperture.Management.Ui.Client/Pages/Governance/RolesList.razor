@page "/governance/roles"
@using System.Net
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Services
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities
@inject NavigationManager Nav

<div class="p-4">
    <div class="flex items-center justify-between gap-3">
        <div class="min-w-0">
            <h1 class="text-xl font-semibold text-heading">Roles</h1>
            <div class="text-xs text-muted">Platform roles and their permission grants.</div>
        </div>
        <button class="rounded bg-surface-muted px-3 py-2 text-sm text-body hover:bg-surface"
                disabled="@_loading"
                @onclick="LoadAsync">
            Refresh
        </button>
    </div>

    @if (!_capabilitiesLoaded)
    {
        <div class="mt-4 text-sm text-muted">Loading...</div>
    }
    else if (_capabilities?.CanViewGovernance != true)
    {
        <div class="mt-4 rounded border border-default bg-surface px-3 py-2 text-sm text-body">
            <div class="font-semibold">Not authorized</div>
            <div class="text-muted">You do not have permission to view roles.</div>
        </div>
    }
    else if (_forbidden)
    {
        <div class="mt-4 rounded border border-default bg-surface px-3 py-2 text-sm text-body">
            <div class="font-semibold">Not authorized</div>
            <div class="text-muted">You do not have permission to view roles.</div>
        </div>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <div class="mt-4 rounded border border-default bg-surface px-3 py-2 text-sm text-body">
            <div class="font-semibold">Error</div>
            <div class="text-muted">@_error</div>
        </div>
    }
    else if (_roles is null)
    {
        <div class="mt-4 text-sm text-muted">Loading...</div>
    }
    else if (_roles.Count == 0)
    {
        <div class="mt-4 text-sm text-muted">No roles found.</div>
    }
    else
    {
        <div class="mt-4 overflow-x-auto rounded border border-default bg-surface">
            <table class="min-w-full text-left text-sm text-body">
                <thead class="border-b border-default text-xs text-muted">
                    <tr>
                        <th class="px-3 py-2">Id</th>
                        <th class="px-3 py-2">Name</th>
                        <th class="px-3 py-2">Description</th>
                        <th class="px-3 py-2">System role</th>
                        <th class="px-3 py-2"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in _roles)
                    {
                        <tr class="border-b border-default hover:bg-surface-muted cursor-pointer"
                            @onclick="@(() => Nav.NavigateTo("/governance/roles/" + Uri.EscapeDataString(r.Id)))">
                            <td class="px-3 py-2 font-mono text-xs">@r.Id</td>
                            <td class="px-3 py-2">@r.Name</td>
                            <td class="px-3 py-2">@(r.Description ?? "-")</td>
                            <td class="px-3 py-2">@(r.IsSystemRole ? "Yes" : "No")</td>
                            <td class="px-3 py-2">
                                <a href="@("/governance/roles/" + Uri.EscapeDataString(r.Id))" class="underline text-sm" @onclick:stopPropagation>View</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@code {
    private IReadOnlyList<RoleDto>? _roles;
    private bool _loading;
    private bool _forbidden;
    private string? _error;
    private OperatorCapabilitiesDto? _capabilities;
    private bool _capabilitiesLoaded;

    protected override async Task OnInitializedAsync()
    {
        try { _capabilities = await Capabilities.GetCapabilitiesAsync(); } catch { _capabilities = new OperatorCapabilitiesDto(false, false, false, false, false, false, false); }
        _capabilitiesLoaded = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_capabilities?.CanViewGovernance != true) return;

        _loading = true;
        _error = null;
        _forbidden = false;
        try
        {
            _roles = await Client.GetRolesAsync();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            _forbidden = true;
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
