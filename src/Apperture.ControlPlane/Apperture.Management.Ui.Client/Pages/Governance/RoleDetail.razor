@page "/config/governance/roles/{RoleId}"
@layout ConfigLayout
@using System.Net
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Organisms
@using Apperture.Management.Ui.Client.Molecules
@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Shared
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities
@inject IToastService Toasts
@inject NavigationManager Nav
@inject ShellOrientationService ShellOrientation

<div class="p-4">
    <PageHeader @key="@RoleId"
                Title="@EntityShellTitles.Detail(_detail?.Name, "Role")">
        <ChildContent>
            <div class="mt-1 text-xs text-muted">
                <a href="/config/governance/roles" class="hover:underline">Roles</a> / Role detail
            </div>
            <div class="mt-1 font-mono text-xs text-muted break-all">@RoleId</div>
        </ChildContent>
        <Toolbar>
            <a href="/config/governance/roles" class="ui-toolbar-btn">Back to roles</a>
            @if (_capabilities?.CanAssignPermissions == true && _detail is not null && !_detail.IsSystemRole && !_editing)
            {
                <button type="button"
                        class="ui-toolbar-btn"
                        title="Edit role permissions"
                        @onclick="StartEdit">
                    Edit permissions
                </button>
            }
            @if (CanManageThisRole && !_editing)
            {
                <button type="button"
                        id="role-delete-trigger"
                        class="ui-toolbar-btn ui-toolbar-btn--danger"
                        disabled="@_loading"
                        aria-label="@DeleteTriggerLabel"
                        @onclick="OpenDeleteConfirmAsync">
                    Delete
                </button>
            }
            <a href="@Epic33UiDisplayHelpers.GetGovernanceAuditLink()" class="ui-toolbar-btn">View governance audit history</a>
            <button type="button"
                    class="ui-toolbar-btn"
                    disabled="@_loading"
                    @onclick="LoadAsync">
                Refresh
            </button>
        </Toolbar>
    </PageHeader>

    @if (!_capabilitiesLoaded)
    {
        <div class="mt-4">
            <LoadingState Message="Loading…" />
        </div>
    }
    else if (_capabilities?.CanViewGovernance != true)
    {
        <div class="mt-4">
            <ForbiddenState Message="You do not have permission to view this role." />
        </div>
    }
    else if (_forbidden)
    {
        <div class="mt-4">
            <ForbiddenState Message="You do not have permission to view this role." />
        </div>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <div class="mt-4">
            <ErrorState Message="@_error" />
        </div>
    }
    else if (_detail is null)
    {
        <div class="mt-4">
            <LoadingState Message="Loading…" />
        </div>
    }
    else if (_editing)
    {
        <ManagementSection Title="Edit permissions" Layer="ManagementSection.UiLayer.Advanced">
            <div class="rounded border border-message-warning bg-message-warning px-3 py-2 text-xs text-body mb-3">
                <strong>Saving replaces the role's entire permission set</strong> with the selections below. Permissions not selected will be revoked. Changes apply to the role as currently loaded.
            </div>
            @if (_catalog is null || !string.IsNullOrEmpty(_error))
            {
                @if (!string.IsNullOrEmpty(_error))
                {
                    <ErrorState Message="@_error" />
                }
                else
                {
                    <LoadingState Message="Loading catalog…" />
                }
                <div class="mt-2 text-xs text-muted">Save is disabled until the catalog loads. Use Cancel to exit edit mode.</div>
            }
            else
            {
                <div class="max-h-96 overflow-y-auto space-y-2">
                    @foreach (var perm in _catalog.Permissions)
                    {
                        var key = PermissionKey(perm);
                        var isChecked = _selectedPermissions.Contains(key);
                        <div class="flex items-center gap-2 py-1">
                            <input type="checkbox" id="@key" checked="@isChecked" @onchange="@(() => TogglePermission(key))" />
                            <label for="@key" class="text-sm font-mono">@perm.Action @(perm.ResourceType ?? "") @(perm.ScopeKey ?? "")</label>
                            @if (!string.IsNullOrEmpty(perm.ModuleId))
                            {
                                <span class="text-xs text-muted">(@perm.ModuleId)</span>
                            }
                        </div>
                    }
                </div>
                <div class="mt-3 flex gap-2">
                    <button type="button"
                            class="btn btn-primary"
                            disabled="@(_loading || _catalog is null)"
                            title="@(_catalog is null ? "Catalog must load before saving" : "Save overwrites entire permission set")"
                            @onclick="SaveEditAsync">
                        Save
                    </button>
                    <button type="button"
                            class="btn btn-secondary"
                            disabled="@_loading"
                            @onclick="CancelEdit">
                        Cancel
                    </button>
                </div>
            }
        </ManagementSection>
    }
    else
    {
        <div class="grid gap-4">
            <ManagementSection Title="Details" Layer="ManagementSection.UiLayer.Summary">
                @if (_detail.IsSystemRole)
                {
                    <MetadataGrid>
                        <MetadataItem Label="Id" Monospace="true" Value="@_detail.Id" />
                        <MetadataItem Label="Name" Value="@_detail.Name" />
                        <MetadataItem Label="Description" Value="@(_detail.Description ?? "-")" />
                        <MetadataItem Label="System role" Value="Yes" />
                    </MetadataGrid>
                    <div id="role-system-notice" class="mt-3 rounded border border-message-warning bg-message-warning px-3 py-2 text-xs text-body">
                        This built-in role cannot be changed or deleted.
                    </div>
                }
                else if (CanManageThisRole)
                {
                    <form @onsubmit="SaveMetadataAsync" @onsubmit:preventDefault>
                        <div class="space-y-4 text-sm text-body">
                            <MetadataGrid>
                                <MetadataItem Label="Id" Monospace="true" Value="@_detail.Id" />
                                <MetadataItem Label="System role" Value="No" />
                            </MetadataGrid>
                            <div>
                                <label class="block text-xs text-muted" for="role-name">Name</label>
                                <input id="role-name"
                                       class="ui-input mt-1"
                                       @bind="_nameDraft"
                                       @bind:event="oninput"
                                       disabled="@_savingMetadata"
                                       required
                                       aria-required="true"
                                       maxlength="256"
                                       autocomplete="off"
                                       aria-describedby="@(_metadataError is null ? null : "role-metadata-error")" />
                            </div>
                            <div>
                                <label class="block text-xs text-muted" for="role-description">Description</label>
                                <textarea id="role-description"
                                          class="ui-input mt-1 w-full"
                                          @bind="_descriptionDraft"
                                          disabled="@_savingMetadata"
                                          maxlength="512"
                                          rows="3"></textarea>
                            </div>
                            @if (!string.IsNullOrEmpty(_metadataError))
                            {
                                <p id="role-metadata-error" class="text-xs text-body" role="alert">@_metadataError</p>
                            }
                            <FormValidationFeedback Visible="@_showMetadataAttention" Message="@_metadataValidation" />
                            <button type="submit"
                                    class="btn btn-primary"
                                    disabled="@_savingMetadata">
                                @(_savingMetadata ? "Saving…" : "Save details")
                            </button>
                        </div>
                    </form>
                }
                else
                {
                    <MetadataGrid>
                        <MetadataItem Label="Id" Monospace="true" Value="@_detail.Id" />
                        <MetadataItem Label="Name" Value="@_detail.Name" />
                        <MetadataItem Label="Description" Value="@(_detail.Description ?? "-")" />
                        <MetadataItem Label="System role" Value="No" />
                    </MetadataGrid>
                }
            </ManagementSection>

            <ManagementSection Title="People with this role" Layer="ManagementSection.UiLayer.Detail">
                <div id="role-assignments">
                    <p id="@(LiveAssignmentCount == 0 ? "role-assignments-empty" : null)" class="text-sm text-body">@AssignmentSummary</p>
                    @if (CanManageThisRole && LiveAssignmentCount > 0)
                    {
                        <p class="mt-2 text-xs text-muted">This role cannot be deleted until those assignments are removed. Deletion does not remove assignments.</p>
                    }
                    @if (!string.IsNullOrEmpty(_assignmentsError))
                    {
                        <p class="mt-2 text-xs text-muted" role="status">@_assignmentsError</p>
                    }
                    else if (_assignments is { Holders.Count: > 0 })
                    {
                        <ul class="mt-2 divide-y divide-default text-sm">
                            @foreach (var holder in _assignments.Holders)
                            {
                                <li class="py-2 text-sm">
                                    <UserRef User="@HolderReference(holder)" Mode="UserRefMode.Compact" CanNavigate="@(_capabilities?.CanViewGovernance == true)" />
                                </li>
                            }
                        </ul>
                    }
                </div>
            </ManagementSection>

            <ManagementSection Title="Granted permissions" Layer="ManagementSection.UiLayer.Detail">
                @if (_detail.Permissions.Count == 0)
                {
                    <div class="text-xs text-muted">No permissions granted.</div>
                }
                else
                {
                    <div class="ui-data-table">
                        <table class="ui-data-table__table min-w-full text-left text-body">
                            <thead>
                                <tr>
                                    <th>Action</th>
                                    <th>Resource type</th>
                                    <th>Scope key</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in _detail.Permissions)
                                {
                                    <tr>
                                        <td class="font-mono text-xs">@p.Action</td>
                                        <td class="font-mono text-xs">@(p.ResourceType ?? "-")</td>
                                        <td class="font-mono text-xs">@(p.ScopeKey ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </ManagementSection>
        </div>
    }
</div>

@if (_detail is not null && _confirmDeleteOpen)
{
    <ConfirmActionDialog IsOpen="true"
                         Title="@DeleteDialogTitle"
                         ConfirmLabel="Delete role"
                         ConfirmDisabled="@(!CanCommitDelete)"
                         Emphasis="@(CanCommitDelete ? ConfirmActionEmphasis.Destructive : ConfirmActionEmphasis.Standard)"
                         OnConfirm="ConfirmDeleteAsync"
                         OnConfirmed="CloseDeleteConfirmAsync"
                         OnCancel="CancelDeleteAsync">
        <ChildContent>
            @if (CanCommitDelete)
            {
                <span>Deleting <strong>@_detail.Name</strong> permanently removes it. It cannot be restored.</span>
            }
            else
            {
                <span>@BlockedDeleteMessage(LiveAssignmentCount)</span>
            }
        </ChildContent>
        <Details>
            @if (CanCommitDelete)
            {
                <p>People who hold this role must be changed to another role before it can be deleted. No one holds it now.</p>
            }
            else
            {
                <p>Change these people's roles first. Deleting this role does not remove their assignments.</p>
                @if (_assignments is { Holders.Count: > 0 })
                {
                    <ul class="mt-2 space-y-1">
                        @foreach (var holder in _assignments.Holders)
                        {
                            <li class="text-sm">
                                <UserRef User="@HolderReference(holder)" Mode="UserRefMode.Compact" CanNavigate="@(_capabilities?.CanViewGovernance == true)" />
                            </li>
                        }
                    </ul>
                }
            }
        </Details>
    </ConfirmActionDialog>
}

@code {
    private const int NameMaxLength = 256;
    private const int DescriptionMaxLength = 512;
    private const string BuiltInRoleNotice = "This built-in role cannot be changed or deleted.";

    [Parameter] public string RoleId { get; set; } = "";

    private RoleDetailDto? _detail;
    private RoleAssignmentsDto? _assignments;
    private GovernanceDescriptorResponse? _catalog;
    private bool _loading;
    private bool _savingMetadata;
    private bool _forbidden;
    private string? _error;
    private string? _metadataError;
    private string _metadataValidation = "Role name is required.";
    private bool _showMetadataAttention;
    private string? _assignmentsError;
    private bool _editing;
    private bool _confirmDeleteOpen;
    private HashSet<string> _selectedPermissions = new();
    private OperatorCapabilitiesDto? _capabilities;
    private bool _capabilitiesLoaded;
    private string? _dataLoadKey;
    private string _nameDraft = "";
    private string _descriptionDraft = "";

    private bool CanManageThisRole =>
        _capabilities?.CanManageRoles == true && _detail is { IsSystemRole: false };

    /// <summary>Set when delete reports assignments the last read had not shown yet. Cleared once a later read agrees.</summary>
    private int? _unconfirmedAssignmentCount;

    private int LiveAssignmentCount =>
        _unconfirmedAssignmentCount
        ?? _assignments?.Count
        ?? _detail?.AssignmentCount
        ?? 0;

    private bool CanCommitDelete => CanManageThisRole && LiveAssignmentCount == 0;

    private string DeleteDialogTitle => CanCommitDelete ? "Delete role?" : "Role cannot be deleted";

    private string DeleteTriggerLabel => CanCommitDelete
        ? "Delete role"
        : "Role cannot be deleted while people hold it";

    private string AssignmentSummary => LiveAssignmentCount switch
    {
        0 => "No one holds this role.",
        1 => "Assigned to 1 person.",
        _ => $"Assigned to {LiveAssignmentCount} people."
    };

    protected override async Task OnInitializedAsync()
    {
        try { _capabilities = await Capabilities.GetCapabilitiesAsync(); } catch { _capabilities = new OperatorCapabilitiesDto(false, false, false, false, false, false, false); }
        _capabilitiesLoaded = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        if (!_capabilitiesLoaded)
            return;
        var key = RoleId ?? "";
        if (key == _dataLoadKey)
            return;
        _dataLoadKey = key;
        _detail = null;
        _assignments = null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_capabilities?.CanViewGovernance != true) return;

        _loading = true;
        _error = null;
        _forbidden = false;
        _editing = false;
        _unconfirmedAssignmentCount = null;
        _metadataError = null;
        _showMetadataAttention = false;
        try
        {
            _detail = await Client.GetRoleAsync(RoleId);
            if (_detail is null)
            {
                _assignments = null;
                _error = "Role not found.";
                return;
            }

            SyncDraftsFromDetail();
            await LoadAssignmentsAsync();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            _forbidden = true;
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            PublishShellTitle();
        }
    }

    private async Task LoadAssignmentsAsync()
    {
        try
        {
            _assignments = await Client.GetRoleAssignmentsAsync(RoleId);
            _assignmentsError = _assignments is null ? "Assignments could not be loaded." : null;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            _assignments = null;
            _assignmentsError = "You do not have permission to view who holds this role.";
        }
        catch (HttpRequestException)
        {
            _assignments = null;
            _assignmentsError = "Assignments could not be loaded.";
        }
    }

    private void SyncDraftsFromDetail()
    {
        if (_detail is null)
            return;
        _nameDraft = _detail.Name;
        _descriptionDraft = _detail.Description ?? "";
    }

    private void PublishShellTitle() =>
        ShellOrientation.PublishForCurrentUri(
            Nav,
            EntityShellTitles.Detail(_detail?.Name, "Role"),
            subtitle: null);

    public async Task StartEdit()
    {
        if (_detail is null || _detail.IsSystemRole || _capabilities?.CanAssignPermissions != true) return;
        _error = null;
        _loading = true;
        try
        {
            var fresh = await Client.GetRoleAsync(RoleId);
            if (fresh is null) { _error = "Role not found."; return; }
            if (fresh.IsSystemRole)
            {
                _detail = fresh;
                return;
            }

            _detail = fresh;
            _catalog = await Client.GetGovernanceDescriptorsAsync();
            if (_catalog is null) { _error = "Failed to load permission catalog."; return; }
            _selectedPermissions = _detail.Permissions.Select(p => PermissionKeyFromEntry(p)).ToHashSet();
            _editing = true;
        }
        catch
        {
            _error = "Failed to load role or catalog. Cannot enter edit mode.";
        }
        finally
        {
            _loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void CancelEdit()
    {
        _editing = false;
        _catalog = null;
    }

    private void TogglePermission(string key)
    {
        if (_selectedPermissions.Contains(key))
            _selectedPermissions.Remove(key);
        else
            _selectedPermissions.Add(key);
    }

    private static string PermissionKey(PermissionCatalogEntryDto p) =>
        $"{p.Action}|{p.ResourceType ?? ""}|{p.ScopeKey ?? ""}";

    private static string PermissionKeyFromEntry(RolePermissionEntryDto p) =>
        $"{p.Action}|{p.ResourceType ?? ""}|{p.ScopeKey ?? ""}";

    private async Task SaveEditAsync()
    {
        if (_detail is null || _detail.IsSystemRole || _catalog is null) return;

        _loading = true;
        _error = null;
        try
        {
            var permissions = _catalog.Permissions
                .Where(p => _selectedPermissions.Contains(PermissionKey(p)))
                .Select(p => new RolePermissionDto(p.Action, p.ResourceType, p.ScopeKey))
                .ToList();
            await Client.SetRolePermissionsAsync(RoleId, new SetRolePermissionsRequest(permissions));
            _editing = false;
            _catalog = null;
            Toasts.Show(ToastSeverity.Success, "Permissions saved for this role.", "Governance");
            await LoadAsync();
        }
        catch (RoleLifecycleConflictException ex) when (ex.Code == RoleLifecycleConflictException.SystemRole)
        {
            _editing = false;
            _catalog = null;
            await LoadAsync();
            Toasts.Show(ToastSeverity.Error, BuiltInRoleNotice, "Save permissions");
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
            Toasts.Show(ToastSeverity.Error, ex.Message, "Save permissions");
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            _error = "Not authorized to assign permissions.";
            Toasts.Show(ToastSeverity.Error, _error, "Save permissions");
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
            Toasts.Show(ToastSeverity.Error, ex.Message, "Save permissions");
        }
        finally
        {
            _loading = false;
        }
    }

    public void SetMetadataDraft(string name, string? description)
    {
        _nameDraft = name;
        _descriptionDraft = description ?? "";
    }

    public async Task SaveMetadataAsync()
    {
        if (!CanManageThisRole || _detail is null || _savingMetadata)
            return;

        _metadataError = null;
        _showMetadataAttention = false;
        if (!TryNormalizeMetadata(out var name, out var description))
        {
            _showMetadataAttention = true;
            await InvokeAsync(StateHasChanged);
            return;
        }

        _savingMetadata = true;
        try
        {
            _detail = await Client.UpdateRoleMetadataAsync(RoleId, new UpdateRoleMetadataRequest(name, description));
            SyncDraftsFromDetail();
            await LoadAssignmentsAsync();
            Toasts.Show(ToastSeverity.Success, "Role details saved.", "Governance");
            PublishShellTitle();
        }
        catch (RoleLifecycleConflictException ex) when (ex.Code == RoleLifecycleConflictException.DuplicateName)
        {
            _metadataError = "A role with this name already exists.";
        }
        catch (RoleLifecycleConflictException ex) when (ex.Code == RoleLifecycleConflictException.SystemRole)
        {
            await LoadAsync();
            _metadataError = BuiltInRoleNotice;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            _metadataError = "You do not have permission to change this role.";
        }
        catch (InvalidOperationException ex) when (ex.Message.Contains("not found", StringComparison.OrdinalIgnoreCase))
        {
            ShowRoleGone();
        }
        catch (InvalidOperationException ex)
        {
            _metadataError = ex.Message;
        }
        catch (HttpRequestException ex)
        {
            _metadataError = ex.Message;
        }
        finally
        {
            _savingMetadata = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private bool TryNormalizeMetadata(out string name, out string? description)
    {
        name = _nameDraft.Trim();
        description = string.IsNullOrWhiteSpace(_descriptionDraft) ? null : _descriptionDraft.Trim();
        if (name.Length == 0)
        {
            _metadataValidation = "Role name is required.";
            return false;
        }

        if (name.Length > NameMaxLength)
        {
            _metadataValidation = "Role name must be 256 characters or fewer.";
            return false;
        }

        if (description is { Length: > DescriptionMaxLength })
        {
            _metadataValidation = "Role description must be 512 characters or fewer.";
            return false;
        }

        return true;
    }

    public async Task OpenDeleteConfirmAsync()
    {
        if (!CanManageThisRole)
            return;

        _confirmDeleteOpen = true;
        await InvokeAsync(StateHasChanged);
    }

    public async Task CancelDeleteAsync()
    {
        _confirmDeleteOpen = false;
        await InvokeAsync(StateHasChanged);
    }

    public async Task CloseDeleteConfirmAsync()
    {
        _confirmDeleteOpen = false;
        await InvokeAsync(StateHasChanged);
    }

    public async Task ConfirmDeleteAsync()
    {
        if (!CanManageThisRole || _detail is null)
            return;

        if (LiveAssignmentCount > 0)
            return;

        try
        {
            await Client.DeleteRoleAsync(RoleId);
        }
        catch (RoleLifecycleConflictException ex) when (ex.Code == RoleLifecycleConflictException.AssignmentsRemain)
        {
            var reported = ex.AssignmentCount is > 0 ? ex.AssignmentCount.Value : 1;
            await ReloadAfterDeleteConflictAsync();
            if (_assignments is not { Count: > 0 })
                _unconfirmedAssignmentCount = reported;
            var count = _assignments is { Count: > 0 } ? _assignments.Count : reported;
            await InvokeAsync(StateHasChanged);
            throw new InvalidOperationException(BlockedDeleteMessage(count));
        }
        catch (RoleLifecycleConflictException ex) when (ex.Code == RoleLifecycleConflictException.SystemRole)
        {
            await ReloadAfterDeleteConflictAsync();
            _confirmDeleteOpen = false;
            Toasts.Show(ToastSeverity.Error, BuiltInRoleNotice, "Delete role");
            await InvokeAsync(StateHasChanged);
            return;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            throw new HttpRequestException("You do not have permission to delete this role.", ex, HttpStatusCode.Forbidden);
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.NotFound)
        {
            ShowRoleGone();
            await InvokeAsync(StateHasChanged);
            return;
        }
        catch (InvalidOperationException ex) when (ex.Message.Contains("not found", StringComparison.OrdinalIgnoreCase))
        {
            ShowRoleGone();
            await InvokeAsync(StateHasChanged);
            return;
        }

        Toasts.Show(ToastSeverity.Success, "Role deleted.", "Governance");
        _confirmDeleteOpen = false;
        Nav.NavigateTo("/config/governance/roles");
    }

    private async Task ReloadAfterDeleteConflictAsync()
    {
        try
        {
            var fresh = await Client.GetRoleAsync(RoleId);
            if (fresh is null)
            {
                ShowRoleGone();
                return;
            }

            _detail = fresh;
            SyncDraftsFromDetail();
            await LoadAssignmentsAsync();
            PublishShellTitle();
        }
        catch (HttpRequestException)
        {
            // Keep the role already on screen. The conflict message still explains the refusal.
        }
    }

    private void ShowRoleGone()
    {
        _confirmDeleteOpen = false;
        _editing = false;
        _detail = null;
        _assignments = null;
        _error = "Role not found.";
        Toasts.Show(ToastSeverity.Warning, "This role no longer exists.", "Delete role");
        PublishShellTitle();
    }

    private static string BlockedDeleteMessage(int count) =>
        count == 1
            ? "This role is assigned to 1 person. Remove that assignment before deleting it. Deletion does not remove assignments."
            : $"This role is assigned to {count} people. Remove those assignments before deleting it. Deletion does not remove assignments.";

    private static UserReferenceDto HolderReference(RoleAssignmentHolderDto holder) =>
        new(holder.UserId, holder.Username, holder.DisplayName);
}
