@page "/governance/roles/{RoleId}"
@using System.Net
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Shared
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities

<div class="p-4">
    <div class="flex items-center justify-between gap-3">
        <div class="min-w-0">
            <div class="text-xs text-muted mb-1"><a href="/governance/roles" class="hover:underline">Roles</a> / Role detail</div>
            <h1 class="text-xl font-semibold text-heading">Role</h1>
            <div class="mt-1 font-mono text-xs text-muted break-all">@RoleId</div>
        </div>
        <div class="flex items-center gap-2">
            <a href="/governance/roles" class="rounded bg-surface-muted px-3 py-2 text-sm text-body hover:bg-surface">Back to roles</a>
            @if (_capabilities?.CanAssignPermissions == true && _detail is not null && !_detail.IsSystemRole && !_editing)
            {
                <button class="rounded bg-surface-muted px-3 py-2 text-sm text-body hover:bg-surface"
                        title="Edit role permissions"
                        @onclick="StartEdit">
                    Edit permissions
                </button>
            }
            <a href="@Epic33UiDisplayHelpers.GetGovernanceAuditLink()" class="rounded bg-surface-muted px-3 py-2 text-sm text-body hover:bg-surface">View governance audit history</a>
            <button class="rounded bg-surface-muted px-3 py-2 text-sm text-body hover:bg-surface"
                    disabled="@_loading"
                    @onclick="LoadAsync">
                Refresh
            </button>
        </div>
    </div>

    @if (!_capabilitiesLoaded)
    {
        <div class="mt-4 text-sm text-muted">Loading...</div>
    }
    else if (_capabilities?.CanViewGovernance != true)
    {
        <div class="mt-4 rounded border border-default bg-surface px-3 py-2 text-sm text-body">
            <div class="font-semibold">Not authorized</div>
            <div class="text-muted">You do not have permission to view this role.</div>
        </div>
    }
    else if (_forbidden)
    {
        <div class="mt-4 rounded border border-default bg-surface px-3 py-2 text-sm text-body">
            <div class="font-semibold">Not authorized</div>
            <div class="text-muted">You do not have permission to view this role.</div>
        </div>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <div class="mt-4 rounded border border-default bg-surface px-3 py-2 text-sm text-body">
            <div class="font-semibold">Error</div>
            <div class="text-muted">@_error</div>
        </div>
    }
    else if (_detail is null)
    {
        <div class="mt-4 text-sm text-muted">Loading...</div>
    }
    else if (_editing)
    {
        <div class="mt-4 rounded border border-default bg-surface p-3">
            <h2 class="text-sm font-semibold text-heading mb-2">Edit permissions</h2>
            <div class="rounded border border-amber-200 bg-amber-50 dark:border-amber-800 dark:bg-amber-950/30 px-3 py-2 text-xs text-body mb-3">
                <strong>Saving replaces the role's entire permission set</strong> with the selections below. Permissions not selected will be revoked. Changes apply to the role as currently loaded.
            </div>
            @if (_catalog is null || !string.IsNullOrEmpty(_error))
            {
                <div class="text-sm text-muted">@(string.IsNullOrEmpty(_error) ? "Loading catalog..." : _error)</div>
                <div class="mt-2 text-xs text-muted">Save is disabled until the catalog loads. Use Cancel to exit edit mode.</div>
            }
            else
            {
                <div class="max-h-96 overflow-y-auto space-y-2">
                    @foreach (var perm in _catalog.Permissions)
                    {
                        var key = PermissionKey(perm);
                        var isChecked = _selectedPermissions.Contains(key);
                        <div class="flex items-center gap-2 py-1">
                            <input type="checkbox" id="@key" checked="@isChecked" @onchange="@(() => TogglePermission(key))" />
                            <label for="@key" class="text-sm font-mono">@perm.Action @(perm.ResourceType ?? "") @(perm.ScopeKey ?? "")</label>
                            @if (!string.IsNullOrEmpty(perm.ModuleId))
                            {
                                <span class="text-xs text-muted">(@perm.ModuleId)</span>
                            }
                        </div>
                    }
                </div>
                <div class="mt-3 flex gap-2">
                    <button class="rounded bg-surface-muted px-3 py-2 text-sm text-body hover:bg-surface"
                            disabled="@(_loading || _catalog is null)"
                            title="@(_catalog is null ? "Catalog must load before saving" : "Save overwrites entire permission set")"
                            @onclick="SaveEditAsync">
                        Save
                    </button>
                    <button class="rounded bg-surface-muted px-3 py-2 text-sm text-body hover:bg-surface"
                            disabled="@_loading"
                            @onclick="CancelEdit">
                        Cancel
                    </button>
                </div>
            }
        </div>
    }
    else
    {
        <div class="mt-4 grid gap-4">
            <div class="rounded border border-default bg-surface p-3">
                <div class="text-sm font-semibold text-heading">Details</div>
                <div class="mt-2 grid grid-cols-1 gap-2 md:grid-cols-2">
                    <div>
                        <div class="text-xs text-muted">Name</div>
                        <div class="text-sm text-body">@_detail.Name</div>
                    </div>
                    <div>
                        <div class="text-xs text-muted">Description</div>
                        <div class="text-sm text-body">@(_detail.Description ?? "-")</div>
                    </div>
                    <div>
                        <div class="text-xs text-muted">System role</div>
                        <div class="text-sm text-body">@(_detail.IsSystemRole ? "Yes" : "No")</div>
                    </div>
                </div>
                @if (_detail.IsSystemRole)
                {
                    <div class="mt-3 rounded border border-amber-200 bg-amber-50 dark:border-amber-800 dark:bg-amber-950/30 px-3 py-2 text-xs text-body">
                        System roles are not editable from this UI. Their permissions are managed by the platform.
                    </div>
                }
            </div>

            <div class="rounded border border-default bg-surface p-3">
                <div class="text-sm font-semibold text-heading">Granted permissions</div>
                @if (_detail.Permissions.Count == 0)
                {
                    <div class="mt-2 text-xs text-muted">No permissions granted.</div>
                }
                else
                {
                    <div class="mt-2 overflow-x-auto">
                        <table class="min-w-full text-left text-sm text-body">
                            <thead class="border-b border-default text-xs text-muted">
                                <tr>
                                    <th class="px-2 py-2">Action</th>
                                    <th class="px-2 py-2">Resource Type</th>
                                    <th class="px-2 py-2">Scope Key</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in _detail.Permissions)
                                {
                                    <tr class="border-b border-default hover:bg-surface-muted">
                                        <td class="px-2 py-2 font-mono text-xs">@p.Action</td>
                                        <td class="px-2 py-2 font-mono text-xs">@(p.ResourceType ?? "-")</td>
                                        <td class="px-2 py-2 font-mono text-xs">@(p.ScopeKey ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string RoleId { get; set; } = "";

    private RoleDetailDto? _detail;
    private GovernanceDescriptorResponse? _catalog;
    private bool _loading;
    private bool _forbidden;
    private string? _error;
    private bool _editing;
    private HashSet<string> _selectedPermissions = new();
    private OperatorCapabilitiesDto? _capabilities;
    private bool _capabilitiesLoaded;

    protected override async Task OnInitializedAsync()
    {
        try { _capabilities = await Capabilities.GetCapabilitiesAsync(); } catch { _capabilities = new OperatorCapabilitiesDto(false, false, false, false, false, false, false); }
        _capabilitiesLoaded = true;
        await LoadAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_capabilitiesLoaded)
            await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_capabilities?.CanViewGovernance != true) return;

        _loading = true;
        _error = null;
        _forbidden = false;
        _editing = false;
        try
        {
            _detail = await Client.GetRoleAsync(RoleId);
            if (_detail is null)
                _error = "Role not found.";
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            _forbidden = true;
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task StartEdit()
    {
        if (_detail is null || _detail.IsSystemRole) return;
        _error = null;
        _loading = true;
        try
        {
            var fresh = await Client.GetRoleAsync(RoleId);
            if (fresh is null) { _error = "Role not found."; return; }
            _detail = fresh;
            _catalog = await Client.GetGovernanceDescriptorsAsync();
            if (_catalog is null) { _error = "Failed to load permission catalog."; return; }
            _selectedPermissions = _detail.Permissions.Select(p => PermissionKeyFromEntry(p)).ToHashSet();
            _editing = true;
        }
        catch
        {
            _error = "Failed to load role or catalog. Cannot enter edit mode.";
        }
        finally
        {
            _loading = false;
        }
    }

    private void CancelEdit()
    {
        _editing = false;
        _catalog = null;
    }

    private void TogglePermission(string key)
    {
        if (_selectedPermissions.Contains(key))
            _selectedPermissions.Remove(key);
        else
            _selectedPermissions.Add(key);
    }

    private static string PermissionKey(PermissionCatalogEntryDto p) =>
        $"{p.Action}|{p.ResourceType ?? ""}|{p.ScopeKey ?? ""}";

    private static string PermissionKeyFromEntry(RolePermissionEntryDto p) =>
        $"{p.Action}|{p.ResourceType ?? ""}|{p.ScopeKey ?? ""}";

    private async Task SaveEditAsync()
    {
        if (_detail is null || _detail.IsSystemRole || _catalog is null) return;

        _loading = true;
        _error = null;
        try
        {
            var permissions = _catalog.Permissions
                .Where(p => _selectedPermissions.Contains(PermissionKey(p)))
                .Select(p => new RolePermissionDto(p.Action, p.ResourceType, p.ScopeKey))
                .ToList();
            await Client.SetRolePermissionsAsync(RoleId, new SetRolePermissionsRequest(permissions));
            _editing = false;
            _catalog = null;
            await LoadAsync();
        }
        catch (InvalidOperationException ex)
        {
            _error = ex.Message;
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            _error = "Not authorized to assign permissions.";
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
