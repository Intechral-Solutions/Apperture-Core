@page "/config/governance/catalog"
@layout ConfigLayout
@using System.Net
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Organisms
@using Apperture.Management.Ui.Client.Molecules
@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Shared
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities

<div class="p-4 ui-page-stack">
    <PageHeader Eyebrow="Config — Governance"
                Title="Permission catalog"
                Subtitle="Resources and permissions from the governance catalog. Source and module attribution where available.">
        <Toolbar>
            <a href="@Epic33UiDisplayHelpers.GetGovernanceAuditLink()" class="ui-toolbar-btn">View governance audit history</a>
            <button type="button"
                    class="ui-toolbar-btn"
                    disabled="@_loading"
                    @onclick="LoadAsync">
                Refresh
            </button>
        </Toolbar>
    </PageHeader>

    @if (!_capabilitiesLoaded)
    {
        <LoadingState Message="Loading…" />
    }
    else if (_capabilities?.CanViewGovernance != true)
    {
        <ForbiddenState Message="You do not have permission to view the governance catalog." />
    }
    else if (_forbidden)
    {
        <ForbiddenState Message="You do not have permission to view the governance catalog." />
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <ErrorState Message="@_error" />
    }
    else if (_catalog is null)
    {
        <LoadingState Message="Loading…" />
    }
    else
    {
        <div class="space-y-6">
            <ManagementSection Title="Resources" Layer="ManagementSection.UiLayer.Detail">
                @if (_catalog.Resources.Count == 0)
                {
                    <div class="text-xs text-muted">No resources in catalog.</div>
                }
                else
                {
                    <div class="ui-data-table">
                        <table class="ui-data-table__table min-w-full text-left text-body">
                            <thead>
                                <tr>
                                    <th>Resource type</th>
                                    <th>Scope key</th>
                                    <th>Family</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in _catalog.Resources)
                                {
                                    <tr>
                                        <td class="font-mono text-xs">@r.ResourceType</td>
                                        <td class="font-mono text-xs">@r.ScopeKey</td>
                                        <td class="text-xs">@(r.Family ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </ManagementSection>

            <ManagementSection Title="Permissions" Layer="ManagementSection.UiLayer.Detail">
                @if (_catalog.Permissions.Count == 0)
                {
                    <div class="text-xs text-muted">No permissions in catalog.</div>
                }
                else
                {
                    <div class="ui-data-table">
                        <table class="ui-data-table__table min-w-full text-left text-body">
                            <thead>
                                <tr>
                                    <th>Action</th>
                                    <th>Resource type</th>
                                    <th>Scope key</th>
                                    <th>Family</th>
                                    <th>Source</th>
                                    <th>Module</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in _catalog.Permissions)
                                {
                                    <tr>
                                        <td class="font-mono text-xs">@p.Action</td>
                                        <td class="font-mono text-xs">@(p.ResourceType ?? "-")</td>
                                        <td class="font-mono text-xs">@(p.ScopeKey ?? "-")</td>
                                        <td class="text-xs">@(p.Family ?? "-")</td>
                                        <td class="text-xs">@p.Source</td>
                                        <td class="text-xs">@(p.ModuleId ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </ManagementSection>
        </div>
    }
</div>

@code {
    private GovernanceDescriptorResponse? _catalog;
    private bool _loading;
    private bool _forbidden;
    private string? _error;
    private OperatorCapabilitiesDto? _capabilities;
    private bool _capabilitiesLoaded;

    protected override async Task OnInitializedAsync()
    {
        try { _capabilities = await Capabilities.GetCapabilitiesAsync(); } catch { _capabilities = new OperatorCapabilitiesDto(false, false, false, false, false, false, false); }
        _capabilitiesLoaded = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_capabilities?.CanViewGovernance != true) return;

        _loading = true;
        _error = null;
        _forbidden = false;
        try
        {
            _catalog = await Client.GetGovernanceDescriptorsAsync();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            _forbidden = true;
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
