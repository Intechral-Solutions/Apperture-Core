@page "/config/governance/catalog"
@layout ConfigLayout
@using System.Net
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Shared
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities

<div class="p-4">
    <div class="flex items-center justify-between gap-3">
        <div class="min-w-0">
            <div class="text-xs text-muted mb-1">Config — Governance — Permission catalog</div>
            <h1 class="text-xl font-semibold text-heading">Permission Catalog</h1>
            <div class="text-xs text-muted">Resources and permissions from the governance catalog. Source and module attribution where available.</div>
        </div>
        <div class="flex items-center gap-2">
            <a href="@Epic33UiDisplayHelpers.GetGovernanceAuditLink()" class="rounded bg-surface-muted px-3 py-2 text-sm text-body hover:bg-surface">View governance audit history</a>
            <button class="rounded bg-surface-muted px-3 py-2 text-sm text-body hover:bg-surface"
                    disabled="@_loading"
                    @onclick="LoadAsync">
                Refresh
            </button>
        </div>
    </div>

    @if (!_capabilitiesLoaded)
    {
        <div class="mt-4 text-sm text-muted">Loading...</div>
    }
    else if (_capabilities?.CanViewGovernance != true)
    {
        <div class="mt-4 rounded border border-default bg-surface px-3 py-2 text-sm text-body">
            <div class="font-semibold">Not authorized</div>
            <div class="text-muted">You do not have permission to view the governance catalog.</div>
        </div>
    }
    else if (_forbidden)
    {
        <div class="mt-4 rounded border border-default bg-surface px-3 py-2 text-sm text-body">
            <div class="font-semibold">Not authorized</div>
            <div class="text-muted">You do not have permission to view the governance catalog.</div>
        </div>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <div class="mt-4 rounded border border-default bg-surface px-3 py-2 text-sm text-body">
            <div class="font-semibold">Error</div>
            <div class="text-muted">@_error</div>
        </div>
    }
    else if (_catalog is null)
    {
        <div class="mt-4 text-sm text-muted">Loading...</div>
    }
    else
    {
        <div class="mt-4 space-y-6">
            <div class="rounded border border-default bg-surface p-3">
                <h2 class="text-sm font-semibold text-heading mb-2">Resources</h2>
                @if (_catalog.Resources.Count == 0)
                {
                    <div class="text-xs text-muted">No resources in catalog.</div>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="min-w-full text-left text-sm text-body">
                            <thead class="border-b border-default text-xs text-muted">
                                <tr>
                                    <th class="px-2 py-2">Resource Type</th>
                                    <th class="px-2 py-2">Scope Key</th>
                                    <th class="px-2 py-2">Family</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in _catalog.Resources)
                                {
                                    <tr class="border-b border-default hover:bg-surface-muted">
                                        <td class="px-2 py-2 font-mono text-xs">@r.ResourceType</td>
                                        <td class="px-2 py-2 font-mono text-xs">@r.ScopeKey</td>
                                        <td class="px-2 py-2 text-xs">@(r.Family ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>

            <div class="rounded border border-default bg-surface p-3">
                <h2 class="text-sm font-semibold text-heading mb-2">Permissions</h2>
                @if (_catalog.Permissions.Count == 0)
                {
                    <div class="text-xs text-muted">No permissions in catalog.</div>
                }
                else
                {
                    <div class="overflow-x-auto">
                        <table class="min-w-full text-left text-sm text-body">
                            <thead class="border-b border-default text-xs text-muted">
                                <tr>
                                    <th class="px-2 py-2">Action</th>
                                    <th class="px-2 py-2">Resource Type</th>
                                    <th class="px-2 py-2">Scope Key</th>
                                    <th class="px-2 py-2">Family</th>
                                    <th class="px-2 py-2">Source</th>
                                    <th class="px-2 py-2">Module</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in _catalog.Permissions)
                                {
                                    <tr class="border-b border-default hover:bg-surface-muted">
                                        <td class="px-2 py-2 font-mono text-xs">@p.Action</td>
                                        <td class="px-2 py-2 font-mono text-xs">@(p.ResourceType ?? "-")</td>
                                        <td class="px-2 py-2 font-mono text-xs">@(p.ScopeKey ?? "-")</td>
                                        <td class="px-2 py-2 text-xs">@(p.Family ?? "-")</td>
                                        <td class="px-2 py-2 text-xs">@p.Source</td>
                                        <td class="px-2 py-2 text-xs">@(p.ModuleId ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private GovernanceDescriptorResponse? _catalog;
    private bool _loading;
    private bool _forbidden;
    private string? _error;
    private OperatorCapabilitiesDto? _capabilities;
    private bool _capabilitiesLoaded;

    protected override async Task OnInitializedAsync()
    {
        try { _capabilities = await Capabilities.GetCapabilitiesAsync(); } catch { _capabilities = new OperatorCapabilitiesDto(false, false, false, false, false, false, false); }
        _capabilitiesLoaded = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_capabilities?.CanViewGovernance != true) return;

        _loading = true;
        _error = null;
        _forbidden = false;
        try
        {
            _catalog = await Client.GetGovernanceDescriptorsAsync();
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            _forbidden = true;
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
