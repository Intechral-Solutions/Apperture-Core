@page "/config/governance/users/{UserId}/role-derived-access"
@layout ConfigLayout
@using System.Net
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Molecules
@using Apperture.Management.Ui.Client.Organisms
@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Shared
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities
@inject NavigationManager Nav
@inject ShellOrientationService ShellOrientation

<div class="p-4">
    <PageHeader @key="@UserId"
                Title="@EntityShellTitles.Detail(_userDisplayName, "User")"
                Subtitle="Role-derived access">
        <ChildContent>
            <div class="mt-1 text-xs text-muted break-all">
                @if (_username is not null)
                {
                    <span class="font-mono">@_username</span><span> — </span>
                }
                Merged permissions from assigned roles only
            </div>
        </ChildContent>
        <Toolbar>
            <a href="@("/config/governance/users/" + Uri.EscapeDataString(UserId))" class="ui-toolbar-btn">Manage role assignments</a>
            <a href="/config/governance/users" class="ui-toolbar-btn">Back to users</a>
            <button type="button"
                    class="ui-toolbar-btn"
                    disabled="@_loading"
                    @onclick="LoadAsync">
                Refresh
            </button>
        </Toolbar>
    </PageHeader>

    <div class="ui-settings-callout">
        This page shows <strong>merged permissions from assigned roles only</strong>. It is not a complete effective-access model: direct user grants, scope containment, and service principals are excluded.
    </div>

    @if (!_capabilitiesLoaded)
    {
        <LoadingState Message="Loading…" />
    }
    else if (_capabilities?.CanViewGovernance != true)
    {
        <ForbiddenState Message="You do not have permission to view effective access." />
    }
    else if (_forbidden)
    {
        <ForbiddenState Message="You do not have permission to view effective access." />
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <ErrorState Message="@_error" />
    }
    else if (_access is null)
    {
        <LoadingState Message="Loading…" />
    }
    else
    {
        <div class="mt-4 grid gap-4">
            <ManagementSection Title="User and roles" Layer="ManagementSection.UiLayer.Summary">
                <MetadataGrid>
                    <MetadataItem Label="Username" Monospace="true" Value="@(_username ?? "-")" />
                    <MetadataItem Label="Roles" Value="@(string.Join(", ", _access.RoleIds) != "" ? string.Join(", ", _access.RoleIds) : "(none)")" />
                </MetadataGrid>
                <TechnicalDetails Dense="true" Class="mt-3">
                    <TechnicalDetail Label="User ID" Value="@_access.UserId" />
                </TechnicalDetails>
            </ManagementSection>

            <ManagementSection Title="Merged permissions" Layer="ManagementSection.UiLayer.Detail">
                @if (_access.Permissions.Count == 0)
                {
                    <div class="text-xs text-muted">No permissions (user has no roles or roles have no permissions).</div>
                }
                else
                {
                    <div class="ui-data-table">
                        <table class="ui-data-table__table min-w-full text-left text-body">
                            <thead>
                                <tr>
                                    <th>Action</th>
                                    <th>Resource type</th>
                                    <th>Scope key</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in _access.Permissions)
                                {
                                    <tr>
                                        <td class="font-mono text-xs">@p.Action</td>
                                        <td class="font-mono text-xs">@(p.ResourceType ?? "-")</td>
                                        <td class="font-mono text-xs">@(p.ScopeKey ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </ManagementSection>
        </div>
    }
</div>

@code {
    [Parameter] public string UserId { get; set; } = "";

    private PrincipalEffectiveAccessDto? _access;
    private string? _userDisplayName;
    private string? _username;
    private bool _loading;
    private bool _forbidden;
    private string? _error;
    private OperatorCapabilitiesDto? _capabilities;
    private bool _capabilitiesLoaded;
    private string? _dataLoadKey;

    protected override async Task OnInitializedAsync()
    {
        try { _capabilities = await Capabilities.GetCapabilitiesAsync(); } catch { _capabilities = new OperatorCapabilitiesDto(false, false, false, false, false, false, false); }
        _capabilitiesLoaded = true;
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        if (!_capabilitiesLoaded)
            return;
        var key = UserId ?? "";
        if (key == _dataLoadKey)
            return;
        _dataLoadKey = key;
        _userDisplayName = null;
        _username = null;
        _access = null;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_capabilities?.CanViewGovernance != true) return;

        _loading = true;
        _error = null;
        _forbidden = false;
        try
        {
            var user = await Client.GetUserAsync(UserId);
            _userDisplayName = user?.DisplayName;
            _username = user?.Username;
            _access = await Client.GetEffectiveAccessAsync(UserId);
            if (_access is null)
                _error = "User not found.";
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            _forbidden = true;
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            ShellOrientation.PublishForCurrentUri(
                Nav,
                EntityShellTitles.Detail(_userDisplayName, "User"),
                "Role-derived access");
        }
    }
}
