@page "/config/governance/users"
@layout ConfigLayout
@using System.Net
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Organisms
@using Apperture.Management.Ui.Client.Services
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities
@inject NavigationManager Nav

<div class="p-4 ui-page-stack">
    <PageHeader Eyebrow="Config — Governance"
                Title="Users"
                Subtitle="Users for role-derived access inspection. Use the effective-access link to see merged permissions from assigned roles.">
        <Toolbar>
            @if (_capabilities?.CanManageUsers == true)
            {
                <a href="/config/governance/users/new" class="ui-toolbar-btn">New user</a>
                <a href="/config/governance/users/from-entra" class="ui-toolbar-btn">Add from Microsoft Entra</a>
                <a href="/config/governance/users/requests" class="ui-toolbar-btn">
                    @(_pendingRequestCount > 0 ? $"Requests ({_pendingRequestCount})" : "Requests")
                </a>
            }
            <button type="button"
                    class="ui-toolbar-btn"
                    disabled="@_loading"
                    @onclick="LoadAsync">
                Refresh
            </button>
        </Toolbar>
    </PageHeader>

    @if (!_capabilitiesLoaded)
    {
        <LoadingState Message="Loading…" />
    }
    else if (_capabilities?.CanViewGovernance != true)
    {
        <ForbiddenState Message="You do not have permission to view users." />
    }
    else if (_forbidden)
    {
        <ForbiddenState Message="You do not have permission to view users." />
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <ErrorState Message="@_error" />
    }
    else if (_page is null)
    {
        <LoadingState Message="Loading…" />
    }
    else if (_page.Items.Count == 0)
    {
        <EmptyState Message="No users found." />
    }
    else
    {
        <div class="ui-data-table">
            <table class="ui-data-table__table min-w-full text-left text-body">
                <thead>
                    <tr>
                        <th>Id</th>
                        <th>Display name</th>
                        <th>Local</th>
                        <th>Entra</th>
                        <th>Roles</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in _page.Items)
                    {
                        var userDetailHref = "/config/governance/users/" + Uri.EscapeDataString(u.UserId);
                        <tr class="cursor-pointer" @onclick="() => Nav.NavigateTo(userDetailHref)">
                            <td class="font-mono text-xs"><a href="@userDetailHref" class="underline hover:no-underline" @onclick:stopPropagation>@u.UserId</a></td>
                            <td><a href="@userDetailHref" class="underline hover:no-underline" @onclick:stopPropagation>@u.DisplayName</a></td>
                            <td>@(u.HasLocalLink ? "Yes" : "No")</td>
                            <td>@(u.HasEntraLink ? "Yes" : "No")</td>
                            <td>@(u.RoleIds?.Count ?? 0)</td>
                            <td class="space-x-3">
                                <a href="@userDetailHref" class="underline text-sm" @onclick:stopPropagation>Manage roles</a>
                                <a href="@(userDetailHref + "/role-derived-access")" class="underline text-sm" @onclick:stopPropagation>View role-derived access</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (_page.TotalCount > _page.Items.Count)
        {
            <div class="mt-2 text-xs text-muted">Showing @_page.Items.Count of @_page.TotalCount users.</div>
            <div class="mt-2 flex gap-2">
                <button type="button"
                        class="btn btn-secondary text-xs"
                        disabled="@(_skip == 0)"
                        @onclick="LoadPrevious">
                    Previous
                </button>
                <button type="button"
                        class="btn btn-secondary text-xs"
                        disabled="@(_skip + _page.Items.Count >= _page.TotalCount)"
                        @onclick="LoadNext">
                    Next
                </button>
            </div>
        }
    }
</div>

@code {
    private UserListResponse? _page;
    private int _skip;
    private const int PageSize = 20;
    private bool _loading;
    private bool _forbidden;
    private string? _error;
    private OperatorCapabilitiesDto? _capabilities;
    private bool _capabilitiesLoaded;
    private int _pendingRequestCount;

    protected override async Task OnInitializedAsync()
    {
        try { _capabilities = await Capabilities.GetCapabilitiesAsync(); } catch { _capabilities = new OperatorCapabilitiesDto(false, false, false, false, false, false, false); }
        _capabilitiesLoaded = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_capabilities?.CanViewGovernance != true) return;

        _loading = true;
        _error = null;
        _forbidden = false;
        try
        {
            _page = await Client.GetUserPageAsync(_skip, PageSize);
            if (_capabilities?.CanManageUsers == true)
            {
                try
                {
                    var requests = await Client.GetEntraAccessRequestsAsync();
                    _pendingRequestCount = requests.PendingCount;
                }
                catch
                {
                    _pendingRequestCount = 0;
                }
            }
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            _forbidden = true;
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadPrevious()
    {
        _skip = Math.Max(0, _skip - PageSize);
        await LoadAsync();
    }

    private async Task LoadNext()
    {
        _skip += PageSize;
        await LoadAsync();
    }
}
