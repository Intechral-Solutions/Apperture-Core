@page "/governance/users"
@using System.Net
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Services
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities
@inject NavigationManager Nav

<div class="p-4">
    <div class="flex items-center justify-between gap-3">
        <div class="min-w-0">
            <div class="text-xs text-muted mb-1">Governance — Users</div>
            <h1 class="text-xl font-semibold text-heading">Users</h1>
            <div class="text-xs text-muted">Users for role-derived access inspection. Use the effective-access link to see merged permissions from assigned roles.</div>
        </div>
        <button class="rounded bg-surface-muted px-3 py-2 text-sm text-body hover:bg-surface"
                disabled="@_loading"
                @onclick="LoadAsync">
            Refresh
        </button>
    </div>

    @if (!_capabilitiesLoaded)
    {
        <div class="mt-4 text-sm text-muted">Loading...</div>
    }
    else if (_capabilities?.CanViewGovernance != true)
    {
        <div class="mt-4 rounded border border-default bg-surface px-3 py-2 text-sm text-body">
            <div class="font-semibold">Not authorized</div>
            <div class="text-muted">You do not have permission to view users.</div>
        </div>
    }
    else if (_forbidden)
    {
        <div class="mt-4 rounded border border-default bg-surface px-3 py-2 text-sm text-body">
            <div class="font-semibold">Not authorized</div>
            <div class="text-muted">You do not have permission to view users.</div>
        </div>
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <div class="mt-4 rounded border border-default bg-surface px-3 py-2 text-sm text-body">
            <div class="font-semibold">Error</div>
            <div class="text-muted">@_error</div>
        </div>
    }
    else if (_page is null)
    {
        <div class="mt-4 text-sm text-muted">Loading...</div>
    }
    else if (_page.Items.Count == 0)
    {
        <div class="mt-4 text-sm text-muted">No users found.</div>
    }
    else
    {
        <div class="mt-4 overflow-x-auto rounded border border-default bg-surface">
            <table class="min-w-full text-left text-sm text-body">
                <thead class="border-b border-default text-xs text-muted">
                    <tr>
                        <th class="px-3 py-2">Id</th>
                        <th class="px-3 py-2">Display name</th>
                        <th class="px-3 py-2">Local</th>
                        <th class="px-3 py-2">Entra</th>
                        <th class="px-3 py-2">Roles</th>
                        <th class="px-3 py-2"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in _page.Items)
                    {
                        <tr class="border-b border-default hover:bg-surface-muted">
                            <td class="px-3 py-2 font-mono text-xs">@u.UserId</td>
                            <td class="px-3 py-2">@u.DisplayName</td>
                            <td class="px-3 py-2">@(u.HasLocalLink ? "Yes" : "No")</td>
                            <td class="px-3 py-2">@(u.HasEntraLink ? "Yes" : "No")</td>
                            <td class="px-3 py-2">@(u.RoleIds?.Count ?? 0)</td>
                            <td class="px-3 py-2">
                                <a href="@("/governance/users/" + Uri.EscapeDataString(u.UserId) + "/effective-access")" class="underline text-sm">View role-derived access</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        @if (_page.TotalCount > _page.Items.Count)
        {
            <div class="mt-2 text-xs text-muted">Showing @_page.Items.Count of @_page.TotalCount users.</div>
            <div class="mt-2 flex gap-2">
                <button class="rounded bg-surface-muted px-2 py-1 text-xs hover:bg-surface"
                        disabled="@(_skip == 0)"
                        @onclick="LoadPrevious">
                    Previous
                </button>
                <button class="rounded bg-surface-muted px-2 py-1 text-xs hover:bg-surface"
                        disabled="@(_skip + _page.Items.Count >= _page.TotalCount)"
                        @onclick="LoadNext">
                    Next
                </button>
            </div>
        }
    }
</div>

@code {
    private UserListResponse? _page;
    private int _skip;
    private const int PageSize = 20;
    private bool _loading;
    private bool _forbidden;
    private string? _error;
    private OperatorCapabilitiesDto? _capabilities;
    private bool _capabilitiesLoaded;

    protected override async Task OnInitializedAsync()
    {
        try { _capabilities = await Capabilities.GetCapabilitiesAsync(); } catch { _capabilities = new OperatorCapabilitiesDto(false, false, false, false, false, false, false); }
        _capabilitiesLoaded = true;
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        if (_capabilities?.CanViewGovernance != true) return;

        _loading = true;
        _error = null;
        _forbidden = false;
        try
        {
            _page = await Client.GetUserPageAsync(_skip, PageSize);
        }
        catch (HttpRequestException ex) when (ex.StatusCode == HttpStatusCode.Forbidden)
        {
            _forbidden = true;
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadPrevious()
    {
        _skip = Math.Max(0, _skip - PageSize);
        await LoadAsync();
    }

    private async Task LoadNext()
    {
        _skip += PageSize;
        await LoadAsync();
    }
}
