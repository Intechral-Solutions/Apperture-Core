@page "/demo/nested-nav"
@page "/demo/nested-nav/{*Slugs}"
@using Apperture.Management.Ui.Client.Molecules
@using Apperture.Management.Ui.Client.Organisms

<PageTitle>Nested nav demo</PageTitle>

<div class="p-4 ui-page-stack max-w-2xl">
    <PageHeader Title="Nested navigation demo"
                Eyebrow="Developer"
                Subtitle="One page for every depth. Use Tools in the control panel to open the tree; each level links here with a longer path." />

    <ManagementSection Title="Route state" Layer="ManagementSection.UiLayer.Detail">
        <MetadataGrid>
            <MetadataItem Label="Depth" Value="@_depth.ToString()" />
            <MetadataItem Label="Segments" Value="@(_segments.Length == 0 ? "(none — root)" : string.Join(" → ", _segments))" />
            <MetadataItem Label="Slugs parameter" Monospace="true" Value="@(string.IsNullOrEmpty(Slugs) ? "(empty)" : Slugs)" />
        </MetadataGrid>
    </ManagementSection>
</div>

@code {
    [Parameter] public string? Slugs { get; set; }

    private string[] _segments = Array.Empty<string>();
    private int _depth;

    protected override void OnParametersSet()
    {
        _segments = string.IsNullOrWhiteSpace(Slugs)
            ? Array.Empty<string>()
            : Slugs.Split('/', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        _depth = _segments.Length;
    }
}
