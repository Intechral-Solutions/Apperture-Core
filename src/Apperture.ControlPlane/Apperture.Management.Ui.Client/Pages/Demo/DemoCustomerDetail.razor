@page "/business-data/customers/{BusinessKey}"
@layout ConfigLayout
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities

<div class="p-4 ui-page-stack">
    <PageHeader Title="@(_record is null ? "Demo customer" : DemoCustomerUiHelpers.CustomerDisplayName(_record))"
                Eyebrow="Business Data"
                Subtitle="@DemoCustomerUiHelpers.PageSubtitle">
        <Toolbar>
            <StatusPill Label="@DemoCustomerUiHelpers.DemoBadge" Semantic="@ManagementStatusSemantic.Neutral" />
            <a href="@DemoCustomerUiRoutes.List" class="ui-toolbar-btn text-sm">← Customers</a>
            <button type="button"
                    class="ui-toolbar-btn text-sm"
                    disabled="@_loading"
                    @onclick="LoadAsync">
                Refresh
            </button>
        </Toolbar>
    </PageHeader>

    <PageMessage Kind="PageMessageKind.Info" Message="@DemoCustomerUiHelpers.DemoScopeBanner" />

    @if (!_capabilitiesLoaded)
    {
        <LoadingState Message="Loading…" />
    }
    else if (!_canView)
    {
        <ForbiddenState Message="@DemoCustomerUiHelpers.ForbiddenMessage" />
    }
    else if (!string.IsNullOrEmpty(_loadError))
    {
        <ErrorState Message="@_loadError">
            <button type="button" class="mt-3 ui-toolbar-btn" @onclick="LoadAsync">Try again</button>
        </ErrorState>
    }
    else if (_loading)
    {
        <LoadingState Message="Loading demo customer…" />
    }
    else if (_notFound)
    {
        <EmptyState Title="Customer not found" Message="@DemoCustomerUiHelpers.NotFoundMessage">
            <a href="@DemoCustomerUiRoutes.List" class="mt-3 inline-block ui-toolbar-btn">Back to list</a>
        </EmptyState>
    }
    else if (_record is not null)
    {
        <ManagementSection Title="Customer" Layer="@ManagementSection.UiLayer.Summary">
            <div class="mb-3 flex flex-wrap items-center gap-2">
                <StatusPill Label="@DemoCustomerUiHelpers.FormatSourceCount(_record.SourceCount)"
                            Semantic="ManagementStatusSemantic.Neutral" />
                <StatusPill Label="@(_record.HasConflict ? "Has conflicts" : "No conflicts")"
                            Semantic="@DemoCustomerUiHelpers.ConflictSemantic(_record.HasConflict)" />
            </div>
            <dl class="grid grid-cols-1 gap-3 text-sm md:grid-cols-2">
                <div>
                    <dt class="text-xs text-muted">Customer</dt>
                    <dd class="font-medium text-heading">@DemoCustomerUiHelpers.CustomerDisplayName(_record)</dd>
                </div>
                <div>
                    <dt class="text-xs text-muted">Business key</dt>
                    <dd class="font-mono text-body">@_record.BusinessKey</dd>
                </div>
                <div>
                    <dt class="text-xs text-muted">Email</dt>
                    <dd class="break-all text-body">@(_record.PrimaryEmail ?? "—")</dd>
                </div>
                <div>
                    <dt class="text-xs text-muted">Status</dt>
                    <dd class="text-body">@(_record.PrimaryStatus ?? "—")</dd>
                </div>
                <div>
                    <dt class="text-xs text-muted">Last observed</dt>
                    <dd class="text-body">
                        <TimestampDisplay Value="@_record.LastObservedAtUtc" ShowUtcDetail="true" />
                    </dd>
                </div>
                @if (_record.HasConflict && !string.IsNullOrWhiteSpace(_record.PrimaryConflictSummary))
                {
                    <div class="md:col-span-2">
                        <dt class="text-xs text-muted">Conflict summary</dt>
                        <dd class="text-body">@_record.PrimaryConflictSummary</dd>
                    </div>
                }
            </dl>
        </ManagementSection>

        <ManagementSection Title="@DemoCustomerActivityUiHelpers.SummaryTitle" Layer="@ManagementSection.UiLayer.Summary">
            @if (_activitySummaryError is not null)
            {
                <PageMessage Kind="PageMessageKind.Warning" Message="@_activitySummaryError" />
            }
            else if (_activitySummary is null)
            {
                <p class="text-sm text-muted">Loading activity summary…</p>
            }
            else
            {
                <div class="flex flex-wrap items-center justify-between gap-3">
                    <div class="space-y-1 text-sm">
                        <div class="font-medium text-heading">@DemoCustomerActivityUiHelpers.FormatSummaryLine(_activitySummary)</div>
                        @if (_activitySummary.LatestOccurredAtUtc is not null)
                        {
                            <div class="text-muted">
                                Latest:
                                <TimestampDisplay Value="@_activitySummary.LatestOccurredAtUtc" ShowUtcDetail="true" />
                            </div>
                        }
                        else
                        {
                            <div class="text-muted">@DemoCustomerActivityUiHelpers.EmptyMessage</div>
                        }
                    </div>
                    <a class="ui-toolbar-btn text-sm"
                       href="@DemoCustomerUiRoutes.Activity(_record.BusinessKey)">
                        View activity
                    </a>
                </div>
            }
        </ManagementSection>

        <ManagementSection Title="Conflicts" Layer="@ManagementSection.UiLayer.Summary">
            @if (!_record.HasConflict || _record.Conflicts.Count == 0)
            {
                <PageMessage Kind="PageMessageKind.Info"
                             Message="No soft conflicts across observed sources." />
            }
            else
            {
                <div class="space-y-3">
                    @foreach (var conflict in _record.Conflicts)
                    {
                        <div class="ui-detail-block">
                            <div class="flex flex-wrap items-center gap-2">
                                <StatusPill Label="@DemoCustomerUiHelpers.FormatFieldLabel(conflict.Field)"
                                            Semantic="ManagementStatusSemantic.Warning" />
                                <span class="text-sm text-body">@conflict.Message</span>
                            </div>
                            <ul class="mt-2 space-y-1 text-sm text-body">
                                @foreach (var pair in conflict.ValuesBySource.OrderBy(kv => kv.Key, StringComparer.OrdinalIgnoreCase))
                                {
                                    <li>
                                        <span class="text-muted">@pair.Key:</span>
                                        <span class="break-all">@pair.Value</span>
                                    </li>
                                }
                            </ul>
                        </div>
                    }
                </div>
                <p class="mt-3 text-xs text-muted">Conflicts are informational only — resolution is not implemented in this demo.</p>
            }
        </ManagementSection>

        <ManagementSection Title="Sources" Layer="@ManagementSection.UiLayer.Summary">
            <p class="mb-3 text-sm text-muted">
                Each observation is the latest known view from a sample module/integration.
            </p>
            <div class="space-y-3">
                @foreach (var source in _record.Sources)
                {
                    var integrationHref = DemoCustomerUiHelpers.TryGetIntegrationHref(source.IntegrationId);
                    <div class="ui-detail-block">
                        <div class="flex flex-wrap items-start justify-between gap-2">
                            <div>
                                <div class="font-medium text-heading">@source.SourceKindLabel</div>
                                <div class="text-xs text-muted">
                                    @(string.IsNullOrWhiteSpace(source.ModuleId) ? "—" : source.ModuleId)
                                    @if (!string.IsNullOrWhiteSpace(source.IntegrationId))
                                    {
                                        <span>· @source.IntegrationId</span>
                                    }
                                </div>
                            </div>
                            <div class="flex flex-wrap gap-2">
                                @{
                                    var affectedHref = AffectedRecordNavigation.BuildDemoCustomerSourceHref(
                                        _record.BusinessKey,
                                        source.RunId,
                                        source.OperationGroupId,
                                        source.OperationItemId);
                                    var affectedLabel = AffectedRecordNavigation.ResolveDemoCustomerSourceLinkLabel(
                                        source.RunId,
                                        source.OperationGroupId,
                                        source.OperationItemId);
                                }
                                @if (affectedHref is not null)
                                {
                                    <a class="text-link text-sm" href="@affectedHref">@affectedLabel</a>
                                }
                                @if (integrationHref is not null)
                                {
                                    <a class="text-link text-sm" href="@integrationHref">Open integration</a>
                                }
                            </div>
                        </div>

                        <dl class="mt-3 grid grid-cols-1 gap-2 text-sm md:grid-cols-2">
                            <div>
                                <dt class="text-xs text-muted">Display name</dt>
                                <dd>@(source.DisplayName ?? "—")</dd>
                            </div>
                            <div>
                                <dt class="text-xs text-muted">Email</dt>
                                <dd class="break-all">@(source.Email ?? "—")</dd>
                            </div>
                            <div>
                                <dt class="text-xs text-muted">Status</dt>
                                <dd>@(source.Status ?? "—")</dd>
                            </div>
                            <div>
                                <dt class="text-xs text-muted">Change kind</dt>
                                <dd>@(source.ChangeKind ?? "—")</dd>
                            </div>
                            <div>
                                <dt class="text-xs text-muted">Observed</dt>
                                <dd><TimestampDisplay Value="@source.ObservedAtUtc" ShowUtcDetail="true" /></dd>
                            </div>
                            <div>
                                <dt class="text-xs text-muted">Provenance</dt>
                                <dd class="text-muted">@source.ProvenanceLabel</dd>
                            </div>
                        </dl>

                        <TechnicalDetails Class="mt-3">
                            <ChildContent>
                                <TechnicalDetail Label="Run ID" Value="@source.RunId" />
                                <TechnicalDetail Label="Operation item ID" Value="@source.OperationItemId" />
                                <TechnicalDetail Label="Operation group ID" Value="@source.OperationGroupId" />
                                <TechnicalDetail Label="Module ID" Value="@source.ModuleId" />
                                <TechnicalDetail Label="Integration ID" Value="@source.IntegrationId" />
                                <TechnicalDetail Label="Operation kind" Value="@source.OperationKind" />
                            </ChildContent>
                            <Note>
                                Open affected record focuses the matching group and item on Run Detail when those identifiers are present.
                            </Note>
                        </TechnicalDetails>
                    </div>
                }
            </div>
        </ManagementSection>
    }
</div>

@code {
    [Parameter] public string BusinessKey { get; set; } = "";

    private bool _capabilitiesLoaded;
    private bool _canView;
    private bool _loading = true;
    private bool _notFound;
    private string? _loadError;
    private DemoCustomerRecordDto? _record;
    private DemoCustomerActivitySummaryDto? _activitySummary;
    private string? _activitySummaryError;

    protected override async Task OnParametersSetAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _loadError = null;
        _notFound = false;
        _record = null;
        _activitySummary = null;
        _activitySummaryError = null;

        var caps = await Capabilities.GetCapabilitiesAsync();
        _canView = caps.CanViewIntegrations;
        _capabilitiesLoaded = true;
        if (!_canView)
        {
            _loading = false;
            return;
        }

        if (string.IsNullOrWhiteSpace(BusinessKey))
        {
            _notFound = true;
            _loading = false;
            return;
        }

        try
        {
            var dto = await Client.GetDemoCustomerRecordAsync(BusinessKey);
            if (dto is null)
            {
                // Client maps 401/403/404 to null; with CanViewIntegrations treat as not found.
                _notFound = true;
            }
            else
            {
                _record = dto;
                try
                {
                    _activitySummary = await Client.GetDemoCustomerActivitySummaryAsync(dto.BusinessKey);
                }
                catch (Exception)
                {
                    _activitySummaryError = DemoCustomerActivityUiHelpers.LoadErrorMessage;
                }
            }
        }
        catch (HttpRequestException ex)
        {
            _loadError = string.IsNullOrWhiteSpace(ex.Message)
                ? DemoCustomerUiHelpers.LoadErrorMessage
                : ex.Message;
        }
        catch (Exception)
        {
            _loadError = DemoCustomerUiHelpers.LoadErrorMessage;
        }
        finally
        {
            _loading = false;
        }
    }
}
