@page "/schedules/{ScheduleId}"
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Shared
@using Apperture.Management.Ui.Client.Organisms
@using Apperture.Management.Ui.Client.Molecules
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities
@inject NavigationManager Nav
@inject ShellOrientationService ShellOrientation

<div class="p-4 ui-page-stack">
    <PageHeader @key="@ScheduleId"
                Eyebrow="Schedules"
                Title="@ScheduleHeaderTitle"
                Subtitle="@ScheduleHeaderSubtitle">
        <ChildContent>
            <OwnershipChip ResourceContextId="@_detail?.ResourceContextId" />
        </ChildContent>
        <Toolbar>
            <a href="/schedules" class="ui-toolbar-btn">Back to list</a>
            @if (_capabilities?.CanManageSchedules == true && !_editing)
            {
                <button type="button"
                        class="ui-toolbar-btn"
                        title="Edit schedule"
                        @onclick="StartEdit">
                    Edit
                </button>
            }
            @if (_capabilities?.CanManageSchedules == true)
            {
                <button type="button"
                        class="ui-toolbar-btn"
                        disabled="@(_loading || (_detail?.Enabled == true))"
                        title="Enable this schedule"
                        @onclick="EnableAsync">
                    Enable
                </button>
                <button type="button"
                        class="ui-toolbar-btn"
                        disabled="@(_loading || (_detail?.Enabled != true))"
                        title="Disable this schedule"
                        @onclick="DisableAsync">
                    Disable
                </button>
            }
            @if (_capabilities?.CanManageRecovery == true)
            {
                <button type="button"
                        class="ui-toolbar-btn"
                        disabled="@_loading"
                        title="@Epic33UiDisplayHelpers.ScheduleActionButtonTitle"
                        @onclick="TriggerRunCycleAsync">
                    @Epic33UiDisplayHelpers.ScheduleActionButtonLabel
                </button>
            }
            <button type="button"
                    class="ui-toolbar-btn"
                    disabled="@_loading"
                    @onclick="RefreshAsync">
                Refresh
            </button>
        </Toolbar>
    </PageHeader>
    <MismatchNotice OwnerResourceContextId="@_detail?.ResourceContextId" ResourceKindLabel="schedule" />

    @if (!string.IsNullOrEmpty(_error))
    {
        <ErrorState Message="@_error">
            @if (_validationErrors is { Count: > 0 })
            {
                <ul class="mt-2 list-disc pl-4 text-muted">
                    @foreach (var err in _validationErrors)
                    {
                        <li>@err</li>
                    }
                </ul>
            }
        </ErrorState>
    }
    else if (_detail is null)
    {
        @if (!string.IsNullOrEmpty(_actionMessage))
        {
            <ActionFeedback Message="@_actionMessage" />
        }
        else if (_loading)
        {
            <LoadingState />
        }
        else
        {
            <EmptyState Title="Schedule not found"
                        Message="The requested schedule could not be loaded." />
        }
    }
    else
    {
        @if (!string.IsNullOrEmpty(_actionMessage))
        {
            <ActionFeedback Message="@_actionMessage" />
        }

        <ManagementSection Title="Summary"
                           Layer="ManagementSection.UiLayer.Summary"
                           Help="Next fire is projected from cron + schedule time zone (not persisted). Timestamps use operator display time zone.">
            <div class="flex flex-wrap items-center gap-2">
                <StatusPill Label="@(_detail.Enabled ? "Enabled" : "Disabled")"
                            Semantic="@(_detail.Enabled ? ManagementStatusSemantic.Success : ManagementStatusSemantic.Neutral)" />
                @{
                    var executionPill = IntegrationConfigurationOperatorUiHelpers.BuildScheduleExecutionPill(
                        _detail.Enabled, _integrationRunnable, _detail.IntegrationId);
                }
                <StatusPill Label="@executionPill.Label" Semantic="@executionPill.Semantic" />
                <StatusPill Label="@RunScheduleOperatorUiHelpers.FormatScheduleHealthLabel(_detail.HealthStatus, _detail.Enabled)"
                            Semantic="@RunScheduleOperatorUiHelpers.MapScheduleHealthSemantic(_detail.HealthStatus)" />
                <StatusPill Label="@GetTargetKind(_detail.TargetJobType)" Semantic="@ManagementStatusSemantic.Neutral" />
                @if (!string.IsNullOrWhiteSpace(_detail.LastOutcome))
                {
                    <StatusPill Label="@($"Last outcome: {_detail.LastOutcome}")"
                                Semantic="@ManagementUiSemantics.MapRunOutcomeSemantic(_detail.LastOutcome)" />
                }
                @if (_detail.IsClaimStale == true)
                {
                    <AttentionPill Label="Stale claim" Semantic="@ManagementAttentionSemantic.Warning" />
                }
            </div>

            @if (!string.IsNullOrWhiteSpace(executionPill.RemediationHref))
            {
                <div class="mt-2">
                    <PageMessage Kind="PageMessageKind.Warning"
                                 Message="This schedule is enabled but blocked by integration configuration. Fix readiness before the next due fire can dispatch.">
                        <DrillInLink Href="@executionPill.RemediationHref">Open configuration overview</DrillInLink>
                    </PageMessage>
                </div>
            }

            @{
                var blockedSummary = IntegrationConfigurationOperatorUiHelpers.FormatBlockedByReadinessSummary(
                    _detail.LastOutcome, _detail.LastOutcomeReason);
            }
            @if (!string.IsNullOrWhiteSpace(blockedSummary))
            {
                <div class="ui-detail-block mt-2 text-sm text-body">
                    <div class="font-semibold">Last blocked dispatch</div>
                    <div class="mt-1 text-xs text-muted">@blockedSummary</div>
                    @if (!string.IsNullOrWhiteSpace(_detail.IntegrationId))
                    {
                        <div class="mt-2">
                            <DrillInLink Href="@IntegrationConfigurationOperatorUiHelpers.BuildConfigurationOverviewHref(_detail.IntegrationId)">
                                Fix integration configuration
                            </DrillInLink>
                        </div>
                    }
                </div>
            }

            <div class="mt-3">
                <MetadataGrid ThreeColumn="true">
                    <MetadataItem Label="Next fire">
                        @if (_detail.NextFireUtc is not null)
                        {
                            <TimestampDisplay Value="@_detail.NextFireUtc" ShowUtcDetail="true" />
                        }
                        else
                        {
                            <span>@(_detail.Enabled ? "None in look-ahead window" : "Inactive (disabled)")</span>
                        }
                    </MetadataItem>
                    <MetadataItem Label="Cron time zone" Value="@(_detail.ScheduleTimeZoneId ?? _detail.TimeZone)" />
                    <MetadataItem Label="Runtime plane" Value="@(_detail.RuntimePlaneId ?? "—")" />
                </MetadataGrid>
            </div>

            @{
                var whyNotFiring = RunScheduleOperatorUiHelpers.BuildWhyNotFiringHints(
                    _detail,
                    workerRuntimeStatus: _schedulerStatus?.Status ?? _schedulerStatus?.WorkerRuntime?.Status);
            }
            @if (whyNotFiring.Count > 0)
            {
                <div class="ui-detail-block mt-3 text-sm text-body">
                    <div class="font-semibold">Why this schedule may not be firing</div>
                    <ul class="mt-2 list-disc pl-5 text-xs text-muted">
                        @foreach (var hint in whyNotFiring)
                        {
                            <li>@hint</li>
                        }
                    </ul>
                    <div class="mt-2">
                        <DrillInLink Href="/control/center">Open Control Center worker runtime</DrillInLink>
                    </div>
                </div>
            }

            @if (_detail.LastAttemptedUtc is not null || _detail.LastSuccessfulDispatchUtc is not null)
            {
                <div class="mt-3">
                    <MetadataGrid ThreeColumn="true">
                        <MetadataItem Label="Last attempted">
                            <TimestampDisplay Value="@_detail.LastAttemptedUtc" ShowUtcDetail="true" />
                        </MetadataItem>
                        <MetadataItem Label="Last outcome" Value="@(_detail.LastOutcome ?? "—")" />
                        <MetadataItem Label="Last successful dispatch">
                            <TimestampDisplay Value="@_detail.LastSuccessfulDispatchUtc" ShowUtcDetail="true" />
                        </MetadataItem>
                    </MetadataGrid>
                    @if (!string.IsNullOrWhiteSpace(_detail.LastOutcomeReason))
                    {
                        <div class="mt-2 text-xs text-muted">@_detail.LastOutcomeReason</div>
                    }
                </div>
            }

            <div class="ui-summary-card-grid">
                @if (!string.IsNullOrWhiteSpace(_detail.IntegrationId))
                {
                    <ManagementSummaryCard Title="Integration"
                                           Description="Bindings, procedures, and readiness for this deployment unit."
                                           Href="@($"/integrations/{Uri.EscapeDataString(_detail.IntegrationId)}")" />
                    <ManagementSummaryCard Title="Schedule diagnostics"
                                           Description="Expected-run and evaluation troubleshooting for this integration."
                                           Href="@($"/integrations/{Uri.EscapeDataString(_detail.IntegrationId)}/schedule-diagnostics")" />
                }
                <ManagementSummaryCard Title="Runs for this schedule"
                                       Description="Filtered run history (correlation convention)."
                                       Href="@Epic33UiDisplayHelpers.GetRunsListCorrelationFilterHref($"schedule:{ScheduleId}")" />
                <ManagementSummaryCard Title="Audit"
                                       Description="Events scoped to this schedule id."
                                       Href="@Epic33UiDisplayHelpers.GetAuditLinkForSchedule(ScheduleId)" />
                <ManagementSummaryCard Title="Blocked work"
                                       Description="Recovery and retry eligibility."
                                       Href="@RunStatusFacets.BlockedRunsHref" />
            </div>
        </ManagementSection>

        @if (_editing)
        {
            <ManagementSection Title="Edit schedule"
                               Layer="ManagementSection.UiLayer.Detail"
                               Help="@Epic33UiDisplayHelpers.ScheduleActionExplanatoryText">
                <div class="text-xs text-muted mb-3">Target cannot be changed after creation.</div>
                <div class="grid grid-cols-1 gap-2 md:grid-cols-2">
                    <div>
                        <label class="block text-xs text-muted">Name</label>
                        <input class="ui-input mt-1 w-full text-sm"
                               @bind="_editName" />
                    </div>
                    <div>
                        <label class="block text-xs text-muted">Enabled</label>
                        <div class="mt-1 flex items-center gap-2">
                            <input type="checkbox" id="editEnabled" @bind="_editEnabled" />
                            <label for="editEnabled" class="text-sm text-body">@(_editEnabled ? "Yes" : "No")</label>
                        </div>
                    </div>
                    <div>
                        <div class="text-xs text-muted">Target type (read-only)</div>
                        <div class="text-sm font-mono">@GetTargetKind(_detail.TargetJobType)</div>
                    </div>
                    <div>
                        <div class="text-xs text-muted">Target configuration (read-only)</div>
                        <div class="text-sm font-mono break-all">@(_detail.TargetJobConfiguration ?? "-")</div>
                    </div>
                    <div>
                        <label class="block text-xs text-muted">Recurrence</label>
                        <input class="ui-input mt-1 w-full text-sm font-mono"
                               @bind="_editRecurrence" />
                    </div>
                    <div>
                        <label class="block text-xs text-muted">Time zone</label>
                        <input class="ui-input mt-1 w-full text-sm"
                               @bind="_editTimeZone" />
                        <div class="mt-1 text-xs text-muted">Cron is interpreted in this zone (IANA, e.g. America/Los_Angeles). Fire times are stored as UTC.</div>
                    </div>
                    <div class="md:col-span-2">
                        <SectionActions>
                        <button type="button"
                                class="ui-toolbar-btn"
                                disabled="@_loading"
                                @onclick="SaveEditAsync">
                            Save
                        </button>
                        <button type="button"
                                class="ui-toolbar-btn"
                                disabled="@_loading"
                                @onclick="CancelEdit">
                            Cancel
                        </button>
                        </SectionActions>
                    </div>
                </div>
            </ManagementSection>
        }

        <ManagementAdvancedSection Title="Schedule configuration and recurrence"
                                   Subtitle="Cron expression, target metadata, catch-up policy, and persisted execution fields."
                                   InitiallyOpen="false">
            @if (!_editing)
            {
                <MetadataGrid>
                    <MetadataItem Label="Name" Value="@_detail.Name" />
                    <MetadataItem Label="Integration" Monospace="true" Value="@(_detail.IntegrationId ?? "-")" />
                    <MetadataItem Label="Recurrence" Monospace="true" Value="@_detail.RecurrenceExpression" />
                    <MetadataItem Label="Time zone" Value="@_detail.TimeZone" />
                    <MetadataItem Label="Target type" Monospace="true" Value="@GetTargetKind(_detail.TargetJobType)" />
                    <MetadataItem Label="Target configuration" Monospace="true" Value="@(_detail.TargetJobConfiguration ?? "-")" />
                </MetadataGrid>
            }
            else
            {
                <div class="text-xs text-muted">Use the edit form above to change name, recurrence, time zone, and enabled state.</div>
            }
            <div class="mt-3 text-xs text-muted">@RunScheduleOperatorUiHelpers.ScheduleCatchUpHelpText</div>
            <div class="mt-2 text-xs text-muted">Schedule time zone drives cron evaluation; operator display time zone formats TimestampDisplay values (SWM-4/SWM-5).</div>
        </ManagementAdvancedSection>

        <ManagementAdvancedSection Title="Technical identifiers and scheduler claim"
                                   Subtitle="Raw ids and in-flight claim metadata from the management API."
                                   InitiallyOpen="false">
            <MetadataGrid>
                <MetadataItem Label="Schedule id" Monospace="true" Value="@_detail.Id" />
                <MetadataItem Label="Version" Monospace="true" Value="@_detail.Version.ToString()" />
            </MetadataGrid>

            @if (!string.IsNullOrEmpty(_detail.ClaimedByHostId))
            {
                <div class="mt-4 border-t border-default pt-3">
                    <div class="text-xs font-semibold text-heading">Active scheduler claim</div>
                    <div class="text-xs text-muted mt-1">Shown only while a firing is in progress (<code class="text-[11px]">ScheduleRuns</code> not yet completed). Not the owner of past runs.</div>
                    <div class="mt-2 grid grid-cols-1 gap-2 md:grid-cols-2">
                        <div>
                            <div class="text-xs text-muted">Claimed by host (current)</div>
                            <div class="text-sm text-body">@_detail.ClaimedByHostId</div>
                        </div>
                        <div>
                            <div class="text-xs text-muted">Claim started</div>
                            <div class="text-sm text-body"><TimestampDisplay Value="@_detail.ClaimedAtUtc" ShowUtcDetail="true" /></div>
                        </div>
                    </div>
                    @if (_detail.IsClaimStale == true)
                    {
                        <div class="mt-2">
                            <span class="ui-status-pill ui-status-pill--warning text-xs">Stale</span>
                            <span class="ml-2 text-xs text-muted">Past claim lease; another host may take over.</span>
                        </div>
                    }
                </div>
            }
        </ManagementAdvancedSection>
    }
</div>

@code {
    [Parameter] public string ScheduleId { get; set; } = "";

    private ScheduleDetailDto? _detail;
    private OperatorCapabilitiesDto? _capabilities;
    private SchedulerStatusSnapshotDto? _schedulerStatus;
    private bool? _integrationRunnable;
    private bool _loading;
    private string? _error;
    private string? _actionMessage;
    private IReadOnlyList<string>? _validationErrors;

    private bool _editing;
    private string _editName = "";
    private string _editRecurrence = "";
    private string _editTimeZone = "";
    private bool _editEnabled;
    private string? _dataLoadKey;

    private string ScheduleHeaderTitle =>
        string.IsNullOrWhiteSpace(_detail?.Name) ? "Schedule" : _detail!.Name;

    private string ScheduleHeaderSubtitle =>
        _detail is null
            ? string.Empty
            : RunScheduleOperatorUiHelpers.BuildScheduleDetailSubtitle(_detail);

    private void StartEdit()
    {
        if (_detail is null) return;
        _editing = true;
        _editName = _detail.Name;
        _editRecurrence = _detail.RecurrenceExpression;
        _editTimeZone = _detail.TimeZone;
        _editEnabled = _detail.Enabled;
        _error = null;
        _validationErrors = null;
    }

    private void CancelEdit()
    {
        _editing = false;
        _error = null;
        _validationErrors = null;
    }

    private async Task SaveEditAsync()
    {
        if (_detail is null) return;

        _loading = true;
        _error = null;
        _validationErrors = null;
        try
        {
            var request = new UpdateScheduleRequest(_editName.Trim(), _editRecurrence.Trim(), string.IsNullOrWhiteSpace(_editTimeZone) ? "UTC" : _editTimeZone.Trim(), _editEnabled);
            await Client.UpdateScheduleAsync(ScheduleId, request);
            _editing = false;
            await LoadAsync();
        }
        catch (ScheduleValidationException ex)
        {
            _error = "Validation failed.";
            _validationErrors = ex.Errors;
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        var key = ScheduleId ?? "";
        if (key == _dataLoadKey)
            return;
        _dataLoadKey = key;
        _detail = null;
        await LoadCapabilitiesAsync();
        await LoadAsync();
    }

    private async Task LoadCapabilitiesAsync()
    {
        try
        {
            _capabilities = await Capabilities.GetCapabilitiesAsync();
        }
        catch
        {
            _capabilities = new OperatorCapabilitiesDto(false, false, false, false, false, false, false);
        }
    }

    private Task RefreshAsync() => LoadAsync();

    private async Task LoadAsync(bool preserveActionFeedback = false)
    {
        if (string.IsNullOrWhiteSpace(ScheduleId))
            return;

        _loading = true;
        _error = null;
        if (!preserveActionFeedback)
            _actionMessage = null;
        try
        {
            _detail = await Client.GetScheduleAsync(ScheduleId);
            _integrationRunnable = null;
            if (!string.IsNullOrWhiteSpace(_detail?.IntegrationId))
            {
                try
                {
                    var readiness = await Client.GetIntegrationReadinessAsync(_detail.IntegrationId);
                    _integrationRunnable = readiness?.IsRunnable;
                }
                catch (HttpRequestException)
                {
                    _integrationRunnable = null;
                }
            }

            if (_capabilities?.CanViewRuntimeHealth == true)
            {
                try
                {
                    _schedulerStatus = await Client.GetSchedulerStatusAsync();
                }
                catch (HttpRequestException)
                {
                    _schedulerStatus = null;
                }
            }
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
            PublishShellTitle();
        }
    }

    private void PublishShellTitle() =>
        ShellOrientation.PublishForCurrentUri(Nav, ScheduleHeaderTitle, ScheduleHeaderSubtitle);

    private async Task EnableAsync()
    {
        await ExecuteScheduleActionAsync(async () =>
        {
            await Client.EnableScheduleAsync(ScheduleId);
            return "Schedule enabled.";
        });
    }

    private async Task DisableAsync()
    {
        await ExecuteScheduleActionAsync(async () =>
        {
            await Client.DisableScheduleAsync(ScheduleId);
            return "Schedule disabled.";
        });
    }

    private async Task TriggerRunCycleAsync()
    {
        await ExecuteScheduleActionAsync(async () =>
        {
            var result = await Client.TriggerSchedulerRunCycleAsync();
            if (result is null)
                return "Scheduler run cycle completed.";
            return $"Scheduler cycle: assigned={result.AssignmentCount} due={result.DueCount} claimed={result.ClaimedCount} dispatched={result.DispatchedCount} skipped={result.SkippedCount}. WritesHeartbeat={result.WritesHeartbeat}.";
        });
    }

    private async Task ExecuteScheduleActionAsync(Func<Task<string>> action)
    {
        _loading = true;
        _actionMessage = null;
        try
        {
            _actionMessage = await action();
        }
        catch (HttpRequestException ex)
        {
            _actionMessage = ex.Message;
        }
        finally
        {
            _loading = false;
        }
        await LoadAsync(preserveActionFeedback: true);
    }

    private static string GetTargetKind(int targetJobType) =>
        targetJobType == 0 ? "Workflow" : targetJobType == 1 ? "Operation" : $"Type{targetJobType}";
}
