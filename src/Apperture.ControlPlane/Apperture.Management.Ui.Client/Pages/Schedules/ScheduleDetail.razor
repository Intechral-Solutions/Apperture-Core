@page "/schedules/{ScheduleId}"
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Shared
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities
@inject NavigationManager Nav

<div class="p-4">
    <div class="flex items-center justify-between gap-3">
        <div class="min-w-0">
            <h1 class="text-xl font-semibold text-heading">Schedule</h1>
            <div class="mt-1 font-mono text-xs text-muted break-all">@ScheduleId</div>
        </div>
        <div class="flex items-center gap-2">
            <a href="/schedules" class="rounded bg-surface-muted px-3 py-2 text-sm text-body hover:bg-surface">Back to list</a>
            @if (_capabilities?.CanManageSchedules == true && !_editing)
            {
                <button class="rounded bg-surface-muted px-3 py-2 text-sm text-body hover:bg-surface"
                        title="Edit schedule"
                        @onclick="StartEdit">
                    Edit
                </button>
            }
            @if (_capabilities?.CanManageSchedules == true)
            {
                <button class="rounded bg-surface-muted px-3 py-2 text-sm text-body hover:bg-surface disabled:opacity-50"
                        disabled="@(_loading || (_detail?.Enabled == true))"
                        title="Enable this schedule"
                        @onclick="EnableAsync">
                    Enable
                </button>
                <button class="rounded bg-surface-muted px-3 py-2 text-sm text-body hover:bg-surface disabled:opacity-50"
                        disabled="@(_loading || (_detail?.Enabled != true))"
                        title="Disable this schedule"
                        @onclick="DisableAsync">
                    Disable
                </button>
            }
            @if (_capabilities?.CanManageRecovery == true)
            {
                <button class="rounded bg-surface-muted px-3 py-2 text-sm text-body hover:bg-surface"
                        disabled="@_loading"
                        title="@Epic33UiDisplayHelpers.ScheduleActionButtonTitle"
                        @onclick="TriggerRunCycleAsync">
                    @Epic33UiDisplayHelpers.ScheduleActionButtonLabel
                </button>
            }
            <button class="rounded bg-surface-muted px-3 py-2 text-sm text-body hover:bg-surface"
                    disabled="@_loading"
                    @onclick="LoadAsync">
                Refresh
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(_error))
    {
        <div class="mt-4 rounded border border-default bg-surface px-3 py-2 text-sm text-body">
            <div class="font-semibold">Error</div>
            <div class="text-muted">@_error</div>
            @if (_validationErrors is { Count: > 0 })
            {
                <ul class="mt-2 list-disc pl-4 text-muted">
                    @foreach (var err in _validationErrors)
                    {
                        <li>@err</li>
                    }
                </ul>
            }
        </div>
    }
    else if (!string.IsNullOrEmpty(_actionMessage))
    {
        <div class="mt-4 rounded border border-default bg-surface px-3 py-2 text-sm text-body">
            <div class="font-semibold">Action</div>
            <div class="text-muted">@_actionMessage</div>
        </div>
    }
    else if (_detail is null)
    {
        <div class="mt-4 text-sm text-muted">Loading...</div>
    }
    else
    {
        <div class="mt-4 grid gap-4">
            <div class="rounded border border-default bg-surface p-3">
                <div class="text-xs text-muted mb-2">@Epic33UiDisplayHelpers.ScheduleActionExplanatoryText</div>
            </div>

            <div class="rounded border border-default bg-surface p-3">
                <div class="text-sm font-semibold text-heading">State</div>
                <div class="text-xs text-muted mt-1">Target cannot be changed after creation.</div>
                <div class="mt-2 grid grid-cols-1 gap-2 md:grid-cols-2">
                    @if (_editing)
                    {
                        <div>
                            <label class="block text-xs text-muted">Name</label>
                            <input class="mt-1 w-full rounded border border-default bg-surface px-2 py-2 text-sm"
                                   @bind="_editName" />
                        </div>
                        <div>
                            <label class="block text-xs text-muted">Enabled</label>
                            <div class="mt-1 flex items-center gap-2">
                                <input type="checkbox" id="editEnabled" @bind="_editEnabled" />
                                <label for="editEnabled" class="text-sm text-body">@(_editEnabled ? "Yes" : "No")</label>
                            </div>
                        </div>
                        <div>
                            <div class="text-xs text-muted">Target type (read-only)</div>
                            <div class="text-sm font-mono">@GetTargetKind(_detail.TargetJobType)</div>
                        </div>
                        <div>
                            <div class="text-xs text-muted">Target configuration (read-only)</div>
                            <div class="text-sm font-mono break-all">@(_detail.TargetJobConfiguration ?? "-")</div>
                        </div>
                        <div>
                            <label class="block text-xs text-muted">Recurrence</label>
                            <input class="mt-1 w-full rounded border border-default bg-surface px-2 py-2 text-sm font-mono"
                                   @bind="_editRecurrence" />
                        </div>
                        <div>
                            <label class="block text-xs text-muted">Time zone</label>
                            <input class="mt-1 w-full rounded border border-default bg-surface px-2 py-2 text-sm"
                                   @bind="_editTimeZone" />
                        </div>
                        <div class="md:col-span-2 flex gap-2">
                            <button class="rounded bg-surface-muted px-3 py-2 text-sm text-body hover:bg-surface"
                                    disabled="@_loading"
                                    @onclick="SaveEditAsync">
                                Save
                            </button>
                            <button class="rounded bg-surface-muted px-3 py-2 text-sm text-body hover:bg-surface"
                                    disabled="@_loading"
                                    @onclick="CancelEdit">
                                Cancel
                            </button>
                        </div>
                    }
                    else
                    {
                        <div>
                            <div class="text-xs text-muted">Name</div>
                            <div class="text-sm text-body">@_detail.Name</div>
                        </div>
                        <div>
                            <div class="text-xs text-muted">Enabled</div>
                            <div class="text-sm text-body">@(_detail.Enabled ? "Yes" : "No")</div>
                        </div>
                        <div>
                            <div class="text-xs text-muted">Target type</div>
                            <div class="text-sm font-mono">@GetTargetKind(_detail.TargetJobType)</div>
                        </div>
                        <div>
                            <div class="text-xs text-muted">Target configuration</div>
                            <div class="text-sm font-mono break-all">@(_detail.TargetJobConfiguration ?? "-")</div>
                        </div>
                        <div>
                            <div class="text-xs text-muted">Recurrence</div>
                            <div class="text-sm font-mono">@_detail.RecurrenceExpression</div>
                        </div>
                        <div>
                            <div class="text-xs text-muted">Time zone</div>
                            <div class="text-sm text-body">@_detail.TimeZone</div>
                        </div>
                    }
                    @if (!_editing)
                    {
                        <div>
                            <div class="text-xs text-muted">Last attempted</div>
                            <div class="text-sm text-body">@Fmt(_detail.LastAttemptedUtc)</div>
                        </div>
                    }
                    @if (!_editing)
                    {
                        <div>
                            <div class="text-xs text-muted">Last outcome</div>
                            <div class="text-sm text-body">@(_detail.LastOutcome ?? "-")</div>
                        </div>
                        <div>
                            <div class="text-xs text-muted">Last outcome reason</div>
                            <div class="text-sm text-body">@(_detail.LastOutcomeReason ?? "-")</div>
                        </div>
                        <div>
                            <div class="text-xs text-muted">Last successful dispatch</div>
                            <div class="text-sm text-body">@Fmt(_detail.LastSuccessfulDispatchUtc)</div>
                        </div>
                    }
                    @if (!_editing && !string.IsNullOrEmpty(_detail.ClaimedByHostId))
                    {
                        <div class="md:col-span-2 border-t border-default pt-2 mt-1">
                            <div class="text-xs font-semibold text-heading">Active scheduler claim</div>
                            <div class="text-xs text-muted mt-1">Shown only while a firing is in progress (<code class="text-[11px]">ScheduleRuns</code> not yet completed). Not the owner of past runs.</div>
                        </div>
                        <div>
                            <div class="text-xs text-muted">Claimed by host (current)</div>
                            <div class="text-sm text-body">@_detail.ClaimedByHostId</div>
                        </div>
                        <div>
                            <div class="text-xs text-muted">Claim started (UTC)</div>
                            <div class="text-sm text-body">@Fmt(_detail.ClaimedAtUtc)</div>
                        </div>
                        @if (_detail.IsClaimStale == true)
                        {
                            <div class="md:col-span-2">
                                <span class="rounded bg-warning-light px-2 py-0.5 text-xs font-medium text-warning">Stale</span>
                                <span class="ml-2 text-xs text-muted">Past claim lease; another host may take over.</span>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="rounded border border-default bg-surface p-3">
                <div class="text-sm font-semibold text-heading">Links</div>
                <div class="mt-2 flex flex-wrap gap-2">
                    <a href="@Epic33UiDisplayHelpers.GetRunsListCorrelationFilterHref($"schedule:{ScheduleId}")" class="text-sm underline">Runs for this schedule</a>
                    <a href="@Epic33UiDisplayHelpers.GetAuditLinkForSchedule(ScheduleId)" class="text-sm underline">View audit for this schedule</a>
                    <a href="/control/blocked-work" class="text-sm underline">Blocked work / recovery</a>
                </div>
            </div>
        </div>
    }
</div>

@code {
    [Parameter] public string ScheduleId { get; set; } = "";

    private ScheduleDetailDto? _detail;
    private OperatorCapabilitiesDto? _capabilities;
    private bool _loading;
    private string? _error;
    private string? _actionMessage;
    private IReadOnlyList<string>? _validationErrors;

    private bool _editing;
    private string _editName = "";
    private string _editRecurrence = "";
    private string _editTimeZone = "";
    private bool _editEnabled;
    private string? _dataLoadKey;

    private void StartEdit()
    {
        if (_detail is null) return;
        _editing = true;
        _editName = _detail.Name;
        _editRecurrence = _detail.RecurrenceExpression;
        _editTimeZone = _detail.TimeZone;
        _editEnabled = _detail.Enabled;
        _error = null;
        _validationErrors = null;
    }

    private void CancelEdit()
    {
        _editing = false;
        _error = null;
        _validationErrors = null;
    }

    private async Task SaveEditAsync()
    {
        if (_detail is null) return;

        _loading = true;
        _error = null;
        _validationErrors = null;
        try
        {
            var request = new UpdateScheduleRequest(_editName.Trim(), _editRecurrence.Trim(), string.IsNullOrWhiteSpace(_editTimeZone) ? "UTC" : _editTimeZone.Trim(), _editEnabled);
            await Client.UpdateScheduleAsync(ScheduleId, request);
            _editing = false;
            await LoadAsync();
        }
        catch (ScheduleValidationException ex)
        {
            _error = "Validation failed.";
            _validationErrors = ex.Errors;
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        await base.OnParametersSetAsync();
        var key = ScheduleId ?? "";
        if (key == _dataLoadKey)
            return;
        _dataLoadKey = key;
        await LoadCapabilitiesAsync();
        await LoadAsync();
    }

    private async Task LoadCapabilitiesAsync()
    {
        try
        {
            _capabilities = await Capabilities.GetCapabilitiesAsync();
        }
        catch
        {
            _capabilities = new OperatorCapabilitiesDto(false, false, false, false, false, false, false);
        }
    }

    private async Task LoadAsync()
    {
        if (string.IsNullOrWhiteSpace(ScheduleId))
            return;

        _loading = true;
        _error = null;
        _actionMessage = null;
        try
        {
            _detail = await Client.GetScheduleAsync(ScheduleId);
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task EnableAsync()
    {
        await ExecuteScheduleActionAsync(async () =>
        {
            await Client.EnableScheduleAsync(ScheduleId);
            return "Schedule enabled.";
        });
    }

    private async Task DisableAsync()
    {
        await ExecuteScheduleActionAsync(async () =>
        {
            await Client.DisableScheduleAsync(ScheduleId);
            return "Schedule disabled.";
        });
    }

    private async Task TriggerRunCycleAsync()
    {
        await ExecuteScheduleActionAsync(async () =>
        {
            await Client.TriggerSchedulerRunCycleAsync();
            return "Scheduler run cycle triggered. Processes all schedules due at cycle time.";
        });
    }

    private async Task ExecuteScheduleActionAsync(Func<Task<string>> action)
    {
        _loading = true;
        _actionMessage = null;
        try
        {
            _actionMessage = await action();
        }
        catch (HttpRequestException ex)
        {
            _actionMessage = ex.Message;
        }
        finally
        {
            _loading = false;
        }
        await LoadAsync();
    }

    private static string Fmt(DateTimeOffset? dt) =>
        dt is null ? "-" : dt.Value.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");

    private static string GetTargetKind(int targetJobType) =>
        targetJobType == 0 ? "Workflow" : targetJobType == 1 ? "Operation" : $"Type{targetJobType}";
}
