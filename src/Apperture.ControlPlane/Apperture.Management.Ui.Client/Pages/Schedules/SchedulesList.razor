@page "/schedules"
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Shared
@using Apperture.Management.Ui.Client.Organisms
@using Apperture.Management.Ui.Client.Molecules
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities
@inject NavigationManager Nav

<div class="p-4 ui-page-stack">
    <PageHeader Eyebrow="Automation"
                Title="Schedules"
                Subtitle="Schedule definitions and persisted execution linkage; open a row for timing, outcomes, and actions.">
        <Toolbar>
            @if (_capabilities?.CanManageSchedules == true)
            {
                <a href="/schedules/new" class="ui-toolbar-btn">Create schedule</a>
            }
            <button class="ui-toolbar-btn"
                    disabled="@_loading"
                    @onclick="LoadAsync">
                Refresh
            </button>
        </Toolbar>
    </PageHeader>

    @if (!string.IsNullOrEmpty(_error))
    {
        <ErrorState Message="@_error" />
    }
    else if (_schedules is null)
    {
        <LoadingState />
    }
    else if (_schedules.Count == 0)
    {
        <EmptyState Message="No schedules found." />
    }
    else
    {
        <ManagementSection Title="Summary"
                           Layer="ManagementSection.UiLayer.Summary"
                           Help="Derived from loaded schedule rows only — no degraded-only list filter exists yet (Epic 47).">
            <div class="flex flex-wrap items-center gap-2">
                <StatusPill Label="@($"Total: {_schedules.Count}")" Semantic="@ManagementStatusSemantic.Neutral" />
                <StatusPill Label="@($"Enabled: {EnabledCount}")" Semantic="@ManagementStatusSemantic.Success" />
                <StatusPill Label="@($"Disabled: {DisabledCount}")" Semantic="@ManagementStatusSemantic.Warning" />
            </div>

            <div class="ui-summary-card-grid ui-summary-card-grid--wide">
                <ManagementSummaryCard Title="Integrations"
                                       Description="Open deployment units owning schedules."
                                       Href="/integrations" />
                <ManagementSummaryCard Title="Runs history"
                                       Description="Correlation and status filters apply from list rows."
                                       Href="/runs" />
                <ManagementSummaryCard Title="Audit timeline"
                                       Description="Operational events with schedule context."
                                       Href="/control/audit" />
                <ManagementSummaryCard Title="Blocked work"
                                       Description="Deferred runs and retry recovery."
                                       Href="/control/blocked-work" />
            </div>
        </ManagementSection>

        <ManagementSection Title="All schedules"
                           Layer="ManagementSection.UiLayer.Detail">
            <div class="overflow-x-auto rounded border border-default bg-surface">
                <table class="min-w-full text-left text-sm text-body">
                    <thead class="border-b border-default text-xs text-muted">
                        <tr>
                            <th class="px-3 py-2">Id</th>
                            <th class="px-3 py-2">Name</th>
                            <th class="px-3 py-2">State</th>
                            <th class="px-3 py-2">Recurrence</th>
                            <th class="px-3 py-2">Integration</th>
                            <th class="px-3 py-2">Target</th>
                            <th class="px-3 py-2"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var s in _schedules)
                        {
                            <tr class="border-b border-default hover:bg-surface-muted cursor-pointer"
                                @onclick="@(() => Nav.NavigateTo("/schedules/" + Uri.EscapeDataString(s.Id)))">
                                <td class="px-3 py-2 font-mono text-xs">@s.Id</td>
                                <td class="px-3 py-2">@s.Name</td>
                                <td class="px-3 py-2">
                                    <StatusPill Label="@(s.Enabled ? "Enabled" : "Disabled")"
                                                Semantic="@(s.Enabled ? ManagementStatusSemantic.Success : ManagementStatusSemantic.Neutral)" />
                                </td>
                                <td class="px-3 py-2 font-mono text-xs break-all max-w-xs">@s.RecurrenceExpression</td>
                                <td class="px-3 py-2 font-mono text-xs">
                                    @if (!string.IsNullOrWhiteSpace(s.IntegrationId))
                                    {
                                        <DrillInLink Href="@($"/integrations/{Uri.EscapeDataString(s.IntegrationId)}")">@s.IntegrationId</DrillInLink>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>
                                <td class="px-3 py-2">
                                    <span class="font-mono text-xs">@GetTargetKind(s.TargetJobType)</span>
                                    @if (!string.IsNullOrEmpty(s.TargetJobConfiguration))
                                    {
                                        <div class="text-xs text-muted truncate max-w-xs">@s.TargetJobConfiguration</div>
                                    }
                                </td>
                                <td class="px-3 py-2">
                                    <a href="@($"/schedules/{Uri.EscapeDataString(s.Id)}")"
                                       class="ui-drill-in-link text-sm"
                                       @onclick:stopPropagation>Open</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </ManagementSection>

        <ManagementAdvancedSection Title="List semantics and diagnostics"
                                   Subtitle="Constraints that affect how this view should be interpreted."
                                   InitiallyOpen="false">
            <ul class="list-disc space-y-2 pl-4 text-xs text-muted">
                <li>Last outcome / next-fire timing appears on each schedule&apos;s detail page (not in list DTO).</li>
                <li>Dashboard and Control Center may surface schedule-health counts; degraded-only filtering for this list is deferred until the API exposes a compatible filter.</li>
            </ul>
        </ManagementAdvancedSection>
    }
</div>

@code {
    private IReadOnlyList<ScheduleDto>? _schedules;
    private OperatorCapabilitiesDto? _capabilities;
    private bool _loading;
    private string? _error;

    private int EnabledCount => _schedules?.Count(x => x.Enabled) ?? 0;

    private int DisabledCount => _schedules?.Count(x => !x.Enabled) ?? 0;

    protected override async Task OnInitializedAsync()
    {
        try { _capabilities = await Capabilities.GetCapabilitiesAsync(); }
        catch { _capabilities = new OperatorCapabilitiesDto(false, false, false, false, false, false, false); }
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _schedules = await Client.GetSchedulesAsync();
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private static string GetTargetKind(int targetJobType) =>
        targetJobType == 0 ? "Workflow" : targetJobType == 1 ? "Operation" : $"Type{targetJobType}";
}
