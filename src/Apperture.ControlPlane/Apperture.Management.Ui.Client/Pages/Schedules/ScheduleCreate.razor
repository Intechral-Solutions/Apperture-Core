@page "/schedules/new"
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Shared
@using Apperture.Management.Ui.Client.Organisms
@using Apperture.Management.Ui.Client.Molecules
@using Apperture.Management.Ui.Client.Atoms
@inject IManagementClient Client
@inject IOperatorCapabilitiesService Capabilities
@inject NavigationManager Nav

<div class="p-4 ui-page-stack">
    <PageHeader Eyebrow="Automation"
                Title="Create schedule"
                Subtitle="Define a new scheduled workflow or operation for an integration.">
        <Toolbar>
            <a href="/schedules" class="ui-toolbar-btn">Back to list</a>
        </Toolbar>
    </PageHeader>

    @if (!_capabilitiesLoaded)
    {
        <LoadingState Message="Loading…" />
    }
    else if (_capabilities?.CanManageSchedules != true)
    {
        <ForbiddenState Title="Not authorized"
                        Message="You do not have permission to create schedules." />
    }
    else if (!string.IsNullOrEmpty(_error))
    {
        <ErrorState Message="@_error">
            @if (_validationErrors is { Count: > 0 })
            {
                <ul class="mt-2 list-disc pl-4 text-muted">
                    @foreach (var err in _validationErrors)
                    {
                        <li>@err</li>
                    }
                </ul>
            }
        </ErrorState>
    }
    else
    {
        <ManagementSection Title="Schedule definition"
                           Layer="ManagementSection.UiLayer.Detail"
                           Help="@($"{Epic33UiDisplayHelpers.ScheduleActionExplanatoryText} Schedules are integration-owned — select an integration first, then workflow or operation targets from that integration's module.")">
            <form class="grid gap-4 md:grid-cols-2" @onsubmit="SubmitAsync" @onsubmit:preventDefault>
                <div class="space-y-3">
                    <div>
                        <label class="block text-xs text-muted">Name (required)</label>
                        <input class="ui-input mt-1 w-full text-sm"
                               @bind="_name"
                               required />
                    </div>

                    <div>
                        <label class="block text-xs text-muted">Integration</label>
                        <select class="ui-input mt-1 w-full text-sm"
                                value="@(_selectedIntegrationId ?? "")"
                                @onchange="OnIntegrationChanged">
                            <option value="">Select…</option>
                            @if (_integrations is not null)
                            {
                                @foreach (var integration in _integrations)
                                {
                                    <option value="@integration.Id">@integration.DisplayName (@integration.Id)</option>
                                }
                            }
                        </select>
                    </div>

                    <div>
                        <label class="block text-xs text-muted">Target kind</label>
                        <div class="text-xs text-muted mt-0.5">Target options are filtered to the selected integration's module.</div>
                        <select class="ui-input mt-1 w-full text-sm"
                                disabled="@string.IsNullOrWhiteSpace(_selectedIntegrationId)"
                                @onchange="OnTargetKindChanged"
                                value="@(_targetKind == 0 ? "0" : "1")">
                            <option value="0">Workflow</option>
                            <option value="1">Operation</option>
                        </select>
                    </div>

                    @if (_targetKind == 0)
                    {
                        <div>
                            <label class="block text-xs text-muted">Workflow</label>
                            <select class="ui-input mt-1 w-full text-sm"
                                    disabled="@(_workflows is null || string.IsNullOrWhiteSpace(_selectedIntegrationId))"
                                    value="@(_selectedWorkflowId ?? "")"
                                    @onchange="OnWorkflowChanged">
                                <option value="">Select…</option>
                                @if (_workflows is not null)
                                {
                                    @foreach (var w in _workflows)
                                    {
                                        <option value="@w.Id">@w.Name (@w.Id)</option>
                                    }
                                }
                            </select>
                        </div>
                    }
                    else
                    {
                        <div>
                            <label class="block text-xs text-muted">Operation</label>
                            <select class="ui-input mt-1 w-full text-sm"
                                    disabled="@string.IsNullOrWhiteSpace(_selectedIntegrationId)"
                                    value="@(_selectedOperationId ?? "")"
                                    @onchange="OnOperationChanged">
                                <option value="">Select…</option>
                                @if (FilteredOperations is { } ops)
                                {
                                    @foreach (var op in ops)
                                    {
                                        <option value="@op.OperationDefinitionId">@op.DisplayName (@op.OperationDefinitionId)</option>
                                    }
                                }
                            </select>
                        </div>
                    }

                    <div>
                        <label class="block text-xs text-muted">Recurrence (cron expression, required)</label>
                        <input class="ui-input mt-1 w-full text-sm font-mono"
                               @bind="_recurrence"
                               placeholder="0 * * * *"
                               required />
                        <div class="mt-1 text-xs text-muted">Cron expression (e.g. 0 * * * * for hourly). Uses Cronos format.</div>
                    </div>

                    <div>
                        <label class="block text-xs text-muted">Time zone</label>
                        <input class="ui-input mt-1 w-full text-sm"
                               @bind="_timeZone"
                               placeholder="America/Los_Angeles" />
                        <div class="mt-1 text-xs text-muted">IANA id (e.g. UTC, America/Los_Angeles). Cron is interpreted in this zone; fire times are stored as UTC. Leave blank to use Scheduling.DefaultTimeZoneId.</div>
                    </div>

                    <div class="flex items-center gap-2">
                        <input type="checkbox" id="enabled" @bind="_enabled" />
                        <label for="enabled" class="text-sm text-body">Enabled</label>
                    </div>
                </div>

                <div class="flex flex-col gap-2">
                    <button type="submit"
                            class="btn btn-primary w-fit"
                            disabled="@(_loading || !CanSubmit)">
                        Create schedule
                    </button>
                    <DrillInLink Href="/schedules" Class="w-fit">Cancel</DrillInLink>
                </div>
            </form>
        </ManagementSection>
    }
</div>

@code {
    private bool _capabilitiesLoaded;
    private OperatorCapabilitiesDto? _capabilities;
    private IReadOnlyList<IntegrationDto>? _integrations;
    private IReadOnlyList<WorkflowDto>? _workflows;
    private IReadOnlyList<OperationDefinitionDto>? _operations;
    private string? _selectedIntegrationId;
    private string? _selectedWorkflowId;
    private string? _selectedOperationId;
    private int _targetKind; // 0 = Workflow, 1 = Operation
    private string _name = "";
    private string _recurrence = "";
    private string _timeZone = "";
    private bool _enabled = true;
    private bool _loading;
    private string? _error;
    private IReadOnlyList<string>? _validationErrors;
    private IReadOnlyList<OperationDefinitionDto> FilteredOperations =>
        _operations is null
            ? Array.Empty<OperationDefinitionDto>()
            : _operations.Where(DoesOperationMatchSelectedIntegration).ToList();

    private bool CanSubmit =>
        !string.IsNullOrWhiteSpace(_name) &&
        !string.IsNullOrWhiteSpace(_recurrence) &&
        !string.IsNullOrWhiteSpace(_selectedIntegrationId) &&
        (_targetKind == 0
            ? !string.IsNullOrWhiteSpace(_selectedWorkflowId)
            : !string.IsNullOrWhiteSpace(_selectedOperationId));

    protected override async Task OnInitializedAsync()
    {
        await LoadCapabilitiesAsync();
        _capabilitiesLoaded = true;
        if (_capabilities?.CanManageSchedules != true)
            return;
        await LoadIntegrationsAsync();
        await LoadOperationsAsync();
    }

    private async Task LoadCapabilitiesAsync()
    {
        try
        {
            _capabilities = await Capabilities.GetCapabilitiesAsync();
        }
        catch
        {
            _capabilities = new OperatorCapabilitiesDto(false, false, false, false, false, false, false);
        }
    }

    private async Task LoadIntegrationsAsync()
    {
        try
        {
            _integrations = await Client.GetIntegrationsAsync();
        }
        catch
        {
            _integrations = Array.Empty<IntegrationDto>();
        }
    }

    private async Task LoadOperationsAsync()
    {
        try
        {
            _operations = await Client.GetOperationsAsync();
        }
        catch
        {
            _operations = Array.Empty<OperationDefinitionDto>();
        }
    }

    private void OnTargetKindChanged(ChangeEventArgs e)
    {
        _targetKind = int.TryParse(e.Value?.ToString(), out var v) ? v : 0;
        _selectedWorkflowId = null;
        _selectedOperationId = null;
        _workflows = null;
    }

    private async Task OnIntegrationChanged(ChangeEventArgs e)
    {
        _selectedIntegrationId = e.Value?.ToString();
        _selectedWorkflowId = null;
        _workflows = null;
        _selectedOperationId = null;
        if (string.IsNullOrEmpty(_selectedIntegrationId))
            return;

        var selectedIntegration = _integrations?.FirstOrDefault(i =>
            string.Equals(i.Id, _selectedIntegrationId, StringComparison.Ordinal));
        if (selectedIntegration is null)
            return;

        try
        {
            _workflows = await Client.GetWorkflowsAsync(selectedIntegration.ModuleId);
        }
        catch
        {
            _workflows = Array.Empty<WorkflowDto>();
        }
    }

    private void OnWorkflowChanged(ChangeEventArgs e) => _selectedWorkflowId = e.Value?.ToString();

    private void OnOperationChanged(ChangeEventArgs e) => _selectedOperationId = e.Value?.ToString();

    private bool DoesOperationMatchSelectedIntegration(OperationDefinitionDto operation)
    {
        if (string.IsNullOrWhiteSpace(_selectedIntegrationId))
            return false;
        var selectedIntegration = _integrations?.FirstOrDefault(i =>
            string.Equals(i.Id, _selectedIntegrationId, StringComparison.Ordinal));
        if (selectedIntegration is null)
            return false;
        return string.Equals(operation.ModuleId, selectedIntegration.ModuleId, StringComparison.Ordinal);
    }

    private async Task SubmitAsync()
    {
        if (!CanSubmit)
            return;

        _loading = true;
        _error = null;
        _validationErrors = null;
        try
        {
            var selectedIntegration = _integrations?.FirstOrDefault(i =>
                string.Equals(i.Id, _selectedIntegrationId, StringComparison.Ordinal));
            if (selectedIntegration is null)
            {
                _error = "Select a valid integration before creating a schedule.";
                return;
            }

            string? targetConfig;
            if (_targetKind == 0)
            {
                targetConfig = System.Text.Json.JsonSerializer.Serialize(new { workflowDefinitionId = _selectedWorkflowId });
            }
            else
            {
                var selectedOperation = _operations?.FirstOrDefault(o =>
                    string.Equals(o.OperationDefinitionId, _selectedOperationId, StringComparison.Ordinal));
                if (selectedOperation is not null &&
                    !string.Equals(selectedOperation.ModuleId, selectedIntegration.ModuleId, StringComparison.Ordinal))
                {
                    _error = "Selected operation does not belong to the selected integration.";
                    return;
                }
                targetConfig = System.Text.Json.JsonSerializer.Serialize(new { operationDefinitionId = _selectedOperationId });
            }

            var request = new CreateIntegrationScheduleRequest(
                _name.Trim(),
                _recurrence.Trim(),
                string.IsNullOrWhiteSpace(_timeZone) ? null : _timeZone.Trim(),
                _enabled,
                _targetKind,
                targetConfig,
                ExecutionPolicyRef: null,
                RuntimePlaneId: "local");

            var created = await Client.CreateIntegrationScheduleAsync(selectedIntegration.Id, request);
            Nav.NavigateTo($"/schedules/{Uri.EscapeDataString(created.Id)}");
        }
        catch (ScheduleValidationException ex)
        {
            _error = "Validation failed.";
            _validationErrors = ex.Errors;
        }
        catch (HttpRequestException ex)
        {
            _error = ex.Message;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
