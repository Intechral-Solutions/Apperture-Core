@page "/account/reset-password"
@layout AuthLayout
@using System.Net.Http
@inject IManagementClient Client
@inject NavigationManager Nav
@inject IToastService Toasts

<div class="mx-auto max-w-md ui-section-panel p-6">
    <PageHeader Title="Reset your password"
                Subtitle="Choose a new local password. This does not turn local sign-in on if it is currently disabled." />

    @if (_error is not null && _done)
    {
        <PageMessage Kind="PageMessageKind.Error" Message="@_error" />
        <p class="mt-4 text-sm text-muted">
            <a class="underline hover:text-heading" href="@AccountUiRoutes.ForgotPassword">Request a new reset link</a>
            ·
            <a class="underline hover:text-heading" href="/login">Sign in</a>
        </p>
    }
    else if (_done)
    {
        <PageMessage Kind="PageMessageKind.Info" Message="Your password was updated." />
        <p class="mt-4 text-sm">
            <a class="btn btn-primary" href="/login">Sign in</a>
        </p>
    }
    else
    {
        @if (_error is not null)
        {
            <PageMessage Kind="PageMessageKind.Error" Message="@_error" />
        }
        <form class="mt-4 space-y-3" @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
            <div>
                <label class="block text-sm font-medium text-heading" for="reset-password">New password</label>
                <input id="reset-password"
                       type="password"
                       autocomplete="new-password"
                       class="ui-input mt-1"
                       @bind="_password" />
            </div>
            <button type="submit" class="btn btn-primary w-full" disabled="@_busy">
                @(_busy ? "Saving…" : "Reset password")
            </button>
        </form>
    }
</div>

@code {
    private string _password = "";
    private string? _token;
    private string? _error;
    private bool _busy;
    private bool _done;

    protected override void OnInitialized()
    {
        _token = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query).Get("token");
        if (string.IsNullOrWhiteSpace(_token))
        {
            _error = "This reset link is invalid or has expired.";
            _done = true;
        }
    }

    private async Task SubmitAsync()
    {
        _error = null;
        _busy = true;
        try
        {
            await Client.CompletePasswordResetAsync(new TokenPasswordRequest(_token, _password));
            _done = true;
            Toasts.Show(ToastSeverity.Success, "Password updated.");
        }
        catch (HttpRequestException)
        {
            _error = "This reset link is invalid or has expired.";
            _done = true;
        }
        finally
        {
            _busy = false;
        }
    }
}
