@page "/account/reset-password"
@layout AuthLayout
@using System.Net.Http
@inject IManagementClient Client
@inject NavigationManager Nav
@inject IToastService Toasts

<div class="mx-auto max-w-md ui-section-panel p-6">
    <PageHeader Title="Reset your password"
                Subtitle="Choose a new local password. This does not turn local sign-in on if it is currently disabled." />

    @if (_error is not null && _done)
    {
        <PageMessage Kind="PageMessageKind.Error" Message="@_error" />
        <p class="mt-4 text-sm text-muted">
            <a class="underline hover:text-heading" href="@AccountUiRoutes.ForgotPassword">Request a new reset link</a>
            ·
            <a class="underline hover:text-heading" href="/login">Sign in</a>
        </p>
    }
    else if (_done)
    {
        <PageMessage Kind="PageMessageKind.Info" Message="Your password was updated." />
        <p class="mt-4 text-sm">
            <a class="btn btn-primary" href="/login">Sign in</a>
        </p>
    }
    else
    {
        @if (_error is not null)
        {
            <PageMessage Kind="PageMessageKind.Error" Message="@_error" />
        }
        <form class="mt-4 space-y-3" @onsubmit="SubmitAsync" @onsubmit:preventDefault="true">
            <PasswordSetupFields Password="_password"
                                 PasswordChanged="value => _password = value"
                                 Confirmation="_confirm"
                                 ConfirmationChanged="value => _confirm = value"
                                 PasswordId="reset-password"
                                 ConfirmId="reset-password-confirm"
                                 IsValidChanged="valid => _setupValid = valid" />
            <ActionButton @ref="_submit"
                          Type="submit"
                          Class="w-full"
                          DefaultText="Reset password"
                          ActiveText="Saving…"
                          SuccessText="Password updated"
                          ErrorText="Could not save"
                          IsInactive="@(!_setupValid)" />
        </form>
    }
</div>

@code {
    private string _password = "";
    private string _confirm = "";
    private string? _token;
    private string? _error;
    private bool _setupValid;
    private bool _done;
    private ActionButton? _submit;

    protected override void OnInitialized()
    {
        _token = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query).Get("token");
        if (string.IsNullOrWhiteSpace(_token))
        {
            _error = "This reset link is invalid or has expired.";
            _done = true;
        }
    }

    private async Task SubmitAsync()
    {
        if (!_setupValid)
            return;
        _error = null;
        if (_submit is not null)
            await _submit.SetStateAsync(ActionButtonState.Active);
        try
        {
            await Client.CompletePasswordResetAsync(new TokenPasswordRequest(_token, _password));
            _done = true;
            if (_submit is not null)
                await _submit.SetStateAsync(ActionButtonState.Success);
        }
        catch (HttpRequestException)
        {
            _error = "This reset link is invalid or has expired.";
            _done = true;
            if (_submit is not null)
                await _submit.SetStateAsync(ActionButtonState.Error);
        }
    }
}
