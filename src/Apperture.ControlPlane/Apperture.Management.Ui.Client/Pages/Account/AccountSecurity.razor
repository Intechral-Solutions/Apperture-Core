@page "/account/security"
@layout MainLayout
@implements IDisposable
@using System.Net.Http
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Molecules
@using Apperture.Management.Ui.Client.Organisms
@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Shared
@using Apperture.Management.Ui.Shared.Options
@using Microsoft.Extensions.Options
@inject SessionStateService Session
@inject IManagementClient Client
@inject ShellHostNavigation HostNav
@inject IOptions<ShellUiOptions> ShellOpts
@inject AuthSignInOptionsService SignInOptions
@inject NavigationManager Nav
@inject IToastService Toasts

<div class="p-4 md:p-6">
    <PageHeader Title="Security"
                Subtitle="How you sign in, and where each control lives." />

    <AccountSectionNav />

    @if (Session.State is SessionLoadState.Unknown or SessionLoadState.Loading)
    {
        <p class="mt-6 text-sm text-muted" role="status">Loading your account…</p>
    }
    else if (_me is null)
    {
        <p class="mt-6 text-sm text-muted">Sign in to view your security settings.</p>
    }
    else
    {
        <div class="mt-6 max-w-2xl space-y-6">
            <section class="rounded border border-default bg-surface p-4" aria-labelledby="signin-heading">
                <h2 id="signin-heading" class="text-base font-semibold text-heading">Sign-in methods</h2>
                <p class="mt-1 text-sm text-muted">
                    Administrators add and remove sign-in methods for your account.
                </p>

                @if (_me.IdentityLinks.Count == 0)
                {
                    <p class="mt-3 text-sm text-muted">No linked identities recorded.</p>
                }
                else
                {
                    <ul class="mt-3 divide-y divide-default text-sm">
                        @foreach (var link in _me.IdentityLinks)
                        {
                            <li class="py-2">
                                <div class="flex flex-wrap items-baseline justify-between gap-2">
                                    <span class="font-medium text-heading">@FormatSignInSource(link.Source)</span>
                                    <span class="text-xs text-muted">@link.DisplayLabel</span>
                                </div>
                                @if (link.LastAuthenticatedAtUtc is not null)
                                {
                                    <p class="mt-1 text-xs text-muted">
                                        Last used <TimestampDisplay Value="link.LastAuthenticatedAtUtc" CssClass="text-xs text-muted" />
                                    </p>
                                }
                            </li>
                        }
                    </ul>
                }
            </section>

            <section class="rounded border border-default bg-surface p-4" aria-labelledby="password-heading">
                <h2 id="password-heading" class="text-base font-semibold text-heading">Password</h2>
                <p class="mt-1 text-sm text-muted">
                    Local credential: <span class="text-body">@FormatCredentialStatus(_me.LocalCredentialStatus)</span>
                </p>

                @if (_me.CanChangeLocalPassword)
                {
                    <form class="mt-4 space-y-3" @onsubmit="ChangePasswordAsync" @onsubmit:preventDefault="true">
                        <div>
                            <label class="block text-sm font-medium text-heading" for="current-password">Current password</label>
                            <input id="current-password"
                                   type="password"
                                   autocomplete="current-password"
                                   class="mt-1 w-full max-w-md rounded border border-default bg-surface px-3 py-2 text-sm"
                                   aria-describedby="@(_passwordError is null ? null : "password-error")"
                                   aria-invalid="@(_passwordError is not null ? "true" : null)"
                                   @bind="_currentPassword" />
                        </div>
                        <div>
                            <label class="block text-sm font-medium text-heading" for="new-password">New password</label>
                            <input id="new-password"
                                   type="password"
                                   autocomplete="new-password"
                                   class="mt-1 w-full max-w-md rounded border border-default bg-surface px-3 py-2 text-sm"
                                   aria-describedby="@(_passwordError is null ? null : "password-error")"
                                   aria-invalid="@(_passwordError is not null ? "true" : null)"
                                   @bind="_newPassword" />
                        </div>
                        @if (_passwordError is not null)
                        {
                            <p id="password-error" class="text-sm text-message-error" role="alert">@_passwordError</p>
                        }
                        <button type="submit"
                                class="rounded bg-surface-muted px-4 py-2 text-sm font-medium text-heading hover:bg-surface disabled:opacity-50"
                                disabled="@_passwordBusy">
                            @(_passwordBusy ? "Updating…" : "Change password")
                        </button>
                    </form>
                }
                else
                {
                    <div class="mt-3">
                        <PageMessage Kind="PageMessageKind.Info"
                                     Message="@PasswordChangeUnavailableMessage(_me.LocalCredentialStatus)" />
                    </div>
                }
            </section>

            @if (HasEntraLink)
            {
                <section class="rounded border border-default bg-surface p-4" aria-labelledby="provider-heading">
                    <h2 id="provider-heading" class="text-base font-semibold text-heading">Managed by Microsoft Entra ID</h2>
                    <p class="mt-1 text-sm text-muted">
                        Multi-factor authentication, passkeys, and password recovery for your
                        organizational identity are managed by your organization's directory, not by
                        Apperture. Change them through your organization's account portal.
                    </p>
                </section>
            }

            <section class="rounded border border-default bg-surface p-4" aria-labelledby="session-heading">
                <h2 id="session-heading" class="text-base font-semibold text-heading">This session</h2>
                <p class="mt-1 text-sm text-muted">
                    Signing out clears your Apperture session in this browser.
                </p>
                <div class="mt-3 flex flex-wrap gap-2">
                    <button type="button"
                            class="rounded border border-default px-4 py-2 text-sm hover:bg-surface-muted"
                            @onclick="SignOutLocalAsync">
                        Sign out
                    </button>
                    @if (UseEntraSignOut)
                    {
                        <button type="button"
                                class="rounded border border-default px-4 py-2 text-sm text-muted hover:bg-surface-muted"
                                @onclick="SignOutHost">
                            Sign out and end the directory session
                        </button>
                    }
                </div>
            </section>
        </div>
    }
</div>

@code {
    private MeResponse? _me;
    private string _currentPassword = "";
    private string _newPassword = "";
    private string? _passwordError;
    private bool _passwordBusy;

    private bool HasEntraLink =>
        _me?.IdentityLinks.Any(l => string.Equals(l.Source, "Entra", StringComparison.OrdinalIgnoreCase)) ?? false;

    private bool UseEntraSignOut =>
        ShellOpts.Value.UseEntraSignIn || (SignInOptions.Current?.EntraSignInEnabled ?? false);

    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
        _me = Session.User;
    }

    public void Dispose() => Session.Changed -= OnSessionChanged;

    private void OnSessionChanged() => _ = InvokeAsync(() =>
    {
        _me = Session.User;
        StateHasChanged();
    });

    private async Task ChangePasswordAsync()
    {
        _passwordError = null;
        _passwordBusy = true;
        try
        {
            await Client.ChangeLocalPasswordAsync(new ChangeLocalPasswordRequest(_currentPassword, _newPassword));
            _currentPassword = "";
            _newPassword = "";
            Toasts.Show(ToastSeverity.Success, "Password updated.");
            await Session.RefreshAsync();
            _me = Session.User ?? _me;
        }
        catch (HttpRequestException ex)
        {
            _passwordError = ex.Message;
        }
        finally
        {
            _passwordBusy = false;
        }
    }

    private async Task SignOutLocalAsync()
    {
        try
        {
            await Client.LocalLogoutAsync();
        }
        catch (HttpRequestException)
        {
            // The cookie may already be gone; treat sign-out as successful either way.
        }

        await Session.RefreshAsync();
        await SignInOptions.RefreshAsync();
        Nav.NavigateTo("/login");
    }

    private void SignOutHost()
    {
        var host = HostNav.GetManagementHostBase(Nav);
        Nav.NavigateTo(new Uri(host, "signout").ToString(), forceLoad: true);
    }

    private static string FormatSignInSource(string source) => source switch
    {
        "Local" => "Local username and password",
        "Entra" => "Microsoft Entra ID",
        _ => source
    };

    private static string FormatCredentialStatus(string status) => status switch
    {
        "active" => "Active",
        "disabled" => "Disabled",
        "none" => "Not configured",
        _ => status
    };

    private static string PasswordChangeUnavailableMessage(string status) => status switch
    {
        "disabled" => "Local sign-in is disabled for your account. Contact an administrator to re-enable it or reset your password.",
        "none" => "This account does not have a local password. Sign in with your organizational identity, or ask an administrator to set a local password.",
        _ => "Password change is not available for your account."
    };
}
