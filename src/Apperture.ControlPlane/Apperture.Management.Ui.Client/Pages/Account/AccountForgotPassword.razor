@page "/account/forgot-password"
@layout AuthLayout
@using System.Net.Http
@using Apperture.Core.Domain.Identity
@using Microsoft.AspNetCore.Components.Forms
@inject IManagementClient Client

<div class="mx-auto max-w-md ui-section-panel p-6">
    <PageHeader Title="Forgot password"
                Subtitle="Enter your local username or verified contact email. If an eligible account matches, a reset email is sent." />

    @if (_acknowledged)
    {
        <PageMessage Kind="PageMessageKind.Info" Message="@_message" />
        <p class="mt-4 text-sm text-muted">
            <a class="underline hover:text-heading" href="/login">Back to sign in</a>
        </p>
    }
    else
    {
        <EditForm Model="_formModel" OnValidSubmit="SubmitAsync" OnInvalidSubmit="OnInvalidSubmit" class="mt-4 space-y-3">
            <ValidatedFieldShell Label="Username or contact email"
                                 For="forgot-identifier"
                                 Validation="@IdentifierValidation">
                <Control>
                    <input id="forgot-identifier"
                           class="ui-input ui-input--adorned"
                           autocomplete="username"
                           value="@_identifier"
                           aria-invalid="@(IdentifierValidation.Kind == FieldValidationKind.Invalid ? "true" : null)"
                           @oninput="OnIdentifierInput" />
                </Control>
            </ValidatedFieldShell>
            <FormValidationFeedback Visible="@_showFormAttention" />
            <ActionButton @ref="_submit"
                          Type="submit"
                          Class="w-full"
                          DefaultText="Send reset link"
                          ActiveText="Sending…"
                          SuccessText="Request sent"
                          ErrorText="Request sent" />
        </EditForm>
        <p class="mt-4 text-sm text-muted">
            <a class="underline hover:text-heading" href="/login">Back to sign in</a>
        </p>
    }
</div>

@code {
    private readonly object _formModel = new();
    private string _identifier = "";
    private string _message = ForgottenPasswordAcknowledgement;
    private bool _acknowledged;
    private bool _identifierTouched;
    private bool _submitAttempted;
    private bool _showFormAttention;
    private ActionButton? _submit;

    private const string ForgottenPasswordAcknowledgement =
        "If an eligible account matches, a reset email is on its way.";

    private FieldValidationPresentation IdentifierValidation
    {
        get
        {
            if (!_identifierTouched && !_submitAttempted)
                return FieldValidationPresentation.Pristine;
            return string.IsNullOrWhiteSpace(_identifier)
                ? FieldValidationPresentation.Invalid("Enter your username or contact email.")
                : FieldValidationPresentation.Valid;
        }
    }

    private void OnIdentifierInput(ChangeEventArgs args)
    {
        _identifier = args.Value?.ToString() ?? "";
        _identifierTouched = true;
    }

    private void OnInvalidSubmit()
    {
        _submitAttempted = true;
        _showFormAttention = string.IsNullOrWhiteSpace(_identifier);
    }

    private async Task SubmitAsync()
    {
        _submitAttempted = true;
        if (string.IsNullOrWhiteSpace(_identifier))
        {
            _showFormAttention = true;
            return;
        }

        _showFormAttention = false;
        if (_submit is not null)
            await _submit.SetStateAsync(ActionButtonState.Active);
        try
        {
            var result = await Client.RequestPasswordResetAsync(new ForgotPasswordRequest(_identifier.Trim()));
            _message = string.IsNullOrWhiteSpace(result.Message) ? ForgottenPasswordAcknowledgement : result.Message;
            if (_submit is not null)
                await _submit.SetStateAsync(ActionButtonState.Success);
        }
        catch (HttpRequestException)
        {
            _message = ForgottenPasswordAcknowledgement;
            if (_submit is not null)
                await _submit.SetStateAsync(ActionButtonState.Success);
        }
        finally
        {
            _acknowledged = true;
        }
    }
}
