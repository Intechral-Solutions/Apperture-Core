@page "/account/setup-password"
@layout AuthLayout
@using System.Net.Http
@using Microsoft.AspNetCore.Components.Forms
@inject IManagementClient Client
@inject NavigationManager Nav
@inject IToastService Toasts

<div class="mx-auto max-w-md ui-section-panel p-6">
    <PageHeader Title="Set up your password"
                Subtitle="Choose the password you will use for local Apperture sign-in." />

    @if (_error is not null && _done)
    {
        <PageMessage Kind="PageMessageKind.Error" Message="@_error" />
        <p class="mt-4 text-sm text-muted">
            <a class="underline hover:text-heading" href="/login">Sign in</a>
        </p>
    }
    else if (_done)
    {
        <PageMessage Kind="PageMessageKind.Info" Message="Your password is set. You can sign in with your local username." />
        <p class="mt-4 text-sm">
            <a class="btn btn-primary" href="/login">Sign in</a>
        </p>
    }
    else
    {
        @if (_error is not null)
        {
            <PageMessage Kind="PageMessageKind.Error" Message="@_error" />
        }
        <EditForm Model="_formModel" OnValidSubmit="SubmitAsync" OnInvalidSubmit="OnInvalidSubmit" class="mt-4 space-y-3">
            <PasswordSetupFields @ref="_fields"
                                 PasswordId="setup-password"
                                 ConfirmId="setup-password-confirm"
                                 PasswordChanged="value => _password = value"
                                 ConfirmationChanged="value => _confirm = value" />
            <FormValidationFeedback Visible="@_showFormAttention" />
            <ActionButton @ref="_submit"
                          Type="submit"
                          Class="w-full"
                          DefaultText="Set password"
                          ActiveText="Saving…"
                          SuccessText="Password set"
                          ErrorText="Could not save" />
        </EditForm>
    }
</div>

@code {
    private readonly object _formModel = new();
    private string _password = "";
    private string _confirm = "";
    private string? _token;
    private string? _error;
    private bool _done;
    private bool _showFormAttention;
    private ActionButton? _submit;
    private PasswordSetupFields? _fields;

    protected override void OnInitialized()
    {
        _token = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query).Get("token");
        if (string.IsNullOrWhiteSpace(_token))
        {
            _error = "This setup link is invalid or has expired.";
            _done = true;
        }
    }

    private void OnInvalidSubmit() => _showFormAttention = true;

    private async Task SubmitAsync()
    {
        if (_fields is not null && !_fields.ValidateForSubmit())
        {
            _showFormAttention = true;
            return;
        }

        _showFormAttention = false;
        _error = null;
        if (_submit is not null)
            await _submit.SetStateAsync(ActionButtonState.Active);
        try
        {
            await Client.CompletePasswordSetupAsync(new TokenPasswordRequest(_token, _password));
            _done = true;
            _fields?.Reset();
            if (_submit is not null)
                await _submit.SetStateAsync(ActionButtonState.Success);
        }
        catch (HttpRequestException)
        {
            _error = "This setup link is invalid or has expired.";
            _done = true;
            if (_submit is not null)
                await _submit.SetStateAsync(ActionButtonState.Error);
        }
    }
}
