@page "/execute"
@using System.Globalization
@using System.Text.Json
@using Apperture.Management.Client
@using Apperture.Management.Ui.Client.Execution
@using Apperture.Management.Ui.Client.Organisms
@using Apperture.Management.Ui.Client.Molecules
@using Apperture.Management.Ui.Shared
@inject IManagementClient Client
@inject NavigationManager Nav

<div class="p-4 ui-page-stack">
    <PageHeader Eyebrow="Operations"
                Title="@PageTitle"
                Subtitle="@PageSubtitle">
        <Toolbar>
            @if (!string.IsNullOrWhiteSpace(_selectedIntegrationId))
            {
                <a href="@($"/integrations/{Uri.EscapeDataString(_selectedIntegrationId)}")" class="ui-toolbar-btn">Integration</a>
            }
            <a href="/runs" class="ui-toolbar-btn">Run history</a>
        </Toolbar>
    </PageHeader>

    @if (!string.IsNullOrWhiteSpace(_error))
    {
        <ErrorState Title="Launch failed" Message="@_error" />
    }

    @if (!string.IsNullOrWhiteSpace(_successMessage) && !string.IsNullOrWhiteSpace(_runId))
    {
        <ActionFeedback Kind="@PageMessageKind.Info" Message="@_successMessage">
            <div class="mt-2 flex flex-wrap gap-2">
                <DrillInLink Href="@ProcedureLaunchOperatorUiHelpers.GetRunDetailHref(_runId)">Open run</DrillInLink>
                <button type="button" class="ui-toolbar-btn" @onclick="() => Nav.NavigateTo(ProcedureLaunchOperatorUiHelpers.GetRunDetailHref(_runId!))">
                    Go to run detail
                </button>
            </div>
        </ActionFeedback>
    }

    @if (_loading && _integrations.Count == 0)
    {
        <LoadingState />
    }
    else if (_integrations.Count == 0)
    {
        <EmptyState Title="No integrations"
                    Message="Create an integration before launching workflows, operations, or procedures.">
            <a href="/integrations/new" class="mt-3 inline-block ui-toolbar-btn">Create integration</a>
        </EmptyState>
    }
    else
    {
        <ManagementSection Title="Launch target"
                           Layer="ManagementSection.UiLayer.Summary"
                           Help="Choose integration, launch type, and executable. Readiness and blocked reasons are evaluated before launch.">
            <div class="grid gap-4 md:grid-cols-2">
                <div>
                    <label class="text-xs text-muted">Integration</label>
                    <select class="mt-1 w-full rounded border border-default bg-surface px-2 py-2 text-sm"
                            value="@(_selectedIntegrationId ?? "")"
                            @onchange="OnIntegrationChanged">
                        <option value="">Select integration…</option>
                        @foreach (var integration in _integrations)
                        {
                            <option value="@integration.Id">@integration.DisplayName</option>
                        }
                    </select>
                    @if (!string.IsNullOrWhiteSpace(_selectedIntegrationId))
                    {
                        <div class="mt-1 text-xs text-muted">
                            <DrillInLink Href="@($"/integrations/{Uri.EscapeDataString(_selectedIntegrationId)}")">View integration</DrillInLink>
                        </div>
                    }
                </div>
                <div>
                    <label class="text-xs text-muted">Launch type</label>
                    <select class="mt-1 w-full rounded border border-default bg-surface px-2 py-2 text-sm"
                            disabled="@string.IsNullOrWhiteSpace(_selectedIntegrationId)"
                            value="@_selectedKind"
                            @onchange="OnKindChanged">
                        <option value="@ExecutionTargetKinds.Procedure">Procedure</option>
                        <option value="@ExecutionTargetKinds.Workflow">Workflow</option>
                        <option value="@ExecutionTargetKinds.Operation">Operation</option>
                    </select>
                </div>
                <div class="md:col-span-2">
                    <label class="text-xs text-muted">@TargetExecutableLabel</label>
                    <select class="mt-1 w-full rounded border border-default bg-surface px-2 py-2 text-sm"
                            disabled="@(!_targetIds.Any())"
                            value="@(_selectedTargetId ?? "")"
                            @onchange="OnTargetChanged">
                        <option value="">Select…</option>
                        @foreach (var target in _targetIds)
                        {
                            <option value="@target.Id" disabled="@target.Blocked">@target.Name@(target.Blocked ? " (blocked)" : "")</option>
                        }
                    </select>
                    @if (_targetIds.Count == 0 && !string.IsNullOrWhiteSpace(_selectedIntegrationId))
                    {
                        <div class="mt-2 text-xs text-muted">No @TargetExecutableLabel.ToLowerInvariant() available for this integration.</div>
                    }
                </div>
            </div>

            @if (_operatorDetail?.Readiness is { } readiness)
            {
                <div class="mt-4 flex flex-wrap items-center gap-2">
                    <StatusPill Label="@(readiness.IsRunnable ? "Integration runnable" : "Integration not runnable")"
                                Semantic="@(readiness.IsRunnable ? ManagementStatusSemantic.Success : ManagementStatusSemantic.Warning)" />
                    @if (readiness.BlockingIssueCount > 0)
                    {
                        <AttentionPill Label="@($"{readiness.BlockingIssueCount} blocking issue(s)")"
                                         Semantic="@ManagementAttentionSemantic.Critical" />
                    }
                </div>
                @if (!readiness.IsRunnable)
                {
                    <PageMessage Kind="PageMessageKind.Warning"
                                 Message="Resolve readiness on the integration page before launching procedures." />
                }
            }

            @if (_descriptor is not null)
            {
                <div class="mt-4 rounded border border-default bg-surface-muted/40 p-3">
                    <div class="text-sm font-semibold text-heading">@_descriptor.DisplayName</div>
                    @if (!string.IsNullOrWhiteSpace(_descriptorDescription))
                    {
                        <div class="text-xs text-muted mt-1">@_descriptorDescription</div>
                    }
                    @if (!_descriptor.Launchable && _descriptor.BlockedReasonCodes.Count > 0)
                    {
                        <ul class="mt-2 list-disc pl-5 text-xs text-body">
                            @foreach (var blocked in _descriptor.BlockedReasonCodes)
                            {
                                <li>@ProcedureLaunchOperatorUiHelpers.DescribeBlockedReason(blocked)</li>
                            }
                        </ul>
                    }
                </div>
            }
        </ManagementSection>

        @if (_descriptor is null && !string.IsNullOrWhiteSpace(_selectedIntegrationId))
        {
            <EmptyState Title="Choose what to run"
                        Message="Select a launch type and executable to configure parameters and launch." />
        }
        else if (_descriptor is not null)
        {
            <ManagementSection Title="Parameters and launch"
                               Layer="ManagementSection.UiLayer.Detail"
                               Help="Required fields are marked with *. Validation runs before the server accepts the launch.">
                @if (_validationErrors.Count > 0)
                {
                    <PageMessage Kind="PageMessageKind.Warning" Message="@_validationErrors[0]" />
                }

                @if (_descriptor.RendererKey == ExecutionRendererKeys.MetadataForm && _descriptor.ProcedureDetail is not null)
                {
                    <ProcedureParameterForm Fields="@_descriptor.ProcedureDetail.ParameterFields"
                                              Values="@_procedureValues"
                                              OnChanged="RefreshValidation" />
                }
                else if (_descriptor.RendererKey == ExecutionRendererKeys.MetadataForm && _descriptor.Fields is { Count: > 0 } fields)
                {
                    @foreach (var field in fields)
                    {
                        <div class="mt-3">
                            <label class="text-xs text-muted">@field.Label@(field.Required ? " *" : "")</label>
                            @if (!string.IsNullOrWhiteSpace(field.HelpText))
                            {
                                <div class="text-xs text-muted mb-1">@field.HelpText</div>
                            }
                            @if (field.AllowedValues is { Count: > 0 } options)
                            {
                                <select class="mt-1 w-full rounded border border-default bg-surface px-2 py-2 text-sm"
                                        value="@GetStringValue(field.Key)"
                                        @onchange="e => SetStringValue(field.Key, e.Value?.ToString())">
                                    <option value="">@(field.Required ? "(select)" : "(optional)")</option>
                                    @foreach (var option in options)
                                    {
                                        <option value="@option">@option</option>
                                    }
                                </select>
                            }
                            else
                            {
                                <input class="mt-1 w-full rounded border border-default bg-surface px-2 py-2 text-sm"
                                       value="@GetStringValue(field.Key, field.DefaultValue)"
                                       @onchange="e => SetStringValue(field.Key, e.Value?.ToString())" />
                            }
                        </div>
                    }
                }
                else
                {
                    <div class="mt-3">
                        <label class="text-xs text-muted">Parameters (JSON object)</label>
                        <textarea class="mt-1 w-full rounded border border-default bg-surface px-2 py-2 text-sm font-mono"
                                  rows="8"
                                  @bind="_jsonParameters"></textarea>
                    </div>
                }

                @{
                    var disabledReason = LaunchDisabledReason;
                }
                <button type="button"
                        class="mt-4 ui-toolbar-btn"
                        disabled="@(!CanLaunch)"
                        title="@disabledReason"
                        @onclick="LaunchAsync">
                    Launch
                </button>
                @if (!string.IsNullOrWhiteSpace(disabledReason) && !CanLaunch)
                {
                    <div class="mt-2 text-xs text-muted">@disabledReason</div>
                }
            </ManagementSection>

            <ManagementAdvancedSection Title="Advanced launch options"
                                       Subtitle="Optional idempotency and correlation; technical target identifiers."
                                       InitiallyOpen="false">
                <div class="grid gap-3 md:grid-cols-2">
                    <div>
                        <label class="text-xs text-muted">Idempotency key (optional)</label>
                        <input class="mt-1 w-full rounded border border-default bg-surface px-2 py-2 text-sm font-mono" @bind="_idempotencyKey" />
                    </div>
                    <div>
                        <label class="text-xs text-muted">Correlation ID (optional)</label>
                        <input class="mt-1 w-full rounded border border-default bg-surface px-2 py-2 text-sm font-mono" @bind="_correlationId" />
                    </div>
                </div>
                <details class="mt-3">
                    <summary class="cursor-pointer text-xs text-muted">Technical identifiers</summary>
                    <div class="mt-2 space-y-1 text-xs font-mono text-muted">
                        <div>Kind: @_descriptor.Kind</div>
                        <div>Target: @_descriptor.TargetId</div>
                        <div>Integration: @_descriptor.IntegrationId</div>
                        <div>Renderer: @_descriptor.RendererKey</div>
                    </div>
                </details>
            </ManagementAdvancedSection>
        }
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "kind")]
    public string? KindFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "integrationId")]
    public string? IntegrationIdFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "procedureId")]
    public string? ProcedureIdFromQuery { get; set; }

    [SupplyParameterFromQuery(Name = "targetId")]
    public string? TargetIdFromQuery { get; set; }

    private readonly List<IExecutionLaunchAdapter> _adapters =
    [
        new WorkflowExecutionLaunchAdapter(),
        new OperationExecutionLaunchAdapter(),
        new ProcedureExecutionLaunchAdapter()
    ];

    private IReadOnlyList<IntegrationDto> _integrations = Array.Empty<IntegrationDto>();
    private IReadOnlyList<OperationDefinitionDto> _operations = Array.Empty<OperationDefinitionDto>();
    private IReadOnlyList<WorkflowDto> _workflows = Array.Empty<WorkflowDto>();
    private IReadOnlyList<IntegrationProcedureItemDto> _procedures = Array.Empty<IntegrationProcedureItemDto>();
    private List<(string Id, string Name, bool Blocked)> _targetIds = [];
    private IntegrationOperatorDetailDto? _operatorDetail;

    private string? _selectedIntegrationId;
    private string _selectedKind = ExecutionTargetKinds.Procedure;
    private string? _selectedTargetId;
    private string? _descriptorDescription;

    private ExecutionDescriptor? _descriptor;
    private readonly Dictionary<string, object?> _fieldValues = new(StringComparer.Ordinal);
    private readonly Dictionary<string, object?> _procedureValues = new(StringComparer.Ordinal);
    private readonly List<string> _validationErrors = [];
    private string _jsonParameters = "{}";
    private string? _idempotencyKey;
    private string? _correlationId;
    private string? _error;
    private string? _successMessage;
    private string? _runId;
    private bool _loading;

    private string PageTitle => _descriptor?.DisplayName ?? "Execute";

    private string PageSubtitle
    {
        get
        {
            if (_descriptor is not null && SelectedIntegration is not null)
                return ProcedureLaunchOperatorUiHelpers.BuildLaunchContextSubtitle(
                    SelectedIntegration.DisplayName,
                    _descriptor.DisplayName,
                    _descriptor.ProcedureDetail?.LaunchKind ?? _descriptor.Kind);
            if (SelectedIntegration is not null)
                return $"Launch workflows, operations, or procedures for {SelectedIntegration.DisplayName}.";
            return "Start a workflow, operation, or procedure for an integration.";
        }
    }

    private IntegrationDto? SelectedIntegration =>
        _integrations.FirstOrDefault(i => string.Equals(i.Id, _selectedIntegrationId, StringComparison.Ordinal));

    private string TargetExecutableLabel =>
        string.Equals(_selectedKind, ExecutionTargetKinds.Procedure, StringComparison.Ordinal) ? "Procedure"
        : string.Equals(_selectedKind, ExecutionTargetKinds.Operation, StringComparison.Ordinal) ? "Operation"
        : "Workflow";

    private bool IntegrationReady => _operatorDetail?.Readiness.IsRunnable ?? _procedureIntegrationReady;

    private bool _procedureIntegrationReady = true;

    private bool CanLaunch =>
        _descriptor is { Launchable: true }
        && IntegrationReady
        && !_loading
        && _validationErrors.Count == 0;

    private string? LaunchDisabledReason =>
        _descriptor is null
            ? "Select a target executable."
            : ProcedureLaunchOperatorUiHelpers.BuildLaunchDisabledReason(
                _loading,
                _descriptor.Launchable,
                IntegrationReady,
                _descriptor.BlockedReasonCodes,
                _validationErrors);

    protected override async Task OnInitializedAsync()
    {
        _selectedKind = NormalizeKind(KindFromQuery);
        _selectedIntegrationId = string.IsNullOrWhiteSpace(IntegrationIdFromQuery) ? null : IntegrationIdFromQuery;
        await LoadBaseAsync();
        await ReloadTargetsAsync();

        var preselect = !string.IsNullOrWhiteSpace(ProcedureIdFromQuery)
            ? ProcedureIdFromQuery
            : TargetIdFromQuery;
        if (!string.IsNullOrWhiteSpace(preselect) && _targetIds.Any(t => string.Equals(t.Id, preselect, StringComparison.Ordinal)))
        {
            _selectedTargetId = preselect;
            _descriptor = await BuildDescriptorAsync(_selectedKind, _selectedIntegrationId!, _selectedTargetId);
            RefreshValidation();
        }
    }

    private async Task LoadBaseAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _integrations = await Client.GetIntegrationsAsync();
            _operations = await Client.GetOperationsAsync();
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OnIntegrationChanged(ChangeEventArgs e)
    {
        _selectedIntegrationId = e.Value?.ToString();
        _selectedTargetId = null;
        _descriptor = null;
        _descriptorDescription = null;
        _operatorDetail = null;
        ClearLaunchFeedback();
        await ReloadTargetsAsync();
    }

    private async Task OnKindChanged(ChangeEventArgs e)
    {
        _selectedKind = NormalizeKind(e.Value?.ToString());
        _selectedTargetId = null;
        _descriptor = null;
        _descriptorDescription = null;
        ClearLaunchFeedback();
        await ReloadTargetsAsync();
    }

    private async Task ReloadTargetsAsync()
    {
        _targetIds.Clear();
        _workflows = Array.Empty<WorkflowDto>();
        _procedures = Array.Empty<IntegrationProcedureItemDto>();
        _procedureIntegrationReady = true;
        _operatorDetail = null;

        if (string.IsNullOrWhiteSpace(_selectedIntegrationId))
            return;

        try
        {
            _operatorDetail = await Client.GetIntegrationOperatorDetailAsync(_selectedIntegrationId);
        }
        catch
        {
            _operatorDetail = null;
        }

        var integration = SelectedIntegration;
        if (integration is null)
            return;

        if (string.Equals(_selectedKind, ExecutionTargetKinds.Workflow, StringComparison.Ordinal))
        {
            _workflows = await Client.GetWorkflowsAsync(integration.ModuleId);
            _targetIds = _workflows.Select(w => (w.Id, w.Name, Blocked: false)).ToList();
        }
        else if (string.Equals(_selectedKind, ExecutionTargetKinds.Operation, StringComparison.Ordinal))
        {
            _targetIds = _operations
                .Where(o => string.Equals(o.ModuleId, integration.ModuleId, StringComparison.Ordinal))
                .Select(o => (o.OperationDefinitionId, o.DisplayName, Blocked: !o.CanStart))
                .ToList();
        }
        else
        {
            var procedureList = await Client.GetIntegrationProceduresAsync(_selectedIntegrationId);
            _procedureIntegrationReady = procedureList?.IntegrationReady ?? false;
            _procedures = procedureList?.Procedures ?? Array.Empty<IntegrationProcedureItemDto>();
            _targetIds = _procedures.Select(p => (p.Id, p.DisplayName, Blocked: !p.Launchable)).ToList();
        }
    }

    private async Task OnTargetChanged(ChangeEventArgs e)
    {
        _selectedTargetId = e.Value?.ToString();
        _descriptor = null;
        _descriptorDescription = null;
        _fieldValues.Clear();
        _procedureValues.Clear();
        ClearLaunchFeedback();
        if (string.IsNullOrWhiteSpace(_selectedTargetId) || string.IsNullOrWhiteSpace(_selectedIntegrationId))
            return;

        _descriptor = await BuildDescriptorAsync(_selectedKind, _selectedIntegrationId, _selectedTargetId);
        RefreshValidation();
    }

    private async Task<ExecutionDescriptor?> BuildDescriptorAsync(string kind, string integrationId, string targetId)
    {
        if (string.Equals(kind, ExecutionTargetKinds.Workflow, StringComparison.Ordinal))
        {
            var workflow = _workflows.FirstOrDefault(w => string.Equals(w.Id, targetId, StringComparison.Ordinal));
            if (workflow is null)
                return null;

            var launchable = IntegrationReady;
            var blockedReasons = launchable ? Array.Empty<string>() : new[] { "integration_not_ready" };
            _descriptorDescription = null;
            return new ExecutionDescriptor(
                kind,
                integrationId,
                workflow.Id,
                workflow.Name,
                launchable,
                blockedReasons,
                ExecutionRendererKeys.RawJson,
                WizardDefinitionRef: null);
        }

        if (string.Equals(kind, ExecutionTargetKinds.Operation, StringComparison.Ordinal))
        {
            var operation = _operations.FirstOrDefault(o => string.Equals(o.OperationDefinitionId, targetId, StringComparison.Ordinal));
            if (operation is null)
                return null;

            var fields = operation.InputSchema?.Fields
                .Select(f => new ExecutionInputField(
                    f.Key,
                    f.Type,
                    f.Label,
                    f.HelpText,
                    f.Required,
                    f.DefaultValue,
                    f.AllowedValues))
                .ToArray();
            if (fields is not null)
            {
                foreach (var field in fields)
                    _fieldValues[field.Key] = field.DefaultValue;
            }

            var blockedReasons = new List<string>();
            if (!IntegrationReady)
                blockedReasons.Add("integration_not_ready");
            if (!operation.CanStart)
                blockedReasons.Add("target_not_executable");

            _descriptorDescription = null;
            return new ExecutionDescriptor(
                kind,
                integrationId,
                operation.OperationDefinitionId,
                operation.DisplayName,
                IntegrationReady && operation.CanStart,
                blockedReasons,
                fields is { Length: > 0 } ? ExecutionRendererKeys.MetadataForm : ExecutionRendererKeys.RawJson,
                WizardDefinitionRef: null,
                Fields: fields);
        }

        var detail = await Client.GetIntegrationProcedureAsync(integrationId, targetId);
        if (detail is null)
            return null;

        ProcedureParameterForm.SeedValues(detail.ParameterFields, _procedureValues);
        _descriptorDescription = detail.Description;
        var procedureBlockedReasons = detail.BlockedReasonCodes.ToList();
        if (!IntegrationReady && !procedureBlockedReasons.Contains("integration_not_ready", StringComparer.Ordinal))
            procedureBlockedReasons.Insert(0, "integration_not_ready");

        return new ExecutionDescriptor(
            kind,
            integrationId,
            detail.Id,
            detail.DisplayName,
            detail.Launchable && IntegrationReady,
            procedureBlockedReasons,
            ExecutionRendererKeys.MetadataForm,
            WizardDefinitionRef: null,
            ProcedureDetail: detail);
    }

    private void RefreshValidation()
    {
        _validationErrors.Clear();
        if (_descriptor?.ProcedureDetail is { } procedure)
        {
            _validationErrors.AddRange(
                ProcedureLaunchOperatorUiHelpers.ValidateProcedureParameters(procedure.ParameterFields, _procedureValues));
        }
        else if (_descriptor?.Fields is { Count: > 0 } fields)
        {
            _validationErrors.AddRange(
                ProcedureLaunchOperatorUiHelpers.ValidateOperationFields(
                    fields.Select(f => new ExecutionInputFieldLike(f.Key, f.Label, f.Required)).ToList(),
                    _fieldValues));
        }
    }

    private string? GetStringValue(string key, string? fallback = null) =>
        _fieldValues.TryGetValue(key, out var value) ? value?.ToString() ?? fallback : fallback;

    private void SetStringValue(string key, string? value)
    {
        _fieldValues[key] = value;
        RefreshValidation();
    }

    private void ClearLaunchFeedback()
    {
        _error = null;
        _successMessage = null;
        _runId = null;
        _validationErrors.Clear();
    }

    private async Task LaunchAsync()
    {
        if (_descriptor is null)
            return;

        RefreshValidation();
        if (_validationErrors.Count > 0)
            return;

        _loading = true;
        _error = null;
        _successMessage = null;
        _runId = null;
        try
        {
            var adapter = _adapters.First(a => string.Equals(a.Kind, _descriptor.Kind, StringComparison.Ordinal));
            var parameters = ResolveParameters(_descriptor);
            var outcome = await adapter.LaunchAsync(
                Client,
                _descriptor,
                parameters,
                string.IsNullOrWhiteSpace(_idempotencyKey) ? null : _idempotencyKey,
                string.IsNullOrWhiteSpace(_correlationId) ? null : _correlationId);

            if (!outcome.Succeeded)
            {
                _error = ProcedureLaunchOperatorUiHelpers.FormatLaunchError(outcome.ErrorCode, outcome.ErrorMessage);
                return;
            }

            _runId = outcome.RunId;
            _successMessage = ProcedureLaunchOperatorUiHelpers.FormatLaunchSuccessMessage(_runId!, outcome.Status);
        }
        catch (JsonException ex)
        {
            _error = $"Invalid parameters JSON: {ex.Message}";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private IReadOnlyDictionary<string, object?>? ResolveParameters(ExecutionDescriptor descriptor)
    {
        if (descriptor.ProcedureDetail is not null)
            return _procedureValues.Count == 0 ? null : _procedureValues;

        if (descriptor.Fields is { Count: > 0 })
        {
            var dict = new Dictionary<string, object?>(StringComparer.Ordinal);
            foreach (var field in descriptor.Fields)
            {
                _fieldValues.TryGetValue(field.Key, out var rawValue);
                var raw = rawValue?.ToString();
                if (string.IsNullOrWhiteSpace(raw))
                {
                    if (field.Required)
                        throw new InvalidOperationException($"Field '{field.Label}' is required.");
                    continue;
                }

                dict[field.Key] = field.Type.ToLowerInvariant() switch
                {
                    "int" => int.Parse(raw, CultureInfo.InvariantCulture),
                    "decimal" => decimal.Parse(raw, CultureInfo.InvariantCulture),
                    "bool" => bool.Parse(raw),
                    _ => raw
                };
            }

            return dict.Count == 0 ? null : dict;
        }

        return ParseJsonObject(_jsonParameters);
    }

    private static IReadOnlyDictionary<string, object?>? ParseJsonObject(string json)
    {
        if (string.IsNullOrWhiteSpace(json))
            return null;
        var trimmed = json.Trim();
        if (trimmed == "{}")
            return null;

        var doc = JsonDocument.Parse(trimmed);
        if (doc.RootElement.ValueKind != JsonValueKind.Object)
            throw new JsonException("Parameters must be a JSON object.");

        var dict = new Dictionary<string, object?>(StringComparer.Ordinal);
        foreach (var property in doc.RootElement.EnumerateObject())
        {
            dict[property.Name] = property.Value.ValueKind switch
            {
                JsonValueKind.String => property.Value.GetString(),
                JsonValueKind.True => true,
                JsonValueKind.False => false,
                JsonValueKind.Number => property.Value.TryGetInt64(out var l) ? l : property.Value.GetDouble(),
                JsonValueKind.Null => null,
                _ => property.Value.GetRawText()
            };
        }
        return dict;
    }

    private static string NormalizeKind(string? kind) =>
        string.Equals(kind, ExecutionTargetKinds.Operation, StringComparison.OrdinalIgnoreCase) ? ExecutionTargetKinds.Operation :
        string.Equals(kind, ExecutionTargetKinds.Workflow, StringComparison.OrdinalIgnoreCase) ? ExecutionTargetKinds.Workflow :
        ExecutionTargetKinds.Procedure;
}
