@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Shared.Auth
@implements IDisposable
@inject SessionStateService Session
@inject IOperatorCapabilitiesService Capabilities
@inject ShellBootstrapState ShellBootstrap
@inject NavigationManager Nav
@* Injected so the per-document recovery coordinator exists from the first render: it listens for a signed-in
   tab's soft session refresh being answered 401 (SessionStateService.UnauthorizedDuringRefresh). *@
@inject SessionRecoveryCoordinator Recovery

@* UIX-2 pass 7: keep ChildContent mounted after first show. Initial auth still loading-only.
   Public routes (login) render ChildContent without committing the protected shell. *@
@if (_blockProtectedShell && !_shellCommitted)
{
    <div class="flex min-h-screen items-center justify-center bg-surface-elevated px-4">
        @if (_surfaceState is { } surfaceState)
        {
            <SessionStatusSurface State="surfaceState" />
        }
        else
        {
            <p class="text-sm text-muted">@_loadingMessage</p>
        }
    </div>
}
else
{
    <div class="@(_blockProtectedShell ? "hidden" : null)" aria-hidden="@_blockProtectedShell">
        @ChildContent
    </div>
    @if (_blockProtectedShell)
    {
        <div class="flex min-h-screen items-center justify-center bg-surface-elevated px-4">
            <p class="text-sm text-muted">@_loadingMessage</p>
        </div>
    }
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _blockProtectedShell = true;
    private bool _shellCommitted;
    private string _loadingMessage = "Loading session…";
    private bool _capabilitiesReady;
    private SessionLoadState _lastSessionState = SessionLoadState.Unknown;
    private int _capabilitiesWarmGeneration;
    private bool _loginRedirectIssued;
    private bool _disposed;

    /// <summary>Set while the protected shell is replaced by a session-status surface (session expired, account or service unavailable).</summary>
    private SessionLoadState? _surfaceState;

    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
        Nav.LocationChanged += OnLocationChanged;
        ShellBootstrap.Changed += OnBootstrapChanged;
        UpdateBlocking();
        _ = ApplyNavigationRulesAsync();
        _ = SyncCapabilitiesWithSessionAsync();
    }

    public void Dispose()
    {
        if (_disposed)
            return;
        _disposed = true;
        Session.Changed -= OnSessionChanged;
        Nav.LocationChanged -= OnLocationChanged;
        ShellBootstrap.Changed -= OnBootstrapChanged;
    }

    private void OnBootstrapChanged()
    {
        if (_disposed)
            return;

        _ = InvokeAsync(() =>
        {
            if (_disposed)
                return;

            if (UpdateBlocking())
                StateHasChanged();
        });
    }

    private void OnSessionChanged()
    {
        if (_disposed)
            return;

        // Marshal onto the renderer: Session.RefreshAsync may resume off-context.
        _ = InvokeAsync(async () =>
        {
            if (_disposed)
                return;

            var blockChanged = UpdateBlocking();
            _ = ApplyNavigationRulesAsync();
            _ = SyncCapabilitiesWithSessionAsync();
            if (blockChanged)
                StateHasChanged();
            await Task.CompletedTask;
        });
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        if (_disposed)
            return;

        _ = InvokeAsync(() =>
        {
            if (_disposed)
                return;

            var blockChanged = UpdateBlocking();
            _ = ApplyNavigationRulesAsync();
            if (blockChanged)
                StateHasChanged();
        });
    }

    /// <returns>True when the block flag or commit flag changed (caller should re-render).</returns>
    private bool UpdateBlocking()
    {
        var path = new Uri(Nav.Uri).AbsolutePath;
        var pub = LoginRouteHelper.IsPublicPath(path);
        var loginChooser = LoginRouteHelper.IsLoginChooserPath(path);
        var root = LoginRouteHelper.IsRootBootstrapPath(path);
        var wasCommitted = _shellCommitted;

        if (AuthShellAccess.ShouldReleaseShellCommit(Session.State, pub))
            _shellCommitted = false;

        _loadingMessage = AuthShellAccess.GetBlockingMessage(Session.State, _capabilitiesReady);
        var next = AuthShellAccess.ShouldBlockProtectedShell(
            Session.State,
            _capabilitiesReady,
            pub,
            root,
            _shellCommitted,
            ShellBootstrap.IsReady,
            loginChooser);

        if (AuthShellAccess.ShouldCommitShell(next, pub, root))
            _shellCommitted = true;

        var surface = AuthShellAccess.ShouldShowSessionStatusSurface(Session.State, pub) ? Session.State : (SessionLoadState?)null;

        var changed = next != _blockProtectedShell || wasCommitted != _shellCommitted || surface != _surfaceState;
        _blockProtectedShell = next;
        _surfaceState = surface;
        return changed;
    }

    private async Task SyncCapabilitiesWithSessionAsync()
    {
        if (Session.State != SessionLoadState.Authenticated)
        {
            await InvokeAsync(() =>
            {
                if (_disposed)
                    return;

                // Anything that is not a usable signed-in session must not leave stale capabilities behind.
                if (Session.State is SessionLoadState.Unauthenticated
                    or SessionLoadState.ServiceUnavailable
                    or SessionLoadState.SessionExpired
                    or SessionLoadState.AccountUnavailable)
                    Capabilities.InvalidateCache();

                if (_lastSessionState == SessionLoadState.Authenticated && !_shellCommitted)
                    _capabilitiesReady = false;

                _lastSessionState = Session.State;
                if (UpdateBlocking())
                    StateHasChanged();
            });
            return;
        }

        if (_capabilitiesReady && _lastSessionState == SessionLoadState.Authenticated)
            return;

        var generation = Interlocked.Increment(ref _capabilitiesWarmGeneration);

        await InvokeAsync(() =>
        {
            if (_disposed)
                return;

            // Never clear ready after the shell is committed — that would hide/re-show ChildContent
            // and reintroduce dispose-during-await races.
            if (!_shellCommitted)
                _capabilitiesReady = false;

            _lastSessionState = Session.State;
            if (UpdateBlocking())
                StateHasChanged();
        });

        try
        {
            await Capabilities.RefreshAsync();
        }
        catch
        {
            /* RefreshAsync does not throw; guard for future changes */
        }

        if (_disposed || generation != _capabilitiesWarmGeneration)
            return;

        await InvokeAsync(async () =>
        {
            if (_disposed || generation != _capabilitiesWarmGeneration)
                return;

            _capabilitiesReady = true;
            if (!UpdateBlocking())
                return;

            // Defer shell mount one tick so it is not nested inside the caps continuation
            // that also races App bootstrap / first-paint children (parentNode).
            await Task.Yield();
            if (_disposed || generation != _capabilitiesWarmGeneration)
                return;
            StateHasChanged();
        });
    }

    private async Task ApplyNavigationRulesAsync()
    {
        var path = new Uri(Nav.Uri).AbsolutePath;
        var isPublic = LoginRouteHelper.IsPublicPath(path);
        var isRoot = LoginRouteHelper.IsRootBootstrapPath(path);

        await Task.Yield();
        if (_disposed)
            return;

        if (AuthShellAccess.ShouldRedirectRootBootstrap(Session.State, isRoot))
        {
            _loginRedirectIssued = false;
            if (Session.State == SessionLoadState.Authenticated)
            {
                Nav.NavigateTo(LoginRouteHelper.DefaultPostLoginPath, replace: true);
                return;
            }

            if (Session.State == SessionLoadState.AccessRequestSession)
            {
                Nav.NavigateTo("/access-request", replace: true);
                return;
            }

            if (AuthShellAccess.ShouldRedirectToLogin(Session.State, isPublicPath: false))
            {
                if (_loginRedirectIssued)
                    return;
                _loginRedirectIssued = true;
                Nav.NavigateTo(LoginRouteHelper.BuildLoginUrl("/"), replace: true);
            }

            return;
        }

        if (AuthShellAccess.ShouldRedirectAuthenticatedAwayFromLogin(Session.State, LoginRouteHelper.IsLoginChooserPath(path))
            && Session.User is not null)
        {
            _loginRedirectIssued = false;
            var safe = LoginRouteHelper.ReadReturnTarget(Nav.Uri) ?? LoginRouteHelper.DefaultPostLoginPath;
            Nav.NavigateTo(safe, replace: true);
            return;
        }

        if (isPublic)
        {
            _loginRedirectIssued = false;
            return;
        }

        if (AuthShellAccess.ShouldRedirectToAccessRequest(Session.State, LoginRouteHelper.IsAccessRequestPath(path)))
        {
            Nav.NavigateTo("/access-request", replace: true);
            return;
        }

        if (Session.State is SessionLoadState.Unknown or SessionLoadState.Loading)
            return;

        if (Session.State == SessionLoadState.Authenticated)
        {
            _loginRedirectIssued = false;
            return;
        }

        // Boot-time sign-in only: auth/me positively answered 401. A session lost while the tab is open is owned
        // by SessionRecoveryCoordinator (full-page navigation); an outage or unusable account never signs in.
        if (!AuthShellAccess.ShouldRedirectToLogin(Session.State, isPublic))
            return;

        if (_loginRedirectIssued)
            return;

        _loginRedirectIssued = true;
        // Path, query and fragment exactly as the browser has them; BuildLoginUrl applies the shared return-target policy.
        Nav.NavigateTo(LoginRouteHelper.BuildLoginUrl(LocalReturnUrl.FromAbsoluteUri(Nav.Uri)), replace: true);
    }
}
