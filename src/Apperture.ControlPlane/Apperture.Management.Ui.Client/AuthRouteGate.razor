@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Shared.Auth
@implements IDisposable
@inject SessionStateService Session
@inject IOperatorCapabilitiesService Capabilities
@inject NavigationManager Nav

@if (_blockProtectedShell)
{
    <div class="flex min-h-screen items-center justify-center bg-surface-elevated px-4">
        <p class="text-sm text-muted">@_loadingMessage</p>
    </div>
}
else
{
    @ChildContent
}

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _blockProtectedShell;
    private string _loadingMessage = "Loading session…";
    private bool _capabilitiesReady;
    private SessionLoadState _lastSessionState = SessionLoadState.Unknown;
    private int _capabilitiesWarmGeneration;

    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
        Nav.LocationChanged += OnLocationChanged;
        UpdateBlocking();
        _ = ApplyNavigationRulesAsync();
        _ = SyncCapabilitiesWithSessionAsync();
    }

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        Nav.LocationChanged -= OnLocationChanged;
    }

    private void OnSessionChanged()
    {
        UpdateBlocking();
        _ = ApplyNavigationRulesAsync();
        _ = SyncCapabilitiesWithSessionAsync();
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
    {
        UpdateBlocking();
        _ = ApplyNavigationRulesAsync();
        _ = InvokeAsync(StateHasChanged);
    }

    private void UpdateBlocking()
    {
        var path = new Uri(Nav.Uri).AbsolutePath;
        var pub = LoginRouteHelper.IsPublicPath(path);
        if (pub)
        {
            _blockProtectedShell = false;
            return;
        }

        _loadingMessage = Session.State is SessionLoadState.Unknown or SessionLoadState.Loading
            ? "Loading session…"
            : "Loading permissions…";

        _blockProtectedShell = Session.State is SessionLoadState.Unknown or SessionLoadState.Loading
            || (Session.State == SessionLoadState.Authenticated && !_capabilitiesReady);
    }

    private async Task SyncCapabilitiesWithSessionAsync()
    {
        if (Session.State != SessionLoadState.Authenticated)
        {
            if (Session.State is SessionLoadState.Unauthenticated or SessionLoadState.Error)
                Capabilities.InvalidateCache();

            if (_lastSessionState == SessionLoadState.Authenticated)
                _capabilitiesReady = false;

            _lastSessionState = Session.State;
            UpdateBlocking();
            return;
        }

        if (_capabilitiesReady && _lastSessionState == SessionLoadState.Authenticated)
            return;

        var generation = Interlocked.Increment(ref _capabilitiesWarmGeneration);
        _capabilitiesReady = false;
        _lastSessionState = Session.State;
        UpdateBlocking();

        try
        {
            await Capabilities.RefreshAsync();
        }
        catch
        {
            /* RefreshAsync does not throw; guard for future changes */
        }

        if (generation != _capabilitiesWarmGeneration)
            return;

        _capabilitiesReady = true;
        UpdateBlocking();
        await InvokeAsync(StateHasChanged);
    }

    private async Task ApplyNavigationRulesAsync()
    {
        var path = new Uri(Nav.Uri).AbsolutePath;
        await Task.Yield();

        if (LoginRouteHelper.IsPublicPath(path))
        {
            if (Session.State == SessionLoadState.Authenticated && Session.User is not null)
            {
                var returnUrl = LoginRouteHelper.GetReturnUrlRaw(Nav.Uri);
                var safe = LoginRouteHelper.NormalizeReturnUrl(returnUrl) ?? LoginRouteHelper.DefaultPostLoginPath;
                Nav.NavigateTo(safe, replace: true);
            }

            return;
        }

        if (Session.State is SessionLoadState.Unknown or SessionLoadState.Loading)
            return;

        if (Session.State is SessionLoadState.ForbiddenUnlinked or SessionLoadState.Authenticated)
            return;

        if (Session.State is SessionLoadState.Unauthenticated or SessionLoadState.Error)
        {
            var enc = Uri.EscapeDataString(path + new Uri(Nav.Uri).Query);
            Nav.NavigateTo($"/login?returnUrl={enc}", replace: true);
        }
    }
}
