<div class="@WrapperClass" @attributes="AdditionalAttributes">
    <AppertureLogoShape class="@ShapeClass" />
</div>

@code {
    [Parameter]
    public string WrapperClass { get; set; } = "inline-block p-1";

    [Parameter]
    public string ShapeClass { get; set; } = "w-8 h-8 bg-slate-900 dark:bg-slate-100";

    [Parameter(CaptureUnmatchedValues = true)]
    public Dictionary<string, object>? AdditionalAttributes { get; set; }
}
