@using Apperture.Core.Domain.Identity

<div class="@RootClass" aria-live="polite">
    <div class="ui-password-strength__row">
        <span class="ui-password-strength__label">Password strength</span>
        @if (!Neutral)
        {
            <span class="ui-password-strength__value">@Band</span>
        }
    </div>
    <div class="ui-password-strength__meter"
         role="meter"
         aria-label="Password strength"
         aria-valuemin="0"
         aria-valuemax="4"
         aria-valuenow="@(Neutral ? 0 : Evaluation.Score)"
         aria-valuetext="@(Neutral ? "Not rated" : Band)">
        <span class="ui-password-strength__fill" style="width: @FillPercent%"></span>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public PasswordEvaluationResult Evaluation { get; set; } =
        new(false, PasswordStrengthLevel.VeryWeak, 0, [], [], []);

    [Parameter] public bool Neutral { get; set; }

    [Parameter] public string Class { get; set; } = "";

    private string Band => PasswordStrengthDisplay.BandLabel(Evaluation.Score).ToUpperInvariant();

    private int FillPercent => PasswordStrengthDisplay.MeterPercent(Evaluation.Score, Neutral);

    private string RootClass
    {
        get
        {
            var tone = Neutral ? "neutral" : Evaluation.Score.ToString();
            var extra = string.IsNullOrWhiteSpace(Class) ? "" : $" {Class}";
            return $"ui-password-strength ui-password-strength--{tone}{extra}";
        }
    }
}
