@using Apperture.Core.Domain.Identity

<div class="@Class" aria-live="polite">
    <div class="flex items-center justify-between gap-3">
        <span class="text-xs font-medium text-heading">Password strength</span>
        <span class="text-xs text-muted">@Evaluation.StrengthLabel</span>
    </div>
    <div class="mt-1.5 grid grid-cols-4 gap-1" role="meter" aria-label="Password strength" aria-valuemin="0" aria-valuemax="4" aria-valuenow="@Evaluation.Score" aria-valuetext="@Evaluation.StrengthLabel">
        @for (var i = 1; i <= 4; i++)
        {
            <span class="@BarClass(i)"></span>
        }
    </div>
    @if (!string.IsNullOrWhiteSpace(Guidance))
    {
        <p class="mt-2 text-xs text-muted">@Guidance</p>
    }
</div>

@code {
    [Parameter, EditorRequired] public PasswordEvaluationResult Evaluation { get; set; } = new(false, PasswordStrengthLevel.VeryWeak, 0, [], []);
    [Parameter] public string Class { get; set; } = "";

    private string Guidance =>
        Evaluation.Issues.Count > 0 ? Evaluation.Issues[0]
        : Evaluation.Suggestions.Count > 0 ? Evaluation.Suggestions[0]
        : "";

    private string BarClass(int index)
    {
        var filled = Evaluation.Score >= index && Evaluation.Score > 0;
        var tone = Evaluation.Strength switch
        {
            PasswordStrengthLevel.VeryStrong or PasswordStrengthLevel.Strong => "bg-[var(--color-success)]",
            PasswordStrengthLevel.Fair => "bg-[var(--color-warning)]",
            _ => "bg-[var(--color-error)]"
        };
        return filled
            ? $"h-1.5 rounded-full {tone}"
            : "h-1.5 rounded-full bg-[var(--color-border)]";
    }
}
