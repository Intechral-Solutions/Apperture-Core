@using Blazor.Heroicons.Solid
@using Microsoft.AspNetCore.Components.Web

@* The label names the action, not the glyph. Closed shows the menu icon; open shows a close (X) icon. *@
<button @ref="_button"
        type="button"
        class="relative -mx-3 flex items-center justify-center px-3 transition-all duration-300
               @(IsLocked ? "hamburger-toggle-open" : "hamburger-toggle-closed")"
        aria-label="@(IsLocked ? "Close navigation" : "Open navigation")"
        aria-expanded="@(IsLocked ? "true" : "false")"
        aria-controls="control-panel"
        @onclick="Toggle">
    <span class="ui-hamburger-icon flex h-6 w-6 items-center justify-center pointer-events-none" aria-hidden="true">
        @if (IsLocked)
        {
            <XMarkIcon class="h-6 w-6" />
        }
        else
        {
            <Bars3Icon class="h-6 w-6" />
        }
    </span>
</button>

@code {
    private ElementReference _button;

    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public bool IsLocked { get; set; }
    [Parameter] public EventCallback<bool> OnToggle { get; set; }

    private async Task Toggle()
    {
        if (OnToggle.HasDelegate)
            await OnToggle.InvokeAsync(!IsOpen);
    }
}
