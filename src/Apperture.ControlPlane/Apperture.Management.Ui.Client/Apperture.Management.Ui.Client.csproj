<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Apperture.Management.Ui.Client</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UiAppSettingsCanonical>$(MSBuildThisFileDirectory)..\..\..\deploy\config\ui\appsettings.json</UiAppSettingsCanonical>
    <UiAppSettingsWwwRoot>$(MSBuildThisFileDirectory)wwwroot\appsettings.json</UiAppSettingsWwwRoot>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Blazor.Heroicons" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Apperture.Management.Client\Apperture.Management.Client.csproj" />
    <ProjectReference Include="..\Apperture.Management.Ui.Shared\Apperture.Management.Ui.Shared.csproj" />
  </ItemGroup>
  <Target Name="SyncCanonicalUiAppSettings" BeforeTargets="BeforeBuild">
    <Copy SourceFiles="$(UiAppSettingsCanonical)" DestinationFiles="$(UiAppSettingsWwwRoot)" SkipUnchangedFiles="true" Condition="Exists('$(UiAppSettingsCanonical)')" />
  </Target>
</Project>
