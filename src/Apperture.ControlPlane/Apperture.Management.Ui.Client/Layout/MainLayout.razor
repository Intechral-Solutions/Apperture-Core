@using Apperture.Management.Ui.Client.Services
@inherits LayoutComponentBase

@inject DomainMenuService DomainMenuService
@inject NavigationManager NavManager

<div id="main" class="flex h-screen bg-surface-elevated">
    <NavRail IsControlPanelOpen="@isControlPanelOpen"
             IsControlPanelLocked="@isControlPanelLocked"
             CurrentDomainName="@currentDomainName"
             OnControlPanelOpen="HandleControlPanelOpen"
             OnControlPanelClose="HandleControlPanelClose" />

    <div class="flex min-h-0 flex-1 flex-col @(isControlPanelOpen ? "ml-70" : "ml-17")">
        <TopBar IsControlPanelOpen="@isControlPanelOpen"
                IsControlPanelLocked="@isControlPanelLocked"
                OnHamburgerClick="HandleHamburgerClick" />
        <div id="content-wrapper" class="flex-1 overflow-y-auto">
            <main class="px-1">
                @Body
            </main>
        </div>
    </div>
</div>

@code {
    private bool isControlPanelOpen;
    private bool isControlPanelLocked;
    private string currentDomainName = "";

    private void HandleControlPanelOpen(string domainName)
    {
        currentDomainName = domainName;
        isControlPanelOpen = true;
        isControlPanelLocked = true;
    }

    private void HandleControlPanelClose()
    {
        isControlPanelOpen = false;
        isControlPanelLocked = false;
    }

    private async Task HandleHamburgerClick(bool _)
    {
        if (isControlPanelLocked)
        {
            isControlPanelLocked = false;
            isControlPanelOpen = false;
        }
        else
        {
            // Ensure the control panel shows the submenu relevant to the current route.
            await DomainMenuService.LoadMenusAsync();
            var resolved = ResolveDomainForCurrentUri();
            if (!string.IsNullOrWhiteSpace(resolved))
                currentDomainName = resolved;

            isControlPanelOpen = true;
            isControlPanelLocked = true;
        }
    }

    private string ResolveDomainForCurrentUri()
    {
        var path = new Uri(NavManager.Uri).AbsolutePath;

        foreach (var domainName in DomainMenuService.GetValidDomains())
        {
            var menu = DomainMenuService.GetDomain(domainName);
            if (menu?.Items is null) continue;

            foreach (var item in menu.Items)
            {
                var href = item.Href;
                if (string.IsNullOrWhiteSpace(href)) continue;

                // Allow prefix matching so routes like `/runs/{RunId}` still select `Runs`.
                if (path.StartsWith(href, StringComparison.OrdinalIgnoreCase))
                    return domainName;
            }
        }

        return "";
    }
}
