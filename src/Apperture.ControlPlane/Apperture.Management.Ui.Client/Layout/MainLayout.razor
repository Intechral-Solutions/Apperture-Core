@using Apperture.Management.Ui.Client.Services
@using Apperture.Management.Ui.Shared
@inherits LayoutComponentBase
@implements IDisposable

@inject DomainMenuService DomainMenuService
@inject NavigationManager NavManager
@inject SessionStateService SessionState

<div id="main" class="flex h-screen bg-shell">
    <NavRail IsControlPanelOpen="@isControlPanelOpen"
             IsControlPanelLocked="@isControlPanelLocked"
             CurrentDomainName="@currentDomainName"
             OnControlPanelOpen="HandleControlPanelOpen"
             OnControlPanelClose="HandleControlPanelClose" />

    <div class="flex min-h-0 flex-1 flex-col @(isControlPanelOpen ? "shell-main-offset-open" : "shell-main-offset-closed")">
        @if (SessionState.State == SessionLoadState.ForbiddenUnlinked)
        {
            <div class="border-b border-message-warning bg-message-warning px-4 py-2 text-sm text-body" role="status">
                You are signed in, but this identity is not linked to a platform user. Some features will be unavailable until an administrator links your account.
            </div>
        }
        <TopBar IsControlPanelOpen="@isControlPanelOpen"
                IsControlPanelLocked="@isControlPanelLocked"
                OnHamburgerClick="HandleHamburgerClick" />
        <ToastHost />
        <div id="content-wrapper" class="flex-1 overflow-y-auto">
            <main class="px-1">
                @Body
            </main>
        </div>
    </div>
</div>

@code {
    private bool isControlPanelOpen;
    private bool isControlPanelLocked;
    private string currentDomainName = "";

    protected override async Task OnInitializedAsync()
    {
        SessionState.Changed += OnSessionChanged;
        await DomainMenuService.LoadMenusAsync();
        ResolveAndUpdateCurrentDomain();
        NavManager.LocationChanged += OnLocationChanged;
    }

    private bool _disposed;

    public void Dispose()
    {
        if (_disposed)
            return;
        _disposed = true;
        SessionState.Changed -= OnSessionChanged;
        NavManager.LocationChanged -= OnLocationChanged;
    }

    private void OnSessionChanged() =>
        _ = InvokeAsync(() =>
        {
            if (_disposed)
                return;
            StateHasChanged();
        });

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        ResolveAndUpdateCurrentDomain();
        _ = InvokeAsync(() =>
        {
            if (_disposed)
                return;
            StateHasChanged();
        });
    }

    private void ResolveAndUpdateCurrentDomain()
    {
        var resolved = ResolveDomainForCurrentUri();
        currentDomainName = resolved;
    }

    private void HandleControlPanelOpen(string domainName)
    {
        currentDomainName = domainName;
        isControlPanelOpen = true;
        isControlPanelLocked = true;
    }

    private void HandleControlPanelClose()
    {
        isControlPanelOpen = false;
        isControlPanelLocked = false;
    }

    private async Task HandleHamburgerClick(bool _)
    {
        if (isControlPanelLocked)
        {
            isControlPanelLocked = false;
            isControlPanelOpen = false;
        }
        else
        {
            // Ensure the control panel shows the submenu relevant to the current route.
            await DomainMenuService.LoadMenusAsync();
            currentDomainName = ResolveDomainForCurrentUri();

            isControlPanelOpen = true;
            isControlPanelLocked = true;
        }
    }

    private string ResolveDomainForCurrentUri()
    {
        var path = new Uri(NavManager.Uri).AbsolutePath;
        return RouteToSectionResolver.Resolve(
            path,
            DomainMenuService.GetDomain,
            DomainMenuService.GetValidDomains());
    }
}
