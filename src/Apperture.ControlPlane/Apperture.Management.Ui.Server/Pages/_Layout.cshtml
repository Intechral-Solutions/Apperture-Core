@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @if (HostEnvironment.IsDevelopment())
    {
        @* So WASM loads wwwroot/appsettings.Development.json (API on :9000, UI on :9001). *@
        <meta name="blazor-environment" content="Development" />
        @* Avoid stale prerendered boot config after rebuilds (hashed _framework assets would 404). *@
        <meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate" />
        <meta http-equiv="Pragma" content="no-cache" />
    }
    <title>Apperture</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' fill='%231a1a2e'/><text x='16' y='22' font-size='18' text-anchor='middle' fill='%23eee'>A</text></svg>" />
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="css/app.css" />
    <script>
        (function () {
            try {
                var k = 'apperture.theme';
                var v = localStorage.getItem(k) || 'System';
                var dark = v === 'Dark' || (v === 'System' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
                document.documentElement.classList.toggle('dark', dark);
            } catch (e) { }
        })();
    </script>
    <script src="js/apperture-shell.js"></script>
    <script src="js/control-panel-resize.js"></script>
</head>
<body id="app">
    @RenderBody()
    <script src="_framework/blazor.webassembly.js"></script>
</body>
</html>
