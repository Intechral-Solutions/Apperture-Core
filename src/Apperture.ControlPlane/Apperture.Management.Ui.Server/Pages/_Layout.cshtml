@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @if (HostEnvironment.IsDevelopment())
    {
        @* So WASM loads wwwroot/appsettings.Development.json (API on :9000, UI on :9001). *@
        <meta name="blazor-environment" content="Development" />
        @* Avoid stale prerendered boot config after rebuilds (hashed _framework assets would 404). *@
        <meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate" />
        <meta http-equiv="Pragma" content="no-cache" />
    }
    <title>Apperture</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'><rect width='32' height='32' fill='%231a1a2e'/><text x='16' y='22' font-size='18' text-anchor='middle' fill='%23eee'>A</text></svg>" />
    <base href="/" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="css/app.css" />
    <link rel="stylesheet" href="css/management-ui-primitives.css" />
    <script>
        (function () {
            try {
                var k = 'apperture.theme';
                var v = localStorage.getItem(k) || 'System';
                var dark = v === 'Dark' || (v === 'System' && window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches);
                document.documentElement.classList.toggle('dark', dark);
            } catch (e) { }
        })();
    </script>
    <script src="js/apperture-shell.js"></script>
    <script src="js/control-panel-resize.js"></script>
    @* #region agent log *@
    <script>
        (function () {
            function snap() {
                var app = document.getElementById('app');
                var html = app ? (app.innerHTML || '') : '';
                var stamp = 'pass18-singleroot';
                if (window.appertureShell && window.appertureShell.debugLog) {
                    window.appertureShell.debugLog('_Layout.cshtml:pre-wasm', 'host-dom-before-wasm', 'H1', {
                        buildStamp: stamp,
                        appChildCount: app ? app.childNodes.length : -1,
                        appHtmlLen: html.length,
                        appHtmlHead: html.slice(0, 240),
                        bodyIdIsApp: document.body && document.body.id === 'app',
                        hasBlazorComment: html.indexOf('blazor') >= 0 || html.indexOf('Blazor') >= 0
                    });
                }
            }
            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', snap);
            } else {
                snap();
            }
            window.addEventListener('load', function () {
                var app = document.getElementById('app');
                var html = app ? (app.innerHTML || '') : '';
                if (window.appertureShell && window.appertureShell.debugLog) {
                    window.appertureShell.debugLog('_Layout.cshtml:load', 'host-dom-after-load', 'H2', {
                        appHtmlLen: html.length,
                        appHtmlHead: html.slice(0, 240)
                    });
                }
            });
        })();
    </script>
    @* #endregion *@
</head>
<body>
    @* Blazor root must not be <body> — that would replace the boot script node. *@
    <div id="app">
        @RenderBody()
    </div>
    <script src="_framework/blazor.webassembly.js"></script>
</body>
</html>
