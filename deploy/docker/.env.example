# DO NOT EDIT .env BY HAND. It is generated by scripts/dev/Sync-EnvFromUserSecrets.ps1
# from User Secrets (SqlServer:Password). Single source of truth.
#
# To set the SQL Server password, use:
#   dotnet user-secrets set "SqlServer:Password" "<password>" --project src/Apperture.ControlPlane/Apperture.Management.Host
#
# For integration tests (dotnet test), set the Aspire SQL endpoint explicitly:
#   APPERTURE_TEST_SQL_CONNECTION_STRING=Server=127.0.0.1,<aspire-port>;User Id=sa;Password=<password>;TrustServerCertificate=True;Initial Catalog=Apperture;
# Semicolon-heavy values work unquoted; double quotes are also supported.
# Legacy fallback (defaults to localhost,1433) is used only when the line above is absent:
#   MSSQL_SA_PASSWORD=<password>
