{
  "_Comment": "On-premises Windows instance template. Merge into appsettings.Production.json or instance-specific config. See docs/03-operations/management-platform-configuration.md and docs/01-architecture/bootstrap-and-secrets-boundary.md.",
  "SqlServer": {
    "Server": "your-sql-host",
    "Database": "Apperture",
    "CredentialReference": {
      "SourceType": "WindowsIntegrated",
      "Reference": ""
    }
  },
  "LocalAuth": {
    "Enabled": false
  },
  "Entra": {
    "Enabled": false,
    "TenantId": "",
    "ClientId": "",
    "Instance": "https://login.microsoftonline.com/"
  },
  "BootstrapPlatformAdmin": {
    "Enabled": true,
    "CreateUserIfMissing": false,
    "Principals": []
  },
  "PlatformEvents": {
    "Enabled": false
  },
  "Notifications": {
    "Evaluation": { "Enabled": false },
    "Instances": { "Enabled": false },
    "Delivery": { "Enabled": false },
    "UsePlatformPipeline": { "Enabled": false }
  }
}
