{
  "SqlServer": {
    "Server": "localhost,1433",
    "Database": "Apperture",
    "User": "sa"
  },
  "DevTestUser": {
    "Enabled": true,
    "Username": "tenny",
    "DisplayName": "Tenny (Dev)",
    "Password": "dev"
  },
  "BootstrapPlatformAdmin": {
    "Enabled": true,
    "CreateUserIfMissing": true,
    "Principals": [
      {
        "IdentitySource": "Local",
        "ExternalId": "tenny",
        "DisplayName": "Tenny (bootstrap admin)"
      }
    ]
  },
  "_BootstrapPlatformAdmin_Comment": "For Entra: set IdentitySource to Entra and ExternalId to the user's object id (oid) from the token — not email. Local usernames are normalized (trim, lowercase). Idempotent: safe on every startup.",
  "LocalAuth": {
    "Enabled": true
  },
  "BreakGlassAuth": {
    "Enabled": false
  },
  "PlatformEvents": {
    "Enabled": true
  },
  "_Notifications_Comment": "Matches Management Host: evaluation, instances, and delivery enabled. SMTP remains empty until configured.",
  "Notifications": {
    "Evaluation": { "Enabled": true },
    "Instances": { "Enabled": true },
    "Delivery": {
      "Enabled": true,
      "PollIntervalSeconds": 30,
      "BatchSize": 20,
      "MaxAttempts": 5,
      "InitialBackoffSeconds": 60,
      "MaxBackoffSeconds": 3600
    },
    "Email": {
      "SmtpHost": "",
      "SmtpPort": 587,
      "SmtpUseSsl": true,
      "SmtpUser": "",
      "SmtpPassword": "",
      "SmtpPasswordRef": "",
      "FromAddress": "",
      "FromDisplayName": "Apperture"
    }
  },
  "AttentionIncidents": {
    "Observation": {
      "Enabled": true,
      "Interval": "00:05:00"
    }
  }
}
