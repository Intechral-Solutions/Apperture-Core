<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Lets the "Security-patched transitive pins" below override the version an upstream package asks for. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- Windows DPAPI -->
    <PackageVersion Include="Microsoft.Kiota.Abstractions" Version="2.1.2" />
    <PackageVersion Include="Microsoft.Kiota.Authentication.Azure" Version="2.1.2" />
    <PackageVersion Include="Microsoft.Kiota.Http.HttpClientLibrary" Version="2.1.2" />
    <PackageVersion Include="Microsoft.Kiota.Serialization.Form" Version="2.1.2" />
    <PackageVersion Include="Microsoft.Kiota.Serialization.Json" Version="2.1.2" />
    <PackageVersion Include="Microsoft.Kiota.Serialization.Multipart" Version="2.1.2" />
    <PackageVersion Include="Microsoft.Kiota.Serialization.Text" Version="2.1.2" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
    <!-- SQL Client -->
    <PackageVersion Include="Microsoft.Data.SqlClient" Version="7.0.3" />
    <!-- EF Core -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <!-- DTFx -->
    <PackageVersion Include="DurableTask.Core" Version="2.0.0.6" />
    <!-- Microsoft.Extensions -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.FileProviders.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.13" />
    <!-- ASP.NET Core -->
    <PackageVersion Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.13" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Cryptography.KeyDerivation" Version="10.0.13" />
    <!-- Testing -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.10.0" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.0" />
    <PackageVersion Include="FluentAssertions" Version="8.10.0" />
    <PackageVersion Include="bunit" Version="2.11.3" />
    <PackageVersion Include="Moq" Version="4.20.72" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="10.0.13" />
    <!-- Opt-in browser proof harness (tests/Apperture.BrowserTests) -->
    <PackageVersion Include="Microsoft.Playwright" Version="1.63.0" />
    <!-- Azure Key Vault and Identity (runtime secret resolution) -->
    <PackageVersion Include="Azure.Identity" Version="1.21.0" />
    <PackageVersion Include="Azure.Security.KeyVault.Secrets" Version="4.11.1" />
    <PackageVersion Include="Microsoft.Graph" Version="6.6.0" />
    <!-- Cron / schedule evaluation (Epic 28) -->
    <PackageVersion Include="Cronos" Version="0.13.0" />
    <!-- Azure Functions (isolated, .NET 10 compatible) -->
    <PackageVersion Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.1.0" />
    <PackageVersion Include="Microsoft.Azure.Functions.Worker.Extensions.Http" Version="3.3.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.13" />
    <PackageVersion Include="Microsoft.AspNetCore.Components.WebAssembly.Server" Version="10.0.13" />
    <PackageVersion Include="Blazor.Heroicons" Version="3.2.1.2" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.13" />
    <!-- SFTP (Campus Nexus / file integrations) -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <!-- Profile image decode / normalize (MIT-licensed; Linux native assets for containerized hosts) -->
    <PackageVersion Include="SkiaSharp" Version="4.152.0" />
    <PackageVersion Include="SkiaSharp.NativeAssets.Linux" Version="4.152.0" />
    <!-- .NET Aspire (Epic 106 — local dev orchestration) -->
    <PackageVersion Include="Aspire.Hosting.SqlServer" Version="13.5.3" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.10.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.10.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.18.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.18.0" />
    <PackageVersion Include="Zxcvbn" Version="0.1.1" />
    <!--
      Security-patched transitive pins. No project references these directly; they exist only so that
      CentralPackageTransitivePinningEnabled lifts the version an upstream package requests.
      Remove a pin once every upstream package that reaches it asks for a patched version.
      - System.Security.Cryptography.Pkcs: Microsoft.Data.SqlClient (6.1.x and 7.x) and Aspire.Hosting.SqlServer
        request 9.0.11-9.0.13 or 10.0.11, all inside the vulnerable ranges <= 9.0.20 and <= 10.0.12
        (GHSA-846f-f764-76mx, GHSA-2fmv-rv2c-59x7). Patched for net10.0: 10.0.13.
      - MessagePack: reached through Aspire.Hosting -> StreamJsonRpc, which requests 2.5.302
        (GHSA-qhrr-8q5h-9q3h, fixed in 2.5.303). 2.5.307 additionally fixes the LZ4 decompression overflow
        GHSA-7rj2-5w9w-r9jx, which affects every version below 2.5.307 and is not yet in the NuGet audit feed.
    -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <PackageVersion Include="MessagePack" Version="2.5.307" />
  </ItemGroup>
</Project>