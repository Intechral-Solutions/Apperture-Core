<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Apperture.Management.Ui.Shared.Tests</RootNamespace>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Apperture.Core\Apperture.Core.Domain\Apperture.Core.Domain.csproj" />
    <!-- Ui.Shared production code deliberately does NOT reference Apperture.Core.Application (see
         NotificationToastSeverityMapper's <remarks>); this test-only reference exists so
         NotificationToastSeverityMapperTests can reflect over PlatformEventSeverities to detect
         drift between it and the mapper's local literal constants. Mirrors this project's existing
         practice of referencing Apperture.Core.Domain directly even though the production project
         it tests only gets that transitively. -->
    <ProjectReference Include="..\..\src\Apperture.Core\Apperture.Core.Application\Apperture.Core.Application.csproj" />
    <ProjectReference Include="..\..\src\Apperture.ControlPlane\Apperture.Management.Client\Apperture.Management.Client.csproj" />
    <ProjectReference Include="..\..\src\Apperture.ControlPlane\Apperture.Management.Ui.Shared\Apperture.Management.Ui.Shared.csproj" />
  </ItemGroup>
</Project>
